{
  "name": "@schedule/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backup-archive": {
      "types": "./dist/jobs/backup-archive.d.ts",
      "import": "./dist/jobs/backup-archive.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file=../../.env dist/local-server.js",
    "migrate": "node --env-file=../../.env dist/migrate.js",
    "start": "node --env-file=../../.env dist/local-server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "4.0.3",
    "@schedule/contracts": "workspace:*",
    "@schedule/database": "workspace:*",
    "@schedule/scheduling-domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@schedule/test-fixtures": "workspace:*"
  }
}
