<page-shell title="换班与加扣班">
  <shell-state
    wx:if="{{!hasWorkflowAccess}}"
    kind="error"
    title="当前群组无工作流权限"
    description="请返回工作台选择成员、管理员或群主身份的群组。"
  />
  <view wx:elif="{{workflow}}" class="operations-page">
    <text wx:if="{{workflow.errorMessage}}" class="operations-message operations-message--error"
      >{{workflow.errorMessage}}</text
    >
    <text wx:if="{{workflow.conflict}}" class="operations-message operations-message--error"
      >{{workflow.conflict.message}}</text
    >
    <text wx:if="{{workflow.infoMessage}}" class="operations-message operations-message--success"
      >{{workflow.infoMessage}}</text
    >

    <picker mode="date" fields="month" value="{{workflow.businessMonth}}" bindchange="handleMonth">
      <view class="operations-field"
        ><text>候选班次月份</text><text>{{workflow.businessMonth}}</text></view
      >
    </picker>

    <view class="operations-card">
      <text class="operations-title">普通换班</text>
      <text class="operations-hint">先生成双方班次、冲突与服务端状态预览，再确认提交。</text>
      <picker
        range="{{workflow.swap.candidates}}"
        range-key="label"
        bindchange="handleSwapInitiator"
      >
        <view class="operations-field"
          ><text>我的/发起班次</text
          ><text>{{workflow.swap.form.initiatorAssignmentId || '请选择'}}</text></view
        >
      </picker>
      <picker range="{{workflow.swap.candidates}}" range-key="label" bindchange="handleSwapTarget">
        <view class="operations-field"
          ><text>目标班次</text
          ><text>{{workflow.swap.form.targetAssignmentId || '请选择'}}</text></view
        >
      </picker>
      <view wx:if="{{workflow.swap.preview}}" class="operations-preview">
        <view wx:if="{{workflow.swap.isDirectPreview}}">
          <text>管理员直办换班将立即完成，无需成员同意或群组审批。</text>
          <text>双方班次已进入事务前预览；最终仍由服务端校验。</text>
        </view>
        <view wx:else>
          <text>服务端后续状态：{{workflow.swap.preview.nextStatus}}</text>
          <text>对方自动接受：{{workflow.swap.preview.targetAutoAccepts ? '是' : '否'}}</text>
          <text>需要群组审批：{{workflow.swap.preview.requiresApproval ? '是' : '否'}}</text>
        </view>
        <text
          wx:for="{{workflow.swap.preview.conflicts}}"
          wx:key="message"
          class="operations-message operations-message--error"
          >{{item.message}}</text
        >
      </view>
      <button class="operations-button" bindtap="handleSwapSubmit" loading="{{workflow.isWriting}}">
        预览/提交普通换班
      </button>
      <button
        wx:if="{{isAdministrator}}"
        class="operations-button operations-button--secondary"
        bindtap="handleSwapDirect"
      >
        管理员直办换班（先预览，立即完成）
      </button>
    </view>

    <view class="operations-card">
      <text class="operations-title">普通加扣班</text>
      <text class="operations-hint">普通申请先预览；原因选填，服务端状态原样显示。</text>
      <picker range="{{workflow.duty.candidates}}" range-key="label" bindchange="handleDutyCovered">
        <view class="operations-field"
          ><text>被代班次</text
          ><text>{{workflow.duty.form.coveredAssignmentId || '请选择'}}</text></view
        >
      </picker>
      <picker
        range="{{workflow.duty.members}}"
        range-key="realName"
        bindchange="handleDutyOvertime"
      >
        <view class="operations-field"
          ><text>加班成员</text
          ><text>{{workflow.duty.form.overtimeMembershipId || '请选择'}}</text></view
        >
      </picker>
      <textarea
        class="operations-reason"
        value="{{workflow.duty.form.reason}}"
        maxlength="200"
        placeholder="原因（选填）"
        bindinput="handleDutyReason"
      />
      <view wx:if="{{workflow.duty.preview}}" class="operations-preview">
        <text>服务端后续状态：{{workflow.duty.preview.nextStatus}}</text>
        <text>加班成员自动接受：{{workflow.duty.preview.overtimeAutoAccepts ? '是' : '否'}}</text>
        <text>需要群组审批：{{workflow.duty.preview.requiresApproval ? '是' : '否'}}</text>
        <text
          wx:for="{{workflow.duty.preview.conflicts}}"
          wx:key="message"
          class="operations-message operations-message--error"
          >{{item.message}}</text
        >
      </view>
      <button class="operations-button" bindtap="handleDutySubmit" loading="{{workflow.isWriting}}">
        预览/提交普通加扣班
      </button>
      <button
        wx:if="{{isAdministrator}}"
        class="operations-button operations-button--secondary"
        bindtap="handleDutyDirect"
      >
        管理员直办加扣班（无需预览，立即完成）
      </button>
    </view>

    <view class="operations-card">
      <text class="operations-title">审批设置</text>
      <view class="operations-field"
        ><text>我自动接受换班</text
        ><switch checked="{{workflow.swap.swapAutoAccepts}}" bindchange="handleMemberSetting"
      /></view>
      <view wx:if="{{isAdministrator}}" class="operations-settings">
        <view class="operations-field"
          ><text>换班需要群组审批</text
          ><switch checked="{{workflow.swap.groupRequiresApproval}}" bindchange="handleSwapSetting"
        /></view>
        <view class="operations-field"
          ><text>加扣班需要群组审批</text
          ><switch checked="{{workflow.duty.groupRequiresApproval}}" bindchange="handleDutySetting"
        /></view>
      </view>
    </view>

    <view class="operations-card">
      <text class="operations-title">换班请求</text>
      <text wx:if="{{swapItems.length === 0}}" class="operations-hint">暂无换班请求。</text>
      <view wx:for="{{swapItems}}" wx:key="id" class="operations-request">
        <text>状态：{{item.status}}</text
        ><text wx:if="{{item.decidedByMemberName}}">处理人：{{item.decidedByMemberName}}</text>
        <text
          wx:if="{{item.revocationBlockedReason}}"
          class="operations-message operations-message--error"
          >{{item.revocationBlockedReason}}</text
        >
        <view class="operations-actions">
          <button
            wx:if="{{item.actions.accept}}"
            data-domain="swap"
            data-action="accept"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            接受
          </button>
          <button
            wx:if="{{item.actions.approve}}"
            data-domain="swap"
            data-action="approve"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            批准
          </button>
          <button
            wx:if="{{item.actions.reject}}"
            data-domain="swap"
            data-action="reject"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            驳回
          </button>
          <button
            wx:if="{{item.actions.cancel}}"
            data-domain="swap"
            data-action="cancel"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            取消
          </button>
          <button
            wx:if="{{item.actions.revoke}}"
            data-domain="swap"
            data-action="revoke"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            撤销
          </button>
          <text wx:if="{{item.actions.autoArchived}}" class="operations-hint"
            >已自动归档/不可撤销。</text
          >
        </view>
      </view>
    </view>

    <view class="operations-card">
      <text class="operations-title">加扣班请求</text>
      <text wx:if="{{dutyItems.length === 0}}" class="operations-hint">暂无加扣班请求。</text>
      <view wx:for="{{dutyItems}}" wx:key="id" class="operations-request">
        <text>状态：{{item.status}}</text
        ><text wx:if="{{item.decidedByMemberName}}">处理人：{{item.decidedByMemberName}}</text>
        <text
          wx:if="{{item.revocationBlockedReason}}"
          class="operations-message operations-message--error"
          >{{item.revocationBlockedReason}}</text
        >
        <view class="operations-actions">
          <button
            wx:if="{{item.actions.accept}}"
            data-domain="duty"
            data-action="accept"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            接受
          </button>
          <button
            wx:if="{{item.actions.approve}}"
            data-domain="duty"
            data-action="approve"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            批准
          </button>
          <button
            wx:if="{{item.actions.reject}}"
            data-domain="duty"
            data-action="reject"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            驳回
          </button>
          <button
            wx:if="{{item.actions.cancel}}"
            data-domain="duty"
            data-action="cancel"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            取消
          </button>
          <button
            wx:if="{{item.actions.revoke}}"
            data-domain="duty"
            data-action="revoke"
            data-id="{{item.id}}"
            bindtap="handleAction"
          >
            撤销
          </button>
          <text wx:if="{{item.actions.autoArchived}}" class="operations-hint"
            >已自动归档/不可撤销。</text
          >
        </view>
      </view>
    </view>
  </view>
</page-shell>
