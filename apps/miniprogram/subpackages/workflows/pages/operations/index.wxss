.operations-page,
.operations-card,
.operations-settings,
.operations-preview,
.operations-request,
.operations-actions {
  display: grid;
  gap: 14rpx;
}

.operations-page {
  padding-bottom: 32rpx;
}
.operations-card {
  padding: 24rpx;
  border: 1rpx solid #dbe4f0;
  border-radius: 16rpx;
  background: #ffffff;
}
.operations-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}
.operations-hint {
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.6;
}
.operations-field {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f7;
  color: #334155;
  font-size: 27rpx;
}
.operations-button {
  margin: 0;
  color: #ffffff;
  background: #1f5aa6;
}
.operations-button--secondary {
  color: #1f5aa6;
  background: #e9f0fa;
}
.operations-reason {
  width: auto;
  min-height: 120rpx;
  padding: 16rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
}
.operations-preview {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 25rpx;
}
.operations-message {
  display: block;
  font-size: 25rpx;
  line-height: 1.5;
}
.operations-message--error {
  color: #b42318;
}
.operations-message--success {
  color: #067647;
}
.operations-request {
  padding: 16rpx 0;
  border-top: 1rpx solid #edf2f7;
  color: #475569;
  font-size: 25rpx;
}
.operations-actions {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.operations-actions button {
  margin: 0;
  font-size: 24rpx;
}
