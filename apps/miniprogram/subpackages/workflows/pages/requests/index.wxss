.workflow-center {
  display: grid;
  gap: 16rpx;
}

.workflow-center__intro,
.workflow-center__later {
  display: grid;
  gap: 8rpx;
  padding: 24rpx;
  border: 1rpx solid #dbe4f0;
  border-radius: 16rpx;
  background: #ffffff;
}

.workflow-center__title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}

.workflow-center__description,
.workflow-center__later {
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
}

.workflow-center__primary {
  margin: 0;
  color: #ffffff;
  background: #1f5aa6;
}
