<page-shell title="全天请假与审批">
  <shell-state
    wx:if="{{!hasWorkflowAccess}}"
    kind="error"
    title="当前群组无工作流权限"
    description="请返回工作台选择成员、管理员或群主身份的群组。"
  />
  <view wx:elif="{{workflow}}" class="leave-page">
    <text wx:if="{{workflow.errorMessage}}" class="leave-page__message leave-page__message--error"
      >{{workflow.errorMessage}}</text
    >
    <text wx:if="{{workflow.conflict}}" class="leave-page__message leave-page__message--error"
      >{{workflow.conflict.message}}</text
    >
    <text wx:if="{{workflow.infoMessage}}" class="leave-page__message leave-page__message--success"
      >{{workflow.infoMessage}}</text
    >

    <view class="leave-card">
      <text class="leave-card__title">提交全天请假</text>
      <text class="leave-card__hint"
        >提交前仅查询影响提示；这不是正式重排预览，提示失败也不会阻止提交。</text
      >
      <picker mode="date" value="{{workflow.form.startDate}}" bindchange="handleStartDateChange">
        <view class="leave-field"
          ><text>开始日期</text><text>{{workflow.form.startDate}}</text></view
        >
      </picker>
      <picker mode="date" value="{{workflow.form.endDate}}" bindchange="handleEndDateChange">
        <view class="leave-field"><text>结束日期</text><text>{{workflow.form.endDate}}</text></view>
      </picker>
      <picker range="{{leaveTypeOptions}}" range-key="label" bindchange="handleLeaveTypeChange">
        <view class="leave-field"
          ><text>请假类型</text><text>{{workflow.form.leaveType}}</text></view
        >
      </picker>
      <textarea
        class="leave-reason"
        value="{{workflow.form.reason}}"
        maxlength="200"
        placeholder="原因（选填）"
        bindinput="handleReasonInput"
      />
      <text class="leave-card__days"
        >已选全天 {{workflow.form.startDate}} 至 {{workflow.form.endDate}}，共 {{workflow.dayCount}}
        天</text
      >

      <view wx:if="{{workflow.impact.kind === 'loading'}}" class="leave-impact"
        >正在查询已发布班次影响…</view
      >
      <view
        wx:elif="{{workflow.impact.kind === 'unavailable'}}"
        class="leave-impact leave-impact--warning"
        >影响班次暂时查询失败，仍可提交请假；审批时会重新生成完整预览。</view
      >
      <view wx:elif="{{workflow.impact.kind === 'none'}}" class="leave-impact"
        >已确认没有受影响的已发布班次，仍可提交请假。</view
      >
      <view wx:elif="{{workflow.impact.kind === 'ready'}}" class="leave-impact">
        <text>受影响的已发布班次：</text>
        <text wx:for="{{workflow.impact.shifts}}" wx:key="assignmentId" class="leave-impact__item"
          >{{item.businessDate}} · {{item.shiftTypeName}} · {{item.isCovered ? '已有覆盖' :
          '待审批处理'}}</text
        >
      </view>
      <button
        class="leave-button"
        bindtap="handleSubmitCreate"
        disabled="{{!workflow.canSubmit || workflow.isSubmitting}}"
        loading="{{workflow.isSubmitting}}"
      >
        提交请假
      </button>
    </view>

    <view wx:if="{{workflow.groupStrategy}}" class="leave-card">
      <text class="leave-card__title">群组默认重排策略</text>
      <text class="leave-card__hint">仅影响后续新申请；当前审批仍可按单项预览覆盖。</text>
      <picker
        range="{{strategyOptions}}"
        range-key="label"
        value="{{groupStrategyIndex}}"
        bindchange="handleGroupStrategyChange"
      >
        <view class="leave-field"
          ><text>默认策略</text><text>{{workflow.groupStrategy.draft}}</text></view
        >
      </picker>
    </view>

    <view class="leave-card">
      <text class="leave-card__title">我的申请</text>
      <text wx:if="{{workflow.myRequests.length === 0}}" class="leave-card__hint"
        >暂时没有请假申请。</text
      >
      <view wx:for="{{workflow.myRequests}}" wx:key="id" class="leave-request">
        <text>{{item.leaveType}} · {{item.startsAt}} 至 {{item.endsAt}}</text>
        <text>状态：{{item.status}} · 保存策略：{{item.reflowStrategy}}</text>
        <text wx:if="{{item.decidedByMemberName}}">处理人：{{item.decidedByMemberName}}</text>
        <button
          wx:if="{{item.status === 'pending'}}"
          class="leave-button leave-button--secondary"
          data-id="{{item.id}}"
          bindtap="handleCancel"
        >
          取消申请
        </button>
        <button
          wx:if="{{item.status === 'approved' && item.isRevocable !== false}}"
          class="leave-button leave-button--secondary"
          data-id="{{item.id}}"
          bindtap="handleRevoke"
        >
          撤销请假
        </button>
        <text
          wx:if="{{item.status === 'approved' && item.isRevocable === false}}"
          class="leave-card__hint"
          >该记录已被后续流程覆盖，不能撤销。</text
        >
      </view>
    </view>

    <view wx:if="{{workflow.approvals.length > 0}}" class="leave-card">
      <text class="leave-card__title">请假审批</text>
      <view wx:for="{{workflow.approvals}}" wx:key="id" class="leave-request">
        <text>{{item.memberName || '成员'}} · {{item.leaveType}} · {{item.status}}</text>
        <text wx:if="{{item.decidedByMemberName}}">已由 {{item.decidedByMemberName}} 处理</text>
        <button
          wx:if="{{item.status === 'pending'}}"
          class="leave-button leave-button--secondary"
          data-id="{{item.id}}"
          bindtap="handleOpenApproval"
        >
          查看审批预览
        </button>
      </view>
    </view>

    <view wx:if="{{workflow.approval}}" class="leave-card leave-approval">
      <text class="leave-card__title"
        >审批：{{workflow.approval.request.memberName || '成员'}}</text
      >
      <picker
        range="{{strategyOptions}}"
        range-key="label"
        bindchange="handleApprovalStrategyChange"
      >
        <view class="leave-field"
          ><text>本次重排策略</text><text>{{workflow.approval.strategy}}</text></view
        >
      </picker>
      <text wx:if="{{workflow.approval.isPreviewing}}" class="leave-card__hint"
        >正在生成完整审批预览…</text
      >
      <view wx:if="{{workflow.approval.preview}}" class="leave-preview">
        <text>涉及已发布班次：{{workflow.approval.preview.affectedShiftCount}}</text>
        <text
          wx:if="{{workflow.approval.preview.overlapsUnpublishedPeriod}}"
          class="leave-impact leave-impact--warning"
          >存在未发布期间：批准后仅记录请假，不会重排该期间。</text
        >
        <text
          wx:if="{{workflow.approval.preview.affectedAssignments.length === 0 && !workflow.approval.preview.overlapsUnpublishedPeriod}}"
          class="leave-card__hint"
          >该申请不改变已发布排班。</text
        >
        <view
          wx:for="{{workflow.approval.preview.affectedAssignments}}"
          wx:key="assignmentId"
          class="leave-preview__assignment"
        >
          <text>{{item.businessDate}} · {{item.shiftTypeName}}</text>
          <text>{{item.previousMemberName || '空缺'}} → {{item.nextMemberName || '空缺'}}</text>
        </view>
        <text>统计变化：{{workflow.approval.preview.statisticsDelta.totalAssignmentDelta}} 班</text>
        <text
          wx:if="{{workflow.approval.preview.workflowBlockers.length > 0}}"
          class="leave-impact leave-impact--error"
          >活动工作流阻塞：{{workflow.approval.preview.workflowBlockers.length}}
          项，不能确认绕过。</text
        >
        <text
          wx:if="{{workflow.approval.preview.conflicts.length > 0}}"
          class="leave-impact leave-impact--warning"
          >冲突：{{workflow.approval.preview.conflicts.length}} 项。</text
        >
        <text
          wx:if="{{workflow.approval.preview.continuousDutyWarnings.length > 0}}"
          class="leave-impact leave-impact--warning"
          >连续值班警告：{{workflow.approval.preview.continuousDutyWarnings.length}}
          项（仅提示）。</text
        >
        <text
          wx:if="{{workflow.approval.preview.vacancies.length > 0}}"
          class="leave-impact leave-impact--warning"
          >空缺：{{workflow.approval.preview.vacancies.length}} 项。</text
        >
        <checkbox-group
          wx:if="{{workflow.approval.preview.workflowBlockers.length === 0 && (workflow.approval.preview.conflicts.length > 0 || workflow.approval.preview.vacancies.length > 0)}}"
          bindchange="handleAcknowledgement"
        >
          <label class="leave-acknowledgement"
            ><checkbox
              value="acknowledge"
              checked="{{workflow.approval.acknowledgeBlockers}}"
            />我已确认冲突和空缺。</label
          >
        </checkbox-group>
        <text class="leave-card__hint">手动排班快捷入口当前不可用，不创建空路由。</text>
        <view class="leave-actions">
          <text wx:if="{{workflow.approvalBlockReason}}" class="leave-card__hint"
            >{{workflow.approvalBlockReason}}</text
          >
          <button class="leave-button leave-button--secondary" bindtap="handleReject">驳回</button>
          <button
            class="leave-button"
            bindtap="handleApprove"
            disabled="{{!workflow.canApproveApproval}}"
          >
            批准
          </button>
        </view>
      </view>
    </view>
  </view>
</page-shell>
