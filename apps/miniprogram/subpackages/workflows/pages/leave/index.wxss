.leave-page,
.leave-card,
.leave-preview,
.leave-request {
  display: grid;
  gap: 16rpx;
}

.leave-page {
  padding-bottom: 24rpx;
}

.leave-card {
  padding: 24rpx;
  border: 1rpx solid #dbe4f0;
  border-radius: 16rpx;
  background: #ffffff;
}

.leave-card__title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}

.leave-card__hint,
.leave-card__days,
.leave-request,
.leave-preview {
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
}

.leave-field {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  color: #334155;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 28rpx;
}

.leave-reason {
  width: 100%;
  min-height: 136rpx;
  padding: 16rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  color: #334155;
  font-size: 28rpx;
}

.leave-impact,
.leave-page__message {
  display: grid;
  gap: 8rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  color: #334155;
  background: #f1f5f9;
  font-size: 26rpx;
  line-height: 1.55;
}

.leave-impact--warning {
  color: #92400e;
  background: #fffbeb;
}

.leave-impact--error,
.leave-page__message--error {
  color: #b91c1c;
  background: #fef2f2;
}

.leave-page__message--success {
  color: #166534;
  background: #f0fdf4;
}

.leave-impact__item,
.leave-preview__assignment {
  display: block;
}

.leave-button {
  margin: 0;
  color: #ffffff;
  background: #1f5aa6;
  font-size: 28rpx;
}

.leave-button--secondary {
  color: #1f5aa6;
  background: #eff6ff;
}

.leave-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.leave-acknowledgement {
  display: flex;
  align-items: center;
  color: #92400e;
  font-size: 26rpx;
}
