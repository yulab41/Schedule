.manual-editor {
  display: flex;
  flex-direction: column;
  gap: var(--v3-space-md);
}

.manual-editor__config,
.manual-editor__members,
.manual-editor__palette,
.manual-editor__preview,
.manual-editor__publish,
.manual-editor__history {
  display: flex;
  padding: var(--v3-space-md);
  background: var(--v3-color-surface);
  border: 1rpx solid var(--v3-color-border);
  border-radius: var(--v3-radius-md);
  flex-direction: column;
  gap: var(--v3-space-sm);
}

.manual-editor__field {
  display: flex;
  min-height: var(--v3-touch-min);
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--v3-color-border);
  gap: var(--v3-space-sm);
}

.manual-editor__config picker:last-child .manual-editor__field {
  border-bottom: 0;
}

.manual-editor__label {
  color: var(--v3-color-text-muted);
  font-size: var(--v3-font-size-sm);
}

.manual-editor__value {
  overflow: hidden;
  font-weight: 600;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manual-editor__section-title {
  font-weight: 700;
}

.manual-editor__member-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--v3-space-sm);
}

.manual-editor__member {
  display: flex;
  min-height: var(--v3-touch-min);
  padding: 0 var(--v3-space-sm);
  align-items: center;
  background: var(--v3-color-background);
  border-radius: var(--v3-radius-md);
  gap: var(--v3-space-xs);
}

.manual-editor__member--stale {
  background: var(--v3-color-warning-light);
}

.manual-editor__stale,
.manual-editor__hint {
  color: var(--v3-color-text-muted);
  font-size: var(--v3-font-size-sm);
}

.manual-editor__lock {
  display: flex;
  padding: var(--v3-space-sm) var(--v3-space-md);
  align-items: center;
  justify-content: space-between;
  background: var(--v3-color-primary-light);
  border-radius: var(--v3-radius-md);
  gap: var(--v3-space-sm);
}

.manual-editor__lock button {
  min-height: var(--v3-touch-min);
  margin: 0;
}

.manual-editor__actions {
  display: flex;
  flex-direction: column;
  gap: var(--v3-space-sm);
}

.manual-editor__actions button {
  width: 100%;
}

.manual-editor__feedback {
  display: flex;
  padding: var(--v3-space-sm);
  background: var(--v3-color-warning-light);
  border-radius: var(--v3-radius-md);
  flex-direction: column;
  gap: var(--v3-space-xs);
}
