@import '../../../styles/calendar-date-marker.wxss';

.calendar-cell {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 53px;
  padding: 4px 3px;
  overflow: hidden;
  box-sizing: border-box;
  flex-direction: column;
  align-items: flex-start;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-surface);
  font-variant-numeric: tabular-nums;
}

.calendar-cell.is-pressed {
  background: var(--ui-color-primary-light);
}

.calendar-cell.is-outside {
  color: #a7b0bb;
  background: #fafbfd;
}

.calendar-cell.is-holiday {
  background: #fff0f1;
}

.calendar-cell.is-bottom-left {
  border-bottom-left-radius: 17px;
}

.calendar-cell.is-bottom-right {
  border-bottom-right-radius: 17px;
}

.date-number {
  font-size: 10px;
  font-weight: var(--ui-font-weight-strong);
  line-height: 18px;
}

.calendar-cell.is-weekend .date-number {
  color: var(--ui-color-weekend);
}

.calendar-cell.is-today .date-number {
  color: var(--ui-color-near-black);
}

.holiday-chip {
  position: absolute;
  top: 4px;
  right: 3px;
  display: flex;
  max-width: 28px;
  min-height: 16px;
  padding: 0 5px;
  overflow: hidden;
  box-sizing: border-box;
  align-items: center;
  color: #ad2d36;
  background: #fee1e4;
  border-radius: 5px;
  font-size: 9px;
  font-weight: var(--ui-font-weight-strong);
  line-height: 16px;
  white-space: nowrap;
}

.month-duty-line {
  display: flex;
  width: 100%;
  margin-top: 2px;
  align-items: center;
  gap: 2px;
}

.holiday-chip.is-workday {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
}

.month-shift-line {
  display: flex;
  height: 14px;
  margin-top: 1px;
}
.month-shift-badge {
  padding: 0 3px;
  border-radius: 3px;
  font-size: 8px;
  line-height: 14px;
}
.month-person-count {
  flex: none;
  font-size: 9px;
  line-height: 14px;
}

.month-person {
  display: block;
  min-width: 0;
  overflow: hidden;
  flex: 0 1 auto;
  font-size: 11px;
  font-weight: var(--ui-font-weight-semibold);
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.change-mark {
  display: flex;
  width: 13px;
  height: 13px;
  flex: none;
  align-items: center;
  justify-content: center;
  color: #a66700;
  background: var(--ui-color-warning-light);
  border-radius: 4px;
  font-size: 8px;
  font-weight: var(--ui-font-weight-strong);
  line-height: 13px;
}

.month-duty-lines {
  width: 100%;
}
.month-duty-line.is-removed .month-person {
  color: var(--ui-color-text-primary);
  text-decoration: line-through;
}
.month-duty-line.is-added .month-person {
  color: #a42620;
}
.duty-abbreviation {
  display: flex;
  width: 13px;
  height: 13px;
  box-sizing: border-box;
  flex: 0 0 13px;
  align-items: center;
  justify-content: center;
  border: 1px solid;
  border-radius: 3px;
  font-size: 8px;
  line-height: 11px;
}
.calendar-cell.has-duties {
  padding-right: 1px;
  padding-left: 1px;
}
.calendar-cell.has-duties .month-duty-line {
  gap: 1px;
}
.calendar-cell.is-compact .month-person {
  font-size: 9px;
  line-height: 14px;
}
@media (max-width: 360px) {
  .duty-abbreviation {
    width: 11px;
    height: 11px;
    flex-basis: 11px;
    line-height: 9px;
  }
  .calendar-cell.is-compact.has-duties {
    padding-right: 0;
    padding-left: 0;
  }
  .holiday-chip {
    right: 1px;
    max-width: 22px;
    padding: 0 2px;
    font-size: 8px;
  }
  .calendar-cell.has-duties .month-person {
    font-size: 9px;
  }
  .calendar-cell.is-compact .month-person {
    font-size: 8px;
  }
}
.calendar-cell.is-disabled {
  color: #a7b0bb;
  background: #fafbfd;
}
