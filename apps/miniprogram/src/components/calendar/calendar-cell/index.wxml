<view
  class="calendar-cell {{disabled ? 'is-disabled' : ''}} {{isCurrentMonth ? '' : 'is-outside'}} {{isWeekend ? 'is-weekend' : ''}} {{isHoliday ? 'is-holiday' : ''}} {{isSelected ? 'is-selected' : ''}} {{isToday ? 'is-today' : ''}} {{isBottomLeft ? 'is-bottom-left' : ''}} {{isBottomRight ? 'is-bottom-right' : ''}}"
  hover-class="{{isCurrentMonth && !disabled ? 'is-pressed' : 'none'}}"
  hover-start-time="0"
  hover-stay-time="70"
  aria-role="button"
  aria-label="{{ariaLabel}}"
  aria-pressed="{{isSelected}}"
  aria-disabled="{{!isCurrentMonth || disabled}}"
  bindtap="handleSelect"
>
  <view class="calendar-date-marker {{isToday ? 'is-today' : ''}}">
    <text class="date-number calendar-date-text">{{day}}</text>
  </view>
  <text wx:if="{{holiday}}" class="holiday-chip">{{holiday}}</text>
  <view wx:if="{{duties.length > 0}}" class="month-duty-lines">
    <view wx:for="{{duties}}" wx:key="key" class="month-duty-line is-{{item.state}}">
      <text class="month-person">{{item.name}}</text>
      <text wx:if="{{item.abbreviation}}" class="duty-abbreviation">{{item.abbreviation}}</text>
    </view>
  </view>
  <view wx:elif="{{person || marker}}" class="month-duty-line">
    <text wx:if="{{person}}" class="month-person">{{person}}</text>
    <text wx:if="{{marker}}" class="change-mark">{{marker}}</text>
  </view>
</view>
