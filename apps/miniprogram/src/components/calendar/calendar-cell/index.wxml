<view
  class="calendar-cell {{duties.length ? 'has-duties' : ''}} {{compact ? 'is-compact' : ''}} {{disabled ? 'is-disabled' : ''}} {{isCurrentMonth ? '' : 'is-outside'}} {{weekend ? 'is-weekend' : ''}} {{isHoliday ? 'is-holiday' : ''}} {{isPast ? 'is-past' : ''}} {{isSelected ? 'is-selected' : ''}} {{isToday ? 'is-today' : ''}} {{isBottomLeft ? 'is-bottom-left' : ''}} {{isBottomRight ? 'is-bottom-right' : ''}}"
  hover-class="{{isCurrentMonth && !disabled ? 'is-pressed' : 'none'}}"
  hover-start-time="0"
  hover-stay-time="70"
  aria-role="button"
  aria-label="{{ariaLabel}}"
  aria-pressed="{{isSelected}}"
  aria-disabled="{{!isCurrentMonth || disabled}}"
  bindtap="handleSelect"
>
  <view class="calendar-date-marker {{isToday ? 'is-today' : ''}}">
    <text class="date-number calendar-date-text">{{dayText}}</text>
  </view>
  <text wx:if="{{holiday}}" class="holiday-chip">{{holiday}}</text>
  <text wx:elif="{{isWorkday}}" class="holiday-chip is-workday" aria-label="法定补班日">班</text>
  <view wx:if="{{shiftAbbreviation}}" class="month-shift-line"
    ><text class="month-shift-badge" style="{{shiftBadgeStyle}}">{{shiftAbbreviation}}</text></view
  >
  <view wx:if="{{duties.length > 0}}" class="month-duty-lines">
    <view
      wx:for="{{duties}}"
      wx:key="key"
      class="month-duty-line is-{{item.state}} {{item.comparisonClass}}"
    >
      <calendar-fit-line
        layout="{{compact ? 'month-duties-compact' : 'month-duties'}}"
        reference-name="{{item.abbreviation.length > 1 ? '' : item.name}}"
        max-scale="{{1.18}}" centered="{{true}}"
        active="{{active}}"
        content-key="{{item.name + '|' + item.abbreviation + '|' + compact}}"
      >
        <text class="month-person">{{item.name}}</text>
        <text wx:if="{{item.abbreviation}}" class="duty-abbreviation" style="{{item.badgeStyle}}"
          >{{item.abbreviation}}</text
        >
      </calendar-fit-line>
    </view>
  </view>
  <view wx:elif="{{person || marker}}" class="month-duty-line">
    <calendar-fit-line
      layout="{{compact ? 'month-compact' : 'month'}}"
      reference-name="{{extraPersonCount > 0 ? '' : person}}"
      max-scale="{{1.18}}" centered="{{true}}"
      active="{{active}}"
      content-key="{{person + '|' + marker + '|' + extraPersonCount + '|' + compact}}"
    >
      <text wx:if="{{person}}" class="month-person">{{person}}</text>
      <text wx:if="{{extraPersonCount > 0}}" class="month-person-count">+{{extraPersonCount}}</text>
      <text wx:if="{{marker}}" class="change-mark">{{marker}}</text>
    </calendar-fit-line>
  </view>
</view>
