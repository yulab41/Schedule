<view
  class="calendar-cell {{isCurrentMonth ? '' : 'is-outside'}} {{isWeekend ? 'is-weekend' : ''}} {{isHoliday ? 'is-holiday' : ''}} {{isSelected ? 'is-selected' : ''}} {{isToday ? 'is-today' : ''}} {{isBottomLeft ? 'is-bottom-left' : ''}} {{isBottomRight ? 'is-bottom-right' : ''}}"
  hover-class="{{isCurrentMonth ? 'is-pressed' : 'none'}}"
  hover-start-time="0"
  hover-stay-time="70"
  aria-role="button"
  aria-label="{{ariaLabel}}"
  aria-pressed="{{isSelected}}"
  aria-disabled="{{!isCurrentMonth}}"
  bindtap="handleSelect"
>
  <text class="date-number">{{day}}</text>
  <text wx:if="{{holiday}}" class="holiday-chip">{{holiday}}</text>
  <view wx:if="{{person || marker}}" class="month-duty-line">
    <text wx:if="{{person}}" class="month-person">{{person}}</text>
    <text wx:if="{{marker}}" class="change-mark">{{marker}}</text>
  </view>
</view>
