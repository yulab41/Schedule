<view class="month-card">
  <view class="month-toolbar">
    <view
      class="month-step"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="60"
      aria-role="button"
      aria-label="上一月"
      bindtap="handlePrevious"
    >
      <view
        class="chevron is-left {{stepMotion === 'previous' ? 'is-animating' : ''}}"
        aria-hidden="true"
      >
        <image class="chevron-image" src="/assets/icons/web-chevron-left.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="month-heading">
      <text class="month-label">{{monthLabel}}</text>
      <text class="month-hint">左右滑动切换月份</text>
    </view>
    <view
      class="locate-button"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="60"
      aria-role="button"
      aria-label="定位到今天"
      bindtap="handleLocateToday"
    >
      <view class="locate-crosshair {{locateAnimating ? 'is-animating' : ''}}" aria-hidden="true">
        <image class="locate-image" src="/assets/icons/web-locate.svg" mode="aspectFit" />
      </view>
    </view>
    <view
      class="month-step"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="60"
      aria-role="button"
      aria-label="下一月"
      bindtap="handleNext"
    >
      <view
        class="chevron is-right {{stepMotion === 'next' ? 'is-animating' : ''}}"
        aria-hidden="true"
      >
        <image class="chevron-image" src="/assets/icons/web-chevron-right.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="weekday-row" aria-hidden="true">
    <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text>
    <text class="is-weekend">六</text><text class="is-weekend">日</text>
  </view>

  <swiper
    class="calendar-motion-viewport"
    style="height:{{viewportHeight}}px"
    current="{{swiperCurrent}}"
    duration="{{swiperDuration}}"
    easing-function="easeOutCubic"
    circular="{{true}}"
    skip-hidden-item-layout="{{false}}"
    bindchange="handleMonthChangeStart"
    bindanimationfinish="handleMonthSwipe"
    aria-label="月历，可左右滑动切换月份"
  >
    <swiper-item
      wx:for="{{panels}}"
      wx:key="slot"
      class="calendar-slide-panel"
      aria-hidden="{{item.relative !== 0}}"
    >
      <view class="month-grid">
        <view
          wx:for="{{item.cells}}"
          wx:key="businessDate"
          class="calendar-cell-slot {{item.isSelected ? 'is-selected' : ''}} {{item.isBottomRow ? 'is-bottom-row' : ''}} {{item.isBottomLeft ? 'is-bottom-left' : ''}} {{item.isBottomRight ? 'is-bottom-right' : ''}}"
        >
          <calendar-cell
            aria-label="{{item.ariaLabel}}"
            business-date="{{item.businessDate}}"
            day="{{item.day}}"
            holiday="{{item.holiday}}"
            is-bottom-left="{{item.isBottomLeft}}"
            is-bottom-right="{{item.isBottomRight}}"
            is-current-month="{{item.isCurrentMonth}}"
            is-holiday="{{item.isHoliday}}"
            is-selected="{{item.isSelected}}"
            is-today="{{item.isToday}}"
            is-weekend="{{item.isWeekend}}"
            marker="{{item.marker}}"
            person="{{item.person}}"
            bind:select="handleCellSelect"
          ></calendar-cell>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>
