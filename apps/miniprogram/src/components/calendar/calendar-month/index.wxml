<template name="calendar-month-grid">
  <view class="month-grid">
    <view
      wx:for="{{panel.cells}}"
      wx:for-item="cell"
      wx:key="businessDate"
      style="height:{{panel.rowHeight || 54}}px"
      class="calendar-cell-slot {{cell.isSelected ? 'is-selected' : ''}} {{cell.isBottomRow ? 'is-bottom-row' : ''}} {{cell.isBottomLeft ? 'is-bottom-left' : ''}} {{cell.isBottomRight ? 'is-bottom-right' : ''}}"
    >
      <calendar-cell
        compact="{{compact}}"
        runtime-pressed-feedback-compatibility="{{runtimePressedFeedbackCompatibility}}"
        duties="{{cell.duties}}"
        disabled="{{cell.disabled}}"
        aria-label="{{cell.ariaLabel}}"
        business-date="{{cell.businessDate}}"
        day="{{cell.day}}"
        holiday="{{cell.holiday}}"
        is-bottom-left="{{cell.isBottomLeft}}"
        is-bottom-right="{{cell.isBottomRight}}"
        is-current-month="{{cell.isCurrentMonth}}"
        is-holiday="{{cell.isHoliday}}"
        is-past="{{cell.isPast}}"
        is-workday="{{cell.isWorkday}}"
        is-selected="{{cell.isSelected}}"
        is-today="{{cell.isToday}}"
        is-weekend="{{cell.isWeekend}}"
        marker="{{cell.marker}}"
        shift-abbreviation="{{cell.shiftAbbreviation}}"
        shift-badge-style="{{cell.shiftBadgeStyle}}"
        person="{{cell.person}}"
        extra-person-count="{{cell.extraPersonCount}}"
        bind:select="handleCellSelect"
      ></calendar-cell>
    </view>
  </view>
</template>

<view class="month-card {{shadow ? '' : 'is-flat'}}">
  <view class="month-toolbar">
    <view
      class="month-step"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="60"
      aria-role="button"
      aria-label="上一月"
      bindtap="handlePrevious"
    >
      <view
        class="chevron is-left {{stepMotion === 'previous' ? 'is-animating' : ''}}"
        aria-hidden="true"
      >
        <image class="chevron-image" src="/assets/icons/ui-chevron-left.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="month-heading">
      <text class="month-label">{{monthLabel}}</text>
      <text class="month-hint">左右滑动切换月份</text>
    </view>
    <view
      class="locate-button"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="60"
      aria-role="button"
      aria-label="定位到今天"
      bindtap="handleLocateToday"
    >
      <view class="locate-crosshair {{locateAnimating ? 'is-animating' : ''}}" aria-hidden="true">
        <image class="locate-image" src="/assets/icons/ui-locate.svg" mode="aspectFit" />
      </view>
    </view>
    <view
      class="month-step"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="60"
      aria-role="button"
      aria-label="下一月"
      bindtap="handleNext"
    >
      <view
        class="chevron is-right {{stepMotion === 'next' ? 'is-animating' : ''}}"
        aria-hidden="true"
      >
        <image class="chevron-image" src="/assets/icons/ui-chevron-right.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="weekday-row" aria-hidden="true">
    <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text>
    <text class="is-weekend">六</text><text class="is-weekend">日</text>
  </view>

  <!-- The affected runtime cannot animate a programmatic swiper jump, so the
       same three-panel ring is paged by a native horizontal scroller there: the
       platform animates the month and the grid follows the finger itself. -->
  <!-- The platform defers a height transition on the node that is running a
       smooth scroll, so on the affected runtime the animated height lives on a
       wrapper and only the horizontal paging happens on the scroller itself. -->
  <view
    wx:if="{{skyline3172UiCompatibility}}"
    class="calendar-motion-frame"
    style="height:{{viewportHeight}}px"
  >
    <scroll-view
      class="calendar-motion-viewport is-compat"
      scroll-x
      enhanced
      bounces="{{false}}"
      show-scrollbar="{{false}}"
      scroll-with-animation="{{pagerAnimated}}"
      scroll-into-view="{{pagerTarget}}"
      bindtouchstart="handlePagerTouchStart"
      bindscroll="handlePagerScroll"
      bindtouchend="handlePagerTouchEnd"
      bindtouchcancel="handlePagerTouchEnd"
      aria-label="月历，可左右滑动切换月份"
    >
      <view class="calendar-pager-track" style="{{trackStyle}}">
        <view
          class="calendar-pager-pane"
          style="{{paneStyle}}"
          wx:for="{{compatPanes}}"
          wx:for-item="panel"
          wx:key="relative"
          id="month-pane-{{index}}"
          aria-hidden="{{panel.relative !== 0}}"
        >
          <template
            is="calendar-month-grid"
            data="{{panel: panel, compact: compact, runtimePressedFeedbackCompatibility: runtimePressedFeedbackCompatibility}}"
          />
        </view>
      </view>
    </scroll-view>
  </view>
  <swiper
    wx:else
    class="calendar-motion-viewport"
    style="height:{{viewportHeight}}px"
    current="{{swiperCurrent}}"
    duration="{{swiperDuration}}"
    easing-function="{{swiperEasingFunction}}"
    circular="{{true}}"
    skip-hidden-item-layout="{{false}}"
    bindchange="handleMonthChangeStart"
    bindanimationfinish="handleMonthSwipe"
    aria-label="月历，可左右滑动切换月份"
  >
    <swiper-item
      wx:for="{{panels}}"
      wx:for-item="panel"
      wx:key="slot"
      class="calendar-slide-panel"
      aria-hidden="{{panel.relative !== 0}}"
    >
      <template
        is="calendar-month-grid"
        data="{{panel: panel, compact: compact, runtimePressedFeedbackCompatibility: runtimePressedFeedbackCompatibility}}"
      />
    </swiper-item>
  </swiper>
</view>
