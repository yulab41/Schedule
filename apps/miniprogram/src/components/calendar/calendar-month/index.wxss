.month-card {
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: 18px;
  box-shadow: 0 5px 16px rgba(21, 43, 67, 0.07);
}

.month-toolbar {
  display: flex;
  min-height: 62px;
  padding: 4px 6px;
  box-sizing: border-box;
  align-items: center;
  border-bottom: 1px solid var(--ui-color-border);
}

.month-step {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  background: transparent;
  border-radius: 12px;
}

.month-step.is-pressed,
.locate-button.is-pressed {
  border-radius: 12px;
  transform: scale(0.9);
  background: var(--ui-color-primary-light);
}

.month-heading {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.month-label {
  color: var(--ui-color-text-primary);
  font-size: 15px;
  font-weight: var(--ui-font-weight-semibold);
  letter-spacing: -0.02em;
  line-height: 20px;
}

.month-hint {
  margin-top: 2px;
  color: var(--ui-color-text-muted);
  font-size: 10px;
  line-height: 14px;
}

.locate-button {
  display: flex;
  width: 40px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  border-radius: 12px;
}

.chevron {
  position: relative;
  width: 20px;
  height: 20px;
}

.chevron-image,
.locate-image {
  display: block;
  width: 100%;
  height: 100%;
}

.chevron-line {
  position: absolute;
  left: 2px;
  width: 10px;
  height: 2px;
  background: currentColor;
  border-radius: 1px;
}

.chevron-line.is-upper {
  top: 5px;
}

.chevron-line.is-lower {
  top: 11px;
}

.chevron.is-left .chevron-line.is-upper,
.chevron.is-right .chevron-line.is-lower {
  transform: rotate(-45deg);
}

.chevron.is-left .chevron-line.is-lower,
.chevron.is-right .chevron-line.is-upper {
  transform: rotate(45deg);
}

.locate-crosshair {
  position: relative;
  width: 20px;
  height: 20px;
}

.locate-crosshair.is-animating {
  animation: click-locate 520ms cubic-bezier(0.2, 0, 0, 1);
}

.locate-tick {
  position: absolute;
  background: currentColor;
}

.locate-tick.is-top,
.locate-tick.is-bottom {
  left: 5px;
  width: 2px;
  height: 4px;
}

.locate-tick.is-top {
  top: -4px;
}

.locate-tick.is-bottom {
  bottom: -4px;
}

.locate-tick.is-left,
.locate-tick.is-right {
  top: 5px;
  width: 4px;
  height: 2px;
}

.locate-tick.is-left {
  left: -4px;
}

.locate-tick.is-right {
  right: -4px;
}

.locate-crosshair-center {
  position: absolute;
  z-index: 1;
  top: 4px;
  left: 4px;
  width: 4px;
  height: 4px;
  background: currentColor;
  border: 1px solid var(--ui-color-surface);
  border-radius: 50%;
}

.weekday-row {
  display: flex;
  height: 28px;
  align-items: center;
  color: var(--ui-color-text-muted);
  background: var(--ui-color-surface-muted);
  font-size: 11px;
  font-weight: var(--ui-font-weight-semibold);
  text-align: center;
}

.weekday-row text {
  width: 14.285714%;
}

.weekday-row .is-weekend {
  color: var(--ui-color-weekend);
}

.calendar-motion-viewport {
  width: 100%;
  overflow: hidden;
  transition: height 240ms cubic-bezier(0.33, 1, 0.68, 1);
}

.calendar-slide-panel {
  width: 100%;
}

.month-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  overflow: hidden;
  background: var(--ui-color-surface);
  border-top: 1px solid var(--ui-color-border);
  border-bottom-right-radius: 17px;
  border-bottom-left-radius: 17px;
}

.calendar-cell-slot {
  width: 14.285714%;
  height: 54px;
  border-right: 1px solid var(--ui-color-border);
  border-bottom: 1px solid var(--ui-color-border);
  box-sizing: border-box;
}

.calendar-cell-slot.is-selected {
  position: relative;
  z-index: 2;
}

.calendar-cell-slot.is-selected::after {
  position: absolute;
  z-index: 3;
  top: 0;
  right: -1px;
  bottom: -1px;
  left: 0;
  box-sizing: border-box;
  border: 2px solid var(--ui-color-primary);
  border-radius: inherit;
  content: '';
  pointer-events: none;
}

.calendar-cell-slot.is-selected:nth-child(7n)::after {
  right: 0;
}

.calendar-cell-slot.is-selected.is-bottom-row::after {
  bottom: 0;
}

.calendar-cell-slot:nth-child(7n) {
  border-right: 0;
}

.calendar-cell-slot.is-bottom-row {
  border-bottom: 0;
}

.chevron.is-animating {
  animation: click-chevron 240ms cubic-bezier(0.2, 0, 0, 1);
}

@keyframes click-chevron {
  0%,
  100% {
    transform: translateX(0);
  }
  48% {
    transform: translateX(2px);
  }
}

.chevron.is-left.is-animating {
  animation-direction: reverse;
}

.calendar-cell-slot.is-bottom-left {
  overflow: hidden;
  border-bottom-left-radius: 17px;
}

.calendar-cell-slot.is-bottom-right {
  overflow: hidden;
  border-bottom-right-radius: 17px;
}

@keyframes click-locate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(90deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .locate-crosshair.is-animating {
    animation: none;
  }

  .chevron.is-animating {
    animation: none;
  }
}
