<view class="week-day-grid {{compact ? 'is-compact' : ''}}">
  <view
    wx:for="{{days}}"
    wx:for-item="day"
    wx:key="businessDate"
    class="week-day {{day.isSelected ? 'is-selected' : ''}} {{day.isToday ? 'is-today' : ''}} {{day.isWeekend ? 'is-weekend' : ''}} {{day.isPast ? 'is-past' : ''}} {{day.isFuture ? 'is-future' : ''}} {{day.disabled ? 'is-disabled' : ''}}"
    data-business-date="{{day.businessDate}}"
    hover-class="{{day.disabled ? 'none' : 'is-pressed'}}"
    aria-role="button"
    aria-label="{{day.ariaLabel}}"
    aria-disabled="{{day.disabled}}"
    bindtap="handleSelect"
  >
    <view class="week-day-content">
      <view class="week-date-line">
        <view class="calendar-date-marker {{day.isToday ? 'is-today' : ''}}">
          <text class="day-number calendar-date-text">{{day.day}}</text>
        </view>
        <text wx:if="{{day.holiday}}" class="week-holiday">{{day.holiday}}</text>
        <text wx:elif="{{day.isWorkday}}" class="week-holiday is-workday" aria-label="法定补班日"
          >班</text
        >
      </view>
      <view wx:if="{{day.duties.length === 0}}" class="week-duty-empty">—</view>
      <view
        wx:for="{{day.shiftGroups}}"
        wx:for-item="shiftGroup"
        wx:key="key"
        class="week-shift-group"
        style="background:{{shiftGroup.tint}}"
      >
        <view class="week-group-title">
          <text
            class="week-shift-badge"
            style="color:{{shiftGroup.textColor}};background:{{shiftGroup.color}}"
            >{{shiftGroup.abbreviation}}</text
          >
        </view>
        <view
          wx:for="{{shiftGroup.duties}}"
          wx:for-item="duty"
          wx:key="key"
          class="week-duty-item {{duty.comparisonClass}}"
        >
          <calendar-fit-line layout="{{compact ? 'week-name-compact' : 'week-name'}}" reference-name="{{duty.name}}" active="{{active}}" content-key="{{duty.name + '|' + compact}}">
            <text class="week-duty-name">{{duty.name}}</text>
          </calendar-fit-line>
          <view wx:if="{{duty.markers.length > 0}}" class="week-duty-badges">
            <calendar-fit-line
              layout="{{compact ? 'week-badges-compact' : 'week-badges'}}"
              active="{{active}}"
              content-key="{{'markers:' + duty.markers + '|' + compact}}"
            >
              <text
                wx:for="{{duty.markers}}"
                wx:for-item="marker"
                wx:key="*this"
                class="week-change-badge"
                >{{marker}}</text
              >
            </calendar-fit-line>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
