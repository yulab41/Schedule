<view
  class="ui-picker {{disabled ? 'is-disabled' : ''}}"
  hover-class="{{disabled ? 'none' : 'is-pressed'}}"
  aria-role="button"
  aria-label="{{label}}，{{value}}"
  aria-disabled="{{disabled}}"
  bindtap="handlePress"
>
  <text class="ui-picker__label">{{label}}</text>
  <view class="ui-picker__value-row">
    <text class="ui-picker__value">{{value}}</text>
    <image class="ui-picker__chevron" src="/assets/icons/ui-chevron-right-muted.svg" mode="aspectFit" aria-hidden="true" />
  </view>
</view>
