<wxs module="wheelGesture" src="./wheel-gesture.wxs"></wxs>

<view
  class="ui-wheel-column"
  aria-role="listbox"
  aria-label="{{ariaLabel}}"
  data-runtime-key="{{wheelConfig.runtimeKey}}"
  data-generation="{{wheelConfig.generation}}"
  data-item-count="{{wheelConfig.itemCount}}"
  data-base-index="{{wheelLayoutIndex}}"
  wheel-config="{{wheelConfig}}"
  change:wheel-config="{{wheelGesture.configure}}"
  catchtouchstart="{{wheelGesture.touchStart}}"
  catchtouchmove="{{wheelGesture.touchMove}}"
  bindtouchend="{{wheelGesture.touchEnd}}"
  bindtouchcancel="{{wheelGesture.touchCancel}}"
>
  <view id="ui-wheel-track" class="ui-wheel-track" style="{{wheelTrackStyle}}">
    <view class="ui-wheel-spacer"></view>
    <view
      wx:for="{{items}}"
      wx:key="label"
      id="ui-wheel-item-{{index}}"
      class="ui-wheel-item {{index === internalSelectedIndex ? 'is-selected' : ''}}"
      data-index="{{index}}"
      aria-role="option"
      aria-label="{{item.ariaLabel || item.label}}"
      aria-selected="{{index === internalSelectedIndex}}"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="60"
      bindtap="handleItemTap"
    >
      <text id="ui-wheel-number-{{index}}" class="ui-wheel-number">{{item.label}}</text>
      <text wx:if="{{item.unit}}" class="ui-wheel-unit">{{item.unit}}</text>
      <text wx:else class="ui-wheel-unit">{{unit}}</text>
    </view>
    <view class="ui-wheel-spacer"></view>
  </view>
</view>
