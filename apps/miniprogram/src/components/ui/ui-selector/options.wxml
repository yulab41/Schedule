<template name="selector-options">
  <view
    wx:if="{{open}}"
    class="workflow-picker-selector-backdrop"
    aria-role="button"
    aria-label="关闭选项"
    bindtap="handleClose"
  ></view>
  <scroll-view
    wx:if="{{open}}"
    class="workflow-picker-selector-popover {{popoverPlacement === 'up' ? 'is-up' : 'is-down'}} {{popoverPlacementReady ? 'is-ready' : 'is-measuring'}}"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{renderedOptions}}"
      wx:key="value"
      class="workflow-picker-option {{item.isWeekend ? 'is-weekend' : ''}} {{(multiple ? item.checked : index === selectedOptionIndex) ? 'is-selected' : ''}} {{item.disabled ? 'is-disabled' : ''}}"
      data-index="{{index}}"
      aria-role="option"
      aria-selected="{{multiple ? item.checked : index === selectedOptionIndex}}"
      aria-disabled="{{item.disabled}}"
      bindtap="handleOptionTap"
    >
      <text wx:if="{{multiple}}" class="workflow-picker-check">{{item.checked ? '✓' : '○'}}</text><text class="workflow-picker-option-label"
        ><text>{{item.leadingLabel}}</text
        ><text wx:if="{{item.weekendLabel}}" class="workflow-picker-option-weekend"
          >{{item.weekendLabel}}</text
        ><text>{{item.trailingLabel}}</text></text
      >
    </view>
    <view wx:if="{{options.length === 0}}" class="workflow-picker-empty">暂无可选项</view>
  </scroll-view>
</template>
