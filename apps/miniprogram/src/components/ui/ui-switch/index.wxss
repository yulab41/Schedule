.ui-switch__hit-area {
  display: flex;
  width: 60px;
  min-height: 44px;
  padding: 0 4px;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
}

.ui-switch__hit-area.is-inactive {
  opacity: 0.55;
}

.ui-switch__hit-area.is-pressed .ui-switch__track {
  opacity: 0.78;
}

.ui-switch__track {
  position: relative;
  width: 52px;
  height: 30px;
  background: #c8ced6;
  border-radius: var(--ui-radius-pill);
  transition: background 180ms ease;
}

.ui-switch__track.is-checked {
  background: var(--ui-color-primary);
}

.ui-switch__thumb {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 24px;
  height: 24px;
  background: var(--ui-color-white);
  border-radius: var(--ui-radius-pill);
  box-shadow: 0 2px 5px rgba(22, 32, 42, 0.24);
  transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.ui-switch__track.is-checked .ui-switch__thumb {
  transform: translateX(22px);
}
