<root-portal enable="{{true}}">
  <view
    class="ui-toast__layer {{isVisible ? 'is-visible' : ''}}"
    style="top:{{safeTopOffset}}px;"
    aria-hidden="{{!isVisible}}"
    aria-role="status"
    aria-label="{{displayTitle + ' ' + displayMessage}}"
  >
    <view
      class="ui-toast ui-toast--{{displayTone}} {{skyline3172UiCompatibility ? 'is-skyline-3172-ui' : ''}}"
    >
      <view
        wx:if="{{skyline3172UiCompatibility}}"
        class="ui-toast__accent"
        aria-hidden="true"
      ></view>
      <text wx:if="{{displayTitle}}" class="ui-toast__title">{{displayTitle}}</text>
      <text wx:if="{{displayMessage}}" class="ui-toast__message" max-lines="2"
        >{{displayMessage}}</text
      >
    </view>
  </view>
</root-portal>
