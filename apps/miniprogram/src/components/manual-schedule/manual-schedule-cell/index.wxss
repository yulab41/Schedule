.manual-schedule-cell {
  position: relative;
  display: flex;
  width: 72px;
  height: 44px;
  padding: 4px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 2px;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-surface);
  font-variant-numeric: tabular-nums;
}

.manual-schedule-cell.is-pressed {
  background: var(--ui-color-primary-border);
}

.manual-schedule-cell.is-selected {
  z-index: 1;
  background: var(--ui-color-primary-light);
  box-shadow: inset 0 0 0 2px var(--ui-color-primary);
}

.manual-schedule-cell.is-stale {
  background: var(--ui-color-warning-light);
}

.manual-schedule-cell.is-disabled {
  opacity: 0.45;
}

.cell-shift {
  display: flex;
  min-width: 28px;
  min-height: 24px;
  padding: 2px 6px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  font-size: 12px;
  font-weight: var(--ui-font-weight-semibold);
  line-height: 20px;
}

.cell-empty {
  color: var(--ui-color-border-strong);
  font-size: 12px;
}

.stale-badge {
  padding: 1px 3px;
  color: var(--ui-color-warning);
  background: var(--ui-color-warning-light);
  border-radius: 4px;
  font-size: 9px;
  font-weight: var(--ui-font-weight-semibold);
  line-height: 15px;
}
