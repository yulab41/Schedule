<scroll-view class="profile-scroll" type="list" scroll-y show-scrollbar="{{false}}">
  <view class="profile-page {{embedded ? 'is-embedded' : ''}} {{largeText ? 'is-large-text' : ''}}">
    <view class="profile-heading">
      <view class="profile-heading-main">
        <view
          wx:if="{{!embedded}}"
          class="profile-back"
          hover-class="is-pressed"
          aria-role="button"
          aria-label="返回排班台"
          bindtap="handleBack"
        >
          <image src="/assets/icons/ui-chevron-left.svg" mode="aspectFit" />
        </view>
        <view class="profile-heading-copy">
          <text class="profile-eyebrow">个人中心</text>
          <text class="profile-title">我的</text>
          <text class="profile-subtitle">账户、值班与安全设置</text>
        </view>
      </view>
      <view class="profile-heading-avatar" aria-hidden="true">
        <image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" />
        <text wx:else>{{initial}}</text>
      </view>
    </view>

    <view wx:if="{{mode === 'missing'}}" class="profile-state">
      <view class="state-mark" aria-hidden="true">—</view>
      <text class="state-title">尚未登录</text>
      <text class="state-copy">登录后才能查看个人资料、值班概览和账号安全设置。</text>
      <navigator class="primary-action" url="/pages/identity/index" aria-role="button">
        进入登录
      </navigator>
    </view>

    <block wx:else>
      <view class="profile-identity-card">
        <view class="profile-avatar" aria-hidden="true">
          <image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" />
          <text wx:else>{{initial}}</text>
        </view>
        <view class="profile-identity-copy">
          <view class="profile-name-row">
            <text class="profile-name">{{realName}}</text>
            <text class="profile-verified">✓ 已验证</text>
          </view>
          <text class="profile-role">{{roleLabel}} · {{groupName}}</text>
          <text class="profile-login-state">当前登录状态正常</text>
        </view>
        <view class="profile-status"><view aria-hidden="true"></view><text>正常</text></view>
      </view>

      <block wx:if="{{showDutyOverview}}">
        <view class="profile-stats-card">
          <view class="profile-card-heading">
            <view>
              <text class="profile-eyebrow">个人数据</text>
              <text class="profile-section-title">值班概览</text>
            </view>
            <button class="profile-inline-action" bindtap="handleOpenStatistics">
              查看完整统计 <image class="profile-inline-chevron" src="/assets/icons/ui-chevron-right.svg" mode="aspectFit" aria-hidden="true" />
            </button>
          </view>

          <view wx:if="{{overviewState === 'loading'}}" class="profile-overview-state">
            正在汇总个人值班数据…
          </view>
          <view wx:elif="{{overviewState === 'error'}}" class="profile-overview-state is-error">
            <text>{{overviewError}}</text>
            <button bindtap="handleOverviewRetry">重新加载</button>
          </view>
          <view wx:else class="profile-stat-list">
            <view class="profile-stat is-primary">
              <text>本月值班</text>
              <view class="profile-stat-number"
                ><text>{{monthCountLabel}}</text><text class="profile-stat-unit">次</text></view
              >
              <text class="profile-stat-note">{{monthDeltaLabel}}</text>
            </view>
            <view class="profile-stat">
              <text>年度累计</text>
              <view class="profile-stat-number"
                ><text>{{yearCountLabel}}</text><text class="profile-stat-unit">次</text></view
              >
              <text class="profile-stat-note">{{overviewYearLabel}}</text>
            </view>
            <view class="profile-stat">
              <text>特殊日期</text>
              <view class="profile-stat-number"
                ><text>{{specialDateCountLabel}}</text
                ><text class="profile-stat-unit">次</text></view
              >
              <text class="profile-stat-note">本月周末与节假日班次</text>
            </view>
          </view>
        </view>

        <view class="profile-pulse-card">
          <view class="profile-card-heading">
            <view>
              <text class="profile-eyebrow">DUTY PULSE</text>
              <text class="profile-section-title">值班节奏</text>
            </view>
            <text class="profile-period-label">近四月</text>
          </view>
          <view wx:if="{{trend.length}}" class="profile-pulse-chart">
            <view wx:for="{{trend}}" wx:key="label" class="profile-pulse-column">
              <text>{{item.count}}</text>
              <view class="profile-pulse-track" aria-hidden="true">
                <view
                  class="profile-pulse-bar {{item.current ? 'is-current' : ''}}"
                  style="{{item.heightStyle}}"
                ></view>
              </view>
              <text>{{item.label}}</text>
            </view>
          </view>
          <view wx:else class="profile-empty-insight">还没有可展示的个人统计趋势</view>
        </view>

        <view class="profile-next-duty">
          <view class="profile-next-duty-heading">
            <view>
              <text class="profile-eyebrow">下一班</text>
              <text class="profile-next-title">{{nextDutyDateLabel}}</text>
            </view>
            <text wx:if="{{!nextDutyEmpty}}" class="profile-shift-badge">
              {{nextDutyShiftLabel}}
            </text>
          </view>
          <block wx:if="{{!nextDutyEmpty}}">
            <text class="profile-duty-time">{{nextDutyTimeLabel}}</text>
            <text class="profile-duty-role">{{nextDutyRoleLabel}}</text>
            <button class="profile-duty-link" bindtap="handleOpenCalendar">
              打开排班日历 <image class="profile-inline-chevron" src="/assets/icons/ui-chevron-right.svg" mode="aspectFit" aria-hidden="true" />
            </button>
          </block>
          <text wx:else class="profile-duty-empty"> 当前月份与下个月没有查询到你的待值班次。 </text>
        </view>
      </block>

      <view class="profile-account-card">
        <view class="profile-card-heading">
          <view>
            <text class="profile-eyebrow">账号与安全</text>
            <text class="profile-section-title">账户设置</text>
          </view>
          <text class="profile-private-note">仅自己可见</text>
        </view>
        <view class="profile-details">
          <view class="profile-detail-row"><text>姓名</text><text>{{realName}}</text></view>
          <view class="profile-detail-row"><text>当前群组</text><text>{{groupName}}</text></view>
          <view class="profile-detail-row"><text>群组身份</text><text>{{roleLabel}}</text></view>
          <view wx:if="{{mobilePhone}}" class="profile-detail-row"
            ><text>手机号</text><text>{{mobilePhone}}</text></view
          >
          <view wx:if="{{shortPhone}}" class="profile-detail-row"
            ><text>短号</text><text>{{shortPhone}}</text></view
          >
          <view class="profile-detail-row">
            <text>登录状态</text>
            <view class="profile-detail-status"
              ><view aria-hidden="true"></view><text>已验证 · {{authMethodLabel}}</text></view
            >
          </view>
          <view class="profile-detail-row">
            <view>
              <text>微信小程序身份</text>
              <text wx:if="{{bindingState === 'error'}}" class="profile-detail-hint">
                稍后可重新进入刷新
              </text>
            </view>
            <view class="profile-detail-action">
              <text>{{bindingLabel}}</text>
              <button wx:if="{{canUnbindWechat}}" bindtap="handleUnbind">解除绑定</button>
            </view>
          </view>
          <view class="profile-detail-row">
            <text>微信头像</text>
            <view class="profile-detail-action">
              <text>{{avatarSyncLabel}}</text>
              <button
                wx:if="{{avatarPath}}"
                disabled="{{avatarBusy}}"
                bindtap="handleAvatarRestore"
              >
                恢复姓名首字
              </button>
            </view>
          </view>
          <view class="profile-detail-row is-last">
            <text>登录密码</text>
            <button class="profile-password-action" bindtap="handlePasswordOpen">
              修改登录密码
            </button>
          </view>
        </view>
      </view>

      <view class="profile-actions">
        <button class="profile-sign-out" bindtap="handleSignOut">退出登录</button>
        <text>登录状态只保存在当前设备，退出后需要重新验证。</text>
      </view>
    </block>

    <text wx:if="{{!embedded}}" class="profile-build-label">{{buildLabel}}</text>
  </view>
</scroll-view>

<ui-sheet
  wx:if="{{passwordSheetOpen}}"
  visible="{{passwordSheetOpen}}"
  title="修改登录密码"
  close-label="取消"
  bind:close="handlePasswordClose"
>
  <view class="profile-password-form">
    <text wx:if="{{authMethod === 'wechat'}}" class="profile-password-proof-note">
      提交时将使用新的微信登录凭证验证身份。
    </text>
    <view wx:if="{{authMethod === 'password'}}" class="profile-password-field">
      <text>当前密码</text>
      <input
        password
        value="{{currentPassword}}"
        placeholder="请输入当前密码"
        bindinput="handleCurrentPasswordInput"
      />
    </view>
    <view class="profile-password-field">
      <text>新密码</text>
      <input
        password
        value="{{newPassword}}"
        placeholder="请输入新密码"
        bindinput="handleNewPasswordInput"
      />
    </view>
    <view class="profile-password-field">
      <text>确认新密码</text>
      <input
        password
        value="{{passwordConfirm}}"
        placeholder="请再次输入新密码"
        bindinput="handlePasswordConfirmInput"
        bindconfirm="handlePasswordSubmit"
      />
    </view>
    <text wx:if="{{passwordError}}" class="profile-password-error">{{passwordError}}</text>
    <button
      class="profile-password-submit"
      disabled="{{passwordSaving}}"
      bindtap="handlePasswordSubmit"
    >
      {{passwordSaving ? '正在修改…' : '确认修改'}}
    </button>
  </view>
</ui-sheet>
