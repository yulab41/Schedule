@import '../account-security/index.wxss';
.profile-scroll {
  width: 100%;
  height: 100%;
  background: var(--ui-color-background);
}

.profile-page {
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  padding: 12px 12px calc(96px + env(safe-area-inset-bottom));
  flex-direction: column;
  gap: var(--ui-spacing-md);
  color: var(--ui-color-text-primary);
}

.profile-page.is-embedded {
  padding-top: 14px;
}

.profile-identity-card,
.profile-name-row,
.profile-status,
.profile-card-heading,
.profile-next-duty-heading,
.profile-detail-row,
.profile-detail-status,
.profile-detail-action,
.profile-actions {
  display: flex;
  align-items: center;
}

.profile-back {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  margin-right: 4px;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
}

.profile-back.is-pressed {
  background: var(--ui-color-surface-muted);
}

.profile-back image {
  width: 20px;
  height: 20px;
}

.profile-eyebrow {
  display: block;
  margin-bottom: 4px;
  color: var(--ui-color-primary);
  font-size: 13px;
  font-weight: var(--ui-font-weight-semibold);
  letter-spacing: 0;
  line-height: 1.2;
}

.profile-avatar {
  display: flex;
  overflow: hidden;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-white);
  background: linear-gradient(145deg, #2d88e4, #0a66d5);
  font-weight: var(--ui-font-weight-bold);
}

.profile-identity-card,
.profile-stats-card,
.profile-pulse-card,
.profile-next-duty,
.profile-account-card,
.profile-state {
  min-width: 0;
  box-sizing: border-box;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-card);
}

.profile-identity-card {
  padding: 18px;
  align-items: center;
  gap: 12px;
}

.profile-avatar {
  width: 58px;
  height: 58px;
  border-radius: 18px;
  font-size: 24px;
}

.profile-identity-copy {
  min-width: 0;
  flex: 1;
}

.profile-name-row {
  flex-wrap: wrap;
  gap: 7px;
}

.profile-name {
  overflow: hidden;
  max-width: 100%;
  font-size: 20px;
  font-weight: var(--ui-font-weight-semibold);
  letter-spacing: -0.4px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-verified {
  padding: 4px 8px;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  border-radius: var(--ui-radius-pill);
  font-size: 10px;
  font-weight: var(--ui-font-weight-semibold);
}

.profile-role,
.profile-login-state {
  display: block;
  margin-top: 5px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  line-height: 1.35;
}

.profile-login-state {
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.profile-status {
  align-self: flex-start;
  gap: 5px;
  color: #19724a;
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
}

.profile-status > view,
.profile-detail-status > view {
  width: 7px;
  height: 7px;
  flex: none;
  background: #19724a;
  border-radius: 50%;
}

.profile-stats-card,
.profile-pulse-card,
.profile-next-duty,
.profile-account-card {
  padding: 16px;
}

.profile-stats-card,
.profile-next-duty {
  overflow: hidden;
  background:
    radial-gradient(circle at 88% -30%, rgba(10, 102, 213, 0.11), transparent 230px),
    var(--ui-color-surface);
}

.profile-card-heading,
.profile-next-duty-heading {
  justify-content: space-between;
  gap: 10px;
}

.profile-section-title,
.profile-next-title {
  display: block;
  font-size: 22px;
  font-weight: var(--ui-font-weight-semibold);
  letter-spacing: -0.3px;
}

.profile-inline-action,
.profile-duty-link,
.profile-overview-state button {
  min-height: 44px;
  box-sizing: border-box;
  padding: 0;
  color: var(--ui-color-primary);
  background: transparent;
  border: 0;
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 1.3;
}

.profile-inline-action::after,
.profile-duty-link::after,
.profile-overview-state button::after,
.profile-detail-action button::after,
.profile-password-action::after,
.profile-sign-out::after,
.profile-password-submit::after {
  border: 0;
}

.profile-inline-action text,
.profile-duty-link text {
  margin-left: 4px;
  font-size: 18px;
  font-weight: var(--ui-font-weight-regular);
}

.profile-inline-chevron {
  width: 18px;
  height: 18px;
  margin-left: 4px;
  vertical-align: middle;
}

.profile-overview-state {
  min-height: 116px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-sm);
  text-align: center;
}

.profile-overview-state.is-error {
  flex-direction: column;
  gap: 4px;
  color: var(--ui-color-danger);
}

.profile-stat-list {
  display: flex;
  gap: 7px;
}

.profile-stat {
  min-width: 0;
  min-height: 96px;
  box-sizing: border-box;
  display: flex;
  flex: 1;
  padding: 10px 9px;
  flex-direction: column;
  justify-content: space-between;
  background: #f5f8fb;
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
}

.profile-stat.is-primary {
  color: var(--ui-color-white);
  background: linear-gradient(145deg, #0c6dd7, #0753aa);
  border-color: transparent;
  box-shadow: 0 12px 26px rgba(10, 102, 213, 0.2);
}

.profile-stat > text:first-child {
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: 12px;
  font-weight: var(--ui-font-weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-stat.is-primary > text:first-child,
.profile-stat.is-primary .profile-stat-note {
  color: rgba(255, 255, 255, 0.76);
}

.profile-stat-number {
  display: flex;
  align-items: baseline;
}

.profile-stat-number > text:first-child {
  font-size: 28px;
  font-weight: var(--ui-font-weight-bold);
  letter-spacing: -1px;
  line-height: 1;
}

.profile-stat-unit {
  margin-left: 3px;
  font-size: 10px;
  font-weight: var(--ui-font-weight-semibold);
}

.profile-stat-note {
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: 11px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-period-label {
  padding: 4px 8px;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-background);
  border-radius: var(--ui-radius-pill);
  font-size: 10px;
  font-weight: var(--ui-font-weight-semibold);
}

.profile-pulse-chart {
  height: 154px;
  box-sizing: border-box;
  display: flex;
  padding: 12px 4px 0;
  align-items: stretch;
  gap: 12px;
  background:
    linear-gradient(var(--ui-color-border), var(--ui-color-border)) 0 35% / 100% 1px no-repeat,
    linear-gradient(var(--ui-color-border), var(--ui-color-border)) 0 70% / 100% 1px no-repeat;
}

.profile-pulse-column {
  height: 100%;
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.profile-pulse-column > text {
  color: var(--ui-color-text-muted);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}

.profile-pulse-track {
  min-height: 0;
  display: flex;
  width: 100%;
  flex: 1;
  align-items: flex-end;
  justify-content: center;
}

.profile-pulse-bar {
  width: 70%;
  max-width: 30px;
  max-height: 100%;
  align-self: end;
  background: #c9d6e4;
  border-radius: 8px 8px 4px 4px;
}

.profile-pulse-bar.is-current {
  background: linear-gradient(180deg, #2f8ce9, #0a66d5);
  box-shadow: 0 7px 14px rgba(10, 102, 213, 0.18);
}

.profile-empty-insight {
  min-height: 154px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-sm);
  text-align: center;
}

.profile-next-duty {
  min-height: 0;
  display: flex;
  overflow: hidden;
  flex-direction: column;
  color: var(--ui-color-text-primary);
}

.profile-next-duty .profile-eyebrow {
  color: var(--ui-color-primary);
}

.profile-next-title {
  color: var(--ui-color-text-primary);
  font-size: 22px;
}

.profile-shift-badge {
  padding: 5px 8px;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  border: 1px solid var(--ui-color-border);
  border-radius: 8px;
  font-size: 10px;
  font-weight: var(--ui-font-weight-semibold);
}

.profile-duty-time {
  margin-top: 16px;
  color: var(--ui-color-text-primary);
  font-size: 25px;
  font-weight: var(--ui-font-weight-bold);
  font-variant-numeric: tabular-nums;
  letter-spacing: -1px;
}

.profile-duty-role,
.profile-duty-empty {
  margin-top: 12px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  line-height: 1.6;
}

.profile-duty-link {
  margin-top: auto;
  align-self: flex-start;
  color: var(--ui-color-primary);
}

.profile-duty-empty {
  margin: auto 0;
  text-align: center;
}

.profile-account-card .profile-card-heading {
  margin-bottom: 12px;
}

.profile-private-note {
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.profile-details {
  display: flex;
  flex-direction: column;
}

.profile-detail-row {
  min-width: 0;
  min-height: 50px;
  padding: 6px 0;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid var(--ui-color-border);
}

.profile-detail-row.is-last {
  border-bottom: 0;
}

.profile-detail-row > text:first-child,
.profile-detail-row > view:first-child > text:first-child {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
}

.profile-detail-label {
  min-width: 0;
  max-width: 50%;
  flex-shrink: 0;
  line-height: var(--ui-line-height-normal);
  text-align: left;
  word-break: normal;
}

.profile-detail-row > text:last-child {
  max-width: 62%;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
  text-align: right;
  word-break: break-all;
}

.profile-detail-status {
  max-width: 66%;
  justify-content: flex-end;
  gap: 6px;
  color: #19724a;
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
  text-align: right;
}

.profile-detail-action {
  min-width: 0;
  flex: 1;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.profile-detail-action > text {
  display: block;
  width: auto;
  min-width: 0;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-normal);
  text-align: right;
  word-break: normal;
  white-space: normal;
}

.profile-detail-action button,
.profile-password-action {
  display: flex;
  width: auto;
  min-width: 0;
  max-width: 100%;
  min-height: 44px;
  margin: 0;
  box-sizing: border-box;
  padding: 8px 10px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  border: 0;
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 1.2;
  text-align: center;
  word-break: normal;
}

.profile-password-action {
  margin-left: auto;
  flex-shrink: 0;
}

.profile-detail-action button {
  max-width: 126px;
}

.profile-detail-hint {
  display: block;
  max-width: 120px;
  margin-top: 3px;
  color: var(--ui-color-text-muted);
  font-size: 10px;
}

.profile-actions {
  flex-direction: column;
  gap: 8px;
}

.profile-sign-out {
  display: flex;
  width: 184px;
  min-width: 0;
  max-width: 100%;
  min-height: 44px;
  margin: 0;
  box-sizing: border-box;
  padding: 8px 18px;
  align-self: center;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-danger);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-normal);
  text-align: center;
  word-break: normal;
}

.profile-actions > text {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  text-align: center;
}

.profile-state {
  min-height: 270px;
  display: flex;
  padding: 20px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  text-align: center;
}

.state-mark {
  display: flex;
  width: 46px;
  height: 46px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary-dark);
  background: var(--ui-color-primary-light);
  border-radius: 50%;
  font-size: 24px;
}

.state-title {
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-semibold);
}

.state-copy {
  max-width: 300px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  line-height: 1.55;
}

.primary-action {
  min-height: 44px;
  display: flex;
  width: 160px;
  margin-top: 6px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
  text-decoration: none;
}

.profile-build-label {
  color: var(--ui-color-text-muted);
  font-size: 10px;
  text-align: center;
}

.is-large-text .profile-name,
.is-large-text .profile-section-title,
.is-large-text .profile-next-title {
  overflow: visible;
  font-size: 22px;
  text-overflow: clip;
  white-space: normal;
}

.is-large-text .profile-identity-card {
  align-items: flex-start;
}

.is-large-text .profile-stat-list {
  flex-direction: column;
}

.is-large-text .profile-stat {
  width: 100%;
  flex: none;
  min-height: 118px;
  padding: 14px;
}

.is-large-text .profile-role,
.is-large-text .profile-login-state,
.is-large-text .profile-detail-row > text,
.is-large-text .profile-detail-row > view > text,
.is-large-text .profile-detail-status,
.is-large-text .profile-detail-action button,
.is-large-text .profile-password-action,
.is-large-text .profile-sign-out {
  font-size: 16px;
}

@media (max-width: 340px) {
  .profile-page {
    padding-right: 10px;
    padding-left: 10px;
    gap: 13px;
  }

  .profile-identity-card,
  .profile-stats-card,
  .profile-pulse-card,
  .profile-next-duty,
  .profile-account-card {
    padding: 14px;
  }

  .profile-identity-card {
    align-items: flex-start;
  }

  .profile-avatar {
    width: 52px;
    height: 52px;
  }

  .profile-status text {
    display: none;
  }

  .profile-stat {
    min-height: 104px;
    padding: 11px 7px;
  }

  .profile-stat-number > text:first-child {
    font-size: 25px;
  }

  .profile-pulse-chart {
    gap: 8px;
  }

  .profile-detail-row {
    gap: 8px;
  }

  .profile-detail-action {
    gap: 4px;
  }

  .profile-detail-action button {
    max-width: 108px;
    padding: 0 7px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .profile-back,
  .profile-pulse-bar {
    transition: none;
  }
}

.profile-inline-action {
  min-width: 0;
  margin-left: auto;
  margin-right: 0;
  flex-shrink: 1;
  text-align: right;
}

.profile-stats-card .profile-card-heading > view {
  flex-shrink: 0;
}

/* Explicit mini sizing avoids native default button width and keeps text at the edge. */
button.profile-inline-action,
button.profile-duty-link {
  display: flex;
  width: auto;
  min-width: 0;
  min-height: 44px;
  margin: 0 0 0 auto;
  padding: 0;
  flex: none;
  align-items: center;
  justify-content: flex-end;
  font-size: 13px;
  line-height: 1.35;
}

.profile-stats-card .profile-card-heading {
  margin-bottom: 8px;
}

.profile-duty-footer {
  display: flex;
  min-width: 0;
  margin-top: 4px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.profile-duty-footer .profile-duty-role {
  min-width: 0;
  margin: 0;
  flex: 1;
  font-size: 12px;
  line-height: 1.4;
}

.profile-shift-badge {
  display: flex;
  min-height: 28px;
  max-width: 40%;
  box-sizing: border-box;
  padding: 4px 10px;
  flex: none;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  line-height: 1.2;
  text-align: center;
}

.profile-detail-action button,
button.profile-password-action {
  width: auto;
  margin: 0;
  padding: 0;
  background: transparent;
  flex: none;
}

button.profile-password-action {
  margin-left: auto;
}

.profile-action-label {
  display: block;
  padding: 8px 12px;
  background: var(--ui-color-primary-light);
  border-radius: var(--ui-radius-small);
  font-size: 12px;
  line-height: 1.3;
  text-align: center;
}

.is-large-text .profile-inline-action,
.is-large-text .profile-duty-link {
  font-size: 15px;
}
