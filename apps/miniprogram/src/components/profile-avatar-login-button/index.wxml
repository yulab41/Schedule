<button
  class="profile-avatar-login-button {{disabled || loading ? 'is-inactive' : ''}}"
  type="default"
  open-type="chooseAvatar"
  disabled="{{disabled || loading}}"
  aria-label="{{label}}"
  aria-disabled="{{disabled || loading}}"
  aria-busy="{{loading}}"
  hover-class="{{disabled || loading ? 'none' : 'is-pressed'}}"
  hover-start-time="0"
  hover-stay-time="80"
  bindtap="handlePress"
  bindchooseavatar="handleChooseAvatar"
>
  <view wx:if="{{loading}}" class="profile-avatar-login-button__loading">
    <ui-loading compact inherit-color></ui-loading>
  </view>
  <text>{{label}}</text>
</button>
