<view
  wx:if="{{defaultPasswordReminderOpen}}"
  class="profile-confirm-backdrop"
  catchtap="handleDefaultPasswordReminderClose"
>
  <view class="profile-confirm-dialog" catchtap="handleConfirmDialogTap">
    <view class="profile-confirm-icon" aria-hidden="true"><text>!</text></view>
    <text class="profile-confirm-eyebrow">账号安全提醒</text>
    <text class="profile-confirm-title">当前使用的是初始密码</text>
    <text class="profile-confirm-copy"
      >当前密码仍为系统初始密码。为保护排班与联系方式数据，建议现在修改。</text
    >
    <text wx:if="{{passwordError}}" class="profile-password-error">{{passwordError}}</text>
    <view class="profile-confirm-actions">
      <button class="profile-confirm-secondary" bindtap="handleDefaultPasswordReminderClose">
        取消
      </button>
      <button class="profile-confirm-primary" bindtap="handleDefaultPasswordReminderEdit">
        修改密码
      </button>
    </view>
    <button class="profile-confirm-quiet" bindtap="handleDefaultPasswordReminderDismiss">
      不再提示
    </button>
    <text class="profile-confirm-note">修改成功后，下次登录请使用新密码。</text>
  </view>
</view>

<ui-sheet
  wx:if="{{passwordSheetOpen}}"
  visible="{{passwordSheetOpen}}"
  title="修改登录密码"
  close-label="取消"
  bind:close="handlePasswordClose"
>
  <view class="profile-password-form">
    <text wx:if="{{authMethod === 'wechat'}}" class="profile-password-proof-note">
      提交时将使用新的微信登录凭证验证身份。
    </text>
    <view wx:if="{{authMethod === 'password'}}" class="profile-password-field">
      <text>当前密码</text>
      <input
        password
        value="{{currentPassword}}"
        placeholder="请输入当前密码"
        bindinput="handleCurrentPasswordInput"
      />
    </view>
    <view class="profile-password-field">
      <text>新密码</text>
      <input
        password
        value="{{newPassword}}"
        placeholder="请输入新密码"
        bindinput="handleNewPasswordInput"
      />
    </view>
    <view class="profile-password-field">
      <text>确认新密码</text>
      <input
        password
        value="{{passwordConfirm}}"
        placeholder="请再次输入新密码"
        bindinput="handlePasswordConfirmInput"
        bindconfirm="handlePasswordSubmit"
      />
    </view>
    <text wx:if="{{passwordError}}" class="profile-password-error">{{passwordError}}</text>
    <button
      class="profile-password-submit"
      disabled="{{passwordSaving}}"
      bindtap="handlePasswordSubmit"
    >
      {{passwordSaving ? '正在修改…' : '确认修改'}}
    </button>
  </view>
</ui-sheet>
