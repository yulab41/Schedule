<calendar-month
  shadow="{{shadow}}"
  id="preview-month"
  compact="{{compact}}"
  month-label="{{monthLabel}}"
  period-subtitle="{{periodSubtitle}}"
  period-unit="{{viewMode}}"
  panels="{{panels}}"
  panel-heights="{{panelHeights}}"
  grid-height="{{gridHeight}}"
  bindmonthchange="handleMonthChange"
  bindmonthsettled="handleMonthSettled"
  bindlocatetoday="handleLocate"
/>
