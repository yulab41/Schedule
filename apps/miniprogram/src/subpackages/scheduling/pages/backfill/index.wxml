<view class="backfill-page {{viewportClass}}">
  <view class="mini-header" style="{{shellHeaderStyle}}">
    <view
      class="header-back"
      hover-class="is-pressed"
      aria-role="button"
      aria-label="返回排班台"
      bindtap="handleBack"
    >
      <image src="/assets/icons/ui-chevron-left.svg" mode="aspectFit" />
    </view>
    <view class="header-title">
      <text class="header-title-main">排班补录</text>
      <text class="header-title-sub">{{currentGroupName}} · 管理员</text>
    </view>
  </view>

  <scroll-view
    class="backfill-scroll"
    style="{{pageScrollStyle}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="page-content">
      <view wx:if="{{state === 'loading'}}" class="page-state-card">
        <ui-loading label="正在加载既往排班"></ui-loading>
      </view>
      <view wx:elif="{{state === 'error'}}" class="page-state-card">
        <ui-alert tone="danger" title="排班补录暂时无法加载" message="{{errorMessage}}"></ui-alert>
        <view
          class="web-button is-primary"
          hover-class="is-pressed"
          aria-role="button"
          bindtap="handleReload"
          >重新加载</view
        >
      </view>
      <view wx:else class="web-parity-page past-schedule-view">
        <text class="page-title">排班补录</text>
        <ui-alert wx:if="{{errorMessage}}" tone="danger" title="操作未完成" message="{{errorMessage}}" />
        <view class="controls">
          <view class="field-label"><text>排班岗位</text>
            <picker disabled="{{isBusy}}" range="{{roleLabels}}" value="{{roleIndex}}" bindchange="handleRoleChange">
              <view class="web-input-shell"><text>{{roleLabels[roleIndex] || '请选择排班岗位'}}</text><image class="picker-chevron" src="/assets/icons/ui-chevron-right-muted.svg" mode="aspectFit" aria-hidden="true" /></view>
            </picker>
          </view>
        </view>
        <view class="palette-section">
          <view class="palette-row"><text class="palette-label">班种</text>
            <view wx:for="{{shiftTypes}}" wx:key="id" class="palette-button shift-type-button {{activeShiftTypeId === item.id ? 'is-active' : ''}}" style="border-color:{{item.color}};background-color:{{activeShiftTypeId === item.id ? item.color : '#ffffff'}};color:{{activeShiftTypeId === item.id ? item.textColor : item.color}}" hover-class="is-pressed" aria-role="button" aria-pressed="{{activeShiftTypeId === item.id}}" data-id="{{item.id}}" bindtap="handleShiftTap">{{item.name}}</view>
          </view>
          <view class="palette-row"><text class="palette-label">成员</text>
            <view wx:for="{{members}}" wx:key="membershipId" class="palette-button member-button {{activeMemberId === item.membershipId ? 'is-active' : ''}}" hover-class="is-pressed" aria-role="button" aria-pressed="{{activeMemberId === item.membershipId}}" data-id="{{item.membershipId}}" bindtap="handleMemberTap">{{item.realName}}</view>
          </view>
          <view class="reason-field"><input value="{{reason}}" maxlength="1000" disabled="{{isBusy}}" placeholder="补录说明（选填）" bindinput="handleReasonInput" /></view>
        </view>
        <text class="paint-hint">{{isPaintReady ? '点击既往日期配班，再点取消；红字为未确认修改。' : paintStatusText}}</text>
        <calendar-month wx:if="{{roleId}}" id="backfill-month" panels="{{monthPanels}}" panel-heights="{{monthPanelHeights}}" grid-height="{{gridHeight}}" month-label="{{monthLabel}}" bind:monthchange="handleCalendarMonthChange" bind:monthsettled="handleCalendarMonthSettled" bind:locatetoday="handleLocateToday" bind:select="handleCalendarSelect" />
        <view class="events-section">
          <text class="events-title">最近补录记录</text>
          <text wx:if="{{records.length === 0}}" class="records-empty">暂无补录记录</text>
          <view wx:for="{{records}}" wx:key="key" class="event-row"><text class="event-time">{{item.time}}</text><text>{{item.summary}}</text></view>
        </view>
      </view>
      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>
  <ui-toast visible="{{!!infoMessage}}" message="{{infoMessage}}" tone="{{feedbackTone}}" />
  <view wx:if="{{state === 'ready'}}" class="backfill-actions">
    <view class="web-button is-primary" hover-class="is-pressed" aria-role="button" aria-disabled="{{isBusy || pendingCount === 0}}" bindtap="handleConfirm">{{isBusy ? '正在处理' : '确认补录（' + pendingCount + '）'}}</view>
    <view class="web-button is-outline" hover-class="is-pressed" aria-role="button" aria-disabled="{{isBusy || pendingCount === 0}}" bindtap="handleClear">清空草稿</view>
  </view>
</view>
