page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--ui-color-background);
}

.backfill-page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-background);
  font-family: var(--ui-font-family-system);
}

.mini-header {
  position: relative;
  z-index: 8;
  display: flex;
  padding: 0 14px;
  box-sizing: border-box;
  align-items: center;
  background: rgba(244, 247, 250, 0.96);
  border-bottom: 1px solid var(--ui-color-border);
}

.header-back {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-medium);
}

.header-back image {
  width: 22px;
  height: 22px;
}

.header-back.is-pressed {
  background: var(--ui-color-primary-light);
}

.header-title {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.header-title-main {
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-strong);
}

.header-title-sub {
  margin-top: 2px;
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.backfill-scroll {
  width: 100%;
}

.page-content {
  padding: 12px 14px 0;
  box-sizing: border-box;
}

.page-state-card {
  display: flex;
  min-height: 210px;
  padding: 20px;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
}

.web-parity-page {
  display: flex;
  flex-direction: column;
  gap: var(--ui-spacing-md);
}

.page-title {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-xl);
  font-weight: var(--ui-font-weight-semibold);
}

.controls,
.palette-section,
.events-section {
  padding: var(--ui-spacing-sm);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
  box-shadow: var(--ui-shadow-card);
}

.controls,
.palette-section,
.events-section,
.field-label,
.reason-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.field-label,
.reason-field {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-medium);
}

.web-input-shell,
.web-button {
  display: flex;
  min-height: 44px;
  padding: 0 12px;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border-strong);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-medium);
  text-align: center;
}

.web-input-shell .picker-chevron {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  transform: rotate(90deg);
}

.web-button {
  justify-content: center;
}

.web-button image {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
}

.web-button.is-primary {
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-color: var(--ui-color-primary);
}

.web-button.is-outline {
  color: var(--ui-color-primary-dark);
  background: var(--ui-color-surface);
  border-color: var(--ui-color-primary-border);
}

.web-button.is-pressed,
.palette-button.is-pressed {
  transform: scale(0.98);
  opacity: 0.86;
}

.palette-row {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 6px;
}

.palette-label {
  width: 100%;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.palette-button {
  display: flex;
  min-height: 44px;
  padding: 6px 12px;
  box-sizing: border-box;
  flex: 0 0 auto;
  white-space: nowrap;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--ui-color-border-strong);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-sm);
}

.palette-button.is-active {
  outline: 2px solid var(--ui-color-primary);
  outline-offset: 1px;
  box-shadow: 0 0 0 3px rgba(31, 90, 166, 0.18);
}

.member-button {
  color: var(--ui-color-text-primary);
  background: var(--ui-color-surface-muted);
}

.member-button.is-active {
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-color: var(--ui-color-primary);
}

.reason-field input {
  width: 100%;
  height: 44px;
  padding: 0 10px;
  line-height: 44px;
  box-sizing: border-box;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border-strong);
  border-radius: var(--ui-radius-small);
  font-family: var(--ui-font-family-system);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-medium);
}

.paint-hint {
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.events-section {
  gap: 0;
}

.events-title {
  margin-bottom: 6px;
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
}

.event-row {
  display: flex;
  min-height: 44px;
  padding: 7px 0;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  gap: 3px;
  border-bottom: 1px dashed var(--ui-color-border);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.event-time,
.records-empty {
  color: var(--ui-color-text-muted);
}

.records-empty {
  min-height: 44px;
  line-height: 44px;
  font-size: var(--ui-font-size-sm);
}

.bottom-spacer {
  height: calc(90px + env(safe-area-inset-bottom));
}

.backfill-page.is-compact .page-content {
  padding-right: 12px;
  padding-left: 12px;
}

.backfill-actions { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 8px; padding: 8px 14px calc(8px + env(safe-area-inset-bottom)); background: var(--ui-color-surface); border-top: 1px solid var(--ui-color-border); z-index: 10; }
.backfill-actions .web-button { flex: 1; justify-content: center; }
.backfill-actions [aria-disabled="true"] { opacity: 0.55; }
