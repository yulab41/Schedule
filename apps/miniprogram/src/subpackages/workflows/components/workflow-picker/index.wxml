<view class="workflow-picker-root {{open ? 'is-open' : ''}}">
  <view
    class="workflow-picker-trigger {{disabled ? 'is-disabled' : ''}}"
    hover-class="{{disabled ? 'none' : 'is-pressed'}}"
    aria-role="button"
    aria-disabled="{{disabled}}"
    aria-expanded="{{open}}"
    bindtap="handleOpen"
  >
    <text class="workflow-picker-trigger-value {{displayValue ? '' : 'is-placeholder'}}"
      >{{displayValue || placeholder}}</text
    >
    <text class="workflow-picker-chevron" aria-hidden="true">›</text>
  </view>

  <scroll-view
    wx:if="{{open && mode === 'selector'}}"
    class="workflow-picker-selector-popover"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{options}}"
      wx:key="value"
      class="workflow-picker-option {{item.isWeekend ? 'is-weekend' : ''}} {{index === selectedOptionIndex ? 'is-selected' : ''}}"
      data-index="{{index}}"
      aria-role="option"
      aria-selected="{{index === selectedOptionIndex}}"
      bindtap="handleOptionTap"
    >
      <view class="workflow-picker-option-marker"></view>
      <text>{{item.label}}</text>
      <text wx:if="{{index === selectedOptionIndex}}" class="workflow-picker-option-check">✓</text>
    </view>
    <view wx:if="{{options.length === 0}}" class="workflow-picker-empty">暂无可选项</view>
  </scroll-view>
</view>

<view wx:if="{{open && mode !== 'selector'}}" class="workflow-picker-layer">
  <view class="workflow-picker-scrim" aria-role="button" bindtap="handleClose"></view>
  <view class="workflow-picker-sheet" aria-role="dialog" aria-label="{{title}}">
    <view class="workflow-picker-handle"></view>
    <view class="workflow-picker-heading">
      <view>
        <text
          >{{mode === 'month' ? '选择月份' : mode === 'date' ? '选择日期' : '选择'}}</text
        >
        <text>{{draftDisplayValue}}</text>
      </view>
      <view class="workflow-picker-close" aria-role="button" aria-label="关闭" bindtap="handleClose"
        >×</view
      >
    </view>

    <view class="workflow-picker-summary">
      <view class="workflow-picker-summary-mark"></view>
      <view>
        <text>{{draftDisplayValue}}</text>
        <text
          >{{mode === 'month' ? '上下滑动年份与月份' : mode === 'date' ? '选择日期后点击完成' :
          '选择后点击完成'}}</text
        >
      </view>
    </view>

    <picker-view
      wx:if="{{mode === 'month'}}"
      class="workflow-picker-wheel"
      value="{{draftIndices}}"
      indicator-class="workflow-picker-indicator"
      mask-class="workflow-picker-mask"
      immediate-change="{{true}}"
      bindchange="handlePickerViewChange"
    >
      <picker-view-column>
        <view wx:for="{{years}}" wx:key="*this" class="workflow-picker-wheel-item"
          ><text>{{item}}</text><text class="workflow-picker-unit">年</text></view
        >
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{months}}" wx:key="*this" class="workflow-picker-wheel-item"
          ><text>{{item}}</text><text class="workflow-picker-unit">月</text></view
        >
      </picker-view-column>
    </picker-view>

    <view wx:elif="{{mode === 'date'}}" class="workflow-picker-date-panel">
      <view class="workflow-picker-date-navigation">
        <view
          class="workflow-picker-date-step"
          data-offset="-1"
          aria-role="button"
          aria-label="上一月"
          bindtap="handleDateNavigate"
          >‹</view
        >
        <text>{{draftYear}}年{{draftMonth}}月</text>
        <view
          class="workflow-picker-date-step"
          data-offset="1"
          aria-role="button"
          aria-label="下一月"
          bindtap="handleDateNavigate"
          >›</view
        >
      </view>
      <view class="workflow-picker-weekdays">
        <text wx:for="{{weekdays}}" wx:key="*this" class="{{index >= 5 ? 'is-weekend' : ''}}"
          >{{item}}</text
        >
      </view>
      <view class="workflow-picker-date-grid">
        <view
          wx:for="{{dateCells}}"
          wx:key="value"
          class="workflow-picker-date-cell {{item.muted ? 'is-muted' : ''}} {{item.isWeekend ? 'is-weekend' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.disabled ? 'is-disabled' : ''}}"
          data-value="{{item.value}}"
          aria-role="button"
          aria-disabled="{{item.disabled}}"
          aria-pressed="{{item.isSelected}}"
          bindtap="handleDateSelect"
        >
          <text>{{item.day}}</text>
        </view>
      </view>
    </view>

    <view class="workflow-picker-actions">
      <view class="workflow-picker-button is-secondary" aria-role="button" bindtap="handleClose"
        >取消</view
      >
      <view class="workflow-picker-button is-primary" aria-role="button" bindtap="handleConfirm"
        >完成</view
      >
    </view>
  </view>
</view>
