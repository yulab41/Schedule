<view class="workflow-picker-root {{open ? 'is-open' : ''}}" catchtap="handleInternalTap">
  <view
    class="workflow-picker-trigger {{disabled ? 'is-disabled' : ''}}"
    aria-role="button"
    aria-disabled="{{disabled}}"
    aria-expanded="{{open}}"
    bindtap="handleOpen"
  >
    <text class="workflow-picker-trigger-value {{displayValue ? '' : 'is-placeholder'}}"
      >{{displayValue || placeholder}}</text
    >
    <view
      class="workflow-picker-chevron {{mode === 'selector' ? (open ? 'is-up' : 'is-down') : 'is-right'}}"
      aria-hidden="true"
    ></view>
  </view>

  <view
    wx:if="{{open && mode === 'selector'}}"
    class="workflow-picker-selector-backdrop"
    aria-role="button"
    aria-label="关闭选项"
    bindtap="handleClose"
  ></view>
  <scroll-view
    wx:if="{{open && mode === 'selector'}}"
    class="workflow-picker-selector-popover {{popoverPlacement === 'up' ? 'is-up' : 'is-down'}} {{popoverPlacementReady ? 'is-ready' : 'is-measuring'}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{renderedOptions}}"
      wx:key="value"
      class="workflow-picker-option {{item.isWeekend ? 'is-weekend' : ''}} {{index === selectedOptionIndex ? 'is-selected' : ''}}"
      data-index="{{index}}"
      aria-role="option"
      aria-selected="{{index === selectedOptionIndex}}"
      bindtap="handleOptionTap"
    >
      <text class="workflow-picker-option-label"
        ><text>{{item.leadingLabel}}</text
        ><text wx:if="{{item.weekendLabel}}" class="workflow-picker-option-weekend"
          >{{item.weekendLabel}}</text
        ><text>{{item.trailingLabel}}</text></text
      >
    </view>
    <view wx:if="{{options.length === 0}}" class="workflow-picker-empty">暂无可选项</view>
  </scroll-view>
</view>

<view wx:if="{{open && mode !== 'selector'}}" class="workflow-picker-layer">
  <view class="workflow-picker-scrim" aria-role="button" bindtap="handleClose"></view>
  <view class="workflow-picker-sheet" aria-role="dialog" aria-label="{{title}}">
    <view class="workflow-picker-handle"></view>
    <view class="workflow-picker-heading">
      <view>
        <text>{{mode === 'month' ? '选择月份' : mode === 'date' ? '选择日期' : '选择'}}</text>
        <text>{{draftDisplayValue}}</text>
      </view>
      <view class="workflow-picker-close" aria-role="button" aria-label="关闭" bindtap="handleClose"
        >×</view
      >
    </view>

    <view class="workflow-picker-summary">
      <view class="workflow-picker-summary-mark"></view>
      <view>
        <text>{{draftDisplayValue}}</text>
        <text
          >{{mode === 'month' ? '上下滑动年份与月份' : mode === 'date' ? '选择日期后点击完成' :
          '选择后点击完成'}}</text
        >
      </view>
    </view>

    <view wx:if="{{mode === 'month'}}" class="workflow-picker-wheel">
      <scroll-view
        class="workflow-picker-wheel-column workflow-picker-year-column"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        scroll-top="{{yearWheelTop}}"
        scroll-with-animation="{{wheelSnapAnimating}}"
        bindtouchstart="handleYearWheelTouchStart"
        bindtouchend="handleYearWheelTouchEnd"
        bindtouchcancel="handleYearWheelTouchEnd"
        bindscroll="handleYearWheelScroll"
        bindscrollend="handleYearWheelScrollEnd"
      >
        <view class="workflow-picker-wheel-spacer"></view>
        <view
          wx:for="{{yearWheelItems}}"
          wx:key="label"
          class="workflow-picker-wheel-item {{index === draftIndices[0] ? 'is-selected' : ''}}"
          data-index="{{index}}"
          catchtap="handleYearWheelTap"
          style="font-size:{{item.fontSize}}px;opacity:{{item.opacity}};transform:scale({{item.scale}})"
          ><text>{{item.label}}</text><text class="workflow-picker-unit">{{item.unit}}</text></view
        >
        <view class="workflow-picker-wheel-spacer"></view>
      </scroll-view>
      <scroll-view
        class="workflow-picker-wheel-column workflow-picker-month-column"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        scroll-top="{{monthWheelTop}}"
        scroll-with-animation="{{wheelSnapAnimating}}"
        bindtouchstart="handleMonthWheelTouchStart"
        bindtouchend="handleMonthWheelTouchEnd"
        bindtouchcancel="handleMonthWheelTouchEnd"
        bindscroll="handleMonthWheelScroll"
        bindscrollend="handleMonthWheelScrollEnd"
      >
        <view class="workflow-picker-wheel-spacer"></view>
        <view
          wx:for="{{monthWheelItems}}"
          wx:key="label"
          class="workflow-picker-wheel-item {{index === draftIndices[1] ? 'is-selected' : ''}}"
          data-index="{{index}}"
          catchtap="handleMonthWheelTap"
          style="font-size:{{item.fontSize}}px;opacity:{{item.opacity}};transform:scale({{item.scale}})"
          ><text>{{item.label}}</text><text class="workflow-picker-unit">{{item.unit}}</text></view
        >
        <view class="workflow-picker-wheel-spacer"></view>
      </scroll-view>
      <view class="workflow-picker-wheel-rails"></view>
      <view class="workflow-picker-wheel-mask"></view>
    </view>

    <view wx:elif="{{mode === 'date'}}" class="workflow-picker-date-panel">
      <view class="workflow-picker-date-navigation">
        <view
          class="workflow-picker-date-step"
          data-offset="-1"
          aria-role="button"
          aria-label="上一月"
          hover-class="is-pressed"
          hover-start-time="0"
          hover-stay-time="60"
          bindtap="handleDateNavigate"
          ><image src="/assets/icons/web-chevron-left.svg" mode="aspectFit"
        /></view>
        <text>{{draftYear}}年{{draftMonth}}月</text>
        <view
          class="workflow-picker-date-today"
          aria-role="button"
          aria-label="定位今天"
          hover-class="is-pressed"
          hover-start-time="0"
          hover-stay-time="60"
          bindtap="handleDateToday"
          ><view
            class="workflow-picker-date-locate-icon {{dateLocateAnimating ? 'is-animating' : ''}}"
            ><image src="/assets/icons/web-locate.svg" mode="aspectFit" /></view
        ></view>
        <view
          class="workflow-picker-date-step"
          data-offset="1"
          aria-role="button"
          aria-label="下一月"
          hover-class="is-pressed"
          hover-start-time="0"
          hover-stay-time="60"
          bindtap="handleDateNavigate"
          ><image src="/assets/icons/web-chevron-right.svg" mode="aspectFit"
        /></view>
      </view>
      <view class="workflow-picker-weekdays">
        <text wx:for="{{weekdays}}" wx:key="*this" class="{{index >= 5 ? 'is-weekend' : ''}}"
          >{{item}}</text
        >
      </view>
      <swiper
        class="workflow-picker-date-swiper"
        current="{{dateSwiperIndex}}"
        duration="240"
        easing-function="easeOutCubic"
        bindchange="handleDateSwiperChange"
      >
        <swiper-item wx:for="{{datePanels}}" wx:key="key" wx:for-item="panel">
          <view class="workflow-picker-date-grid">
            <view
              wx:for="{{panel.cells}}"
              wx:key="value"
              class="workflow-picker-date-cell {{item.muted ? 'is-muted' : ''}} {{item.isWeekend ? 'is-weekend' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.disabled ? 'is-disabled' : ''}}"
              data-value="{{item.value}}"
              aria-role="button"
              aria-disabled="{{item.disabled}}"
              aria-pressed="{{item.isSelected}}"
              bindtap="handleDateSelect"
            >
              <text>{{item.day}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="workflow-picker-actions">
      <view class="workflow-picker-button is-secondary" aria-role="button" bindtap="handleClose"
        >取消</view
      >
      <view class="workflow-picker-button is-primary" aria-role="button" bindtap="handleConfirm"
        >完成</view
      >
    </view>
  </view>
</view>
