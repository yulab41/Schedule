<view
  class="swap-page leave-page {{viewportClass}} {{embedded ? 'is-embedded' : ''}}"
  bindtap="handlePanelBackgroundTap"
  bind:pickerrequestopen="handlePickerRequestOpen"
>
  <view wx:if="{{!embedded}}" class="mini-header" style="{{shellHeaderStyle}}">
    <view class="header-back" aria-role="button" aria-label="返回排班台" bindtap="handleBack">
      <image src="/assets/icons/web-chevron-left.svg" mode="aspectFit" />
    </view>
    <view class="header-title">
      <text class="header-title-main">换班管理</text>
      <text class="header-title-sub">{{currentGroupName}} · {{currentGroupRole}}</text>
    </view>
    <text class="phase-chip">P7</text>
  </view>

  <scroll-view
    class="leave-scroll"
    style="{{embedded ? 'height:100%;' : pageScrollStyle}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="page-content">
      <view wx:if="{{state === 'loading'}}" class="page-state-card">
        <view class="native-spinner"></view>
        <text class="state-title">正在加载换班数据</text>
        <text class="state-copy">正在同步班次、申请和审批设置。</text>
      </view>

      <view wx:elif="{{state === 'error'}}" class="page-state-card">
        <view class="native-alert is-danger"
          ><text class="alert-title">换班数据暂时无法加载</text><text>{{errorMessage}}</text></view
        >
        <view class="web-button is-primary" aria-role="button" bindtap="handleRetry">重新加载</view>
      </view>

      <view wx:elif="{{state === 'ready'}}" class="leave-panel">
        <view class="panel-heading swap-heading">
          <view class="heading-copy">
            <text class="page-title">换班管理</text>
            <text>交换双方已发布班次，并跟踪接受与审批状态。</text>
          </view>
          <view class="heading-actions">
            <view
              wx:if="{{canApprove}}"
              class="web-button is-outline"
              aria-role="button"
              bindtap="handleOpenAdminForm"
              >管理员换班</view
            >
            <view class="web-button is-primary" aria-role="button" bindtap="handleOpenRequestForm"
              >发起换班</view
            >
          </view>
        </view>

        <view wx:if="{{errorMessage}}" class="native-alert is-danger"
          ><text class="alert-title">操作未完成</text><text>{{errorMessage}}</text></view
        >
        <view wx:if="{{infoMessage}}" class="native-alert is-success"
          ><text class="alert-title">操作完成</text><text>{{infoMessage}}</text></view
        >

        <view class="settings-row">
          <view wx:if="{{canApprove}}" class="setting-card">
            <view class="setting-copy"
              ><text>换班需要管理员审批</text><text>目标成员接受后，再由管理员确认。</text></view
            >
            <switch
              checked="{{requiresApproval}}"
              disabled="{{settingsBusy}}"
              color="#1F5AA6"
              bindchange="handleGroupApprovalToggle"
            />
          </view>
          <view class="setting-card">
            <view class="setting-copy"
              ><text>自动接受换班</text><text>收到换班时自动进入下一处理状态。</text></view
            >
            <switch
              checked="{{autoAcceptSwaps}}"
              disabled="{{settingsBusy}}"
              color="#1F5AA6"
              bindchange="handleAutoAcceptToggle"
            />
          </view>
        </view>

        <view wx:if="{{incomingCount > 0}}" class="workflow-section">
          <view class="section-heading"
            ><view
              ><text class="section-title">待我接受</text
              ><text>确认双方班次后接受或驳回。</text></view
            ><text>{{incomingCount}} 项</text></view
          >
          <view class="request-list">
            <view wx:for="{{incomingRequests}}" wx:key="id" class="request-card is-featured">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.initiatorName}}</text><text>发起人</text></view
                ><text class="status-chip is-warning">{{item.statusLabel}}</text></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.pairLabel}}</text></view>
              <view class="request-actions">
                <view
                  class="web-button is-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleAccept"
                  >接受</view
                >
                <view
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleReject"
                  >驳回</view
                >
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{canApprove && pendingApprovalCount > 0}}" class="workflow-section">
          <view class="section-heading"
            ><view
              ><text class="section-title">待管理员审批</text
              ><text>目标成员已接受，等待最终确认。</text></view
            ><text>{{pendingApprovalCount}} 项</text></view
          >
          <view class="request-list">
            <view wx:for="{{pendingApprovals}}" wx:key="id" class="request-card is-featured">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.initiatorName}} ↔ {{item.targetName}}</text
                  ><text>换班双方</text></view
                ><text class="status-chip is-warning">{{item.statusLabel}}</text></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.pairLabel}}</text></view>
              <view class="request-actions">
                <view
                  class="web-button is-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleApprove"
                  >批准</view
                >
                <view
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleReject"
                  >驳回</view
                >
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{canApprove && handledApprovalCount > 0}}" class="workflow-section">
          <view class="section-heading"
            ><view
              ><text class="section-title">已受理记录</text
              ><text>查看已处理换班及处理人。</text></view
            ><text>{{handledApprovalCount}} 项</text></view
          >
          <view class="request-list">
            <view wx:for="{{handledApprovals}}" wx:key="id" class="request-card is-muted">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.initiatorName}} ↔ {{item.targetName}}</text
                  ><text>处理人 {{item.decidedByLabel}}</text></view
                ><text
                  class="status-chip {{item.statusTone}} {{item.statusLabel === '已取消' || item.statusLabel === '已撤销' ? 'is-neutral' : ''}}"
                  >{{item.statusLabel}}</text
                ></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.pairLabel}}</text></view>
            </view>
          </view>
        </view>

        <view
          wx:if="{{canApprove && (completedSwapCount > 0 || archivedSwapCount > 0)}}"
          class="workflow-section"
        >
          <view class="section-heading"
            ><view
              ><text class="section-title">已生效待撤销</text
              ><text>只能按工作流逆序撤销仍有效的换班。</text></view
            ><text>{{completedSwapCount}} 项</text></view
          >
          <view wx:if="{{completedSwapCount > 0}}" class="request-list">
            <view wx:for="{{completedSwaps}}" wx:key="id" class="request-card">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.initiatorName}} ↔ {{item.targetName}}</text
                  ><text>已交换实际班次</text></view
                ><text class="status-chip is-success">已生效</text></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.pairLabel}}</text></view>
              <view
                class="web-button is-danger-outline"
                data-id="{{item.id}}"
                aria-role="button"
                bindtap="handleRevoke"
                >撤销</view
              >
            </view>
          </view>
          <view wx:if="{{archivedSwapCount > 0}}" class="native-alert is-warning"
            ><text
              >另有 {{archivedSwapCount}} 条因后续排班变动而失效的换班记录已自动归档。</text
            ></view
          >
        </view>

        <view class="workflow-section">
          <view class="section-heading"
            ><view
              ><text class="section-title">我的换班申请</text
              ><text>跟进发起、接受、审批与撤销状态。</text></view
            ><text>{{myRequestCount}} 项</text></view
          >
          <view wx:if="{{myRequestCount === 0}}" class="empty-card"
            ><text class="empty-title">暂无换班申请</text
            ><text>选择双方已发布班次后发起换班。</text></view
          >
          <view wx:else class="request-list">
            <view wx:for="{{myRequests}}" wx:key="id" class="request-card">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.counterpartName}}</text><text>对方</text></view
                ><text class="status-chip {{item.statusTone}}">{{item.statusLabel}}</text></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.pairLabel}}</text></view>
              <text wx:if="{{item.reasonLabel}}" class="status-reason">{{item.reasonLabel}}</text>
              <view wx:if="{{item.canCancel || item.canRevoke}}" class="request-actions">
                <view
                  wx:if="{{item.canCancel}}"
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleCancel"
                  >撤销申请</view
                >
                <view
                  wx:if="{{item.canRevoke}}"
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleRevoke"
                  >撤销换班</view
                >
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!embedded}}" class="bottom-nav" aria-label="工作流导航">
    <view class="bottom-nav-item" aria-role="button" bindtap="handleBack"
      ><image src="/assets/icons/web-calendar.svg" mode="aspectFit" /><text>日历</text></view
    >
    <view class="bottom-nav-item" aria-role="button" bindtap="handleLeaveNav"
      ><image src="/assets/icons/web-leave.svg" mode="aspectFit" /><text>请假</text></view
    >
    <view class="bottom-nav-item is-active" aria-current="page"
      ><image src="/assets/icons/web-swap.svg" mode="aspectFit" /><text>换班</text></view
    >
    <view class="bottom-nav-item" data-label="加扣班" aria-disabled="false" bindtap="handleDutyNav"
      ><image src="/assets/icons/web-duty.svg" mode="aspectFit" /><text>加扣班</text></view
    >
    <view
      class="bottom-nav-item is-disabled"
      data-label="更多"
      aria-disabled="true"
      bindtap="handleUnavailable"
      ><image src="/assets/icons/web-more.svg" mode="aspectFit" /><text>更多</text></view
    >
  </view>

  <view wx:if="{{requestFormVisible}}" class="sheet-layer">
    <view class="sheet-scrim" aria-role="button" bindtap="handleCloseRequestForm"></view>
    <view class="native-sheet" aria-role="dialog" aria-label="发起换班">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"
        ><view
          ><text class="sheet-title">发起换班</text
          ><text>选择双方已发布班次，预览后提交。</text></view
        ><view class="sheet-close" aria-role="button" bindtap="handleCloseRequestForm"
          >×</view
        ></view
      >
      <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="sheet-body">
          <view wx:if="{{requestErrorMessage}}" class="native-alert is-danger"
            ><text>{{requestErrorMessage}}</text></view
          >
          <view class="field-block"
            ><text class="field-label">我的班次月份</text
            ><workflow-picker
              mode="month"
              value="{{myAssignmentMonth}}"
              display-value="{{myAssignmentMonth}}"
              title="我的班次月份"
              bindchange="handleMyMonthChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">我的班次</text
            ><workflow-picker
              mode="selector"
              options="{{myAssignmentOptions}}"
              selected-index="{{myAssignmentIndex}}"
              display-value="{{myAssignmentIndex >= 0 ? myAssignmentOptions[myAssignmentIndex].label : ''}}"
              placeholder="选择我的班次"
              title="我的班次"
              bindchange="handleMyAssignmentChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">对方班次月份</text
            ><workflow-picker
              mode="month"
              value="{{targetAssignmentMonth}}"
              display-value="{{targetAssignmentMonth}}"
              title="对方班次月份"
              bindchange="handleTargetMonthChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">目标成员</text
            ><workflow-picker
              mode="selector"
              options="{{targetMemberOptions}}"
              selected-index="{{targetMemberIndex}}"
              display-value="{{targetMemberIndex >= 0 ? targetMemberOptions[targetMemberIndex].label : ''}}"
              placeholder="选择目标成员"
              title="目标成员"
              bindchange="handleTargetMemberChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">目标班次</text
            ><workflow-picker
              mode="selector"
              options="{{targetAssignmentOptions}}"
              selected-index="{{targetAssignmentIndex}}"
              display-value="{{targetAssignmentIndex >= 0 ? targetAssignmentOptions[targetAssignmentIndex].label : ''}}"
              placeholder="选择目标成员的班次"
              title="目标班次"
              bindchange="handleTargetAssignmentChange"
            ></workflow-picker
          ></view>
          <view class="form-actions"
            ><view class="web-button is-outline" aria-role="button" bindtap="handlePreview"
              >生成预览</view
            ><view class="web-button is-primary" aria-role="button" bindtap="handleSubmit"
              >{{requestBusy ? '正在提交' : '提交换班'}}</view
            ></view
          >
          <view wx:if="{{requestPreviewReady}}" class="preview-card"
            ><text class="preview-title">换班预览</text><text>{{requestPreviewSummary}}</text></view
          >
          <view wx:for="{{requestPreviewConflicts}}" wx:key="id" class="native-alert is-danger"
            ><text>{{item.message}}</text></view
          >
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{adminFormVisible}}" class="sheet-layer">
    <view class="sheet-scrim" aria-role="button" bindtap="handleCloseAdminForm"></view>
    <view class="native-sheet approval-sheet" aria-role="dialog" aria-label="管理员直接换班">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"
        ><view
          ><text class="sheet-title">管理员直接换班</text
          ><text>直接生效，无需对方同意或审批。</text></view
        ><view class="sheet-close" aria-role="button" bindtap="handleCloseAdminForm">×</view></view
      >
      <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="sheet-body">
          <view wx:if="{{adminErrorMessage}}" class="native-alert is-danger"
            ><text>{{adminErrorMessage}}</text></view
          >
          <view class="field-block"
            ><text class="field-label">成员一月份</text
            ><workflow-picker
              mode="month"
              value="{{adminInitiatorMonth}}"
              display-value="{{adminInitiatorMonth}}"
              title="成员一月份"
              bindchange="handleAdminInitiatorMonthChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">成员一</text
            ><workflow-picker
              mode="selector"
              options="{{adminInitiatorMemberOptions}}"
              selected-index="{{adminInitiatorMemberIndex}}"
              display-value="{{adminInitiatorMemberIndex >= 0 ? adminInitiatorMemberOptions[adminInitiatorMemberIndex].label : ''}}"
              placeholder="选择成员一"
              title="成员一"
              bindchange="handleAdminInitiatorMemberChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">成员一的班次</text
            ><workflow-picker
              mode="selector"
              options="{{adminInitiatorAssignmentOptions}}"
              selected-index="{{adminInitiatorAssignmentIndex}}"
              display-value="{{adminInitiatorAssignmentIndex >= 0 ? adminInitiatorAssignmentOptions[adminInitiatorAssignmentIndex].label : ''}}"
              placeholder="选择成员一的班次"
              title="成员一的班次"
              bindchange="handleAdminInitiatorAssignmentChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">成员二月份</text
            ><workflow-picker
              mode="month"
              value="{{adminTargetMonth}}"
              display-value="{{adminTargetMonth}}"
              title="成员二月份"
              bindchange="handleAdminTargetMonthChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">成员二</text
            ><workflow-picker
              mode="selector"
              options="{{adminTargetMemberOptions}}"
              selected-index="{{adminTargetMemberIndex}}"
              display-value="{{adminTargetMemberIndex >= 0 ? adminTargetMemberOptions[adminTargetMemberIndex].label : ''}}"
              placeholder="选择成员二"
              title="成员二"
              bindchange="handleAdminTargetMemberChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">成员二的班次</text
            ><workflow-picker
              mode="selector"
              options="{{adminTargetAssignmentOptions}}"
              selected-index="{{adminTargetAssignmentIndex}}"
              display-value="{{adminTargetAssignmentIndex >= 0 ? adminTargetAssignmentOptions[adminTargetAssignmentIndex].label : ''}}"
              placeholder="选择成员二的班次"
              title="成员二的班次"
              bindchange="handleAdminTargetAssignmentChange"
            ></workflow-picker
          ></view>
          <view class="form-actions"
            ><view class="web-button is-outline" aria-role="button" bindtap="handleAdminPreview"
              >生成预览</view
            ><view class="web-button is-primary" aria-role="button" bindtap="handleAdminSubmit"
              >{{adminBusy ? '正在执行' : '直接执行换班'}}</view
            ></view
          >
          <view wx:if="{{adminPreviewReady}}" class="preview-card"
            ><text class="preview-title">直接换班预览</text
            ><text>{{adminPreviewSummary}}</text></view
          >
          <view wx:for="{{adminPreviewConflicts}}" wx:key="id" class="native-alert is-danger"
            ><text>{{item.message}}</text></view
          >
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{revokeVisible}}" class="sheet-layer">
    <view class="sheet-scrim" aria-role="button" bindtap="handleCloseRevoke"></view>
    <view class="native-sheet revoke-sheet" aria-role="dialog" aria-label="撤销换班">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"
        ><view
          ><text class="sheet-title">撤销换班</text
          ><text>只能撤销仍处于工作流链末端的换班。</text></view
        ><view class="sheet-close" aria-role="button" bindtap="handleCloseRevoke">×</view></view
      >
      <view class="sheet-body">
        <view wx:if="{{revokeErrorMessage}}" class="native-alert is-danger"
          ><text>{{revokeErrorMessage}}</text></view
        >
        <view class="field-block"
          ><text class="field-label">撤销原因（选填）</text
          ><textarea
            class="native-textarea"
            value="{{revokeReason}}"
            maxlength="200"
            placeholder="记录撤销原因"
            bindinput="handleRevokeReasonInput"
          />
        </view>
        <view class="web-button is-danger-outline" aria-role="button" bindtap="handleConfirmRevoke"
          >{{revokeBusy ? '正在撤销' : '确认撤销换班'}}</view
        >
      </view>
    </view>
  </view>
</view>
