<ui-toast
  visible="{{!!infoMessage && (!embedded || active)}}"
  title="操作完成"
  message="{{infoMessage}}"
  tone="success"
/>

<view
  class="duty-page leave-page {{viewportClass}} {{embedded ? 'is-embedded' : ''}}"
  bindtap="handlePanelBackgroundTap"
  bind:pickerrequestopen="handlePickerRequestOpen"
>
  <view wx:if="{{!embedded}}" class="mini-header" style="{{shellHeaderStyle}}">
    <view class="header-back" aria-role="button" aria-label="返回排班台" bindtap="handleBack">
      <image src="/assets/icons/ui-chevron-left.svg" mode="aspectFit" />
    </view>
    <view class="header-title">
      <text class="header-title-main">加扣班管理</text>
      <text class="header-title-sub">{{currentGroupName}} · {{currentGroupRole}}</text>
    </view>
  </view>

  <scroll-view
    class="leave-scroll"
    style="{{embedded ? 'height:100%;' : pageScrollStyle}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="page-content">
      <view wx:if="{{state === 'loading'}}" class="page-state-card">
        <view class="native-spinner"></view>
        <text class="state-title">正在加载加扣班数据</text>
        <text class="state-copy">正在同步班次、申请和审批设置。</text>
      </view>

      <view wx:elif="{{state === 'error'}}" class="page-state-card">
        <view class="native-alert is-danger"
          ><text class="alert-title">加扣班数据暂时无法加载</text
          ><text>{{errorMessage}}</text></view
        >
        <view class="web-button is-primary" aria-role="button" bindtap="handleRetry">重新加载</view>
      </view>

      <view wx:elif="{{state === 'ready'}}" class="leave-panel">
        <view class="panel-heading duty-heading">
          <view class="heading-copy"
            ><text class="page-title">加扣班管理</text
            ><text>安排成员代值已发布班次，并跟踪接受与审批状态。</text></view
          >
          <view class="heading-actions">
            <view
              wx:if="{{canApprove}}"
              class="web-button is-outline"
              aria-role="button"
              bindtap="handleOpenAdminForm"
              >管理员代值</view
            >
            <view class="web-button is-primary" aria-role="button" bindtap="handleOpenRequestForm"
              >发起加扣班</view
            >
          </view>
        </view>

        <view wx:if="{{errorMessage}}" class="native-alert is-danger"
          ><text class="alert-title">操作未完成</text><text>{{errorMessage}}</text></view
        >

        <view class="settings-row">
          <view wx:if="{{canApprove}}" class="setting-card">
            <view class="setting-copy"
              ><text>加扣班需要管理员审批</text><text>加班成员接受后，再由管理员确认。</text></view
            >
            <ui-switch
              checked="{{requiresApproval}}"
              loading="{{settingsBusy}}"
              label="加扣班需要管理员审批"
              color="#1F5AA6"
              bind:change="handleGroupApprovalToggle"
            />
          </view>
          <view class="setting-card">
            <view class="setting-copy"
              ><text>自动接受换班/加扣班</text
              ><text>收到代值请求时自动进入下一处理状态。</text></view
            >
            <ui-switch
              checked="{{autoAcceptSwaps}}"
              loading="{{settingsBusy}}"
              label="自动接受换班/加扣班"
              color="#1F5AA6"
              bind:change="handleAutoAcceptToggle"
            />
          </view>
        </view>

        <view wx:if="{{incomingCount > 0}}" class="workflow-section">
          <view class="section-heading"
            ><view
              ><text class="section-title">待我接受</text
              ><text>确认代值班次后接受或驳回。</text></view
            ><text>{{incomingCount}} 项</text></view
          >
          <view class="request-list">
            <view wx:for="{{incomingRequests}}" wx:key="id" class="request-card is-featured">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.deductedName}}</text><text>扣班成员</text></view
                ><text class="status-chip is-warning">{{item.statusLabel}}</text></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.shiftLabel}}</text></view>
              <view class="request-detail"
                ><text>原因</text><text>{{item.reasonLabel || '未填写'}}</text></view
              >
              <view class="request-actions"
                ><view
                  class="web-button is-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleAccept"
                  >接受</view
                ><view
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleReject"
                  >驳回</view
                ></view
              >
            </view>
          </view>
        </view>

        <view wx:if="{{canApprove && pendingApprovalCount > 0}}" class="workflow-section">
          <view class="section-heading"
            ><view
              ><text class="section-title">待管理员审批</text
              ><text>加班成员已接受，等待最终确认。</text></view
            ><text>{{pendingApprovalCount}} 项</text></view
          >
          <view class="request-list">
            <view wx:for="{{pendingApprovals}}" wx:key="id" class="request-card is-featured">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.deductedName}} → {{item.overtimeName}}</text
                  ><text>扣班 / 加班</text></view
                ><text class="status-chip is-warning">{{item.statusLabel}}</text></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.shiftLabel}}</text></view>
              <view class="request-detail"
                ><text>原因</text><text>{{item.reasonLabel || '未填写'}}</text></view
              >
              <view class="request-actions"
                ><view
                  class="web-button is-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleApprove"
                  >批准</view
                ><view
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleReject"
                  >驳回</view
                ></view
              >
            </view>
          </view>
        </view>

        <view wx:if="{{canApprove && handledApprovalCount > 0}}" class="workflow-section">
          <view class="section-heading"
            ><view
              ><text class="section-title">已受理记录</text
              ><text>查看已取消、驳回或撤销的记录。</text></view
            ><text>{{handledApprovalCount}} 项</text></view
          >
          <view class="request-list">
            <view wx:for="{{handledApprovals}}" wx:key="id" class="request-card is-muted">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.deductedName}} → {{item.overtimeName}}</text
                  ><text>处理人 {{item.decidedByLabel}}</text></view
                ><text
                  class="status-chip {{item.statusTone}} {{item.statusLabel === '已取消' || item.statusLabel === '已撤销' ? 'is-neutral' : ''}}"
                  >{{item.statusLabel}}</text
                ></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.shiftLabel}}</text></view>
            </view>
          </view>
        </view>

        <view
          wx:if="{{canApprove && (completedCount > 0 || archivedDutyCount > 0)}}"
          class="workflow-section"
        >
          <view class="section-heading"
            ><view
              ><text class="section-title">已生效待撤销</text
              ><text>撤销后恢复原扣班成员为实际值班人员。</text></view
            ><text>{{completedCount}} 项</text></view
          >
          <view wx:if="{{completedCount > 0}}" class="request-list">
            <view wx:for="{{completedAdjustments}}" wx:key="id" class="request-card">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.deductedName}} → {{item.overtimeName}}</text
                  ><text>已生效代值</text></view
                ><text class="status-chip is-success">已生效</text></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.shiftLabel}}</text></view>
              <view
                class="web-button is-danger-outline"
                data-id="{{item.id}}"
                aria-role="button"
                bindtap="handleRevoke"
                >撤销</view
              >
            </view>
          </view>
          <view wx:if="{{archivedDutyCount > 0}}" class="native-alert is-warning"
            ><text
              >另有 {{archivedDutyCount}} 条因后续排班变动而失效的加扣班记录已自动归档。</text
            ></view
          >
        </view>

        <view class="workflow-section">
          <view class="section-heading"
            ><view
              ><text class="section-title">我的加扣班记录</text
              ><text>跟进发起、接受、审批与撤销状态。</text></view
            ><text>{{myRequestCount}} 项</text></view
          >
          <view wx:if="{{myRequestCount === 0}}" class="empty-card"
            ><text class="empty-title">暂无加扣班记录</text
            ><text>选择自己的已发布班次和加班成员后发起。</text></view
          >
          <view wx:else class="request-list">
            <view wx:for="{{myRequests}}" wx:key="id" class="request-card">
              <view class="request-card-heading"
                ><view class="request-person"
                  ><text>{{item.counterpartName}}</text><text>对方</text></view
                ><text
                  class="status-chip {{item.statusTone}} {{item.statusLabel === '已取消' || item.statusLabel === '已撤销' ? 'is-neutral' : ''}}"
                  >{{item.statusLabel}}</text
                ></view
              >
              <view class="request-detail"><text>班次</text><text>{{item.shiftLabel}}</text></view>
              <text wx:if="{{item.reasonLabel}}" class="status-reason">{{item.reasonLabel}}</text>
              <view wx:if="{{item.canCancel || item.canRevoke}}" class="request-actions"
                ><view
                  wx:if="{{item.canCancel}}"
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleCancel"
                  >撤销申请</view
                ><view
                  wx:if="{{item.canRevoke}}"
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleRevoke"
                  >撤销加扣班</view
                ></view
              >
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <ui-sheet
    wx:if="{{requestFormVisible}}"
    visible="{{requestFormVisible}}"
    title="发起加扣班"
    close-label="完成"
    swipe-dismiss="{{!requestBusy}}"
    bind:close="handleCloseRequestForm"
  >
      <scroll-view class="workflow-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}"
        ><view class="sheet-body">
          <view class="sheet-form-intro"
            ><text class="form-section-title">安排成员代值我的班次</text></view
          >
          <view wx:if="{{requestErrorMessage}}" class="native-alert is-danger"
            ><text>{{requestErrorMessage}}</text></view
          >
          <view class="field-block"
            ><text class="field-label">月份</text
            ><workflow-picker
              mode="month"
              value="{{businessMonth}}"
              display-value="{{businessMonth}}"
              title="月份"
              bindchange="handleMonthChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">我的班次</text
            ><workflow-picker
              mode="selector"
              options="{{myAssignmentOptions}}"
              selected-index="{{myAssignmentIndex}}"
              display-value="{{myAssignmentIndex >= 0 ? myAssignmentOptions[myAssignmentIndex].label : ''}}"
              placeholder="选择我的班次"
              title="我的班次"
              bindchange="handleMyAssignmentChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">加班成员</text
            ><workflow-picker
              mode="selector"
              options="{{overtimeMemberOptions}}"
              selected-index="{{overtimeMemberIndex}}"
              display-value="{{overtimeMemberIndex >= 0 ? overtimeMemberOptions[overtimeMemberIndex].label : ''}}"
              placeholder="选择加班成员"
              title="加班成员"
              bindchange="handleOvertimeMemberChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">原因（选填）</text
            ><input
              class="native-reason-input"
              value="{{reason}}"
              maxlength="200"
              placeholder="记录加扣班原因"
              bindinput="handleReasonInput"
            />
          </view>
          <view wx:if="{{requestPreviewReady}}" class="preview-card"
            ><text class="preview-title">加扣班预览</text
            ><text>{{requestPreviewSummary}}</text></view
          >
          <view wx:for="{{requestPreviewConflicts}}" wx:key="id" class="native-alert is-danger"
            ><text>{{item.message}}</text></view
          >
        </view>
      </scroll-view>
    <view class="workflow-sheet-footer">
      <view class="form-actions"
        ><view class="web-button is-outline" aria-role="button" bindtap="handlePreview"
          >生成预览</view
        ><view class="web-button is-primary" aria-role="button" bindtap="handleSubmit"
          >{{requestBusy ? '正在提交' : '提交加扣班'}}</view
        ></view
      >
    </view>
  </ui-sheet>

  <ui-sheet
    wx:if="{{adminFormVisible}}"
    visible="{{adminFormVisible}}"
    title="管理员直接代值"
    close-label="完成"
    swipe-dismiss="{{!adminBusy}}"
    bind:close="handleCloseAdminForm"
  >
      <scroll-view class="workflow-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}"
        ><view class="sheet-body">
          <view class="sheet-form-intro">
            <text class="form-section-title">选择代值班次与成员</text>
            <text class="workflow-form-hint">直接生效，不需要双方确认或审批；原因选填。</text>
          </view>
          <view wx:if="{{adminErrorMessage}}" class="native-alert is-danger"
            ><text>{{adminErrorMessage}}</text></view
          >
          <view class="field-block"
            ><text class="field-label">月份</text
            ><workflow-picker
              mode="month"
              value="{{businessMonth}}"
              display-value="{{businessMonth}}"
              title="月份"
              bindchange="handleMonthChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">被代班班次</text
            ><workflow-picker
              mode="selector"
              options="{{adminAssignmentOptions}}"
              selected-index="{{adminAssignmentIndex}}"
              display-value="{{adminAssignmentIndex >= 0 ? adminAssignmentOptions[adminAssignmentIndex].label : ''}}"
              placeholder="选择被代班班次"
              title="被代班班次"
              bindchange="handleAdminAssignmentChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">加班成员</text
            ><workflow-picker
              mode="selector"
              options="{{adminOvertimeMemberOptions}}"
              selected-index="{{adminOvertimeMemberIndex}}"
              display-value="{{adminOvertimeMemberIndex >= 0 ? adminOvertimeMemberOptions[adminOvertimeMemberIndex].label : ''}}"
              placeholder="选择加班成员"
              title="加班成员"
              bindchange="handleAdminOvertimeMemberChange"
            ></workflow-picker
          ></view>
          <view class="field-block"
            ><text class="field-label">原因（选填）</text
            ><input
              class="native-reason-input"
              value="{{adminReason}}"
              maxlength="200"
              placeholder="记录管理员代值原因"
              bindinput="handleAdminReasonInput"
            />
          </view>
          <view wx:if="{{adminPreviewReady}}" class="preview-card"
            ><text class="preview-title">直接代值预览</text
            ><text>{{adminPreviewSummary}}</text></view
          >
          <view wx:for="{{adminPreviewConflicts}}" wx:key="id" class="native-alert is-danger"
            ><text>{{item.message}}</text></view
          >
        </view>
      </scroll-view>
    <view class="workflow-sheet-footer">
      <view class="form-actions"
        ><view class="web-button is-outline" aria-role="button" bindtap="handleAdminPreview"
          >生成预览</view
        ><view class="web-button is-primary" aria-role="button" bindtap="handleAdminSubmit"
          >{{adminBusy ? '正在执行' : '直接执行代值'}}</view
        ></view
      >
    </view>
  </ui-sheet>

  <ui-sheet
    wx:if="{{revokeVisible}}"
    visible="{{revokeVisible}}"
    title="撤销加扣班"
    close-label="关闭"
    swipe-dismiss="{{!revokeBusy}}"
    bind:close="handleCloseRevoke"
  >
    <view class="workflow-sheet-short-content">
      <text class="workflow-form-hint">撤销后恢复原扣班成员。</text>
      <view wx:if="{{revokeErrorMessage}}" class="native-alert is-danger"
        ><text>{{revokeErrorMessage}}</text></view
      >
      <view class="field-block"
        ><text class="field-label">撤销原因（选填）</text
        ><textarea
          class="native-textarea"
          value="{{revokeReason}}"
          maxlength="200"
          placeholder="记录撤销原因"
          bindinput="handleRevokeReasonInput"
        /></view
      >
    </view>
    <view class="workflow-sheet-footer">
      <view class="web-button is-danger-outline" aria-role="button" bindtap="handleConfirmRevoke"
        >{{revokeBusy ? '正在撤销' : '确认撤销加扣班'}}</view
      >
    </view>
  </ui-sheet>
</view>
