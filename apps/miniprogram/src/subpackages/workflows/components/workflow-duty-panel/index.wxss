@import '../workflow-swap-panel/index.wxss';

.duty-page.is-compact {
  letter-spacing: 0;
}

.duty-page .page-content {
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
}

.duty-page.is-embedded .page-content {
  padding-bottom: 20px;
}

.web-button {
  min-height: 44px;
}

.duty-heading {
  display: flex;
  min-width: 0;
}

.duty-page.is-compact .heading-actions,
.duty-page.is-compact .form-actions {
  flex-direction: column;
}

.duty-page.is-compact .heading-actions .web-button,
.duty-page.is-compact .form-actions .web-button {
  width: 100%;
}
