<view
  class="leave-page {{viewportClass}} {{embedded ? 'is-embedded' : ''}}"
  bindtap="handlePanelBackgroundTap"
  bind:pickerrequestopen="handlePickerRequestOpen"
>
  <view wx:if="{{!embedded}}" class="mini-header" style="{{shellHeaderStyle}}">
    <view
      class="header-back"
      hover-class="is-pressed"
      aria-role="button"
      aria-label="返回排班台"
      bindtap="handleBack"
    >
      <image src="/assets/icons/web-chevron-left.svg" mode="aspectFit" />
    </view>
    <view class="header-title">
      <text class="header-title-main">请假与审批</text>
      <text class="header-title-sub">{{currentGroupName}} · {{currentGroupRole}}</text>
    </view>
  </view>

  <scroll-view
    class="leave-scroll"
    style="{{embedded ? 'height:100%;' : pageScrollStyle}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="page-content">
      <view wx:if="{{state === 'loading'}}" class="page-state-card">
        <view class="native-spinner"></view>
        <text class="state-title">正在加载请假数据</text>
        <text class="state-copy">正在同步申请、审批和重排策略。</text>
      </view>

      <view wx:elif="{{state === 'error'}}" class="page-state-card">
        <view class="native-alert is-danger">
          <text class="alert-title">请假数据暂时无法加载</text>
          <text>{{errorMessage}}</text>
        </view>
        <view
          class="web-button is-primary"
          hover-class="is-pressed"
          aria-role="button"
          bindtap="handleRetry"
          >重新加载</view
        >
      </view>

      <view wx:elif="{{state === 'ready'}}" class="leave-panel">
        <view class="panel-heading">
          <view class="heading-copy">
            <text class="page-title">请假与审批</text>
            <text>查看请假状态，或处理会影响排班的申请。</text>
          </view>
          <view
            class="web-button is-primary create-action"
            hover-class="is-pressed"
            aria-role="button"
            bindtap="handleOpenForm"
            >新建请假</view
          >
        </view>

        <view wx:if="{{errorMessage}}" class="native-alert is-danger">
          <text class="alert-title">操作未完成</text><text>{{errorMessage}}</text>
        </view>
        <view wx:if="{{infoMessage}}" class="native-alert is-success">
          <text class="alert-title">操作完成</text><text>{{infoMessage}}</text>
        </view>

        <view wx:if="{{canApprove}}" class="workflow-tabs" aria-role="tablist">
          <view
            class="workflow-tab {{activeTab === 'mine' ? 'is-active' : ''}}"
            data-tab="mine"
            aria-role="tab"
            aria-selected="{{activeTab === 'mine'}}"
            bindtap="handleTabChange"
            ><text>我的请假</text><text class="count-badge">{{myCount}}</text></view
          >
          <view
            class="workflow-tab {{activeTab === 'review' ? 'is-active' : ''}}"
            data-tab="review"
            aria-role="tab"
            aria-selected="{{activeTab === 'review'}}"
            bindtap="handleTabChange"
            ><text>待我审批</text
            ><text wx:if="{{pendingApprovalCount > 0}}" class="count-badge is-primary"
              >{{pendingApprovalCount}}</text
            ></view
          >
        </view>

        <view wx:if="{{activeTab === 'mine'}}" class="workflow-section">
          <view class="section-heading">
            <view
              ><text class="section-title">我的请假</text><text>跟进提交后的审批状态。</text></view
            >
            <text>{{myCount}} 项</text>
          </view>
          <view wx:if="{{myRequests.length === 0}}" class="empty-card">
            <text class="empty-title">暂无请假记录</text>
            <text>需要离岗时，可在这里新建请假。</text>
          </view>
          <view wx:else class="request-list">
            <view wx:for="{{myRequests}}" wx:key="id" class="request-card">
              <view class="request-card-heading">
                <view class="request-person"
                  ><text>{{item.memberName}}</text><text>{{item.typeLabel}}</text></view
                >
                <text class="status-chip {{item.statusTone}}">{{item.statusLabel}}</text>
              </view>
              <view class="request-detail"><text>时间</text><text>{{item.rangeLabel}}</text></view>
              <view class="request-detail"><text>原因</text><text>{{item.reasonLabel}}</text></view>
              <view wx:if="{{item.canCancel || item.canRevoke}}" class="request-actions">
                <view
                  wx:if="{{item.canCancel}}"
                  class="web-button is-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleCancel"
                  >取消申请</view
                >
                <view
                  wx:if="{{item.canRevoke}}"
                  class="web-button is-danger-outline"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleRevoke"
                  >撤销请假</view
                >
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{canApprove && activeTab === 'review'}}" class="review-content">
          <view class="strategy-card">
            <view class="strategy-copy">
              <text class="section-title">群组默认重排策略</text>
              <text>审批时仍可对单个申请覆盖此默认策略。</text>
            </view>
            <workflow-picker
              mode="selector"
              options="{{strategyOptions}}"
              selected-index="{{strategyIndex}}"
              display-value="{{strategyOptions[strategyIndex].label}}"
              title="群组默认重排策略"
              disabled="{{strategyBusy}}"
              bindchange="handleStrategyChange"
            ></workflow-picker>
          </view>

          <view class="workflow-section">
            <view class="section-heading">
              <view
                ><text class="section-title">待审批</text
                ><text>先查看对排班的影响，再作出决定。</text></view
              >
              <text>{{pendingApprovalCount}} 项</text>
            </view>
            <view wx:if="{{pendingApprovals.length === 0}}" class="empty-card">
              <text class="empty-title">暂无待审批申请</text><text>新的请假申请会显示在这里。</text>
            </view>
            <view wx:else class="request-list">
              <view wx:for="{{pendingApprovals}}" wx:key="id" class="request-card is-featured">
                <view class="request-card-heading">
                  <view class="request-person"
                    ><text>{{item.memberName}}</text><text>{{item.typeLabel}}</text></view
                  >
                  <text class="status-chip is-warning">{{item.statusLabel}}</text>
                </view>
                <view class="request-detail"
                  ><text>时间</text><text>{{item.rangeLabel}}</text></view
                >
                <view class="request-detail"
                  ><text>原因</text><text>{{item.reasonLabel}}</text></view
                >
                <view
                  class="web-button is-primary"
                  data-id="{{item.id}}"
                  aria-role="button"
                  bindtap="handleOpenApproval"
                  >预览并审批</view
                >
              </view>
            </view>
          </view>

          <view wx:if="{{decidedApprovals.length > 0}}" class="workflow-section">
            <view class="section-heading"
              ><text class="section-title">已处理</text
              ><text>{{decidedApprovals.length}} 项</text></view
            >
            <view class="request-list">
              <view wx:for="{{decidedApprovals}}" wx:key="id" class="request-card is-muted">
                <view class="request-card-heading">
                  <view class="request-person"
                    ><text>{{item.memberName}}</text><text>{{item.typeLabel}}</text></view
                  >
                  <text class="status-chip {{item.statusTone}}">{{item.statusLabel}}</text>
                </view>
                <view class="request-detail"
                  ><text>时间</text><text>{{item.rangeLabel}}</text></view
                >
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view hidden="{{!formVisible}}" class="sheet-layer">
    <view class="sheet-scrim" aria-role="button" bindtap="handleCloseForm"></view>
    <view class="native-sheet request-sheet" aria-role="dialog" aria-label="新建请假">
      <view class="sheet-handle"></view>
      <view class="sheet-heading">
        <view><text class="sheet-title">新建请假</text></view>
        <view class="sheet-finish" aria-role="button" bindtap="handleCloseForm">完成</view>
      </view>
      <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="sheet-body">
          <view wx:if="{{formErrorMessage}}" class="native-alert is-danger"
            ><text>{{formErrorMessage}}</text></view
          >
          <view class="leave-form-intro">
            <text class="form-section-title">请假信息</text>
            <text class="form-intro">请假按整天计算；提交前会检查已发布的未来班次。</text>
          </view>
          <view class="field-block">
            <text class="field-label">请假类型</text>
            <workflow-picker
              mode="selector"
              options="{{leaveTypeOptions}}"
              selected-index="{{leaveTypeIndex}}"
              display-value="{{leaveTypeOptions[leaveTypeIndex].label}}"
              title="请假类型"
              bindchange="handleLeaveTypeChange"
            ></workflow-picker>
          </view>
          <view class="date-fields">
            <view class="field-block">
              <text class="field-label">开始日期</text>
              <workflow-picker
                mode="date"
                min="{{todayDate}}"
                value="{{startDate}}"
                display-value="{{startDateDisplay}}"
                title="开始日期"
                bindchange="handleStartDateChange"
              ></workflow-picker>
            </view>
            <view class="field-block">
              <text class="field-label">结束日期</text>
              <workflow-picker
                mode="date"
                min="{{endDateMin}}"
                value="{{endDate}}"
                display-value="{{endDateDisplay}}"
                title="结束日期"
                bindchange="handleEndDateChange"
              ></workflow-picker>
            </view>
          </view>
          <view class="day-count-hint"
            >{{startDateDisplay}} 至 {{endDateDisplay}}，共 {{leaveDayCount}} 天</view
          >
          <view class="affected-block" aria-busy="{{affectedShiftsLoading}}">
            <text wx:if="{{affectedShiftsLoading}}" class="affected-hint"
              >正在检查请假期间班次…</text
            >
            <view wx:elif="{{affectedShifts.length > 0}}">
              <text class="affected-title">涉及 {{affectedShifts.length}} 个已发布班次</text>
              <view class="affected-list">
                <view wx:for="{{affectedShifts}}" wx:key="id" class="affected-row"
                  ><text>{{item.detail}}</text
                  ><text class="affected-status is-{{item.tone}}">{{item.statusLabel}}</text></view
                >
              </view>
              <text wx:if="{{affectedWarningMessage}}" class="affected-warning"
                >{{affectedWarningMessage}}</text
              >
            </view>
            <text wx:else class="affected-hint"
              >{{affectedShiftMessage || '请假期间没有已发布的未来班次。'}}</text
            >
          </view>
          <view class="field-block reason-field">
            <text class="field-label">原因说明（选填）</text>
            <textarea
              class="native-textarea leave-reason-field"
              value="{{reason}}"
              maxlength="1000"
              placeholder="请填写请假原因"
              bindinput="handleReasonInput"
            />
          </view>
          <view
            class="web-button is-primary leave-submit {{formBusy ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-busy="{{formBusy}}"
            bindtap="handleSubmitLeave"
            >{{formBusy ? '正在提交' : '提交请假'}}</view
          >
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{approvalVisible}}" class="sheet-layer">
    <view class="sheet-scrim" aria-role="button" bindtap="handleCloseApproval"></view>
    <view class="native-sheet approval-sheet" aria-role="dialog" aria-label="预览并审批">
      <view class="sheet-handle"></view>
      <view class="sheet-heading">
        <view><text class="sheet-title">预览并审批</text><text>{{approvalSummary}}</text></view>
        <view class="sheet-close" aria-role="button" bindtap="handleCloseApproval">×</view>
      </view>
      <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="sheet-body">
          <view wx:if="{{approvalErrorMessage}}" class="native-alert is-danger"
            ><text>{{approvalErrorMessage}}</text></view
          >
          <view wx:if="{{approvalBusy && !approvalPreviewReady}}" class="preview-loading"
            ><view class="native-spinner"></view><text>正在生成请假预览</text></view
          >
          <view wx:if="{{approvalPreviewReady}}" class="approval-preview">
            <view class="impact-count">请假期间涉及 {{approvalShiftCount}} 个已发布班次。</view>
            <view wx:if="{{approvalHasAffectedAssignments}}" class="field-block">
              <text class="field-label">重排策略</text>
              <workflow-picker
                mode="selector"
                options="{{strategyOptions}}"
                selected-index="{{approvalStrategyIndex}}"
                display-value="{{strategyOptions[approvalStrategyIndex].label}}"
                title="重排策略"
                bindchange="handleApprovalStrategyChange"
              ></workflow-picker>
            </view>
            <view
              wx:if="{{approvalHasAffectedAssignments}}"
              class="web-button is-outline"
              aria-role="button"
              bindtap="handleRefreshApproval"
              >生成重排预览</view
            >
            <view wx:if="{{approvalStatistics}}" class="statistics-card"
              >统计变化：{{approvalStatistics}}</view
            >
            <view wx:for="{{approvalShifts}}" wx:key="id" class="impact-row is-primary"
              ><text>{{item.detail}}</text></view
            >
            <view wx:for="{{approvalAlerts}}" wx:key="id" class="native-alert is-{{item.tone}}"
              ><text>{{item.message}}</text></view
            >
            <checkbox-group bindchange="handleApprovalAcknowledge">
              <label wx:if="{{approvalRequiresAcknowledge}}" class="acknowledge-field">
                <checkbox value="acknowledged" checked="{{approvalAcknowledged}}" color="#1F5AA6" />
                <text>我已知晓冲突和空缺，确认按预览结果批准该请假。</text>
              </label>
            </checkbox-group>
            <view class="approval-actions">
              <view class="web-button is-danger-outline" aria-role="button" bindtap="handleReject"
                >驳回</view
              >
              <view class="web-button is-primary" aria-role="button" bindtap="handleApprove"
                >{{approvalHasAffectedAssignments ? '批准并重排' : '批准'}}</view
              >
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
