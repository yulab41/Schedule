<wxs module="directorySheetGesture" src="./filter-sheet-drag.wxs"></wxs>

<template name="directory-pane">
  <scroll-view
    class="directory-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{pane.mainScrollTop}}"
    data-directory-kind="{{pane.directoryKind}}"
    bindscroll="handleMainScroll"
    aria-label="{{pane.title}}"
  >
    <view class="page-content">
      <view class="directory-content">
        <text wx:if="{{pane.facetsLoading}}" class="visually-hidden">正在读取通讯录</text>

        <view wx:if="{{pane.state === 'disabled'}}" class="page-state-card insights-disabled">
          <view class="state-mark">—</view>
          <text class="state-title">通讯录暂未开放</text>
          <text class="state-copy">当前版本未开启通讯录能力，不会读取目录或号码。</text>
        </view>

        <block wx:else>
          <view class="wayfinding">
            <view class="wayfinding-header">
              <text class="wayfinding-title">院区导览</text>
              <view class="wayfinding-actions">
                <view
                  wx:if="{{pane.activeFilterCount > 0}}"
                  class="clear-filter-action"
                  aria-role="button"
                  aria-label="清除全部筛选"
                  data-directory-kind="{{pane.directoryKind}}"
                  bindtap="handleClearFilters"
                  >清除全部</view
                >
                <view
                  wx:if="{{!pane.facetsLoading && !pane.facetsErrorMessage}}"
                  class="filter-open-action"
                  aria-role="button"
                  aria-label="打开筛选，已选{{pane.activeFilterCount}}项"
                  data-directory-kind="{{pane.directoryKind}}"
                  bindtap="handleOpenFilters"
                >
                  <image
                    class="filter-open-icon"
                    src="/assets/icons/ui-filter-funnel.svg"
                    mode="aspectFit"
                    aria-hidden="true"
                  />
                  <text class="filter-open-copy">全部筛选</text>
                  <text wx:if="{{pane.activeFilterCount > 0}}" class="filter-count"
                    >{{pane.activeFilterCount}}</text
                  >
                </view>
                <view
                  wx:else
                  class="filter-open-action is-disabled"
                  aria-role="button"
                  aria-disabled="true"
                  aria-label="{{pane.facetsLoading ? '筛选条件正在加载' : '筛选条件加载失败'}}"
                >
                  <image
                    class="filter-open-icon"
                    src="/assets/icons/ui-filter-funnel.svg"
                    mode="aspectFit"
                    aria-hidden="true"
                  />
                  <text class="filter-open-copy">全部筛选</text>
                </view>
              </view>
            </view>
            <view
              wx:if="{{pane.facetsLoading}}"
              class="wayfinding-ribbon wayfinding-loading"
              aria-hidden="true"
            >
              <view class="wayfinding-stop"></view>
              <view class="wayfinding-stop"></view>
              <view class="wayfinding-stop"></view>
              <view class="wayfinding-stop"></view>
              <view class="wayfinding-stop"></view>
              <view class="wayfinding-stop"></view>
            </view>
            <view wx:elif="{{pane.facetsErrorMessage}}" class="wayfinding-state" aria-role="alert">
              <text>{{pane.facetsErrorMessage}}</text>
              <view
                class="retry-action"
                aria-role="button"
                data-directory-kind="{{pane.directoryKind}}"
                bindtap="handleRetry"
                >重新加载筛选</view
              >
            </view>
            <view wx:elif="{{pane.guideStops.length > 0}}" class="wayfinding-ribbon">
              <view
                wx:for="{{pane.guideStops}}"
                wx:for-item="section"
                wx:for-index="sectionIndex"
                wx:key="key"
                class="wayfinding-stop {{section.selected ? 'is-selected' : ''}}"
                aria-role="button"
                aria-pressed="{{section.selected}}"
                data-directory-kind="{{pane.directoryKind}}"
                data-filter="{{section.key}}"
                bindtap="handleOpenFilterAt"
              >
                <text class="stop-index">{{sectionIndex + 1}}</text>
                <view class="stop-copy">
                  <text>{{section.label}}</text>
                  <text>{{section.selectedLabel}}</text>
                </view>
              </view>
            </view>
            <text wx:else class="wayfinding-empty">当前无需筛选</text>
          </view>

          <view class="directory-search" aria-role="search">
            <image
              class="search-icon"
              src="/assets/icons/ui-search.svg"
              mode="aspectFit"
              aria-hidden="true"
            />
            <input
              class="search-input"
              value="{{pane.searchQuery}}"
              maxlength="100"
              confirm-type="search"
              placeholder-class="search-placeholder"
              placeholder="{{pane.directoryKind === 'employee' ? '姓名可自动搜索；拼音、工号或电话输入后按键盘搜索' : '名称可自动搜索；拼音或电话输入后按键盘搜索'}}"
              data-directory-kind="{{pane.directoryKind}}"
              bindinput="handleSearchInput"
              bindconfirm="handleSearch"
            />
            <view
              wx:if="{{pane.searchQuery.length > 0}}"
              class="search-clear"
              aria-role="button"
              aria-label="清空搜索"
              data-directory-kind="{{pane.directoryKind}}"
              bindtap="handleClearSearch"
            >
              <image src="/assets/icons/ui-close.svg" mode="aspectFit" />
            </view>
          </view>

          <view wx:if="{{pane.errorMessage}}" class="directory-error" aria-role="alert">
            <view class="directory-error-copy">
              <text class="directory-error-title">{{pane.title}}未能更新</text>
              <text class="directory-error-message">{{pane.errorMessage}}</text>
            </view>
            <view
              class="retry-action"
              aria-role="button"
              data-directory-kind="{{pane.directoryKind}}"
              bindtap="handleRetry"
              >{{pane.retryKind === 'pagination' ? '重试本页' : '重新加载'}}</view
            >
            <view
              wx:if="{{pane.canRefreshFromStart}}"
              class="retry-action is-secondary"
              aria-role="button"
              data-directory-kind="{{pane.directoryKind}}"
              bindtap="handleRefreshFromStart"
              >从头刷新</view
            >
          </view>

          <view wx:if="{{pane.hasCriteria}}" class="directory-search-results">
            <text class="result-summary" aria-live="polite">
              {{pane.resultSummary}}{{pane.searching && pane.entries.length > 0 ? ' · 正在更新' :
              ''}}
            </text>

            <view
              wx:if="{{pane.searching && pane.entries.length === 0}}"
              class="directory-skeleton"
              aria-hidden="true"
            >
              <view></view><view></view><view></view><view></view>
            </view>

            <view wx:elif="{{pane.entries.length > 0}}" class="directory-results">
              <directory-entry-card
                wx:for="{{pane.entries}}"
                wx:for-item="entry"
                wx:for-index="entryIndex"
                wx:key="id"
                entry="{{entry}}"
                disabled="{{pane.interactionDisabled}}"
                large-text="{{largeText}}"
                show-divider="{{entryIndex > 0}}"
                data-directory-kind="{{pane.directoryKind}}"
                bindfavoritechange="handleDirectoryCardFavorite"
                binddirectorycall="handleDirectoryCardCall"
              ></directory-entry-card>
            </view>

            <view wx:elif="{{!pane.searching && !pane.errorMessage}}" class="empty-card">
              <image
                class="empty-search-icon"
                src="/assets/icons/ui-search.svg"
                mode="aspectFit"
                aria-hidden="true"
              />
              <text class="state-title">没有找到匹配号码</text>
              <text class="state-copy">可缩短搜索词，或清除部分层级筛选后重试。</text>
              <view
                class="empty-reset"
                aria-role="button"
                data-directory-kind="{{pane.directoryKind}}"
                bindtap="handleResetSearch"
                >清空搜索和筛选</view
              >
            </view>

            <view wx:if="{{pane.hasMore}}" class="load-more">
              <ui-button
                variant="secondary"
                label="{{pane.loadingMore ? '正在加载' : '加载更多'}}"
                loading="{{pane.loadingMore}}"
                disabled="{{pane.loadingMore || pane.interactionDisabled}}"
                data-directory-kind="{{pane.directoryKind}}"
                bindpress="handleLoadMore"
              ></ui-button>
            </view>
          </view>

          <view
            wx:if="{{pane.prioritySections.length > 0}}"
            class="directory-priority"
            aria-label="收藏和常用通讯录"
          >
            <view
              wx:for="{{pane.prioritySections}}"
              wx:for-item="prioritySection"
              wx:key="key"
              class="priority-section"
            >
              <view class="priority-heading">
                <text>{{prioritySection.title}}</text>
                <text>{{prioritySection.entries.length}} 项</text>
              </view>
              <view class="directory-results">
                <directory-entry-card
                  wx:for="{{prioritySection.entries}}"
                  wx:for-item="entry"
                  wx:for-index="entryIndex"
                  wx:key="id"
                  entry="{{entry}}"
                  large-text="{{largeText}}"
                  show-divider="{{entryIndex > 0}}"
                  data-directory-kind="{{pane.directoryKind}}"
                  bindfavoritechange="handleDirectoryCardFavorite"
                  binddirectorycall="handleDirectoryCardCall"
                ></directory-entry-card>
              </view>
            </view>
          </view>

          <text class="privacy-note"
            >{{pane.directoryKind === 'employee' ? '员工联系方式' :
            '院内联系方式'}}仅供工作使用，请勿向院外转发。</text
          >
        </block>
      </view>
    </view>
  </scroll-view>
</template>

<template name="directory-filter-sheet">
  <view wx:if="{{sheet.open}}" class="sheet-layer" catchtouchmove="preventTouchMove">
    <view
      id="directory-filter-sheet-scrim"
      class="sheet-scrim"
      aria-role="button"
      aria-label="关闭筛选"
      data-directory-kind="{{sheet.directoryKind}}"
      bindtap="handleCloseFilters"
    ></view>
    <view
      id="directory-filter-sheet-panel"
      class="filter-sheet"
      style="{{filterSheetStyle}}"
      aria-role="dialog"
      aria-label="筛选{{sheet.title}}"
    >
      <view
        class="sheet-drag-region"
        bindtouchstart="{{directorySheetGesture.touchStart}}"
        bindtouchmove="{{directorySheetGesture.touchMove}}"
        bindtouchend="{{directorySheetGesture.touchEnd}}"
        bindtouchcancel="{{directorySheetGesture.touchCancel}}"
      >
        <view class="sheet-handle" aria-hidden="true"></view>
      </view>
      <view class="sheet-heading">
        <text class="sheet-title">筛选{{sheet.title}}</text>
        <view
          class="sheet-finish"
          aria-role="button"
          aria-label="完成筛选"
          data-directory-kind="{{sheet.directoryKind}}"
          bindtap="handleCloseFilters"
          >完成</view
        >
      </view>
      <view
        class="sheet-reset-action {{sheet.activeFilterCount === 0 ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{sheet.activeFilterCount === 0}}"
        data-directory-kind="{{sheet.directoryKind}}"
        bindtap="handleClearFilters"
      >
        <image src="/assets/icons/ui-filter-clear.svg" mode="aspectFit" />
        <text>清除全部筛选</text>
        <text wx:if="{{sheet.activeFilterCount > 0}}" class="sheet-reset-count"
          >已选 {{sheet.activeFilterCount}} 项</text
        >
      </view>
      <text wx:if="{{sheet.filterAdjustmentMessage}}" class="visually-hidden" aria-live="polite"
        >{{sheet.filterAdjustmentMessage}}</text
      >
      <scroll-view
        class="sheet-scroll"
        type="list"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        scroll-with-animation="{{true}}"
        scroll-into-view="{{sheet.scrollTarget}}"
        scroll-top="{{sheet.scrollTop}}"
        data-directory-kind="{{sheet.directoryKind}}"
        bindscroll="handleSheetScroll"
      >
        <view class="sheet-body">
          <view class="directory-filter-grid">
            <view wx:if="{{sheet.emptyMessage}}" class="sheet-empty-state">
              <text>{{sheet.emptyMessage}}</text>
              <text>当前通讯录没有需要进一步缩小的层级。</text>
            </view>
            <view
              wx:for="{{sheet.sections}}"
              wx:for-item="section"
              wx:key="key"
              id="directory-filter-{{sheet.directoryKind}}-{{section.key}}"
              class="filter-section"
            >
              <view
                class="filter-section-toggle"
                aria-role="button"
                aria-expanded="{{section.expanded}}"
                data-directory-kind="{{sheet.directoryKind}}"
                data-filter="{{section.key}}"
                bindtap="handleToggleFilterSection"
              >
                <view class="filter-section-copy">
                  <text>{{section.label}}</text>
                  <text>{{section.selectedLabel}} · {{section.optionCount}} 项</text>
                </view>
                <view class="filter-chevron {{section.expanded ? 'is-expanded' : ''}}"
                  ><image src="/assets/icons/ui-chevron-right-muted.svg" mode="aspectFit" /></view
                >
              </view>
              <view wx:if="{{section.expanded}}" class="filter-options">
                <view
                  wx:for="{{section.options}}"
                  wx:for-item="option"
                  wx:key="value"
                  class="filter-option {{option.value === section.selectedValue ? 'is-selected' : ''}}"
                  aria-role="button"
                  aria-pressed="{{option.value === section.selectedValue}}"
                  data-directory-kind="{{sheet.directoryKind}}"
                  data-filter="{{section.key}}"
                  data-value="{{option.value}}"
                  bindtap="handleFilterOption"
                >
                  <text>{{option.label}}</text>
                  <text wx:if="{{option.value}}" class="option-count">{{option.count}}</text>
                </view>
                <text wx:if="{{section.optionCount === 0}}" class="filter-options-empty"
                  >当前上级下无可选项</text
                >
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<view
  class="directory-page {{embedded ? 'is-embedded' : ''}} {{viewportClass}} {{largeText ? 'is-large-text' : ''}}"
>
  <view wx:if="{{!embedded}}" class="mini-header" style="{{shellHeaderStyle}}">
    <view
      class="header-back"
      hover-class="is-pressed"
      aria-role="button"
      aria-label="返回更多工具"
      bindtap="handleBack"
    >
      <image src="/assets/icons/ui-chevron-left.svg" mode="aspectFit" />
    </view>
    <text class="header-title-main">通讯录</text>
  </view>

  <view class="directory-shell" style="{{shellContentStyle}}">
    <view
      class="mode-rail {{directoryKind === 'employee' ? 'is-employee' : ''}}"
      aria-role="tablist"
      aria-label="通讯录范围"
    >
      <view class="mode-indicator"></view>
      <view
        class="mode-tab {{directoryKind === 'internal' ? 'is-active' : ''}}"
        hover-class="is-pressed"
        aria-role="tab"
        aria-selected="{{directoryKind === 'internal'}}"
        bindtap="handleInternalMode"
      >
        <view
          class="mode-icon department-icon {{departmentAnimating ? 'is-animating' : ''}}"
          aria-hidden="true"
        >
          <image
            class="mode-icon-image"
            src="{{directoryKind === 'internal' ? '/assets/icons/ui-department.svg' : '/assets/icons/ui-department-muted.svg'}}"
            mode="aspectFit"
          />
        </view>
        <text>科室</text>
      </view>
      <view
        class="mode-tab {{directoryKind === 'employee' ? 'is-active' : ''}}"
        hover-class="is-pressed"
        aria-role="tab"
        aria-selected="{{directoryKind === 'employee'}}"
        bindtap="handleEmployeeMode"
      >
        <view
          class="mode-icon people-icon {{peopleAnimating ? 'is-animating' : ''}}"
          aria-hidden="true"
        >
          <image
            class="mode-icon-image mode-icon-image-primary"
            src="{{directoryKind === 'employee' ? '/assets/icons/ui-people-primary.svg' : '/assets/icons/ui-people-primary-muted.svg'}}"
            mode="aspectFit"
          />
          <image
            class="mode-icon-image mode-icon-image-secondary"
            src="{{directoryKind === 'employee' ? '/assets/icons/ui-people-secondary.svg' : '/assets/icons/ui-people-secondary-muted.svg'}}"
            mode="aspectFit"
          />
        </view>
        <text>人员</text>
      </view>
    </view>

    <swiper
      class="directory-mode-swiper"
      current="{{activeModeIndex}}"
      duration="{{swiperDuration}}"
      easing-function="easeOutCubic"
      skip-hidden-item-layout="{{false}}"
      disable-touch="{{filterSheetOpen}}"
      bindchange="handleModeSwiperChange"
      aria-label="科室与人员通讯录，可左右滑动切换"
    >
      <swiper-item class="directory-mode-item" aria-hidden="{{directoryKind !== 'internal'}}">
        <template is="directory-pane" data="{{pane: internalPane, largeText: largeText}}" />
      </swiper-item>
      <swiper-item class="directory-mode-item" aria-hidden="{{directoryKind !== 'employee'}}">
        <template is="directory-pane" data="{{pane: employeePane, largeText: largeText}}" />
      </swiper-item>
    </swiper>
  </view>

  <template
    is="directory-filter-sheet"
    data="{{sheet: activeSheet, filterSheetStyle: filterSheetStyle}}"
  />
</view>
