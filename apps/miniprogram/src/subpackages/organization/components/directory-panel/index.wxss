@import "../../../../styles/ui-icon-motion.wxss";

.directory-page {
  --directory-accent: #0a66d5;
  --directory-accent-soft: #eaf3ff;
  --directory-canvas: #f7f9fc;
  --directory-surface: #ffffff;
  --directory-text: #17202a;
  --directory-muted: #667386;
  --directory-border: #dce3eb;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: var(--directory-text);
  background:
    radial-gradient(circle at 50% -120px, rgba(10, 102, 213, 0.08), transparent 360px),
    var(--directory-canvas);
  font-family: var(--ui-font-family-system);
  font-size: var(--ui-font-size-md);
  line-height: var(--ui-line-height-normal);
}

.mini-header {
  box-sizing: border-box;
  position: relative;
  display: flex;
  padding-right: 14px;
  padding-left: 8px;
  align-items: center;
  background: var(--directory-surface);
  border-bottom: 1px solid var(--directory-border);
}

.header-back {
  display: flex;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
}

.header-back.is-pressed {
  background: #edf1f6;
}

.header-back image {
  width: 20px;
  height: 20px;
}

.header-title-main {
  padding-left: 4px;
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-tight);
}

.directory-shell {
  display: flex;
  width: 100%;
  min-height: 0;
  overflow: hidden;
  flex-direction: column;
}

.mode-rail {
  position: relative;
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 52px;
  margin: 10px 14px 12px;
  padding: 4px;
  gap: 3px;
  background: rgba(224, 229, 236, 0.82);
  border: 1px solid rgba(203, 212, 223, 0.88);
  border-radius: 15px;
  box-shadow:
    inset 0 1px 2px rgba(42, 55, 72, 0.08),
    0 10px 30px rgba(43, 59, 80, 0.05);
}

.mode-indicator {
  position: absolute;
  z-index: 0;
  top: 4px;
  bottom: 4px;
  left: 4px;
  width: calc(50% - 5.5px);
  background: var(--directory-surface);
  border-radius: 11px;
  box-shadow:
    0 1px 2px rgba(22, 32, 42, 0.12),
    0 5px 16px rgba(39, 58, 82, 0.08);
  pointer-events: none;
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.mode-rail.is-employee .mode-indicator {
  transform: translateX(calc(100% + 3px));
}

.mode-tab {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 0 16px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: var(--ui-color-directory-mode-inactive);
  border-radius: 11px;
  font-size: 14px;
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-normal);
  transition:
    color 180ms ease,
    transform 180ms ease;
}

.mode-tab.is-active {
  color: var(--directory-accent);
}

.mode-tab.is-pressed {
  transform: scale(0.985);
}

.mode-icon {
  position: relative;
  display: block;
  flex: 0 0 auto;
  color: inherit;
}

.mode-icon-image {
  display: block;
  transform-origin: center;
}

.people-icon .mode-icon-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}


.directory-mode-swiper {
  width: 100%;
  height: auto;
  min-height: 1px;
  flex: 1 1 auto;
  overflow: hidden;
}

.directory-mode-item,
.directory-scroll {
  width: 100%;
  height: 100%;
}

.page-content {
  box-sizing: border-box;
  min-height: 100%;
  padding: 0 14px 32px;
}

.directory-content {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 16px;
}

.wayfinding {
  min-width: 0;
  padding: 12px;
  background: var(--directory-surface);
  border: 1px solid var(--directory-border);
  border-radius: var(--ui-radius-large);
  box-shadow: 0 6px 18px rgba(22, 32, 42, 0.05);
}

.wayfinding-header {
  display: flex;
  padding: 0 2px 8px;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.wayfinding-title {
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-normal);
}

.wayfinding-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0;
}

.clear-filter-action,
.filter-open-action,
.search-clear,
.retry-action,
.empty-reset,
.sheet-finish,
.sheet-reset-action,
.filter-section-toggle,
.filter-option {
  box-sizing: border-box;
  min-height: 44px;
}

.clear-filter-action {
  display: flex;
  padding: 0 7px;
  align-items: center;
  color: var(--directory-accent);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.filter-open-action {
  display: flex;
  min-width: 44px;
  padding: 0 12px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: var(--directory-accent);
  background: var(--directory-surface);
  border: 1px solid #bed8f5;
  border-radius: var(--ui-radius-small);
}

.filter-open-action.is-disabled {
  color: var(--ui-color-text-muted);
  background: var(--ui-color-surface-muted);
  border-color: var(--directory-border);
  opacity: 0.72;
}

.filter-open-icon {
  width: 18px;
  height: 18px;
}

.filter-open-copy {
  display: none;
}

.filter-count {
  display: flex;
  min-width: 20px;
  height: 20px;
  padding: 0 5px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: var(--directory-accent);
  border-radius: 10px;
  font-size: 11px;
  line-height: 1;
}

.wayfinding-ribbon {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-wrap: wrap;
  gap: 6px;
}

.wayfinding-stop {
  box-sizing: border-box;
  display: flex;
  width: calc(50% - 3px);
  flex: 0 0 calc(50% - 3px);
  min-width: 0;
  min-height: 48px;
  padding: 5px 7px;
  align-items: center;
  gap: 6px;
  color: var(--ui-color-text-secondary);
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid transparent;
  border-radius: 11px;
}

.wayfinding-stop.is-selected {
  color: var(--directory-accent);
  background: var(--directory-surface);
  border-color: #bed8f5;
}

.wayfinding-loading .wayfinding-stop {
  background: var(--ui-color-surface-muted);
  border-color: var(--directory-border);
  animation: directory-loading 1.4s ease infinite;
}

.wayfinding-state {
  display: flex;
  min-height: 96px;
  padding: 10px;
  box-sizing: border-box;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8px;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface-muted);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.wayfinding-empty {
  display: flex;
  min-height: 72px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-text-muted);
  background: var(--ui-color-surface-muted);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-sm);
}

.stop-index {
  display: flex;
  width: 22px;
  height: 22px;
  flex: 0 0 22px;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: var(--directory-accent);
  border-radius: 7px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
}

.wayfinding-stop:nth-child(2) .stop-index {
  background: #2a7ad9;
}

.wayfinding-stop:nth-child(3) .stop-index {
  background: #3b8fca;
}

.wayfinding-stop:nth-child(4) .stop-index {
  background: #3a9eaa;
}

.wayfinding-stop:nth-child(5) .stop-index {
  background: #4c9d7c;
}

.wayfinding-stop:nth-child(6) .stop-index {
  background: #758e5a;
}

.wayfinding-stop:nth-child(7) .stop-index {
  background: #8c7f64;
}

.stop-copy {
  display: block;
  min-width: 0;
  flex: 1;
}

.stop-copy text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stop-copy text:first-child {
  color: var(--ui-color-text-secondary);
  font-size: 11px;
}

.stop-copy text:last-child {
  margin-top: 2px;
  color: var(--directory-text);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.directory-search {
  box-sizing: border-box;
  display: flex;
  min-height: 50px;
  padding: 4px 7px 4px 16px;
  align-items: center;
  gap: 8px;
  background: var(--directory-surface);
  border: 1px solid var(--ui-color-border-strong);
  border-radius: 14px;
  box-shadow: none;
}

.directory-search:focus-within {
  border-color: var(--directory-accent);
  box-shadow: 0 0 0 3px var(--directory-accent-soft);
}

.search-icon {
  width: 22px;
  height: 22px;
  flex: 0 0 22px;
}

.search-input {
  min-width: 0;
  height: 44px;
  flex: 1;
  padding: 0;
  color: var(--directory-text);
  font-size: 16px;
  font-weight: var(--ui-font-weight-regular);
  line-height: var(--ui-line-height-normal);
}

.search-placeholder {
  color: var(--ui-color-text-muted);
}

.search-clear {
  display: flex;
  width: 44px;
  flex: 0 0 44px;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-small);
}

.search-clear image {
  width: 18px;
  height: 18px;
}

.directory-error {
  display: flex;
  padding: 18px;
  flex-direction: column;
  gap: 12px;
  background: var(--directory-surface);
  border: 1px solid var(--directory-border);
  border-radius: var(--ui-radius-large);
}

.directory-error-copy {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.directory-error-title {
  font-weight: var(--ui-font-weight-semibold);
}

.directory-error-message {
  color: var(--ui-color-text-secondary);
  line-height: var(--ui-line-height-normal);
}

.retry-action,
.empty-reset {
  display: flex;
  align-self: flex-start;
  padding: 0 16px;
  align-items: center;
  justify-content: center;
  color: var(--directory-accent);
  background: var(--directory-surface);
  border: 1px solid var(--ui-color-border-strong);
  border-radius: var(--ui-radius-small);
  font-weight: var(--ui-font-weight-semibold);
}

.retry-action.is-secondary {
  color: var(--ui-color-text-secondary);
}

.directory-search-results {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 16px;
}

.result-summary {
  margin: 0 4px -6px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.directory-results {
  display: flex;
  min-width: 0;
  flex-direction: column;
  overflow: hidden;
  background: var(--directory-surface);
  border: 1px solid var(--directory-border);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-card);
}

.directory-priority {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.priority-section {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.priority-heading {
  display: flex;
  padding: 0 2px;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}

.priority-heading text:first-child {
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.priority-heading text:last-child {
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.directory-skeleton {
  display: flex;
  overflow: hidden;
  flex-direction: column;
  gap: 1px;
  background: var(--directory-border);
  border: 1px solid var(--directory-border);
  border-radius: var(--ui-radius-large);
}

.directory-skeleton view {
  height: 76px;
  background: var(--ui-color-surface-muted);
  animation: directory-loading 1.4s ease infinite;
}

.empty-card,
.page-state-card {
  box-sizing: border-box;
  display: flex;
  min-height: 240px;
  padding: 24px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  background: var(--directory-surface);
  border: 1px solid var(--directory-border);
  border-radius: var(--ui-radius-large);
  text-align: center;
}

.empty-search-icon {
  width: 32px;
  height: 32px;
  margin-bottom: 1px;
}

.state-mark {
  display: flex;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  color: var(--directory-accent);
  background: var(--directory-accent-soft);
  border-radius: 50%;
  font-size: 23px;
  font-weight: var(--ui-font-weight-semibold);
}

.state-title {
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-tight);
}

.state-copy {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.empty-reset {
  margin-top: 5px;
  align-self: center;
}

.load-more {
  display: flex;
  justify-content: center;
}

.privacy-note {
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
  line-height: var(--ui-line-height-normal);
  text-align: center;
}

.sheet-layer {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet-scrim {
  position: absolute;
  inset: 0;
  background: rgba(22, 32, 42, 0.32);
  backdrop-filter: blur(2px);
}

.filter-sheet {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  flex-direction: column;
  background: var(--directory-surface);
  border-radius: 22px 22px 0 0;
  box-shadow: var(--ui-shadow-elevated);
  animation: sheet-enter 240ms ease-out;
}

.sheet-drag-region {
  display: flex;
  height: 28px;
  box-sizing: border-box;
  flex: none;
  align-items: center;
  justify-content: center;
  touch-action: none;
}

.sheet-handle {
  width: 38px;
  height: 5px;
  margin: 0 auto;
  background: var(--ui-color-border-strong);
  border-radius: var(--ui-radius-pill);
}

.sheet-heading {
  display: flex;
  min-height: 56px;
  padding: 4px 16px;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  flex: none;
  gap: 12px;
}

.sheet-title {
  font-size: var(--ui-font-size-xl);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-tight);
}

.sheet-finish {
  display: flex;
  min-width: 44px;
  padding: 0 8px;
  align-items: center;
  justify-content: center;
  color: var(--directory-accent);
  border-radius: var(--ui-radius-small);
  font-weight: var(--ui-font-weight-semibold);
}

.sheet-scroll {
  min-height: 0;
  flex: 1;
}

.sheet-body {
  padding: 0 16px calc(16px + env(safe-area-inset-bottom));
}

.sheet-reset-action {
  display: flex;
  width: calc(100% - 32px);
  min-height: 44px;
  min-width: 0;
  margin: 0 16px 8px;
  padding: 0 12px;
  box-sizing: border-box;
  flex: none;
  align-items: center;
  gap: 8px;
  color: var(--directory-accent);
  background: var(--directory-accent-soft);
  border-radius: var(--ui-radius-small);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-normal);
}

.sheet-reset-action image {
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
}

.sheet-reset-action > text:first-of-type {
  min-width: 0;
  flex: 1;
}

.sheet-reset-count {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-regular);
}

.sheet-reset-action.is-disabled {
  opacity: 0.45;
}

.directory-filter-grid {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sheet-empty-state {
  display: flex;
  min-height: 220px;
  padding: 24px;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface-muted);
  border-radius: var(--ui-radius-large);
  text-align: center;
}

.sheet-empty-state text:first-child {
  color: var(--directory-text);
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-semibold);
}

.sheet-empty-state text:last-child {
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.filter-section {
  padding-bottom: 8px;
  border-bottom: 1px solid var(--directory-border);
}

.filter-section-toggle {
  display: flex;
  width: 100%;
  padding: 4px 8px;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-radius: var(--ui-radius-small);
}

.filter-section-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 1px;
  text-align: left;
}

.filter-section-copy text:first-child {
  color: var(--directory-text);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-normal);
}

.filter-section-copy text:last-child {
  overflow: hidden;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-regular);
  line-height: var(--ui-line-height-normal);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-chevron {
  display: flex;
  width: 20px;
  height: 20px;
  margin-right: 5px;
  flex: 0 0 auto;
}

.filter-chevron image {
  width: 20px;
  height: 20px;
  transform: rotate(90deg);
  transition: transform var(--ui-duration-fast) ease;
}

.filter-chevron.is-expanded {
  transform: none;
}

.filter-chevron.is-expanded image {
  transform: rotate(-90deg);
}

.filter-options {
  display: flex;
  padding: 0 4px 4px;
  flex-direction: column;
  gap: 3px;
}

.filter-option {
  display: flex;
  padding: 7px 10px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: var(--ui-color-text-secondary);
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-md);
  line-height: var(--ui-line-height-normal);
}

.filter-option.is-selected {
  color: var(--directory-accent);
  background: var(--directory-accent-soft);
  border-color: #c9dff8;
  font-weight: var(--ui-font-weight-semibold);
}

.option-count {
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
  font-variant-numeric: tabular-nums;
}

.filter-options-empty {
  padding: 10px;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-sm);
}

.visually-hidden {
  position: absolute;
  overflow: hidden;
  width: 1px;
  height: 1px;
  clip-path: inset(50%);
  white-space: nowrap;
}

@keyframes directory-loading {
  50% {
    opacity: 0.52;
  }
}

@keyframes sheet-enter {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
}

.is-compact .mode-rail {
  margin-right: 10px;
  margin-left: 10px;
}

.is-compact .page-content {
  padding-right: 10px;
  padding-left: 10px;
}

.is-compact .mode-tab {
  padding-right: 10px;
  padding-left: 10px;
}

.is-large-text .wayfinding-title,
.is-large-text .state-copy,
.is-large-text .privacy-note,
.is-large-text .directory-error-message,
.is-large-text .filter-option {
  font-size: var(--ui-font-size-md);
  line-height: var(--ui-line-height-normal);
}

.is-large-text .stop-copy text,
.is-large-text .filter-section-copy text {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
}

.is-large-text .wayfinding-ribbon {
  flex-direction: column;
}

.is-large-text .wayfinding-stop {
  width: 100%;
  flex-basis: 100%;
}

.is-large-text .filter-open-action,
.is-large-text .clear-filter-action,
.is-large-text .sheet-finish,
.is-large-text .sheet-reset-action,
.is-large-text .filter-section-toggle,
.is-large-text .filter-option {
  min-height: 52px;
}

@media (prefers-reduced-motion: reduce) {
  .mode-indicator,
  .mode-tab,
  .directory-skeleton view,
  .filter-sheet,
  .filter-chevron,
  .filter-chevron image {
