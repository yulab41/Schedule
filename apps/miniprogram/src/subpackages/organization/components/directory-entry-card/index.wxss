@import "../../../../styles/ui-icon-motion.wxss";

:host {
  display: block;
  min-width: 0;
}

.directory-entry {
  position: relative;
  display: grid;
  grid-template-columns: 5px minmax(0, 1fr);
  color: #17202a;
  font-family: var(--ui-font-family-system);
  font-size: var(--ui-font-size-md);
  line-height: var(--ui-line-height-normal);
}

.directory-entry.has-divider {
  border-top: 1px solid #dce3eb;
}

.directory-entry.is-disabled {
  opacity: 0.62;
  pointer-events: none;
}

.entry-accent {
  margin: 9px 0;
  background: #0a66d5;
  border-radius: 0 4px 4px 0;
  opacity: 0.76;
}

.directory-entry.is-merged .entry-accent {
  background: #3a9e7a;
}

.entry-content {
  min-width: 0;
  padding: 9px 11px 8px;
}

.entry-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 44px;
  align-items: start;
  gap: 2px;
}

.entry-heading-copy,
.entry-contexts,
.contact-methods {
  display: grid;
  min-width: 0;
}

.entry-heading-copy {
  gap: 2px;
}

.entry-title-line,
.contact-number-group,
.directory-number {
  display: flex;
}

.entry-title-line {
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.entry-title {
  color: #17202a;
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 1.25;
}

.entry-kind,
.entry-job-title {
  padding: 2px 6px;
  border-radius: var(--ui-radius-pill);
  font-size: 11px;
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-normal);
}

.entry-kind {
  color: #0a66d5;
  background: #eaf3ff;
}

.entry-job-title {
  padding-right: 7px;
  padding-left: 7px;
  color: #17202a;
  background: #f8fafc;
  border: 1px solid #dce3eb;
}

.entry-employee-code,
.entry-merge-count {
  font-size: 11px;
  line-height: var(--ui-line-height-normal);
}

.entry-employee-code {
  color: #667386;
  font-variant-numeric: tabular-nums;
}

.entry-merge-count {
  color: #39745d;
  font-weight: var(--ui-font-weight-semibold);
}

.entry-contexts {
  gap: 1px;
}

.entry-meta,
.entry-notes {
  color: #667386;
  font-size: var(--ui-font-size-xs);
  line-height: var(--ui-line-height-normal);
}

.entry-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-action {
  display: grid;
  min-width: 44px;
  min-height: 44px;
  place-items: center;
  background: transparent;
  border-radius: var(--ui-radius-small);
}

.favorite-action.is-pressed {
  background: #fff6d8;
}

.contact-methods {
  margin-top: 5px;
  gap: 1px;
}

.contact-method {
  display: grid;
  min-width: 0;
  min-height: 44px;
  grid-template-columns: minmax(0, 1fr);
  align-items: center;
  gap: 8px;
  border-top: 1px solid #dce3eb;
}

.contact-method.has-contact-label {
  grid-template-columns: minmax(62px, auto) minmax(0, 1fr);
}

.contact-label {
  overflow: hidden;
  color: #667386;
  font-size: var(--ui-font-size-xs);
  line-height: var(--ui-line-height-normal);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-number-group {
  min-width: 0;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.directory-number {
  min-width: 0;
  min-height: 44px;
  padding: 0 5px;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  color: #17202a;
  background: transparent;
  border-radius: var(--ui-radius-small);
  font-variant-numeric: tabular-nums;
}

.directory-number.is-dialable {
  color: #0a66d5;
}

.directory-number.is-dialable.is-pressed {
  background: transparent;
}

.number-kind {
  color: #8a95a3;
  font-size: 10px;
  font-weight: var(--ui-font-weight-regular);
  line-height: var(--ui-line-height-normal);
}

.contact-number {
  overflow-wrap: normal;
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-normal);
  white-space: nowrap;
}

.phone-icon {
  flex: 0 0 auto;
  transform-origin: center;
}

.entry-notes {
  display: block;
  margin-top: 2px;
  padding-top: 3px;
  border-top: 1px dashed #dce3eb;
}

.directory-entry.is-large-text .entry-title-line {
  align-items: flex-start;
  flex-direction: column;
  gap: 5px;
}

.directory-entry.is-large-text .entry-title,
.directory-entry.is-large-text .entry-meta,
.directory-entry.is-large-text .entry-notes,
.directory-entry.is-large-text .contact-number {
  overflow: visible;
  font-size: var(--ui-font-size-md);
  line-height: var(--ui-line-height-normal);
  text-overflow: clip;
  white-space: normal;
}

.directory-entry.is-large-text .entry-heading {
  align-items: flex-start;
}

.directory-entry.is-large-text .contact-method {
  grid-template-columns: minmax(0, 1fr);
  gap: 5px;
}

.directory-entry.is-large-text .contact-number-group {
  flex-wrap: wrap;
}

.directory-entry.is-large-text .directory-number {
  min-height: 44px;
}

@media (max-width: 380px) {
  .contact-method.has-contact-label {
    grid-template-columns: minmax(58px, auto) minmax(0, 1fr);
    gap: 5px;
  }

  .contact-number-group {
    gap: 6px;
  }

  .directory-number {
    padding-right: 3px;
    padding-left: 3px;
  }
}
