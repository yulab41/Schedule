<view
  class="group-settings-page {{viewportClass}} {{embedded ? 'is-embedded' : ''}} {{largeText ? 'is-large-text' : ''}}"
>
  <view wx:if="{{!embedded}}" class="mini-header" style="{{shellHeaderStyle}}">
    <view
      class="header-back"
      hover-class="is-pressed"
      aria-role="button"
      aria-label="返回排班台"
      bindtap="handleBack"
    >
      <image src="/assets/icons/ui-chevron-left.svg" mode="aspectFit" />
    </view>
    <view class="header-title">
      <text class="header-title-main">群组管理</text>
      <text class="header-title-sub">{{currentGroupName}} · {{currentGroupRole}}</text>
    </view>
  </view>

  <scroll-view
    class="group-settings-scroll"
    style="{{pageScrollStyle}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="page-content">
      <view wx:if="{{state === 'loading'}}" class="page-state-card">
        <ui-loading label="正在读取群组设置"></ui-loading>
      </view>

      <view wx:elif="{{state === 'error'}}" class="page-state-card">
        <ui-alert tone="danger" title="群组设置暂时无法加载" message="{{errorMessage}}"></ui-alert>
        <view
          class="web-button is-primary"
          hover-class="is-pressed"
          aria-role="button"
          bindtap="handleRetry"
          >重新加载</view
        >
      </view>

      <view wx:else class="group-setup-panel">
        <view class="group-identity-band">
          <view class="group-identity-copy">
            <text>当前工作群组</text>
            <text class="group-name">{{currentGroupName}}</text>
            <text class="role-chip">{{currentGroupRole}}</text>
          </view>
        </view>

<ui-alert
          wx:if="{{infoMessage}}"
          tone="success"
          title="手机号公开设置"
          message="{{infoMessage}}"
        ></ui-alert>



        <view class="group-card calendar-preferences-card">
          <view class="group-card-header"><text>日历偏好</text></view>
          <view class="group-card-body">
            <view wx:if="{{calendarPreferencesState === 'loading'}}" class="inline-loading">
              <ui-loading label="正在读取日历偏好"></ui-loading>
            </view>
            <view wx:elif="{{calendarPreferencesState === 'error'}}" class="preference-error">
              <ui-alert
                tone="danger"
                title="日历偏好暂时无法加载"
                message="{{calendarPreferencesError}}"
              ></ui-alert>
              <view
                class="web-button"
                hover-class="is-pressed"
                aria-role="button"
                bindtap="handleCalendarPreferencesRetry"
                >重新加载日历偏好</view
              >
            </view>
            <view wx:else class="calendar-preference-sections">
              <ui-alert
                wx:if="{{calendarPreferencesError}}"
                tone="danger"
                title="日历偏好未保存"
                message="{{calendarPreferencesError}}"
              ></ui-alert>
              <ui-alert
                wx:if="{{calendarPreferencesInfo}}"
                tone="success"
                title="日历偏好"
                message="{{calendarPreferencesInfo}}"
              ></ui-alert>

              <view wx:if="{{canManageGroupCalendarDefaults}}" class="calendar-preference-section">
                <view class="preference-heading">
                  <view>
                    <text class="preference-title">群组日历默认设置</text>
                    <text>决定成员首次进入日历时看到的视图。</text>
                  </view>
                  <text class="preference-scope is-group">群组默认</text>
                </view>
                <ui-selector
                  title="群组默认视图"
                  options="{{groupCalendarViewOptions}}"
                  selected-index="{{groupCalendarView === 'month' ? 0 : groupCalendarView === 'week' ? 1 : groupCalendarView === 'list' ? 2 : 0}}"
                  display-value="{{groupCalendarView === 'month' ? '月视图' : groupCalendarView === 'week' ? '周视图' : groupCalendarView === 'list' ? '列表视图' : '跟随群组'}}"
                  bindchange="handleGroupCalendarViewSelect"
                ></ui-selector>
                <view class="field-block">
                  <text class="field-label">月视图默认班种</text>
                  <ui-selector
                    title="月视图默认班种"
                    options="{{groupCalendarShiftOptions}}"
                    selected-index="{{groupCalendarShiftIndex}}"
                    display-value="{{groupCalendarShiftOptions[groupCalendarShiftIndex].label}}"
                    bindchange="handleGroupCalendarShiftChange"
                  ></ui-selector>
                </view>
                <view
                  class="web-button {{isSavingGroupCalendarDefaults ? 'is-disabled' : 'is-primary'}}"
                  hover-class="{{isSavingGroupCalendarDefaults ? 'none' : 'is-pressed'}}"
                  aria-role="button"
                  aria-disabled="{{isSavingGroupCalendarDefaults}}"
                  aria-busy="{{isSavingGroupCalendarDefaults}}"
                  bindtap="handleSaveGroupCalendarDefaults"
                  >{{isSavingGroupCalendarDefaults ? '正在保存' : '保存群组默认'}}</view
                >
              </view>

              <view class="calendar-preference-section is-personal">
                <view class="preference-heading">
                  <view>
                    <text class="preference-title">我的日历偏好</text>
                    <text>个人设置优先；也可以继续跟随群组。</text>
                  </view>
                  <text class="preference-scope">仅自己</text>
                </view>
                <ui-selector
                  title="我的默认视图"
                  options="{{memberCalendarViewOptions}}"
                  selected-index="{{memberCalendarView === 'month' ? 1 : memberCalendarView === 'week' ? 2 : memberCalendarView === 'list' ? 3 : 0}}"
                  display-value="{{memberCalendarView === 'month' ? '月视图' : memberCalendarView === 'week' ? '周视图' : memberCalendarView === 'list' ? '列表视图' : '跟随群组'}}"
                  bindchange="handleMemberCalendarViewSelect"
                ></ui-selector>
                <view class="field-block">
                  <text class="field-label">月视图默认班种</text>
                  <ui-selector
                    title="月视图默认班种"
                    options="{{memberCalendarShiftOptions}}"
                    selected-index="{{memberCalendarShiftIndex}}"
                    display-value="{{memberCalendarShiftOptions[memberCalendarShiftIndex].label}}"
                    bindchange="handleMemberCalendarShiftChange"
                  ></ui-selector>
                </view>
                <view
                  class="web-button {{isSavingMemberCalendarPreferences ? 'is-disabled' : 'is-primary'}}"
                  hover-class="{{isSavingMemberCalendarPreferences ? 'none' : 'is-pressed'}}"
                  aria-role="button"
                  aria-disabled="{{isSavingMemberCalendarPreferences}}"
                  aria-busy="{{isSavingMemberCalendarPreferences}}"
                  bindtap="handleSaveMemberCalendarPreferences"
                  >{{isSavingMemberCalendarPreferences ? '正在保存' : '保存我的偏好'}}</view
                >
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{!organizationEnabled}}" class="organization-capability-note">
          <text class="capability-note-title">组织管理写入能力暂未开放</text>
          <text>当前可查看成员与联系方式；启用组织管理能力后才会提交新增、修改或删除。</text>
        </view>

        <view wx:if="{{canManageGroup}}" class="group-card group-mutation-card">
          <view class="group-card-header"
            ><text>群组资料</text><text class="card-scope">群主专属</text></view
          >
          <view class="group-card-body mutation-fields">
            <view class="field-block">
              <text class="field-label">群组名称</text>
              <input
                class="native-field"
                value="{{groupNameDraft}}"
                maxlength="100"
                bindinput="handleGroupNameInput"
              />
              <view
                class="web-button is-primary"
                hover-class="is-pressed"
                aria-role="button"
                bindtap="handleSaveGroupName"
                >保存名称</view
              >
            </view>
          </view>
        </view>

        <view wx:if="{{canLeaveGroup}}" class="group-leave-action">
          <view
            class="web-button group-leave-button"
            hover-class="is-pressed"
            aria-role="button"
            aria-disabled="{{managementState === 'loading'}}"
            bindtap="handleLeaveGroup"
            >退出群组</view
          >
        </view>

        <view wx:if="{{canDissolveGroup}}" class="group-card group-exit-card">
          <view class="group-card-header"
            ><text>当前群组操作</text><text class="card-scope">群主专属</text></view
          >
          <view class="group-card-body group-action-row">
            <view
              class="web-button is-danger"
              hover-class="is-pressed"
              aria-role="button"
              bindtap="handleDissolveGroup"
              >解散群组</view
            >
          </view>
        </view>

        <view wx:if="{{canManageGroupLifecycle}}" class="group-card group-lifecycle-card">
          <view class="group-card-header"><text>创建群组</text></view>
          <view class="group-card-body mutation-fields">
            <view class="field-block">
              <text class="field-label">创建群组</text>
              <input
                class="native-field"
                value="{{createGroupName}}"
                maxlength="100"
                placeholder="新群组名称"
                bindinput="handleCreateGroupNameInput"
              />
              <view
                class="web-button is-primary"
                hover-class="is-pressed"
                aria-role="button"
                bindtap="handleCreateGroup"
                >创建群组</view
              >
            </view>
          </view>
        </view>

        <view
          wx:if="{{canDissolveGroup && dissolvedCards.length > 0}}"
          class="group-card dissolved-group-card"
        >
          <view class="group-card-header"
            ><text>已解散群组</text><text class="card-scope">30 天内可恢复</text></view
          >
          <view class="group-card-body member-card-list">
            <view wx:for="{{dissolvedCards}}" wx:for-item="dissolved" wx:key="id" class="group-record-row">
              <view class="group-record-row-copy"
                ><text>{{dissolved.name}}</text
                ><text class="member-row-meta"
                  >解散于 {{dissolved.deletedAt}}</text
                ></view
              >
              <view
                class="web-button compact-button is-primary"
                data-group-id="{{dissolved.id}}"
                aria-role="button"
                bindtap="handleRestoreGroup"
                >恢复</view
              >
            </view>
          </view>
        </view>

        <view class="group-card member-management-card">
          <view class="group-card-header member-card-header">
            <view
              ><text>群组成员</text
              ><text class="card-subtitle"
                >{{memberCards.length}} 位成员</text
              ></view
            >
            <view
              wx:if="{{canManageMembers}}"
              class="web-button compact-button {{!organizationEnabled ? 'is-disabled' : 'is-primary'}}"
              aria-role="button"
              aria-disabled="{{!organizationEnabled}}"
              bindtap="handleRosterToggle"
              >添加预设成员</view
            >
          </view>
          <view class="group-card-body member-card-list">
            <view wx:if="{{managementState === 'loading'}}" class="inline-loading"
              ><ui-loading label="正在读取成员资料"></ui-loading
            ></view>
            <view wx:elif="{{memberCards.length === 0}}" class="inline-empty"
              ><text>当前群组暂无成员。</text></view
            >
            <view
              wx:else
              wx:for="{{memberCards}}"
              wx:for-item="member"
              wx:for-index="memberIndex"
              wx:key="id"
              class="member-management-row"
            >
              <directory-entry-card
                class="member-entry-card"
                entry="{{member.entry}}"
                show-favorite="{{false}}"
                current-user="{{member.isCurrentUser}}"
                show-divider="{{memberIndex > 0}}"
                large-text="{{largeText}}"
                binddirectorycall="handleMemberCall"
              ></directory-entry-card>
              <view wx:if="{{member.canManage}}" class="member-row-actions">
                <view
                  wx:if="{{member.canEdit}}"
                  class="web-button compact-button"
                  data-member-id="{{member.id}}"
                  aria-role="button"
                  bindtap="handleOpenContactEditor"
                  >修改</view
                >
                <view
                  wx:if="{{member.isPendingRoster && member.canManage}}"
                  class="web-button compact-button is-primary"
                  data-real-name="{{member.name}}"
                  aria-role="button"
                  bindtap="handleConvertRoster"
                  >转为正式成员</view
                >

                <view
                  wx:if="{{member.canManage && !member.isCurrentUser && !member.isPendingRoster}}"
                  class="web-button compact-button is-danger"
                  data-member-id="{{member.id}}"
                  data-action="delete"
                  aria-role="button"
                  bindtap="handleMemberAction"
                  >删除</view
                >
                <view
                  wx:if="{{canManageGroup && member.roleLabel === '成员' && !member.isCurrentUser}}"
                  class="web-button compact-button"
                  data-member-id="{{member.id}}"
                  data-action="administrator"
                  aria-role="button"
                  bindtap="handleMemberAction"
                  >设为管理员</view
                >
                <view
                  wx:if="{{canManageGroup && member.roleLabel === '管理员' && !member.isCurrentUser}}"
                  class="web-button compact-button"
                  data-member-id="{{member.id}}"
                  data-action="member"
                  aria-role="button"
                  bindtap="handleMemberAction"
                  >降为成员</view
                >
              </view>
            </view>
          </view>
        </view>



        <ui-alert
          wx:if="{{managementError}}"
          tone="danger"
          title="组织管理操作未完成"
          message="{{managementError}}"
        ></ui-alert>
        <ui-alert
          wx:if="{{managementInfo}}"
          tone="success"
          title="组织管理"
          message="{{managementInfo}}"
        ></ui-alert>

        <view
          wx:if="{{rosterEditorOpen}}"
          class="inline-editor-sheet"
          role="dialog"
          aria-label="添加预设成员"
        >
          <view class="inline-editor-heading"
            ><text>添加预设成员</text
            ><view class="editor-close" aria-role="button" bindtap="handleRosterToggle"
              >完成</view
            ></view
          >
          <text class="inline-editor-copy"
            >每行输入一个姓名。请使用管理员提供的邀请关联成员账号。</text
          >
          <textarea
            class="native-textarea"
            maxlength="2000"
            placeholder="例如：\n张三\n李四"
            value="{{rosterNames}}"
            bindinput="handleRosterInput"
          />
          <view class="web-button is-primary" aria-role="button" bindtap="handleAddRoster"
            >添加预设成员</view
          >
        </view>

        <view
          wx:if="{{contactEditorOpen}}"
          class="inline-editor-sheet"
          role="dialog"
          aria-label="编辑成员联系方式"
        >
          <view class="inline-editor-heading"
            ><text>编辑成员资料</text
            ><view class="editor-close" aria-role="button" bindtap="handleCloseContactEditor"
              >完成</view
            ></view
          >
          <view class="field-block"
            ><text class="field-label">成员姓名</text
            ><input
              class="native-field"
              value="{{editingMemberName}}"
              maxlength="100"
              bindinput="handleContactNameInput"
          /></view>
          <view class="field-block"
            ><text class="field-label">手机号</text
            ><input
              class="native-field"
              type="number"
              value="{{editingMobilePhone}}"
              maxlength="32"
              bindinput="handleContactMobileInput"
          /></view>
          <view class="field-block"
            ><text class="field-label">短号</text
            ><input
              class="native-field"
              type="number"
              value="{{editingShortPhone}}"
              maxlength="16"
              bindinput="handleContactShortInput"
          /></view>
          <view
            class="phone-confirm-toggle {{editingIsConfirmed ? 'is-checked' : ''}}"
            aria-role="switch"
            aria-checked="{{editingIsConfirmed}}"
            bindtap="handleContactConfirmToggle"
            ><view class="phone-confirm-dot"></view><text>确认联系方式</text></view
          >
          <view class="web-button is-primary" aria-role="button" bindtap="handleSaveContact"
            >保存成员资料</view
          >
        </view>

        <view class="group-card contact-disclosure-card">
          <view class="contact-disclosure-row">
            <view class="contact-disclosure-copy">
              <text class="contact-disclosure-title">群内公开手机号</text>
              <text wx:if="{{consentState === 'missing-phone'}}" class="contact-disclosure-note">请先设置手机号</text>
              <text wx:elif="{{isSaving}}" class="contact-disclosure-note">正在保存…</text>
            </view>
            <ui-switch checked="{{desiredConsent}}" disabled="{{switchDisabled}}" loading="{{isSaving}}" label="群内公开手机号" bind:change="handleConsentToggle"></ui-switch>
          </view>
          <view wx:if="{{errorMessage}}" class="contact-disclosure-error">
            <text>{{errorMessage}}</text>
            <view class="web-button compact-button" aria-role="button" bindtap="handleSave">重试保存</view>
          </view>
        </view>
      </view>
      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>
</view>
