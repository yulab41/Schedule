.shift-color-picker {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: 0;
  font-size: 12px;
}

.color-label {
  display: block;
  color: var(--ui-color-text-muted);
  font-size: 9px;
  font-weight: 700;
  line-height: 1.4;
}

.shift-color-picker > .color-label {
  margin-bottom: 2px;
  font-size: 10px;
  font-weight: var(--ui-font-weight-semibold);
}

.color-palette {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.color-swatch {
  position: relative;
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.swatch-fill {
  width: 32px;
  height: 32px;
  box-sizing: border-box;
  border: 3px solid var(--ui-color-white);
  border-radius: 50%;
  box-shadow: 0 0 0 1px #aab7c6;
}

.color-swatch.is-selected .swatch-fill {
  box-shadow: 0 0 0 3px var(--ui-color-primary);
}

.custom-color-plus {
  position: absolute;
  right: 1px;
  bottom: 1px;
  width: 16px;
  height: 16px;
  box-sizing: border-box;
  color: var(--ui-color-primary);
  background: var(--ui-color-white);
  border: 1px solid #b6c8dc;
  border-radius: 50%;
}

.is-selected .custom-color-plus {
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-color: var(--ui-color-primary);
}

.plus-horizontal,
.plus-vertical {
  position: absolute;
  top: 6px;
  left: 3px;
  width: 8px;
  height: 2px;
  background: currentColor;
}

.plus-vertical {
  top: 3px;
  left: 6px;
  width: 2px;
  height: 8px;
}

.custom-color-panel {
  display: flex;
  width: 100%;
  min-width: 0;
  margin-top: 6px;
  padding: 9px;
  box-sizing: border-box;
  flex-direction: column;
  gap: 8px;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-primary-border);
  border-radius: 12px;
}

.color-picker-field {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.color-spectrum {
  position: relative;
  width: 100%;
  height: 92px;
  box-sizing: border-box;
  overflow: hidden;
  border: 1px solid var(--ui-color-border-strong);
  border-radius: 9px;
  touch-action: none;
}

.spectrum-white,
.spectrum-black {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.spectrum-white {
  background: linear-gradient(to right, #fff, rgba(255, 255, 255, 0));
}

.spectrum-black {
  background: linear-gradient(to top, #000, rgba(0, 0, 0, 0));
}

.spectrum-cursor {
  position: absolute;
  width: 14px;
  height: 14px;
  box-sizing: border-box;
  border: 2px solid var(--ui-color-white);
  border-radius: 50%;
  box-shadow: inset 0 0 0 1px rgba(22, 32, 42, 0.55);
  pointer-events: none;
}

.color-hue {
  position: relative;
  width: 100%;
  height: 20px;
  touch-action: none;
}

/* The transparent 44px target does not change the Web rail's visible layout.
   It starts below the SV board and ends before the editable HEX input. */
.hue-hitbox {
  position: absolute;
  top: -2px;
  right: 0;
  left: 0;
  height: 44px;
  background: transparent;
}

.hue-track {
  position: absolute;
  top: 1px;
  right: 0;
  left: 0;
  height: 18px;
  background: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);
  border-radius: var(--ui-radius-pill);
  pointer-events: none;
}

.hue-cursor {
  position: absolute;
  top: 0;
  width: 20px;
  height: 20px;
  box-sizing: border-box;
  background: var(--ui-color-white);
  border: 2px solid var(--ui-color-text-primary);
  border-radius: 50%;
  pointer-events: none;
}

.color-input-row {
  display: flex;
  min-width: 0;
  align-items: flex-end;
  gap: 8px;
}

.hex-color-field {
  min-width: 0;
  flex: 1;
}

.hex-color-input {
  display: block;
  width: 100%;
  min-width: 0;
  height: 42px;
  margin-top: 4px;
  padding: 0 8px;
  box-sizing: border-box;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-white);
  border: 1px solid var(--ui-color-border-strong);
  border-radius: 10px;
  font-size: inherit;
  font-variant-numeric: tabular-nums;
}

.apply-custom-color {
  display: flex;
  min-width: 62px;
  min-height: 42px;
  padding: 0 12px;
  box-sizing: border-box;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-radius: 10px;
  font-size: inherit;
  font-weight: 700;
  line-height: var(--ui-line-height-normal);
}

.color-error {
  color: var(--ui-color-danger);
  font-size: 9px;
  line-height: var(--ui-line-height-normal);
}

.shift-color-picker.is-disabled {
  opacity: 0.6;
}

.shift-color-picker.is-large-text {
  font-size: 16px;
}

.shift-color-picker.is-large-text .color-label {
  font-size: 12px;
}

.shift-color-picker.is-large-text > .color-label {
  font-size: 14px;
}

@media (max-width: 640px) {
  .color-input-row {
    flex-direction: column;
    align-items: stretch;
  }

  .hex-color-field {
    width: calc(50% - 4px);
    flex: none;
  }

  .apply-custom-color {
    width: 100%;
    min-height: 44px;
  }
}
