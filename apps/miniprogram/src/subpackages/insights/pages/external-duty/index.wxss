.page {
  height: 100vh;
  box-sizing: border-box;
  background: #f4f7fb;
  color: #243247;
  padding: 0 14px 20px;
  display: flex;
  flex-direction: column;
}
.header {
  height: 76px;
  padding-top: 24px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #fff;
  margin: 0 -14px;
  padding-left: 14px;
  gap: 20px;
}
.back {
  font-size: 14px;
  color: #376ba7;
}
.title {
  font-size: 18px;
  font-weight: 700;
}
.intro {
  font-size: 12px;
  line-height: 1.7;
  color: #5b6778;
  padding: 15px 2px;
}
.toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
}
.toolbar button {
  margin: 0;
  background: #376ba7;
  color: #fff;
  font-size: 13px;
}
.toolbar text,
.hint {
  font-size: 11px;
  color: #7b8795;
}
.error {
  margin: 12px 0;
  padding: 12px;
  border-radius: 8px;
  background: #fff0ee;
  color: #a42f29;
  font-size: 12px;
}
.empty {
  margin-top: 24px;
  text-align: center;
  color: #718096;
  font-size: 13px;
}
.list {
  flex: 1;
  min-height: 0;
  margin-top: 12px;
}
.card {
  background: #fff;
  border-radius: 12px;
  padding: 13px 14px;
  margin-bottom: 10px;
}
.date-line {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 700;
}
.date-line text:last-child {
  font-size: 11px;
  color: #9c5c25;
}
.names {
  display: flex;
  gap: 10px;
  margin: 12px 0;
}
.names view {
  flex: 1;
  background: #f4f7fb;
  border-radius: 8px;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.names text:first-child {
  font-size: 10px;
  color: #7b8795;
}
.names text:last-child {
  font-size: 15px;
  font-weight: 600;
}
.reason {
  font-size: 11px;
  color: #a42f29;
  margin-bottom: 8px;
}
.actions {
  display: flex;
  gap: 5px;
}
.actions button {
  margin: 0;
  flex: 1;
  font-size: 10px;
  padding: 0 3px;
}
.candidate-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  box-shadow: 0 -6px 24px #23304833;
  padding: 16px;
  z-index: 3;
}
.sheet-title {
  display: flex;
  justify-content: space-between;
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 12px;
}
.sheet-title text:last-child {
  font-size: 12px;
  color: #376ba7;
}
.candidate-list {
  max-height: 45vh;
}
.candidate {
  padding: 13px 4px;
  border-bottom: 1px solid #e9eef4;
  font-size: 13px;
}
.source {
  font-size: 11px;
  color: #718096;
  margin-top: 5px;
}
