<view class="page">
  <view class="header">
    <text class="back" bindtap="back">返回</text>
    <text class="title">排班网页校对</text>
  </view>
  <view class="intro"
    >头颈外科医生 · 一线 · 全天班。仅核对今天及以后双方都有正式排班的日期；所有改动均须逐条确认。</view
  >
  <view class="toolbar"
    ><button bindtap="scan" disabled="{{busy}}">立即检测</button
    ><text>服务器每分钟自动检测</text></view
  >
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{scanStatus}}" class="error">{{scanStatus}}</view>
  <view wx:if="{{busy}}" class="hint">正在校对…</view>
  <view wx:if="{{!busy && rows.length === 0}}" class="empty">目前没有可显示的校对记录。</view>
  <scroll-view scroll-y class="list">
    <view wx:for="{{rows}}" wx:key="businessDate" class="card">
      <view class="date-line"
        ><text>{{item.businessDate}}</text
        ><text
          >{{item.status === 'aligned' ? '已一致' : item.status === 'blocked' ? '无法同步' :
          item.status === 'processing' ? '处理中' : '待确认'}}</text
        ></view
      >
      <view class="source"
        >{{item.changeSource === 'remote' ? '网页端变化' : item.changeSource === 'local' ? '本系统变化' : '两边均有变化'}}</view
      >
      <view class="names"
        ><view><text>网页</text><text>{{item.remoteName}}</text></view
        ><view><text>发布基线</text><text>{{item.baselineName || '未确定'}}</text></view
        ><view><text>本系统</text><text>{{item.localName || '无排班'}}</text></view></view
      >
      <view wx:if="{{item.blockReason}}" class="reason">{{item.blockReason}}</view>
      <view wx:if="{{item.suggestion}}" class="reason">{{item.suggestion.detail}}</view>
      <view wx:if="{{item.status === 'pending'}}" class="actions">
        <button wx:if="{{item.changeSource === 'remote' && item.suggestion && item.suggestion.kind !== 'blocked'}}" size="mini" disabled="{{busy}}" data-date="{{item.businessDate}}" bindtap="applySuggestion">
          预览建议
        </button>
        <button wx:if="{{item.changeSource === 'local'}}" size="mini" disabled="{{busy}}" data-date="{{item.businessDate}}" bindtap="push">
          写入网页
        </button>
      </view>
    </view>
  </scroll-view>
  <button bindtap="toggleHistory" disabled="{{busy}}">{{showHistory ? '收起操作记录' : '查看操作记录与撤回'}}</button>
  <scroll-view wx:if="{{showHistory}}" scroll-y class="list">
    <view wx:for="{{historyRows}}" wx:key="id" class="card">
      <view class="date-line"><text>{{item.businessDate}}</text><text>{{item.status === 'reverted' ? '已撤回' : item.status === 'reverting' ? '撤回中' : item.status === 'applying' ? '写入待核验' : item.workflowStatus === 'rejected' || item.workflowStatus === 'cancelled' ? '申请未生效' : item.workflowStatus === 'revoked' ? '原申请已撤销' : item.workflowStatus && item.workflowStatus !== 'completed' ? '申请处理中' : '已执行'}}</text></view>
      <view class="source">{{item.side === 'external' ? '网页' : '本系统'}}：{{item.beforeName || '空缺'}} → {{item.afterName || '空缺'}}</view>
      <view class="reason">发布基线：{{item.baselineName}}</view>
      <button wx:if="{{item.status === 'applied' || item.status === 'applying'}}" size="mini" disabled="{{busy}}" data-id="{{item.id}}" bindtap="undo">恢复发布基线</button>
    </view>
  </scroll-view>
</view>
