.exports-page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-background);
}

.mini-header {
  display: flex;
  padding: 0 14px 0 8px;
  box-sizing: border-box;
  align-items: center;
  gap: 8px;
  background: var(--ui-color-surface);
  border-bottom: 1px solid var(--ui-color-border);
}

.header-back {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.header-back image {
  width: 20px;
  height: 20px;
}

.header-title {
  min-width: 0;
  flex: 1;
}

.header-title-main,
.header-title-sub,
.page-state-card {
  display: flex;
  flex-direction: column;
}

.header-title-main {
  overflow: hidden;
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-title-sub {
  margin-top: 2px;
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exports-scroll {
  width: 100%;
}

.page-content {
  padding: 16px 14px;
}

.page-state-card {
  min-height: 260px;
  padding: 28px 18px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
  box-shadow: var(--ui-shadow-card);
  text-align: center;
}

.state-mark {
  display: flex;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary-dark);
  background: var(--ui-color-primary-light);
  border-radius: 50%;
  font-size: 24px;
  font-weight: var(--ui-font-weight-semibold);
}

.state-title {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-semibold);
}

.state-copy {
  max-width: 300px;
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-body);
}

.shell-action {
  display: flex;
  min-width: 132px;
  min-height: var(--ui-touch-target-minimum);
  padding: 0 14px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary-dark);
  border: 1px solid var(--ui-color-primary-border);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.shell-action-primary {
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-color: var(--ui-color-primary);
}

@media (max-width: 340px) {
  .page-content {
    padding-right: 10px;
    padding-left: 10px;
  }
}

.is-large-text .header-title-main,
.is-large-text .header-title-sub,
.is-large-text .state-title,
.is-large-text .state-copy,
.is-large-text .shell-action {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  font-size: var(--ui-font-size-md);
  line-height: var(--ui-line-height-body);
}
