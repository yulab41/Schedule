<exports-panel
  wx:if="{{panelReady}}"
  id="exports-panel"
  group-id="{{groupId}}"
  bindstartupready="handlePanelStartupReady"
></exports-panel>
<view wx:else class="exports-page {{viewportClass}} {{largeText ? 'is-large-text' : ''}}">
  <view class="mini-header" style="{{shellHeaderStyle}}">
    <view
      class="header-back"
      aria-role="button"
      aria-label="返回更多工具"
      bindtap="handleBack"
    >
      <image src="/assets/icons/ui-chevron-left.svg" mode="aspectFit" />
    </view>
    <view class="header-title">
      <text class="header-title-main">导出排班与统计</text>
      <text class="header-title-sub">正在准备页面</text>
    </view>
  </view>
  <scroll-view class="exports-scroll" style="{{pageScrollStyle}}" scroll-y show-scrollbar="{{false}}">
    <view class="page-content">
      <view class="page-state-card">
        <text class="state-mark">{{startupError ? '!' : '…'}}</text>
        <text class="state-title">{{startupError ? '导出页面暂时无法加载' : '正在准备页面'}}</text>
        <text class="state-copy">{{startupError || '正在安全加载导出内容，请稍候。'}}</text>
        <view wx:if="{{startupError}}" class="shell-action shell-action-primary" bindtap="handleRetry">重新加载</view>
        <view class="shell-action" bindtap="handleBack">返回更多工具</view>
      </view>
    </view>
  </scroll-view>
</view>
