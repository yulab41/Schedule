<view class="exports-page {{viewportClass}} {{largeText ? 'is-large-text' : ''}}">
  <ui-toast visible="{{!!infoMessage}}" message="{{infoMessage}}" tone="{{feedbackTone}}" />
  <view class="mini-header" style="{{shellHeaderStyle}}">
    <view
      class="header-back"
      hover-class="is-pressed"
      aria-role="button"
      aria-label="返回更多工具"
      bindtap="handleBack"
      ><image src="/assets/icons/ui-chevron-left.svg" mode="aspectFit"
    /></view>
    <view class="header-title"
      ><text class="header-title-main">导出排班与统计</text
      ><text class="header-title-sub">登录态下载 · 仅当前群组</text></view
    >
  </view>
  <scroll-view
    class="exports-scroll"
    style="{{pageScrollStyle}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    ><view class="page-content">
      <view wx:if="{{state === 'loading'}}" class="page-state-card"
        ><ui-loading label="正在加载导出选项"></ui-loading
      ></view>
      <view wx:elif="{{state === 'disabled'}}" class="page-state-card insights-disabled"
        ><view class="state-mark">—</view><text class="state-title">导出暂未开放</text
        ><text class="state-copy"
          >当前版本未开启 insights 能力，不会创建导出任务或下载文件。</text
        ></view
      >
      <view wx:elif="{{state === 'error'}}" class="page-state-card"
        ><ui-alert tone="danger" title="导出选项暂时无法加载" message="{{errorMessage}}"></ui-alert
        ><ui-button variant="primary" label="重新加载" bindpress="handleRetry"></ui-button
      ></view>
      <view wx:else class="exports-content">
        <view class="surface-card export-form-card">
          <view class="card-header"
            ><view
              ><text class="card-title">导出内容</text
              ><text class="card-subtitle"
                >当前群组 · {{format === 'xlsx' ? 'Excel' : 'CSV'}} 文件</text
              ></view
            ><view class="format-switch" aria-label="导出格式"
              ><view
                class="format-option {{format === 'xlsx' ? 'is-active' : ''}}"
                data-format="xlsx"
                bindtap="handleFormatChange"
                >Excel</view
              ><view
                class="format-option {{format === 'csv' ? 'is-active' : ''}}"
                data-format="csv"
                bindtap="handleFormatChange"
                >CSV</view
              ></view
            ></view
          >

          <view class="field-block">
            <text class="field-label">文件类型</text>
            <picker
              mode="selector"
              range="{{['排班', '统计']}}"
              value="{{exportType === 'statistics' ? 1 : 0}}"
              bindchange="handleTypeChange"
            >
              <view
                class="native-picker"
                aria-role="button"
                aria-label="文件类型，{{exportType === 'statistics' ? '统计' : '排班'}}"
                ><text>{{exportType === 'statistics' ? '统计' : '排班'}}</text
                ><image
                  class="picker-chevron"
                  src="/assets/icons/ui-chevron-right.svg"
                  mode="aspectFit"
                  aria-hidden="true" /></view
            ></picker>
          </view>

          <view class="field-block period-field">
            <text class="field-label">时间范围</text>
            <view class="choice-group" role="tablist" aria-label="导出时间范围"
              ><view
                class="choice-option {{periodType === 'month' ? 'is-active' : ''}}"
                aria-role="button"
                aria-label="按月"
                aria-selected="{{periodType === 'month'}}"
                data-period-type="month"
                bindtap="handlePeriodType"
                >按月</view
              ><view
                class="choice-option {{periodType === 'year' ? 'is-active' : ''}}"
                aria-role="button"
                aria-label="按年"
                aria-selected="{{periodType === 'year'}}"
                data-period-type="year"
                bindtap="handlePeriodType"
                >按年</view
              ></view
            >
            <view class="period-stepper" aria-label="导出周期">
              <view
                class="period-step"
                aria-role="button"
                aria-label="上一导出周期"
                bindtap="handlePreviousPeriod"
                ><image
                  class="period-step-icon"
                  src="/assets/icons/ui-chevron-left.svg"
                  mode="aspectFit"
                  aria-hidden="true"
              /></view>
              <view class="period-readout"
                ><text class="period-value">{{periodLabel}}</text
                ><text class="period-caption"
                  >{{periodType === 'month' ? '按月生成' : '按年生成'}}</text
                ></view
              >
              <view
                class="period-step"
                aria-role="button"
                aria-label="下一导出周期"
                bindtap="handleNextPeriod"
                ><image
                  class="period-step-icon"
                  src="/assets/icons/ui-chevron-right.svg"
                  mode="aspectFit"
                  aria-hidden="true"
              /></view>
            </view>
          </view>

          <ui-selector
            field-label="排班岗位"
            title="排班岗位（可多选）"
            multiple="{{true}}"
            options="{{roleOptions}}"
            display-value="{{optionsLoading ? '正在读取…' : roleSummary}}"
            disabled="{{optionsLoading || state === 'waiting'}}"
            bindchange="handleRoleChange"
          />

          <ui-selector
            field-label="成员"
            title="成员（可多选）"
            multiple="{{true}}"
            options="{{memberOptions}}"
            display-value="{{optionsLoading ? '正在读取…' : memberSummary}}"
            disabled="{{optionsLoading || state === 'waiting'}}"
            bindchange="handleMemberChange"
          />

          <view class="export-hint"
            ><text class="hint-mark" aria-hidden="true">i</text
            ><text>文件默认不包含电话号码和内部审计内容；每次导出都会记录安全审计。</text></view
          >

          <view wx:if="{{state === 'waiting'}}" class="export-progress" role="status"
            ><ui-loading compact></ui-loading
            ><view class="progress-copy"
              ><text class="progress-title"
                >{{statusLabel === '正在创建导出任务' ? '正在创建导出任务' : statusLabel}}</text
              ><text class="progress-note">正在检查结果；你可以随时停止等待。</text></view
            ></view
          >
          <view
            wx:elif="{{state === 'timed_out' || state === 'paused'}}"
            class="export-timeout"
            role="status"
            ><view class="timeout-copy"
              ><text class="progress-title">{{statusLabel}}</text
              ><text class="progress-note"
                >{{canCheckJob ? '继续检查同一任务，不会重复创建。' : canRetryCreate ?
                '创建请求尚未发出，可以安全重试。' :
                '暂未取得任务编号，请勿重复提交；可返回稍后再试。'}}</text
              ></view
            ><ui-button
              wx:if="{{canCheckJob}}"
              variant="secondary"
              label="检查同一任务"
              bindpress="handleContinue"
            ></ui-button
            ><ui-button
              wx:elif="{{canRetryCreate}}"
              variant="secondary"
              label="重试生成"
              bindpress="handleCreate"
            ></ui-button
            ><ui-button variant="secondary" label="返回" bindpress="handleBack"></ui-button
          ></view>
          <view
            wx:elif="{{state === 'ready' || state === 'download_failed' || state === 'downloaded' || state === 'shared'}}"
            class="ready-result {{state === 'download_failed' ? 'has-download-error' : ''}}"
            ><view class="ready-heading"
              ><text class="ready-title">{{statusLabel}}</text
              ><text class="ready-file">{{fileLabel}}</text></view
            ><view class="ready-actions"
              ><ui-button
                wx:if="{{state === 'downloaded' || state === 'shared'}}"
                variant="primary"
                label="发送文件"
                loading="{{shareBusy}}"
                disabled="{{shareBusy}}"
                bindpress="handleShare"
              ></ui-button
              ><ui-button
                wx:if="{{state === 'download_failed'}}"
                variant="primary"
                label="重新获取文件"
                aria-label="下载文件"
                loading="{{downloadBusy}}"
                disabled="{{downloadBusy || shareBusy}}"
                bindpress="handleDownload"
              ></ui-button
              ><ui-button
                variant="secondary"
                label="取消"
                disabled="{{shareBusy}}"
                bindpress="handleReset"
              ></ui-button></view
          ></view>

          <view
            wx:if="{{state === 'idle' || state === 'waiting' || state === 'failed'}}"
            class="export-actions"
            ><ui-button
              wx:if="{{state === 'failed'}}"
              variant="secondary"
              label="重新开始"
              bindpress="handleReset"
            ></ui-button
            ><ui-button
              wx:else
              variant="secondary"
              label="{{state === 'waiting' ? '停止等待' : '取消'}}"
              bindpress="handleCancel"
            ></ui-button
            ><ui-button
              variant="primary"
              label="{{state === 'waiting' ? '正在生成' : (format === 'xlsx' ? '导出 Excel' : '导出 CSV')}}"
              loading="{{state === 'waiting'}}"
              disabled="{{state === 'waiting'}}"
              bindpress="handleCreate"
            ></ui-button
          ></view>
        </view>

        <view class="security-note"
          ><text class="security-title">下载安全</text
          ><text
            >下载后点击“发送文件”，自行选择联系人或文件传输助手。临时文件将在离开页面后清理，不写入业务缓存。</text
          ></view
        >
        <view class="bottom-spacer"></view>
      </view>
    </view>
  </scroll-view>
</view>
