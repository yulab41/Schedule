<block wx:if="{{embedded && mode === 'notifications'}}">
  <view
    class="notification-sheet-content {{viewportClass}} {{largeText ? 'is-large-text' : ''}}"
  >
    <view wx:if="{{state === 'loading'}}" class="notification-sheet-state">
      <ui-loading label="正在读取通知"></ui-loading>
    </view>
    <view wx:elif="{{state === 'disabled'}}" class="notification-sheet-state">
      <view class="state-mark">—</view>
      <text class="state-title">通知中心暂未开放</text>
      <text class="state-copy">当前版本未开启通知能力，不会读取或展示通知内容。</text>
    </view>
    <view wx:elif="{{state === 'error'}}" class="notification-sheet-state">
      <ui-alert tone="danger" title="通知暂时无法加载" message="{{errorMessage}}"></ui-alert>
      <ui-button variant="primary" label="重新加载" bindpress="handleRetry"></ui-button>
    </view>
    <view wx:elif="{{state === 'empty'}}" class="notification-sheet-state">
      <view class="state-mark">○</view>
      <text class="state-title">暂无通知</text>
      <text class="state-copy">排班发布、请假和换班产生的提醒会显示在这里。</text>
    </view>
    <view wx:else class="notification-sheet-ready">
      <view class="notification-sheet-summary">
        <view class="notification-sheet-summary-copy">
          <text class="notification-sheet-unread">{{unreadCount}} 条未读</text>
          <text class="notification-sheet-hint">点按一条通知即可标记为已读</text>
        </view>
        <view
          class="notification-sheet-read-all {{actionBusyId !== '' ? 'is-disabled' : ''}}"
          hover-class="{{actionBusyId !== '' ? 'none' : 'is-pressed'}}"
          aria-role="button"
          aria-label="全部标记为已读"
          aria-disabled="{{actionBusyId !== ''}}"
          bindtap="handleMarkAllRead"
          >全部已读</view
        >
      </view>
      <scroll-view
        class="notification-sheet-scroll"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="notification-sheet-list">
          <view
            wx:for="{{notifications}}"
            wx:key="id"
            class="notification-sheet-item {{item.isRead ? 'is-read' : 'is-unread'}}"
            hover-class="{{actionBusyId === '' ? 'is-pressed' : 'none'}}"
            data-id="{{item.id}}"
            aria-role="button"
            aria-label="{{item.isRead ? '已读' : '未读'}}：{{item.title}}"
            bindtap="handleMarkRead"
          >
            <view class="notification-sheet-item-header">
              <text class="notification-type is-{{item.typeTone}}">{{item.typeLabel}}</text>
              <text class="notification-sheet-time">{{item.createdAtLabel}}</text>
            </view>
            <text class="notification-sheet-title">{{item.title}}</text>
            <text class="notification-sheet-body">{{item.body}}</text>
          </view>
          <view wx:if="{{nextCursor}}" class="notification-sheet-more">
            <ui-button
              variant="secondary"
              label="{{loadingMore ? '正在加载' : '加载更多'}}"
              loading="{{loadingMore}}"
              disabled="{{loadingMore}}"
              bindpress="handleLoadMore"
            ></ui-button>
          </view>
        </view>
      </scroll-view>
      <ui-alert
        wx:if="{{errorMessage}}"
        tone="danger"
        title="通知操作未完成"
        message="{{errorMessage}}"
      ></ui-alert>
    </view>
  </view>
</block>

<view wx:else class="notifications-page {{viewportClass}} {{largeText ? 'is-large-text' : ''}}">
  <view class="mini-header" style="{{shellHeaderStyle}}"
    ><view
      class="header-back"
      hover-class="is-pressed"
      aria-role="button"
      aria-label="返回更多工具"
      bindtap="handleBack"
      ><image src="/assets/icons/web-chevron-left.svg" mode="aspectFit" /></view
    ><view class="header-title"
      ><text class="header-title-main">{{mode === 'settings' ? '通知设置' : '通知中心'}}</text
      ><text class="header-title-sub"
        >{{mode === 'settings' ? '群组默认与本人提醒' : '排班、请假与换班提醒'}}</text
      ></view
    ><text class="phase-chip">P9</text></view
  >
  <scroll-view
    class="notifications-scroll"
    style="{{pageScrollStyle}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    ><view class="page-content">
      <block wx:if="{{mode === 'settings'}}">
        <view wx:if="{{state === 'loading'}}" class="page-state-card"
          ><ui-loading label="正在读取通知设置"></ui-loading
        ></view>
        <view wx:elif="{{state === 'disabled'}}" class="page-state-card insights-disabled"
          ><view class="state-mark">—</view><text class="state-title">通知提醒暂未开放</text
          ><text class="state-copy"
            >当前版本未开启 externalMessages 能力，不会请求微信授权或读取通知偏好。</text
          ></view
        >
        <view wx:elif="{{state === 'error'}}" class="page-state-card"
          ><ui-alert
            tone="danger"
            title="通知设置暂时无法加载"
            message="{{errorMessage}}"
          ></ui-alert
          ><ui-button variant="primary" label="重新加载" bindpress="handleRetry"></ui-button
        ></view>
        <view wx:else class="settings-content"
          ><view class="page-heading"
            ><text class="section-eyebrow">提醒节奏</text
            ><text class="page-title">通知设置</text
            ><text class="page-description"
              >站内通知始终可用；微信权限只在主动开启时申请，订阅授权只在点击开启时请求。</text
            ></view
          ><view wx:if="{{canManageGroupSettings}}" class="settings-card"
            ><text class="settings-title">群组默认提醒时间</text
            ><text class="settings-description">值班前提醒小时数，最多 5 个，使用逗号分隔。</text
            ><input
              class="hours-input"
              value="{{groupHoursInput}}"
              placeholder="例如：24, 2"
              disabled="{{groupSettingsBusy}}"
              bindinput="handleGroupHoursInput" />
            <ui-button
              variant="primary"
              label="保存群组设置"
              loading="{{groupSettingsBusy}}"
              disabled="{{groupSettingsBusy}}"
              bindpress="handleSaveGroupSettings"
            ></ui-button></view
          ><view class="settings-card"
            ><text class="settings-title">我的提醒</text
            ><text class="settings-description">选择群组默认、自定义或关闭值班提醒。</text
            ><view class="reminder-mode" aria-label="值班提醒时间"
              ><view
                class="reminder-mode-option {{myHoursMode === 'default' ? 'is-active' : ''}}"
                aria-role="button"
                aria-label="使用群组默认"
                data-mode="default"
                bindtap="handleReminderMode"
                >使用群组默认</view
              ><view
                class="reminder-mode-option {{myHoursMode === 'custom' ? 'is-active' : ''}}"
                aria-role="button"
                aria-label="自定义提醒时间"
                data-mode="custom"
                bindtap="handleReminderMode"
                >自定义</view
              ><view
                class="reminder-mode-option {{myHoursMode === 'off' ? 'is-active' : ''}}"
                aria-role="button"
                aria-label="关闭值班提醒"
                data-mode="off"
                bindtap="handleReminderMode"
                >关闭值班提醒</view
              ></view
            ><input
              wx:if="{{myHoursMode === 'custom'}}"
              class="hours-input"
              value="{{myHoursInput}}"
              placeholder="例如：48, 12"
              disabled="{{mySettingsBusy}}"
              bindinput="handleMyHoursInput" />
            <ui-button
              variant="primary"
              label="保存我的设置"
              loading="{{mySettingsBusy}}"
              disabled="{{mySettingsBusy}}"
              bindpress="handleSaveMyPreferences"
            ></ui-button></view
          ><view class="settings-card"
            ><view class="settings-row"
              ><view class="settings-copy"
                ><text class="settings-title">接收微信值班提醒</text
                ><text class="settings-description"
                  >当前状态：{{enabled ? '已开启' : '已关闭'}}</text
                ></view
              ><ui-switch
                checked="{{enabled}}"
                label="接收微信值班提醒"
                disabled="{{busy}}"
                loading="{{busy}}"
                bind:change="handleToggle"
              ></ui-switch></view
            ><view class="audit-note"
              ><text class="audit-mark">⌁</text
              ><text
                >授权结果仅用于本次设置。未获得微信订阅授权、被拒绝或被封禁时，不会把开关误显示为开启。</text
              ></view
            ></view
          ><ui-alert
            wx:if="{{errorMessage}}"
            tone="danger"
            title="设置未保存"
            message="{{errorMessage}}"
          ></ui-alert
          ><ui-alert
            wx:if="{{infoMessage}}"
            tone="info"
            title="设置状态"
            message="{{infoMessage}}"
          ></ui-alert
          ><view wx:if="{{!templateConfigured}}" class="template-note"
            ><text class="template-note-title">模板尚未配置</text
            ><text class="template-note-copy"
              >当前体验版本尚未配置已批准的微信订阅模板，授权入口保持关闭。</text
            ></view
          ><view class="bottom-spacer"></view
        ></view>
      </block>
      <block wx:else>
        <view wx:if="{{state === 'loading'}}" class="page-state-card"
          ><ui-loading label="正在读取通知"></ui-loading
        ></view>
        <view wx:elif="{{state === 'disabled'}}" class="page-state-card insights-disabled"
          ><view class="state-mark">—</view><text class="state-title">通知中心暂未开放</text
          ><text class="state-copy"
            >当前版本未开启 insights 能力，不会读取或展示通知内容。</text
          ></view
        >
        <view wx:elif="{{state === 'error'}}" class="page-state-card"
          ><ui-alert tone="danger" title="通知暂时无法加载" message="{{errorMessage}}"></ui-alert
          ><ui-button variant="primary" label="重新加载" bindpress="handleRetry"></ui-button
        ></view>
        <view wx:elif="{{state === 'empty'}}" class="page-state-card"
          ><view class="state-mark">○</view><text class="state-title">暂无通知</text
          ><text class="state-copy">排班发布、请假和换班产生的提醒会显示在这里。</text></view
        >
        <view wx:else class="notifications-content"
          ><view class="page-heading"
            ><text class="section-eyebrow">值班台账 / 消息</text
            ><text class="page-title">通知中心</text
            ><text class="page-description"
              >只展示与当前群组和本人有关的提醒；通知正文不会写入本地缓存。</text
            ></view
          ><view class="summary-row"
            ><text class="unread-badge">{{unreadCountLabel}}</text
            ><ui-button
              variant="secondary"
              label="全部标为已读"
              disabled="{{actionBusyId !== ''}}"
              loading="{{actionBusyId === 'all'}}"
              bindpress="handleMarkAllRead"
            ></ui-button></view
          ><view class="notifications-card"
            ><view
              wx:for="{{notifications}}"
              wx:key="id"
              class="notification-row {{item.isRead ? 'is-read' : 'is-unread'}}"
              ><view class="notification-marker"><view></view></view
              ><view class="notification-main"
                ><view class="notification-heading"
                  ><text class="notification-title">{{item.title}}</text
                  ><text class="notification-type is-{{item.typeTone}}"
                    >{{item.typeLabel}}</text
                  ></view
                ><text class="notification-body">{{item.body}}</text
                ><text class="notification-time">{{item.createdAtLabel}}</text></view
              ><ui-button
                wx:if="{{!item.isRead}}"
                variant="secondary"
                label="已读"
                data-id="{{item.id}}"
                disabled="{{actionBusyId !== ''}}"
                loading="{{actionBusyId === item.id}}"
                bindpress="handleMarkRead"
              ></ui-button></view
            ><view wx:if="{{nextCursor}}" class="load-more"
              ><ui-button
                variant="secondary"
                label="{{loadingMore ? '正在加载' : '加载更多通知'}}"
                loading="{{loadingMore}}"
                disabled="{{loadingMore}}"
                bindpress="handleLoadMore"
              ></ui-button></view></view
          ><ui-alert
            wx:if="{{errorMessage}}"
            tone="danger"
            title="通知操作未完成"
            message="{{errorMessage}}"
          ></ui-alert
          ><view class="bottom-spacer"></view
        ></view>
      </block> </view
  ></scroll-view>
</view>
