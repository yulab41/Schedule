<view class="notifications-page {{viewportClass}}">
  <view class="mini-header" style="{{shellHeaderStyle}}"><view class="header-back" hover-class="is-pressed" aria-role="button" aria-label="返回更多工具" bindtap="handleBack"><image src="/assets/icons/web-chevron-left.svg" mode="aspectFit" /></view><view class="header-title"><text class="header-title-main">通知中心</text><text class="header-title-sub">排班、请假与换班提醒</text></view><text class="phase-chip">P9</text></view>
  <scroll-view class="notifications-scroll" style="{{pageScrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}"><view class="page-content">
    <view wx:if="{{state === 'loading'}}" class="page-state-card"><ui-loading label="正在读取通知"></ui-loading></view>
    <view wx:elif="{{state === 'disabled'}}" class="page-state-card insights-disabled"><view class="state-mark">—</view><text class="state-title">通知中心暂未开放</text><text class="state-copy">当前版本未开启 insights 能力，不会读取或展示通知内容。</text></view>
    <view wx:elif="{{state === 'error'}}" class="page-state-card"><ui-alert tone="danger" title="通知暂时无法加载" message="{{errorMessage}}"></ui-alert><ui-button variant="primary" label="重新加载" bindpress="handleRetry"></ui-button></view>
    <view wx:elif="{{state === 'empty'}}" class="page-state-card"><view class="state-mark">○</view><text class="state-title">暂无通知</text><text class="state-copy">排班发布、请假和换班产生的提醒会显示在这里。</text></view>
    <view wx:else class="notifications-content"><view class="page-heading"><text class="section-eyebrow">值班台账 / 消息</text><text class="page-title">通知中心</text><text class="page-description">只展示与当前群组和本人有关的提醒；通知正文不会写入本地缓存。</text></view><view class="summary-row"><text class="unread-badge">{{unreadCountLabel}}</text><ui-button variant="secondary" label="全部标为已读" disabled="{{actionBusyId !== ''}}" loading="{{actionBusyId === 'all'}}" bindpress="handleMarkAllRead"></ui-button></view><view class="notifications-card"><view wx:for="{{notifications}}" wx:key="id" class="notification-row {{item.isRead ? 'is-read' : 'is-unread'}}"><view class="notification-marker"><view></view></view><view class="notification-main"><view class="notification-heading"><text class="notification-title">{{item.title}}</text><text class="notification-type">{{item.typeLabel}}</text></view><text class="notification-body">{{item.body}}</text><text class="notification-time">{{item.createdAtLabel}}</text></view><ui-button wx:if="{{!item.isRead}}" variant="secondary" label="已读" data-id="{{item.id}}" disabled="{{actionBusyId !== ''}}" loading="{{actionBusyId === item.id}}" bindpress="handleMarkRead"></ui-button></view><view wx:if="{{nextCursor}}" class="load-more"><ui-button variant="secondary" label="{{loadingMore ? '正在加载' : '加载更多通知'}}" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindpress="handleLoadMore"></ui-button></view></view><ui-alert wx:if="{{errorMessage}}" tone="danger" title="通知操作未完成" message="{{errorMessage}}"></ui-alert><view class="bottom-spacer"></view></view>
  </view></scroll-view>
</view>
