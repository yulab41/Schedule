.visitor-access-page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-background);
}

.mini-header {
  display: flex;
  padding: 0 14px 0 8px;
  box-sizing: border-box;
  align-items: center;
  gap: 8px;
  background: var(--ui-color-surface);
  border-bottom: 1px solid var(--ui-color-border);
}

.header-back {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.header-back image {
  width: 20px;
  height: 20px;
}

.header-title {
  min-width: 0;
  flex: 1;
}

.header-title-main,
.header-title-sub,
.page-heading,
.card-header,
.chart-item,
.access-row,
.access-main,
.access-meta,
.page-state-card {
  display: flex;
}

.header-title-main,
.header-title-sub,
.page-heading,
.chart-item,
.access-main,
.page-state-card {
  flex-direction: column;
}

.header-title-main {
  overflow: hidden;
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-title-sub {
  margin-top: 2px;
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phase-chip,
.count-badge {
  display: inline-flex;
  min-height: 24px;
  padding: 0 8px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary-dark);
  background: var(--ui-color-primary-light);
  border-radius: var(--ui-radius-pill);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
}

.visitor-access-scroll {
  width: 100%;
}

.page-content {
  padding: 16px 14px;
}

.visitor-access-content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.page-heading {
  gap: 3px;
}

.section-eyebrow,
.card-subtitle,
.privacy-title,
.access-month,
.access-meta,
.state-copy {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
}

.page-title {
  font-size: var(--ui-font-size-xl);
  font-weight: var(--ui-font-weight-semibold);
}

.page-description,
.privacy-note,
.state-copy,
.card-empty {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-body);
}

.privacy-note,
.aggregate-card,
.logs-card,
.page-state-card {
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
  box-shadow: var(--ui-shadow-card);
}

.privacy-note {
  display: flex;
  padding: 11px 12px;
  flex-direction: column;
  gap: 3px;
  background: var(--ui-color-primary-light);
  border-color: var(--ui-color-primary-border);
}

.privacy-title {
  color: var(--ui-color-primary-dark);
  font-weight: var(--ui-font-weight-semibold);
}

.card-header {
  min-height: 58px;
  padding: 10px 12px;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border-bottom: 1px solid var(--ui-color-border);
}

.card-header > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 3px;
}

.card-title {
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
}

.chart-row {
  display: flex;
  min-height: 170px;
  padding: 18px 12px 12px;
  align-items: flex-end;
  justify-content: space-around;
  gap: 8px;
}

.chart-item {
  min-width: 38px;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
}

.chart-value,
.chart-label {
  color: var(--ui-color-text-secondary);
  font-size: 10px;
  text-align: center;
  white-space: nowrap;
}

.chart-value {
  color: var(--ui-color-primary-dark);
  font-weight: var(--ui-font-weight-semibold);
}

.bar-track {
  display: flex;
  width: 24px;
  height: 98px;
  align-items: flex-end;
  background: var(--ui-color-surface-muted);
  border-radius: 8px 8px 4px 4px;
}

.bar-fill {
  width: 100%;
  min-height: 12px;
  background: var(--ui-color-primary);
  border-radius: 8px 8px 4px 4px;
}

.card-empty {
  padding: 20px 12px;
  text-align: center;
}

.access-row {
  position: relative;
  min-height: 70px;
  padding: 12px 12px 12px 28px;
  box-sizing: border-box;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid var(--ui-color-border);
}

.audit-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 14px;
  width: 2px;
  background: var(--ui-color-primary-border);
}

.audit-dot {
  position: absolute;
  top: 25px;
  left: -4px;
  width: 10px;
  height: 10px;
  background: var(--ui-color-primary);
  border: 3px solid var(--ui-color-primary-light);
  border-radius: 50%;
}

.access-main {
  min-width: 0;
  flex: 1;
  gap: 4px;
}

.access-date {
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.access-meta {
  min-width: 92px;
  align-items: flex-end;
  flex-direction: column;
  gap: 4px;
  text-align: right;
}

.load-more {
  display: flex;
  padding: 12px;
  justify-content: center;
}

.page-state-card {
  min-height: 260px;
  padding: 28px 18px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 10px;
  text-align: center;
}

.disabled-mark,
.empty-mark {
  display: flex;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary-dark);
  background: var(--ui-color-primary-light);
  border-radius: 50%;
  font-size: 24px;
  font-weight: var(--ui-font-weight-semibold);
}

.empty-mark {
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface-muted);
}

.state-title {
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-semibold);
}

.state-copy {
  max-width: 300px;
}

.bottom-spacer {
  height: 28px;
}

.is-compact .page-content {
  padding: 12px 10px;
}

.is-compact .chart-row {
  gap: 3px;
  padding-right: 6px;
  padding-left: 6px;
}

.is-compact .bar-track {
  width: 18px;
}

@media (prefers-reduced-motion: reduce) {
  .bar-fill {
    transition: none;
  }
}
