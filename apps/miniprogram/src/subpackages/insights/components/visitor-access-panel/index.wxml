<view class="visitor-access-page {{viewportClass}} {{largeText ? 'is-large-text' : ''}}">
  <view class="mini-header" style="{{shellHeaderStyle}}">
    <view
      class="header-back"
      hover-class="is-pressed"
      aria-role="button"
      aria-label="返回更多工具"
      bindtap="handleBack"
      ><image src="/assets/icons/web-chevron-left.svg" mode="aspectFit"
    /></view>
    <view class="header-title"
      ><text class="header-title-main">谁在查看排班？</text
      ><text class="header-title-sub">访客访问 · 只读审计</text></view
    >
    <text class="phase-chip">P9</text>
  </view>
  <scroll-view
    class="visitor-access-scroll"
    style="{{pageScrollStyle}}"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="page-content">
      <view wx:if="{{state === 'disabled'}}" class="page-state-card insights-disabled"
        ><view class="disabled-mark">i</view
        ><text class="state-title">审计功能尚未开放</text
        ><text class="state-copy"
          >当前版本只保留排班核心能力，访客访问记录将在 RC 后开放；不会读取或展示任何访问记录。</text
      ></view>
      <view wx:elif="{{state === 'error'}}" class="page-state-card"
        ><ui-alert tone="danger" title="访问记录暂时无法加载" message="{{errorMessage}}"></ui-alert
        ><ui-button variant="primary" label="重新加载" bindpress="handleRetry"></ui-button
      ></view>
      <view wx:elif="{{state === 'empty'}}" class="page-state-card empty-state"
        ><view class="empty-mark">日</view
        ><text class="state-title">暂无访客访问记录</text
        ><text class="state-copy">访客查看排班后，记录会出现在这里。</text
      ></view>
      <view wx:else class="visitor-access-content">
        <view class="page-heading"
          ><text class="section-eyebrow">审计轨 / 访客访问</text
          ><text class="page-title">谁在查看排班？</text
          ><text class="page-description"
            >只记录访问时间、查看月份和最小化来源线索，帮助群主管理访客入口。</text
        ></view>

        <view class="privacy-note"
          ><text class="privacy-title">隐私保留</text
          ><text>访问明细最多保留 90 天，随后只保留匿名月份聚合。</text></view
        >

        <view class="aggregate-card">
          <view class="card-header"
            ><view
              ><text class="card-title">近四个月访问次数</text
              ><text class="card-subtitle">按访问月份聚合 · 原始访问记录保留 90 天</text></view
            ><text class="count-badge">{{aggregateCountLabel}}</text></view
          >
          <view wx:if="{{state === 'loading'}}" class="log-skeletons" aria-label="正在加载访问记录"
            ><view class="log-skeleton wide"></view
            ><view class="log-skeleton"></view
          ></view>
          <view wx:elif="{{aggregates.length === 0}}" class="card-empty">暂无月份聚合。</view>
          <view wx:else class="chart-row"
            ><view wx:for="{{aggregates}}" wx:for-item="aggregateItem" wx:key="accessMonth" class="chart-item"
              ><text class="chart-value">{{aggregateItem.accessCountLabel}}</text
              ><view class="bar-track"
                ><view class="bar-fill" style="height:{{aggregateItem.barHeight}}%;"></view></view
              ><text class="chart-label">{{aggregateItem.accessMonthLabel}}</text></view
          ></view>
        </view>

        <view class="logs-card">
          <view class="card-header"
            ><view
              ><text class="card-title">最近访问</text
              ><text class="card-subtitle">查看月份 · 来源已脱敏</text></view
            ><text class="count-badge">{{logCountLabel}}</text></view
          >
          <view wx:if="{{state === 'loading'}}" class="log-skeletons" aria-label="正在加载访问记录"
            ><view class="log-skeleton"></view
            ><view class="log-skeleton"></view
            ><view class="log-skeleton short"></view
          ></view>
          <view wx:elif="{{logs.length === 0}}" class="card-empty">暂无访问记录。</view>
          <view wx:else class="log-list"
            ><view wx:for="{{logs}}" wx:for-item="logItem" wx:key="id" class="access-row"
              ><view class="audit-line" aria-hidden="true"><view class="audit-dot"></view></view
              ><view class="access-main"
                ><text class="access-date">{{logItem.createdAtLabel}}</text
                ><text class="access-month">查看 {{logItem.businessMonthLabel}} 排班</text></view
              ><view class="access-meta"
                ><text>{{logItem.ipLabel}}</text><text>{{logItem.requestIdLabel}}</text></view
            ></view
          ></view>
          <view wx:if="{{nextCursor}}" class="load-more"
            ><ui-button
              variant="secondary"
              label="{{loadingMore ? '正在加载' : '加载更多记录'}}"
              loading="{{loadingMore}}"
              disabled="{{loadingMore}}"
              bindpress="handleLoadMore"
          ></ui-button></view
        ></view>
        <ui-alert
          wx:if="{{loadMoreError}}"
          tone="danger"
          title="更多记录加载失败"
          message="{{loadMoreError}}"
        ></ui-alert>
        <view class="visitor-privacy"
          ><text>仅群主和管理员可见；访客凭证不会出现在记录中。</text></view
        >
        <view class="bottom-spacer"></view>
      </view>
    </view>
  </scroll-view>
</view>
