.insights-dashboard-page { width: 100%; height: 100%; overflow: hidden; color: var(--ui-color-text-primary); background: var(--ui-color-background); }
.mini-header { display: flex; padding: 0 14px 0 8px; box-sizing: border-box; align-items: center; gap: 8px; background: var(--ui-color-surface); border-bottom: 1px solid var(--ui-color-border); }
.header-back { display: flex; width: 44px; height: 44px; flex: none; align-items: center; justify-content: center; border-radius: 50%; }
.header-back image { width: 20px; height: 20px; }
.header-title { min-width: 0; flex: 1; }
.header-title-main, .header-title-sub, .page-heading, .card-header, .event-row, .event-main, .role-heading, .page-state-card { display: flex; }
.header-title-main, .header-title-sub, .page-heading, .event-main, .page-state-card { flex-direction: column; }
.header-title-main { overflow: hidden; font-size: var(--ui-font-size-md); font-weight: var(--ui-font-weight-semibold); text-overflow: ellipsis; white-space: nowrap; }
.header-title-sub { margin-top: 2px; overflow: hidden; color: var(--ui-color-text-secondary); font-size: var(--ui-font-size-xs); text-overflow: ellipsis; white-space: nowrap; }
.phase-chip, .count-badge { display: inline-flex; min-height: 24px; padding: 0 8px; box-sizing: border-box; align-items: center; justify-content: center; color: var(--ui-color-primary-dark); background: var(--ui-color-primary-light); border-radius: var(--ui-radius-pill); font-size: var(--ui-font-size-xs); font-weight: var(--ui-font-weight-semibold); }
.insights-dashboard-scroll { width: 100%; }
.page-content { padding: 16px 14px; }
.dashboard-content, .statistics-content { display: flex; flex-direction: column; gap: 12px; }
.page-heading { gap: 3px; }
.section-eyebrow, .card-subtitle, .metric-label, .metric-note, .event-time, .event-detail, .privacy-title, .state-copy { color: var(--ui-color-text-secondary); font-size: var(--ui-font-size-xs); }
.page-title { font-size: var(--ui-font-size-xl); font-weight: var(--ui-font-weight-semibold); }
.page-description, .privacy-note, .state-copy, .card-empty { color: var(--ui-color-text-secondary); font-size: var(--ui-font-size-sm); line-height: var(--ui-line-height-body); }
.tab-switch, .surface-card, .privacy-note, .metrics-row, .page-state-card { background: var(--ui-color-surface); border: 1px solid var(--ui-color-border); border-radius: var(--ui-radius-medium); box-shadow: var(--ui-shadow-card); }
.tab-switch { display: flex; padding: 4px; gap: 4px; }
.tab-item { display: flex; min-height: 44px; flex: 1; align-items: center; justify-content: center; color: var(--ui-color-text-secondary); border-radius: var(--ui-radius-small); font-size: var(--ui-font-size-sm); font-weight: var(--ui-font-weight-semibold); }
.tab-item.is-active { color: var(--ui-color-primary-dark); background: var(--ui-color-primary-light); }
.card-header { min-height: 58px; padding: 10px 12px; box-sizing: border-box; align-items: center; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--ui-color-border); }
.card-header > view { display: flex; min-width: 0; flex-direction: column; gap: 3px; }
.card-title { font-size: var(--ui-font-size-md); font-weight: var(--ui-font-weight-semibold); }
.event-row { position: relative; min-height: 76px; padding: 12px 12px 12px 34px; box-sizing: border-box; flex-direction: row; gap: 10px; border-bottom: 1px solid var(--ui-color-border); }
.event-row:last-child { border-bottom: 0; }
.event-pin { position: absolute; top: 0; bottom: 0; left: 16px; width: 2px; background: var(--ui-color-primary-border); }
.event-dot { position: absolute; top: 29px; left: -5px; width: 10px; height: 10px; background: var(--ui-color-primary); border: 3px solid var(--ui-color-primary-light); border-radius: 50%; }
.event-main { min-width: 0; flex: 1; gap: 3px; }
.event-title { font-size: var(--ui-font-size-sm); font-weight: var(--ui-font-weight-semibold); }
.event-detail { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.metrics-row { display: flex; padding: 10px; gap: 8px; }
.metric-card { display: flex; min-height: 106px; flex: 1; padding: 10px; box-sizing: border-box; flex-direction: column; justify-content: space-between; background: var(--ui-color-surface-muted); border-radius: var(--ui-radius-small); }
.metric-value { margin: 6px 0; font-size: 24px; font-weight: var(--ui-font-weight-semibold); line-height: 1; }
.role-row { display: flex; padding: 12px; flex-direction: column; gap: 7px; border-bottom: 1px solid var(--ui-color-border); }
.role-row:last-child { border-bottom: 0; }
.role-heading { justify-content: space-between; color: var(--ui-color-text-primary); font-size: var(--ui-font-size-sm); font-weight: var(--ui-font-weight-semibold); }
.role-track { height: 8px; overflow: hidden; background: var(--ui-color-surface-muted); border-radius: var(--ui-radius-pill); }
.role-fill { height: 100%; background: var(--ui-color-primary); border-radius: inherit; }
.privacy-note { display: flex; padding: 11px 12px; flex-direction: column; gap: 3px; background: var(--ui-color-primary-light); border-color: var(--ui-color-primary-border); }
.privacy-title { color: var(--ui-color-primary-dark); font-weight: var(--ui-font-weight-semibold); }
.card-empty { padding: 20px 12px; text-align: center; }
.page-state-card { min-height: 260px; padding: 28px 18px; box-sizing: border-box; align-items: center; justify-content: center; gap: 10px; text-align: center; }
.state-mark { display: flex; width: 44px; height: 44px; align-items: center; justify-content: center; color: var(--ui-color-primary-dark); background: var(--ui-color-primary-light); border-radius: 50%; font-size: 24px; font-weight: var(--ui-font-weight-semibold); }
.state-title { font-size: var(--ui-font-size-lg); font-weight: var(--ui-font-weight-semibold); }
.state-copy { max-width: 300px; }
.bottom-spacer { height: 28px; }
.is-compact .page-content { padding: 12px 10px; }
.is-compact .metrics-row { gap: 4px; padding: 7px; }
.is-compact .metric-card { min-height: 98px; padding: 8px; }
.is-compact .metric-value { font-size: 21px; }
