var currentY = 0;
var originY = 0;
var startY = 0;
var moves = 0;
var tracking = false;

function clamp(value, minimum, maximum) {
  if (value < minimum) return minimum;
  if (value > maximum) return maximum;
  return value;
}

function firstTouch(event) {
  if (event.touches && event.touches.length > 0) return event.touches[0];
  if (event.changedTouches && event.changedTouches.length > 0) return event.changedTouches[0];
  return null;
}

function touchStart(event) {
  var touch = firstTouch(event);
  if (!touch) return;
  tracking = true;
  startY = touch.clientY;
  originY = currentY;
  return false;
}

function touchMove(event, ownerInstance) {
  var touch = firstTouch(event);
  if (!tracking || !touch) return false;
  currentY = clamp(originY + touch.clientY - startY, -88, 88);
  moves += 1;
  var dot = ownerInstance.selectComponent('#wheel-drag-probe-dot');
  if (dot) {
    dot.setStyle({ transform: 'translateY(' + currentY + 'px)' });
  }
  ownerInstance.callMethod('handleWheelDragProbeMove', {
    moves: moves,
    offset: currentY,
    styled: dot ? 1 : 0
  });
  return false;
}

function touchEnd(event, ownerInstance) {
  tracking = false;
  ownerInstance.callMethod('handleWheelDragProbeEnd', { moves: moves, offset: currentY });
  return false;
}

module.exports = {
  touchEnd: touchEnd,
  touchMove: touchMove,
  touchStart: touchStart
};
