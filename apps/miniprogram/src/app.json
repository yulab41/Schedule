{
  "pages": [
    "pages/identity/index",
    "pages/profile/index",
    "pages/workbench/index",
    "pages/index/index",
    "pages/calendar-poc/index",
    "pages/manual-matrix-poc/index",
    "pages/gesture-probe/index",
    "pages/admin-bind/preview",
    "pages/invite/invite",
    "pages/guest/guest"
  ],
  "subpackages": [
    {
      "root": "subpackages/scheduling",
      "pages": ["pages/manual/index", "pages/backfill/index"]
    },
    {
      "root": "subpackages/organization",
      "pages": [
        "pages/group-settings/index",
        "pages/scheduling-config/index",
        "pages/invite-visitor/index",
        "pages/invite-accept/index",
        "pages/platform-accounts/index",
        "pages/directory/index"
      ]
    },
    {
      "root": "subpackages/workflows",
      "pages": ["pages/leave/index", "pages/swap/index", "pages/duty/index"]
    },
    {
      "root": "subpackages/insights",
      "pages": [
        "pages/visitor-access/index",
        "pages/insights/index",
        "pages/notifications/index",
        "pages/exports/index",
        "pages/notification-settings/index"
      ]
    },
    {
      "root": "subpackages/diagnostics",
      "pages": ["pages/test-tools/index"]
    }
  ],
  "window": {
    "backgroundColor": "#F4F7FB",
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom"
  },
  "style": "v2",
  "renderer": "skyline",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "tagNameStyleIsolation": "legacy",
      "disableABTest": true,
      "sdkVersionBegin": "3.3.0",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
