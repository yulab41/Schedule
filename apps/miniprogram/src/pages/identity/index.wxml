<scroll-view class="identity-scroll" scroll-y show-scrollbar="{{false}}">
  <view class="identity-page {{mode === 'login' ? 'is-login' : ''}}">
    <view wx:if="{{mode === 'login'}}" class="identity-login-intro">
      <view class="identity-login-brand-mark" aria-hidden="true"><view></view><view></view></view>
      <text class="identity-login-title">清楚掌握每一次值班</text>
    </view>

    <block wx:else>
      <view class="identity-header">
        <view class="identity-brand"
          ><text class="identity-brand__mark">+</text><text>排班台</text></view
        >
        <text class="identity-build-label">{{buildLabel}}</text>
      </view>

      <view class="identity-progress">
        <view class="identity-progress__track"
          ><view class="identity-progress__fill" style="width: 72%"></view
        ></view>
        <view class="identity-progress__labels">
          <text class="is-active">微信身份</text>
          <text class="is-active">账号证明</text>
          <text>进入排班</text>
        </view>
      </view>

      <view class="identity-heading">
        <text class="identity-eyebrow">{{mode === 'register' ? '首次建档' : '账号证明'}}</text>
        <text class="identity-title"
          >{{mode === 'choice' ? '找到你的排班账号' : mode === 'password' ? '绑定既有账号' :
          '补全你的微信档案'}}</text
        >
        <text class="identity-description"
          >{{mode === 'choice' ? '这个微信身份还没有绑定排班账号，请选择下一步。' : mode ===
          'password' ? '使用平台管理员分配的账号完成一次绑定。' :
          '只需填写真实姓名，之后可由管理员完成入组。'}}</text
        >
      </view>
    </block>

    <view class="identity-card {{mode === 'login' ? 'identity-login-card' : ''}}">
      <ui-alert
        wx:if="{{errorMessage}}"
        class="identity-error"
        title="无法继续"
        message="{{errorMessage}}"
        tone="danger"
      ></ui-alert>

      <block wx:if="{{mode === 'login'}}">
        <view class="identity-login-field">
          <text class="identity-login-field__label">账号</text>
          <view class="identity-login-field__shell">
            <image
              class="identity-login-field__icon"
              src="/assets/icons/web-profile.svg"
              mode="aspectFit"
              aria-hidden="true"
            />
            <input
              class="identity-login-field__control"
              aria-label="账号"
              value="{{username}}"
              maxlength="64"
              placeholder="3-64 位字母、数字或 ._-"
              confirm-type="next"
              bindinput="handleUsernameChange"
            />
          </view>
        </view>
        <view class="identity-login-field identity-login-field--following">
          <text class="identity-login-field__label">密码</text>
          <view class="identity-login-field__shell">
            <image
              class="identity-login-field__icon"
              src="/assets/icons/web-lock.svg"
              mode="aspectFit"
              aria-hidden="true"
            />
            <input
              class="identity-login-field__control"
              aria-label="密码"
              password
              value="{{password}}"
              placeholder="请输入密码"
              confirm-type="done"
              bindinput="handlePasswordInput"
              bindconfirm="handlePasswordLogin"
            />
          </view>
        </view>
        <ui-button
          class="identity-card__button"
          label="进入工作台"
          variant="primary"
          loading="{{loading}}"
          bind:press="handlePasswordLogin"
        ></ui-button>
        <view class="identity-divider" aria-hidden="true"
          ><view></view><text>或</text><view></view
        ></view>
        <profile-avatar-login-button
          class="identity-card__button identity-card__button--secondary identity-card__button--wechat"
          label="微信快捷登录"
          loading="{{loading}}"
          bind:press="handleWechatLogin"
        ></profile-avatar-login-button>
      </block>

      <block wx:elif="{{mode === 'choice'}}">
        <view class="identity-status identity-status--info"
          ><text class="identity-status__icon">i</text><text>已找到可绑定的微信身份</text></view
        >
        <view class="identity-account"
          ><text class="identity-account__avatar">微</text
          ><view class="identity-account__copy"
            ><text>当前微信</text><text>请选择已有账号或首次建档</text></view
          ></view
        >
        <ui-button
          class="identity-card__button"
          label="绑定既有账号"
          variant="primary"
          bind:press="handleChoosePassword"
        ></ui-button>
        <ui-button
          class="identity-card__button identity-card__button--secondary"
          label="这是我第一次使用"
          variant="secondary"
          bind:press="handleChooseRegister"
        ></ui-button>
      </block>

      <block wx:elif="{{mode === 'password'}}">
        <view class="identity-status"
          ><text class="identity-status__icon">✓</text><text>已找到可绑定的排班账号</text></view
        >
        <ui-input-shell
          label="账号"
          value="{{username}}"
          placeholder="请输入平台管理员分配的账号"
          required
          bind:change="handleUsernameChange"
        ></ui-input-shell>
        <view class="identity-field"
          ><text class="identity-field__label">密码</text
          ><input
            class="identity-field__control"
            password
            value="{{password}}"
            placeholder="请输入密码"
            bindinput="handlePasswordInput"
        /></view>
        <ui-button
          class="identity-card__button"
          label="绑定并进入排班"
          variant="primary"
          loading="{{loading}}"
          bind:press="handleLinkPassword"
        ></ui-button>
        <ui-button
          class="identity-card__button identity-card__button--secondary"
          label="返回选择"
          variant="secondary"
          bind:press="handleBackToChoice"
        ></ui-button>
        <text class="identity-card__note"
          >密码只用于证明你拥有这个排班账号，不会显示给管理员。</text
        >
      </block>

      <block wx:elif="{{mode === 'register'}}">
        <view class="identity-status identity-status--info"
          ><text class="identity-status__icon">i</text><text>这是你的首次微信登录</text></view
        >
        <ui-input-shell
          label="真实姓名"
          value="{{realName}}"
          placeholder="请输入资料中的真实姓名"
          required
          bind:change="handleRealNameChange"
        ></ui-input-shell>
        <view class="identity-callout"
          ><text class="identity-callout__icon">!</text
          ><text>请填写证件或院内资料中的真实姓名，之后才能加入预设群组。</text></view
        >
        <ui-button
          class="identity-card__button"
          label="创建微信档案"
          variant="primary"
          loading="{{loading}}"
          bind:press="handleRegister"
        ></ui-button>
        <ui-button
          class="identity-card__button identity-card__button--secondary"
          label="返回选择"
          variant="secondary"
          bind:press="handleBackToChoice"
        ></ui-button>
      </block>
    </view>

    <text wx:if="{{mode === 'login'}}" class="identity-login-privacy"
      >账号只用于排班身份识别。联系信息仅对有权限的群组成员可见。</text
    >
    <text wx:if="{{mode === 'login'}}" class="identity-login-build">{{buildLabel}}</text>
    <text wx:else class="identity-privacy">⌁ 你的身份信息只用于进入有权限的排班群组</text>
  </view>
</scroll-view>
