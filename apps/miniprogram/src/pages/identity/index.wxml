<scroll-view class="identity-scroll" scroll-y show-scrollbar="{{false}}">
  <view class="identity-page is-login">
    <view class="identity-login-intro">
      <view class="identity-login-brand-mark" aria-hidden="true"><view></view><view></view></view>
      <text class="identity-login-title">清楚掌握每一次值班</text>
    </view>

    <view class="identity-card identity-login-card">
      <ui-alert
        class="identity-error"
        wx:if="{{errorMessage && !bindingOpen}}"
        title="无法继续"
        message="{{errorMessage}}"
        tone="danger"
      ></ui-alert>
      <view class="identity-login-form">
        <view class="identity-login-field">
          <text class="identity-login-field__label">账号</text>
          <view class="identity-login-field__shell">
            <image
              class="identity-login-field__icon"
              src="/assets/icons/ui-user.svg"
              mode="aspectFit"
              aria-hidden="true"
            />
            <input
              class="identity-login-field__control"
              aria-label="账号"
              value="{{username}}"
              maxlength="64"
              placeholder="3-64 位字母、数字或 ._-"
              confirm-type="next"
              bindinput="handleUsernameChange"
            />
          </view>
        </view>
        <view class="identity-login-field identity-login-field--following">
          <text class="identity-login-field__label">密码</text>
          <view class="identity-login-field__shell">
            <image
              class="identity-login-field__icon"
              src="/assets/icons/ui-lock.svg"
              mode="aspectFit"
              aria-hidden="true"
            />
            <input
              class="identity-login-field__control"
              aria-label="密码"
              password
              value="{{password}}"
              placeholder="请输入密码"
              confirm-type="done"
              bindinput="handlePasswordInput"
              bindconfirm="handlePasswordLogin"
            />
          </view>
        </view>
        <view class="identity-login-actions">
          <ui-button
            class="identity-card__button"
            label="进入工作台"
            variant="primary"
            loading="{{loading}}"
            bind:press="handlePasswordLogin"
          ></ui-button>
          <view class="identity-divider" aria-hidden="true"
            ><view></view><text>或</text><view></view
          ></view>
          <ui-button
            class="identity-card__button identity-card__button--secondary identity-card__button--wechat"
            variant="secondary"
            label="微信快捷登录"
            loading="{{loading}}"
            bind:press="handleWechatLogin"
          ></ui-button>
        </view>
      </view>
    </view>
    <text class="identity-login-privacy"
      >账号只用于排班身份识别。联系信息仅对有权限的群组成员可见。</text
    >
    <text class="identity-login-build">{{buildLabel}}</text>
  </view>
</scroll-view>
<ui-sheet
  wx:if="{{bindingOpen}}"
  visible="{{bindingOpen}}"
  title="绑定排班账号"
  close-label="取消"
  bind:close="handleBindingCancel"
>
  <view class="identity-binding-form">
    <text class="identity-binding-copy">当前微信尚未绑定账号，请输入账号密码完成绑定</text>
    <ui-input-shell
      label="账号"
      value="{{username}}"
      placeholder="请输入管理员分配的账号"
      disabled="{{loading}}"
      bind:change="handleUsernameChange"
    ></ui-input-shell>
    <view class="identity-field"
      ><text class="identity-field__label">密码</text
      ><input
        class="identity-field__control"
        password
        value="{{password}}"
        disabled="{{loading}}"
        placeholder="请输入密码"
        bindinput="handlePasswordInput"
        bindconfirm="handleLinkPassword"
    /></view>
    <ui-alert
      wx:if="{{errorMessage}}"
      title="绑定未完成"
      message="{{errorMessage}}"
      tone="danger"
    ></ui-alert>
    <ui-button
      variant="primary"
      label="绑定并登录"
      loading="{{loading}}"
      bind:press="handleLinkPassword"
    ></ui-button>
    <text class="identity-binding-copy">没有账号？请联系管理员领取。</text>
  </view>
</ui-sheet>
