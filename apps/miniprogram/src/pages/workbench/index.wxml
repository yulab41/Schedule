<view class="workbench-page">
  <scroll-view class="workbench-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="workbench-header">
      <view class="brand-lockup">
        <text class="brand-mark" aria-hidden="true">+</text>
        <text>排班台</text>
      </view>
      <text class="identity-chip">身份已确认</text>
    </view>

    <view class="workbench-content">
      <view class="workbench-heading">
        <view class="heading-copy">
          <text class="eyebrow">P4 · 已认证工作台</text>
          <text class="page-title">工作台</text>
          <text class="page-lede">只查看你有权限的群组排班。</text>
        </view>
        <view
          class="group-switch"
          hover-class="is-pressed"
          aria-role="button"
          aria-label="切换当前群组"
          bindtap="handleGroupToggle"
        >
          <text class="group-switch-label">当前群组</text>
          <text class="group-switch-name">{{currentGroupName}}</text>
          <text class="group-switch-role">{{currentGroupRole}}⌄</text>
        </view>
      </view>

      <view wx:if="{{groupOpen}}" class="group-menu" aria-label="选择当前群组">
        <view class="group-menu-heading"><text>选择群组</text><text>只读切换</text></view>
        <view
          wx:for="{{groups}}"
          wx:key="id"
          class="group-option {{item.id === currentGroupId ? 'is-selected' : ''}}"
          data-group-id="{{item.id}}"
          hover-class="is-pressed"
          aria-role="button"
          bindtap="handleGroupSelect"
        >
          <view class="group-option-copy"
            ><text>{{item.name}}</text
            ><text
              >{{item.role === 'owner' ? '群主' : item.role === 'administrator' ? '管理员' :
              item.role === 'guest' ? '访客' : '成员'}}</text
            ></view
          >
          <text wx:if="{{item.id === currentGroupId}}" class="option-check" aria-hidden="true"
            >✓</text
          >
        </view>
      </view>

      <view class="period-row">
        <text class="period-label">{{monthLabel}}</text>
        <text class="cache-note"><text class="cache-dot" />只读查看 · 24 小时缓存</text>
      </view>
      <text wx:if="{{offlineNotice}}" class="offline-note">{{offlineNotice}}</text>

      <view class="view-controls" aria-label="排班视图">
        <view class="view-switch" aria-role="tablist">
          <view
            wx:for="{{viewOptions}}"
            wx:key="*this"
            class="view-tab {{item === viewMode ? 'is-active' : ''}}"
            data-view="{{item}}"
            aria-role="tab"
            aria-selected="{{item === viewMode}}"
            bindtap="handleViewChange"
            >{{item === 'month' ? '月' : item === 'week' ? '周' : '列表'}}</view
          >
        </view>
        <view
          class="filter-button {{activeFilter !== 'all' ? 'has-filter' : ''}}"
          hover-class="is-pressed"
          aria-role="button"
          aria-label="筛选排班"
          bindtap="handleFilterToggle"
        >
          <view class="filter-icon" aria-hidden="true"
            ><view></view><view></view><view></view
          ></view>
          <text>筛选</text>
          <text wx:if="{{activeFilter !== 'all'}}" class="filter-count">1</text>
        </view>
      </view>

      <view wx:if="{{filterOpen}}" class="filter-panel" aria-label="筛选排班">
        <view class="filter-panel-heading"><text>筛选排班</text><text>只读条件</text></view>
        <view
          wx:for="{{filterOptions}}"
          wx:key="*this"
          class="filter-option {{item === activeFilter ? 'is-selected' : ''}}"
          data-filter="{{item}}"
          hover-class="is-pressed"
          aria-role="radio"
          aria-checked="{{item === activeFilter}}"
          bindtap="handleFilterSelect"
        >
          <text
            >{{item === 'all' ? '全部班次' : item === 'mine' ? '只看我的排班' :
            '只看有变更的班次'}}</text
          >
          <text wx:if="{{item === activeFilter}}" class="option-check" aria-hidden="true">✓</text>
        </view>
      </view>

      <text wx:if="{{announcement}}" class="sr-announcement" aria-live="polite"
        >{{announcement}}</text
      >

      <block wx:if="{{state === 'ready' && viewMode === 'month'}}">
        <calendar-month
          grid-height="{{gridHeight}}"
          month-label="{{monthLabel}}"
          panels="{{monthPanels}}"
          bind:locatetoday="handleLocateToday"
          bind:monthchange="handleMonthChange"
          bind:select="handleDateSelect"
        ></calendar-month>
        <view class="selected-detail" aria-label="选中日期值班详情">
          <view class="selected-detail-heading">
            <view class="summary-date"
              ><text>选中日期</text><text class="summary-date-value">{{selectedLabel}}</text></view
            >
            <text class="summary-count">{{selectedCountLabel}}</text>
          </view>
          <view wx:if="{{selectedDetails.length === 0}}" class="detail-empty"
            >当天没有已发布排班。</view
          >
          <view wx:for="{{selectedDetails}}" wx:key="title" class="summary-duty">
            <view class="shift-dot" style="background:{{item.color}}"></view>
            <view class="summary-duty-copy">
              <text class="summary-duty-title">{{item.title}}</text>
              <text class="summary-duty-note">{{item.note}}</text>
              <text wx:if="{{item.changeLabel}}" class="change-label">{{item.changeLabel}}</text>
            </view>
          </view>
          <text class="privacy-note">联系方式仅在群组成员单独同意后显示</text>
        </view>
      </block>

      <block wx:elif="{{state === 'ready' && viewMode === 'week'}}">
        <view class="week-calendar" aria-label="周视图">
          <view class="calendar-navigation">
            <view
              class="calendar-step"
              data-delta="-1"
              hover-class="is-pressed"
              aria-role="button"
              aria-label="上一周"
              bindtap="handleWeekChange"
              ><view class="chevron is-left"></view
            ></view>
            <view class="calendar-heading"
              ><text>{{weekRangeLabel}}</text><text>按周查看 · 左右滑动切换</text></view
            >
            <view
              class="calendar-locator"
              hover-class="is-pressed"
              aria-role="button"
              aria-label="定位到今天"
              bindtap="handleLocateToday"
              ><view class="locate-crosshair"><view></view></view
            ></view>
            <view
              class="calendar-step"
              data-delta="1"
              hover-class="is-pressed"
              aria-role="button"
              aria-label="下一周"
              bindtap="handleWeekChange"
              ><view class="chevron is-right"></view
            ></view>
          </view>
          <view class="week-day-row" aria-hidden="true"
            ><text
              wx:for="{{weekDays}}"
              wx:key="businessDate"
              class="{{item.isWeekend ? 'is-weekend' : ''}}"
              >{{item.weekday}}</text
            ></view
          >
          <view class="week-day-grid">
            <view
              wx:for="{{weekDays}}"
              wx:key="businessDate"
              class="week-day {{item.isSelected ? 'is-selected' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.isWeekend ? 'is-weekend' : ''}}"
              data-business-date="{{item.businessDate}}"
              hover-class="is-pressed"
              aria-role="button"
              bindtap="handleWeekDaySelect"
            >
              <text class="day-number">{{item.day}}</text
              ><text class="week-duty">{{item.duty}}</text>
            </view>
          </view>
        </view>
        <view class="selected-detail compact-detail" aria-label="选中日期值班详情">
          <view class="selected-detail-heading"
            ><view class="summary-date"
              ><text>选中日期</text><text class="summary-date-value">{{selectedLabel}}</text></view
            ><text class="summary-count">{{selectedCountLabel}}</text></view
          >
          <view wx:for="{{selectedDetails}}" wx:key="title" class="summary-duty"
            ><view class="shift-dot" style="background:{{item.color}}"></view
            ><view class="summary-duty-copy"
              ><text class="summary-duty-title">{{item.title}}</text
              ><text class="summary-duty-note">{{item.note}}</text></view
            ></view
          >
          <text class="privacy-note">联系方式仅在群组成员单独同意后显示</text>
        </view>
      </block>

      <block wx:elif="{{state === 'ready' && viewMode === 'list'}}">
        <view class="list-calendar" aria-label="列表视图">
          <view class="list-calendar-heading">
            <view
              class="calendar-step"
              data-delta="-1"
              hover-class="is-pressed"
              aria-role="button"
              aria-label="上一月"
              bindtap="handleListMonthChange"
              ><view class="chevron is-left"></view
            ></view>
            <view class="calendar-heading"
              ><text>{{monthLabel}}</text><text>固定月份 · {{listRows.length}} 个班次</text></view
            >
            <view
              class="calendar-locator"
              hover-class="is-pressed"
              aria-role="button"
              aria-label="定位到今天"
              bindtap="handleLocateToday"
              ><view class="locate-crosshair"><view></view></view
            ></view>
            <view
              class="calendar-step"
              data-delta="1"
              hover-class="is-pressed"
              aria-role="button"
              aria-label="下一月"
              bindtap="handleListMonthChange"
              ><view class="chevron is-right"></view
            ></view>
          </view>
          <text class="list-meta">月份工具栏固定 · 已按日期排序</text>
          <view wx:if="{{listRows.length === 0}}" class="detail-empty list-empty"
            >这个月没有已发布排班。</view
          >
          <view
            wx:for="{{listRows}}"
            wx:key="key"
            class="list-row {{item.businessDate === selectedDate ? 'is-selected' : ''}}"
            data-business-date="{{item.businessDate}}"
            hover-class="is-pressed"
            aria-role="button"
            bindtap="handleListSelect"
          >
            <view class="list-date"><text>{{item.day}}</text><text>{{item.weekday}}</text></view>
            <view class="list-copy"
              ><text class="list-title">{{item.shift}} · {{item.name}}</text
              ><text class="list-note">{{item.note}}</text></view
            ><text class="list-arrow">›</text>
          </view>
        </view>
      </block>

      <view wx:elif="{{state === 'loading'}}" class="state-card state-loading" aria-live="polite"
        ><view class="state-mark"><view class="state-spinner"></view></view
        ><text class="state-title">正在读取排班</text
        ><text class="state-description">正在读取当前群组的月历和班次。</text></view
      >
      <view wx:elif="{{state === 'empty'}}" class="state-card state-empty" aria-live="polite"
        ><view class="state-mark">日</view
        ><text class="state-title"
          >{{currentGroupId ? '暂时没有已发布排班' : '暂无可查看的群组'}}</text
        ><text class="state-description"
          >{{currentGroupId ? '群主完成发布后，这里会显示当前群组的值班安排。' :
          '身份确认后，加入有权限的群组即可查看排班。'}}</text
        ></view
      >
      <view wx:elif="{{state === 'offline'}}" class="state-card state-offline" aria-live="polite"
        ><view class="state-mark">日</view><text class="state-title">当前为离线状态</text
        ><text class="state-description"
          >只显示最近一次成功读取的内容，离线时不能提交业务变更。</text
        ></view
      >
      <view wx:elif="{{state === 'error'}}" class="state-card state-error" aria-live="polite"
        ><view class="state-mark">!</view><text class="state-title">排班暂时无法加载</text
        ><text class="state-description">{{errorMessage}}</text
        ><view
          class="retry-action"
          hover-class="is-pressed"
          aria-role="button"
          bindtap="handleRetry"
          >重新加载</view
        ><view
          wx:if="{{canReLogin}}"
          class="login-action"
          hover-class="is-pressed"
          aria-role="button"
          bindtap="handleOpenIdentity"
          >重新登录</view
        ></view
      >
    </view>
  </scroll-view>

  <view class="bottom-nav" aria-label="工作台导航">
    <view class="bottom-nav-item is-active" aria-role="button" aria-current="page"
      ><view class="nav-icon nav-calendar"></view><text>日历</text></view
    >
    <view
      class="bottom-nav-item is-disabled"
      data-label="请假"
      aria-disabled="true"
      aria-role="button"
      bindtap="handleUnavailable"
      ><view class="nav-icon nav-leave"></view><text>请假</text></view
    >
    <view
      class="bottom-nav-item is-disabled"
      data-label="换班"
      aria-disabled="true"
      aria-role="button"
      bindtap="handleUnavailable"
      ><view class="nav-icon nav-swap"></view><text>换班</text></view
    >
    <view
      class="bottom-nav-item is-disabled"
      data-label="调班"
      aria-disabled="true"
      aria-role="button"
      bindtap="handleUnavailable"
      ><view class="nav-icon nav-adjustment"></view><text>调班</text></view
    >
    <view
      class="bottom-nav-item is-disabled"
      data-label="更多"
      aria-disabled="true"
      aria-role="button"
      bindtap="handleUnavailable"
      ><view class="nav-icon nav-more"></view><text>更多</text></view
    >
  </view>
</view>
