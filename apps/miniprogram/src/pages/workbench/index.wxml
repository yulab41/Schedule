            data-kind="shift"
            data-value="{{item.value}}"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
            bindtap="handleFilterOptionToggle"
            ><text>{{item.label}}</text
            ><text class="filter-check">{{item.selected ? '✓' : ''}}</text></view
          >
          <text wx:if="{{filterShiftTypeOptions.length === 0}}" class="filter-field-empty"
            >暂无班种</text
          >
        </scroll-view>
      </view>

      <view class="filter-field">
        <text class="filter-field-label">成员</text>
        <view
          class="filter-select-trigger {{filterOpenField === 'member' ? 'is-open' : ''}}"
          id="filter-member-trigger"
          data-field="member"
          aria-role="button"
          aria-expanded="{{filterOpenField === 'member'}}"
          bindtap="handleFilterFieldToggle"
          ><text>{{filterMemberSummary}}</text><view class="filter-select-chevron"></view
        ></view>
        <scroll-view
          wx:if="{{filterOpenField === 'member'}}"
          class="filter-select-options {{filterDropdownDirection === 'up' ? 'is-up' : 'is-down'}}"
          scroll-y
          show-scrollbar="{{false}}"
        >
          <view
            wx:for="{{filterMemberOptions}}"
            wx:key="value"
            class="filter-select-option {{item.selected ? 'is-selected' : ''}}"
            data-kind="member"
            data-value="{{item.value}}"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
            bindtap="handleFilterOptionToggle"
          >
            <text>{{item.label}}</text
            ><text class="filter-check">{{item.selected ? '✓' : ''}}</text>
          </view>
          <text wx:if="{{filterMemberOptions.length === 0}}" class="filter-field-empty"
            >暂无成员</text
          >
        </scroll-view>
      </view>

      <view class="filter-sheet-actions">
        <view class="filter-clear" aria-role="button" bindtap="handleFilterClear">清除筛选</view>
        <view class="filter-apply" aria-role="button" bindtap="handleFilterApply">查看结果</view>
      </view>
    </view>
  </view>

