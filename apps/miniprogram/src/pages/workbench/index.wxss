}

.filter-select-option.is-selected {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  font-weight: var(--ui-font-weight-semibold);
}

.filter-check {
  color: var(--ui-color-primary);
}

.filter-field-empty {
  display: block;
  padding: 10px;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.filter-sheet-actions {
  position: absolute;
  right: 16px;
  bottom: calc(14px + env(safe-area-inset-bottom));
  left: 16px;
  padding-top: 14px;
  gap: 10px;
}

.filter-clear,
.filter-apply {
  display: flex;
  min-height: 44px;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.filter-clear {
  color: var(--ui-color-primary);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-primary);
}

.filter-apply {
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border: 1px solid var(--ui-color-primary);
}

@keyframes filter-backdrop-enter {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes click-period-chevron {
  0%,
  100% {
    transform: translateX(0);
  }
  48% {
    transform: translateX(2px);
  }
}

@keyframes click-period-chevron-left {
  0%,
  100% {
    transform: translateX(0);
  }
  48% {
    transform: translateX(-2px);
  }
}

@keyframes filter-sheet-enter {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes click-profile {
  0%,
  100% {
    transform: translateY(0);
  }
  42% {
    transform: translateY(-1.5px);
  }
  68% {
    transform: translateY(0.5px);
  }
}

@keyframes minimal-bell {
  0%,
  100% {
    transform: rotate(0deg);
  }
  22% {
    transform: rotate(-9deg);
  }
  44% {
    transform: rotate(8deg);
  }
  64% {
    transform: rotate(-5deg);
  }
  82% {
    transform: rotate(3deg);
  }
}

@keyframes minimal-draw {
  0%,
  100% {
    opacity: 0.35;
    transform: scaleX(0.35);
  }
  50% {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes minimal-swap-left {
  0%,
  50%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-2px);
  }
  75% {
    transform: translateX(1px);
  }
}

@keyframes minimal-swap-right {
  0%,
  50%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(2px);
  }
  75% {
    transform: translateX(-1px);
  }
}

@keyframes minimal-duty {
  0%,
  100% {
    opacity: 0.55;
    transform: scale(0.92);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
  }
}

@keyframes minimal-dot {
  0%,
  100% {
    opacity: 0.5;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-2px);
  }
}

@media (max-width: 340px) {
  .workbench-shell-header {
    padding-left: 10px;
  }

  .group-switcher-copy {
    max-width: 128px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .filter-sheet-backdrop,
  .filter-sheet,
  .bell-icon.is-animating,
  .profile-icon.is-animating,
  .nav-icon,
  .nav-icon view {
    animation: none !important;
    transition: none !important;
  }
}
