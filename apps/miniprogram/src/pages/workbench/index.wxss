.filter-sheet {
  position: relative;
  width: 100%;
  height: 468px;
  max-height: calc(100vh - 32px);
  padding: 7px 16px calc(14px + env(safe-area-inset-bottom));
  overflow: visible;
  box-sizing: border-box;
  background: var(--ui-color-surface);
  border-radius: 22px 22px 0 0;
