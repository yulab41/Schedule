@import "../../styles/ui-icon-motion.wxss";
@import '../../styles/calendar-date-marker.wxss';

page {
  height: 100%;
  background: var(--ui-color-background);
}

.workbench-page {
  height: 100%;
  min-height: 100%;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-background);
  font-family: var(--ui-font-family-system);
}

.workspace-host {
  position: absolute;
  right: 0;
  left: 0;
  width: 100%;
  overflow: hidden;
  background: var(--ui-color-background);
}

.workspace-pane-slot,
.workspace-pane {
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  background: var(--ui-color-background);
}

.workspace-pane directory-panel,
.workspace-pane workflow-swap-panel,
.workspace-pane profile-workspace {
  display: block;
  width: 100%;
  height: 100%;
}

.workspace-disabled-state {
  display: flex;
  height: 100%;
  padding: 24px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  text-align: center;
  background: var(--ui-color-background);
}

.workbench-scroll {
  height: 100%;
  box-sizing: border-box;
  padding-bottom: 0;
}

.view-controls,
.view-switch,
.filter-button,
.calendar-navigation,
.list-calendar-heading,
.bottom-nav-item {
  display: flex;
  align-items: center;
}

.embedded-workspace-loading {
  position: absolute;
  z-index: 2;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-background);
}

.more-workspace {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--ui-color-background);
}

.workbench-notifications-panel {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.more-workspace-content,
.more-heading,
.more-section,
.more-card,
.more-item > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.more-workspace-content {
  padding: 16px 14px 24px;
  gap: var(--ui-spacing-md);
}

.more-heading {
  gap: 4px;
}

.more-heading > text:first-child {
  font-size: var(--ui-font-size-xl);
  font-weight: var(--ui-font-weight-strong);
}

.more-heading > text:last-child {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
}

.more-section {
  gap: 6px;
}

.more-section-title {
  padding: 0 4px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
}

.more-card {
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-card);
}

.more-item {
  display: flex;
  min-height: 68px;
  padding: 10px 12px;
  box-sizing: border-box;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--ui-color-border);
}

.more-item:last-child {
  border-bottom: 0;
}

.more-item.is-pressed {
  background: var(--ui-color-primary-light);
}

.more-item > image:first-child {
  flex: none;
}

.more-item > view {
  flex: 1;
  gap: 2px;
}

.more-item view > text:first-child {
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
}

.more-item view > text:last-child {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
}

.more-item .more-chevron {
  width: 20px;
  height: 20px;
  flex: none;
}

.workbench-content {
  padding: 18px 14px 92px;
  box-sizing: border-box;
}

.filter-button.is-pressed,
.calendar-step.is-pressed,
.calendar-locator.is-pressed,
.week-day.is-pressed,
.retry-action.is-pressed,
.login-action.is-pressed,
.group-option.is-pressed {
  opacity: 0.72;
}

.group-menu {
  margin-top: 10px;
  padding: 0 12px;
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
  box-shadow: var(--ui-shadow-elevated);
}

.group-option {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--ui-color-border);
}

.group-option:last-child {
  border-bottom: 0;
}

.group-option-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.group-option-copy text:first-child {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-sm);
}

.group-option-copy text:last-child {
  margin-top: 1px;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.group-option.is-selected text:first-child {
  color: var(--ui-color-primary);
  font-weight: var(--ui-font-weight-semibold);
}

.group-settings-option {
  display: flex;
  min-height: 52px;
  padding: 5px 8px;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--ui-color-border);
  border-radius: 8px;
}

.group-settings-option.is-pressed {
  background: var(--ui-color-primary-light);
}

.group-settings-option image {
  width: 16px;
  height: 16px;
  margin-left: 8px;
  flex: none;
}

.option-check {
  margin-left: 8px;
  color: var(--ui-color-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-strong);
}

.offline-note {
  display: block;
  margin: 0 0 8px;
  padding: 7px 9px;
  color: var(--ui-color-warning);
  background: var(--ui-color-warning-light);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-xs);
  line-height: var(--ui-line-height-normal);
}

.view-controls {
  position: relative;
  z-index: 24;
  top: auto;
  min-height: 52px;
  justify-content: space-between;
  background: var(--ui-color-background);
}

.view-switch {
  padding: 3px;
  background: var(--ui-color-surface-muted);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-small);
}

.view-tab {
  display: flex;
  min-width: 52px;
  min-height: 38px;
  padding: 0 10px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-text-muted);
  border-radius: 7px;
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 38px;
}

.view-tab.is-active {
  color: var(--ui-color-primary);
  background: var(--ui-color-surface);
  box-shadow: 0 2px 7px rgba(22, 32, 42, 0.08);
}

.filter-button {
  min-width: 76px;
  min-height: 44px;
  margin-left: 8px;
  padding: 0 10px;
  box-sizing: border-box;
  justify-content: center;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  border: 0;
  border-radius: 12px;
  font-size: var(--ui-font-size-sm);
}

.filter-button.has-filter {
  background: var(--ui-color-primary-light);
}

.filter-icon {
  position: relative;
  display: flex;
  margin-right: 6px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
}

.filter-icon-bar {
  position: absolute;
  inset: 0;
}

.filter-count {
  display: flex;
  width: 16px;
  height: 16px;
  margin-left: 5px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-radius: 50%;
  font-size: 9px;
  font-weight: var(--ui-font-weight-strong);
}

.sr-announcement {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
}

.selected-date-details,
.week-calendar,
.list-calendar {
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-card);
}

.selected-date-details {
  margin-top: 12px;
  padding: 14px 12px;
  box-sizing: border-box;
  background: linear-gradient(145deg, var(--ui-color-surface), #f7fbff);
}

.detail-heading {
  display: flex;
  margin-bottom: 14px;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--ui-spacing-md);
}

.detail-date-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.detail-date-copy text:first-child {
  color: var(--ui-color-primary);
  font-size: 10px;
  font-weight: var(--ui-font-weight-strong);
}

.detail-date-value {
  margin-top: 4px;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-xl);
  font-weight: var(--ui-font-weight-strong);
  line-height: var(--ui-line-height-tight);
}

.duty-count,
.duty-status {
  display: inline-flex;
  min-height: 22px;
  padding: 2px 8px;
  box-sizing: border-box;
  align-items: center;
  border-radius: var(--ui-radius-pill);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 1.25;
  white-space: nowrap;
}

.duty-count {
  margin-left: 8px;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
}

.duty-status.is-scheduled {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
}

.duty-status.is-changed {
  color: var(--ui-color-warning);
  background: var(--ui-color-warning-light);
}

.duty-status.is-pending {
  color: var(--ui-color-danger);
  background: var(--ui-color-danger-light);
}

.duty-group-grid,
.grouped-staff-list {
  display: grid;
}

.duty-group-grid {
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
}

.shift-detail-card {
  position: relative;
  min-width: 0;
  padding: 12px 10px 10px 13px;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
}

.shift-detail-accent {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 3px;
}

.shift-card-heading {
  display: grid;
  min-width: 0;
  grid-template-columns: 38px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
}

.shift-code {
  display: flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-medium);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-strong);
}

.shift-card-heading > view,
.staff-name-copy,
.staff-name-static {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.shift-name,
.shift-time,
.staff-name,
.staff-role {
  display: block;
}

.shift-name {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-strong);
}

.shift-time {
  margin-top: 2px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  font-variant-numeric: tabular-nums;
}

.grouped-staff-list {
  margin-top: var(--ui-spacing-sm);
  gap: 6px;
}

.staff-duty-row {
  min-width: 0;
  padding: 6px;
  box-sizing: border-box;
  background: var(--ui-color-surface-muted);
  border-radius: var(--ui-radius-medium);
}

.staff-duty-heading {
  display: grid;
  min-width: 0;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 6px;
}

.staff-name-button,
.staff-name-static {
  min-width: 0;
  min-height: var(--ui-touch-target-minimum);
  padding: 6px 8px;
  box-sizing: border-box;
  border-radius: var(--ui-radius-small);
}

.staff-name-button {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 16px 16px;
  align-items: center;
  gap: 6px;
}

.staff-name-button.is-pressed,
.detail-phone-action.is-pressed,
.event-action.is-pressed {
  opacity: 0.72;
}

.staff-name {
  overflow: hidden;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-strong);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-role {
  margin-top: 2px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
}

.detail-phone-icon,
.detail-disclosure,
.detail-phone-action image {
  width: 16px;
  height: 16px;
}

.detail-phone-icon,
.detail-disclosure {
  flex: none;
}

.detail-disclosure {
  transition: transform var(--ui-duration-fast) ease;
}

.detail-disclosure.is-expanded {
  transform: rotate(90deg);
}

.phone-split-actions {
  display: grid;
  margin: 2px 0 6px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  overflow: hidden;
  background: var(--ui-color-primary-light);
  border: 1px solid var(--ui-color-primary-border);
  border-radius: var(--ui-radius-medium);
}

.detail-phone-action {
  display: flex;
  min-width: 0;
  min-height: var(--ui-touch-target-minimum);
  padding: 8px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 5px;
  color: var(--ui-color-primary-dark);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
}

.detail-phone-action + .detail-phone-action {
  border-left: 1px solid var(--ui-color-primary-border);
}

.staff-duty-meta {
  display: flex;
  padding: 0 8px 4px;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
}

.change-summary-item {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: var(--ui-color-warning);
  font-size: var(--ui-font-size-xs);
}

.detail-change-badge {
  display: inline-flex;
  min-width: 16px;
  height: 16px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: #92540a;
  background: #fff3cd;
  border-radius: 4px;
  font-size: 9px;
  font-weight: var(--ui-font-weight-strong);
}

.event-action {
  display: inline-flex;
  min-height: var(--ui-touch-target-minimum);
  margin-left: 8px;
  padding: 7px 0;
  box-sizing: border-box;
  align-items: center;
  gap: 5px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
}

.event-history-icon {
  display: block;
  width: 16px;
  height: 16px;
  flex: none;
}

.selected-date-empty {
  padding: var(--ui-spacing-lg);
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface);
  border: 1px dashed var(--ui-color-border-strong);
  border-radius: var(--ui-radius-medium);
  font-size: var(--ui-font-size-sm);
  text-align: center;
}

.detail-empty {
  padding: 12px;
  color: var(--ui-color-text-muted);
  background: var(--ui-color-surface-muted);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-xs);
  line-height: var(--ui-line-height-normal);
  text-align: center;
}

.calendar-navigation,
.list-calendar-heading {
  min-height: 62px;
  padding: 4px 6px;
  box-sizing: border-box;
  border-bottom: 1px solid var(--ui-color-border);
}

.calendar-step,
.calendar-locator {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  transition:
    background 140ms ease,
    transform 140ms ease;
}

.calendar-step {
  color: var(--ui-color-primary);
}

.calendar-locator {
  width: 44px;
  margin-left: 4px;
  color: var(--ui-color-primary);
}

.calendar-heading {
  display: flex;
  min-width: 0;
  margin: 0 3px;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.calendar-heading text:first-child {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 20px;
}

.calendar-heading text:last-child {
  margin-top: 2px;
  color: var(--ui-color-text-muted);
  font-size: 10px;
  line-height: 14px;
}

.chevron {
  width: 20px;
  height: 20px;
}

.chevron.is-left {
  transform: none;
}

.chevron.is-right {
  transform: none;
}

.locate-crosshair {
  position: relative;
}

.locate-crosshair::before,
.locate-crosshair::after {
  display: none;
}

.locate-image,
.chevron-image {
  display: block;
  width: 100%;
  height: 100%;
}

.week-day-row,
.week-day-grid {
  display: flex;
}

.week-day-row {
  min-height: 28px;
  align-items: center;
  color: var(--ui-color-text-muted);
  background: var(--ui-color-surface-muted);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
  text-align: center;
}

.week-day-row text {
  width: 14.285714%;
}

.week-day-row .is-weekend {
  color: var(--ui-color-weekend);
}

.week-day-grid {
  background: var(--ui-color-border);
  overflow: hidden;
  border-bottom-right-radius: var(--ui-radius-large);
  border-bottom-left-radius: var(--ui-radius-large);
}

.week-day {
  display: flex;
  width: 14.285714%;
  min-height: 102px;
  padding: 7px 3px;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface);
  border-right: 1px solid var(--ui-color-border);
  font-size: 10px;
  text-align: center;
}

.week-day:last-child {
  border-right: 0;
}

.week-day.is-selected {
  border-radius: 0;
  box-shadow: inset 0 0 0 2px var(--ui-color-primary);
}

.week-day.is-weekend .day-number {
  color: var(--ui-color-weekend);
}

.day-number {
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-strong);
  line-height: 18px;
}

.list-empty {
  margin: 8px 13px 13px;
}

.state-card {
  display: flex;
  margin-top: 12px;
  padding: 24px 18px;
  box-sizing: border-box;
  align-items: center;
  flex-direction: column;
  text-align: center;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-card);
}

.state-mark {
  display: flex;
  width: 48px;
  height: 48px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  border-radius: 16px;
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-strong);
}

.state-error .state-mark {
  color: var(--ui-color-danger);
  background: var(--ui-color-danger-light);
}

.state-title {
  margin-top: 14px;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-strong);
}

.state-description {
  max-width: 280px;
  margin-top: 6px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.retry-action,
.login-action {
  display: flex;
  min-width: 116px;
  min-height: 44px;
  margin-top: 16px;
  padding: 0 14px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 44px;
}

.login-action {
  margin-top: 8px;
  color: var(--ui-color-primary-dark);
  background: var(--ui-color-primary-light);
}

.state-spinner {
  width: 20px;
  height: 20px;
  box-sizing: border-box;
  border: 2px solid var(--ui-color-primary-border);
  border-top-color: var(--ui-color-primary);
  border-radius: 50%;
}

.bottom-nav {
  position: fixed;
  z-index: var(--ui-z-index-navigation);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(var(--ui-layout-bottom-nav-height) + env(safe-area-inset-bottom));
  min-height: var(--ui-layout-bottom-nav-height);
  padding: 5px 6px env(safe-area-inset-bottom);
  box-sizing: border-box;
  align-items: flex-start;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid var(--ui-color-border);
  box-shadow: 0 -4px 16px rgba(22, 32, 42, 0.06);
}

.bottom-nav-item {
  width: 20%;
  height: 56px;
  min-height: 56px;
  padding-top: 4px;
  box-sizing: border-box;
  justify-content: flex-start;
  flex-direction: column;
  color: var(--ui-color-text-muted);
  border-radius: var(--ui-radius-small);
  font-size: 10px;
  line-height: 16px;
}

.bottom-nav-item.is-active {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  font-weight: var(--ui-font-weight-semibold);
}

.bottom-nav-item.is-disabled {
  opacity: 0.58;
}

.nav-icon {
  position: relative;
  margin-bottom: 1px;
  box-sizing: border-box;
}

.nav-more {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2px;
}

.nav-more {
  padding: 0;
}

.calendar-step.is-pressed .chevron,
.calendar-locator.is-pressed .locate-crosshair {
  transform: scale(0.88);
}

@media (max-width: 340px) {
  .workbench-content {
    padding-right: 10px;
    padding-left: 10px;
  }

  .view-tab {
    min-width: 45px;
    padding-right: 7px;
    padding-left: 7px;
  }

  .week-day {
    min-height: 92px;
    padding-right: 2px;
    padding-left: 2px;
  }
}

/* P4 production-Web parity shell */
.workbench-shell-header {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  min-height: calc(64px + env(safe-area-inset-top));
  padding: calc(8px + env(safe-area-inset-top)) 92px 8px 12px;
  box-sizing: border-box;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid var(--ui-color-border);
}

.workbench-shell-heading {
  min-width: 0;
  flex: 1;
}

.group-switcher {
  position: relative;
  width: fit-content;
  max-width: 100%;
}

.group-switcher-trigger {
  display: flex;
  min-height: 24px;
  padding-right: 24px;
  align-items: center;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-medium);
  line-height: 24px;
}

.group-switcher-copy {
  max-width: 172px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-switcher-arrow {
  position: absolute;
  top: 3px;
  right: 5px;
  display: flex;
  width: 18px;
  height: 18px;
  align-items: center;
  justify-content: center;
}

.group-switcher-arrow image {
  width: 18px;
  height: 18px;
  transform: rotate(90deg);
  transition: transform 160ms ease;
}

.group-switcher-arrow.is-open {
  top: 7px;
}

.group-switcher-arrow.is-open image {
  transform: rotate(-90deg);
}

.shell-page-title {
  display: block;
  margin-top: 1px;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 23px;
  letter-spacing: -0.25px;
}

.workbench-shell-header .group-menu {
  position: absolute;
  z-index: 120;
  top: 34px;
  left: 0;
  width: 216px;
  max-width: calc(100vw - 24px);
  margin: 0;
  padding: 4px;
  box-sizing: border-box;
}

.workbench-shell-header .group-option {
  min-height: 48px;
  padding: 5px 8px;
  box-sizing: border-box;
  border: 0;
  border-radius: 8px;
}

.workbench-shell-header .group-option.is-selected {
  background: var(--ui-color-primary-light);
}

.shell-actions {
  position: absolute;
  right: 10px;
  bottom: 9px;
  display: flex;
  gap: 4px;
}

.notification-action,
.shell-profile-action {
  display: flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  border-radius: 50%;
}

.shell-profile-action {
  background: var(--ui-color-primary-light);
}

.top-icon {
  position: relative;
  box-sizing: border-box;
}

.top-icon-image {
  display: block;
  width: 100%;
  height: 100%;
}

.notification-dot {
  position: absolute;
  top: -2px;
  right: -2px;
  width: 8px;
  height: 8px;
  box-sizing: border-box;
  background: var(--ui-color-danger);
  border: 2px solid var(--ui-color-surface);
  border-radius: 50%;
}

.nav-icon-image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  transform-origin: center;
}

.workbench-content {
  padding: 14px 12px 92px;
}

.workbench-view-anchor {
  box-sizing: border-box;
  padding-top: 8px;
}

.workbench-content.is-list-mode {
  height: 100%;
  min-height: 0;
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.workbench-content.is-list-mode .offline-note,
.workbench-content.is-list-mode .view-controls {
  flex: none;
}

.workbench-content.is-list-mode .view-controls {
  position: relative;
  top: auto !important;
}

.workbench-content.is-list-mode .workbench-view-anchor {
  min-height: 0;
  flex: 1;
}

.view-switch {
  background: #e8edf3;
  border: 0;
  border-radius: 12px;
}

.view-tab.is-active {
  color: var(--ui-color-text-primary);
}

.filter-button,
.filter-button.has-filter {
  color: var(--ui-color-primary);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
}

.filter-icon {
  margin-right: 5px;
  justify-content: center;
  gap: 3px;
}

.period-swiper {
  width: 100%;
}

.week-swiper {
  height: 112px;
  overflow: hidden;
  border-bottom-right-radius: 17px;
  border-bottom-left-radius: 17px;
}

.week-swiper .week-day-grid {
  height: 112px;
}

.week-day:first-child {
  border-bottom-left-radius: 17px;
}

.week-day:last-child {
  border-bottom-right-radius: 17px;
}

.list-swiper,
.list-panel-scroll {
  width: 100%;
}

.list-panel-scroll {
  height: 100%;
  box-sizing: border-box;
}

.list-panel-content {
  box-sizing: border-box;
}

.list-calendar {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  gap: 0;
  overflow: visible;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.list-calendar-heading {
  position: relative;
  z-index: 3;
  flex: none;
  min-height: 62px;
  margin-bottom: 0;
  padding: 4px 6px;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-card);
}

.list-scroll-boundary {
  position: relative;
  z-index: 2;
  width: auto;
  height: 8px;
  margin: 0 -12px;
  box-sizing: border-box;
  flex: none;
  background: var(--ui-color-background);
  border-bottom: 1px solid var(--ui-color-border);
  box-shadow: none;
}

.list-swiper {
  position: relative;
  z-index: 1;
  height: auto;
  min-height: 0;
  flex: 1;
  overflow: hidden;
  background: var(--ui-color-background);
}

.week-date-line,
.week-duty-badges,
.list-day-heading,
.list-date-copy,
.list-duty-item,
.list-duty-name-line {
  display: flex;
  align-items: center;
}

.week-date-line {
  width: 100%;
  min-height: 20px;
  justify-content: space-between;
  gap: 2px;
}

.week-day {
  position: relative;
  min-height: 112px;
  padding: 4px 3px;
  align-items: stretch;
}

.week-date-line .day-number {
  color: var(--ui-color-text-primary);
  font-size: 11px;
  line-height: 18px;
}

.week-day.is-past {
  background: #f3f4f6;
}

.week-day.is-selected {
  box-shadow: none;
}

.week-day.is-selected::after {
  position: absolute;
  z-index: 2;
  inset: 0;
  border-radius: inherit;
  box-shadow: inset 0 0 0 2px var(--ui-color-primary);
  content: '';
  pointer-events: none;
}

.week-day.is-today .day-number {
  color: var(--ui-color-near-black);
}

.week-holiday {
  height: 14px;
  max-width: calc(100% - 20px);
  padding: 0 2px;
  overflow: hidden;
  color: var(--ui-color-danger);
  background: var(--ui-color-danger-light);
  border-radius: 3px;
  font-size: 8px;
  font-weight: var(--ui-font-weight-semibold);
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-duty-empty {
  margin-top: 5px;
  color: var(--ui-color-text-muted);
  font-size: 10px;
}

.week-duty-item {
  display: flex;
  min-width: 0;
  margin-top: 3px;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
}

.week-duty-name {
  width: 100%;
  overflow: hidden;
  color: var(--ui-color-text-primary);
  font-size: 12px;
  font-weight: var(--ui-font-weight-semibold);
  line-height: 12px;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-day.is-past .week-duty-name {
  color: #4b5563;
}

.week-duty-badges {
  min-height: 14px;
  gap: 2px;
}

.week-shift-badge,
.week-change-badge {
  min-width: 12px;
  height: 14px;
  padding: 0 2px;
  box-sizing: border-box;
  border-radius: 3px;
  font-size: 8px;
  font-weight: var(--ui-font-weight-semibold);
  line-height: 14px;
  text-align: center;
}

.week-change-badge,
.list-change-badge {
  color: var(--ui-color-warning);
  background: var(--ui-color-warning-light);
}

.list-day-slot {
  padding-top: 8px;
  box-sizing: border-box;
}

.list-day-card {
  margin: 0;
  padding: 11px;
  box-sizing: border-box;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
}

.list-day-card.is-today {
  padding: 10px;
  background: var(--ui-color-primary-light);
  border: 2px solid var(--ui-color-primary);
}

.list-day-heading {
  min-height: 30px;
  padding-bottom: 8px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  gap: 7px;
}

.list-date-copy {
  min-width: 0;
  gap: 7px;
}

.list-date-label {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-strong);
  font-variant-numeric: tabular-nums;
}

.list-weekday.is-weekend {
  color: var(--ui-color-weekend);
}

.list-day-card.is-weekend .list-date-label {
  color: var(--ui-color-weekend);
}

.list-today-badge {
  padding: 1px 6px;
  color: var(--ui-color-near-black);
  background: var(--ui-color-today-marker);
  border-radius: 10px;
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
}

.list-holiday {
  padding: 1px 5px;
  color: var(--ui-color-danger);
  background: var(--ui-color-danger-light);
  border-radius: 4px;
  font-size: 10px;
  font-weight: var(--ui-font-weight-semibold);
}

.list-duty-count {
  margin-left: auto;
  padding: 4px 7px;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  border-radius: var(--ui-radius-pill);
  font-size: 9px;
  font-weight: var(--ui-font-weight-semibold);
  white-space: nowrap;
}

.list-duty-item {
  position: relative;
  min-height: 52px;
  padding: 8px 0 8px 10px;
  box-sizing: border-box;
  border-top: 1px solid #edf1f5;
}

.list-duty-accent {
  position: absolute;
  top: 10px;
  bottom: 10px;
  left: 0;
  width: 4px;
  border-radius: var(--ui-radius-pill);
}

.list-duty-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.list-duty-name-line {
  min-width: 0;
  gap: 4px;
}

.list-duty-name {
  min-width: 0;
  overflow: hidden;
  color: var(--ui-color-text-primary);
  font-size: 12px;
  font-weight: var(--ui-font-weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-change-badge {
  min-width: 18px;
  padding: 1px 4px;
  border-radius: 4px;
  font-size: 9px;
  line-height: 14px;
  text-align: center;
}

.list-duty-details {
  margin-top: 3px;
  overflow: hidden;
  color: var(--ui-color-text-muted);
  font-size: 9px;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-call-action {
  display: flex;
  width: 44px;
  height: 44px;
  margin-left: 8px;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-success);
  background: var(--ui-color-success-light);
  border-radius: 10px;
}

.list-call-action image {
  width: 20px;
  height: 20px;
}

.calendar-step.is-pressed,
.calendar-locator.is-pressed {
  border-radius: 12px;
  opacity: 1;
  transform: scale(0.9);
  background: var(--ui-color-primary-light);
}

.filter-sheet-backdrop {
  position: fixed;
  z-index: 200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(22, 32, 42, 0.42);
  animation: filter-backdrop-enter 180ms ease-out both;
}

.filter-sheet {
  position: relative;
  width: 100%;
  height: 468px;
  max-height: calc(100vh - 32px);
  padding: 7px 16px calc(14px + env(safe-area-inset-bottom));
  overflow: visible;
  box-sizing: border-box;
  background: var(--ui-color-surface);
  border-radius: 22px 22px 0 0;
  box-shadow: 0 -14px 40px rgba(22, 32, 42, 0.2);
  animation: filter-sheet-enter 260ms cubic-bezier(0.2, 0, 0, 1) both;
}

.filter-sheet-handle {
  width: 36px;
  height: 4px;
  margin: 0 auto 7px;
  background: var(--ui-color-border);
  border-radius: 4px;
}

.filter-sheet-heading,
.changes-filter,
.filter-sheet-actions {
  display: flex;
  align-items: center;
}

.filter-sheet-heading {
  min-height: 44px;
  justify-content: space-between;
}

.filter-sheet-heading > text {
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-semibold);
}

.sheet-close {
  width: 40px;
  height: 40px;
  color: var(--ui-color-text-secondary);
  border-radius: 50%;
  font-size: 25px;
  line-height: 38px;
  text-align: center;
}

.sheet-close-icon {
  width: 20px;
  height: 20px;
}

.changes-filter {
  min-height: 52px;
  justify-content: space-between;
  border-bottom: 1px solid var(--ui-color-border);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-medium);
}

.compact-switch {
  position: relative;
  width: 44px;
  height: 26px;
  background: #c7ced7;
  border-radius: 13px;
  transition: background 180ms ease;
}

.compact-switch view {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 20px;
  height: 20px;
  background: var(--ui-color-surface);
  border-radius: 50%;
  box-shadow: 0 1px 4px rgba(22, 32, 42, 0.25);
  transition: transform 180ms cubic-bezier(0.2, 0, 0, 1);
}

.compact-switch.is-on {
  background: var(--ui-color-primary);
}

.compact-switch.is-on view {
  transform: translateX(18px);
}

.filter-field {
  position: relative;
  padding-top: 10px;
}

.filter-field-label {
  display: block;
  margin-bottom: 7px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
}

.filter-select-trigger,
.filter-select-option {
  display: flex;
  box-sizing: border-box;
  align-items: center;
}

.filter-select-trigger {
  min-height: 44px;
  padding: 0 12px;
  justify-content: space-between;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: 10px;
  font-size: var(--ui-font-size-sm);
}

.filter-select-trigger.is-open {
  border-color: var(--ui-color-primary);
  box-shadow: 0 0 0 2px var(--ui-color-primary-light);
}

.filter-select-chevron {
  display: flex;
  width: 18px;
  height: 18px;
  margin: -4px 2px 0 10px;
  align-items: center;
  justify-content: center;
}

.filter-select-chevron image {
  width: 18px;
  height: 18px;
  transform: rotate(90deg);
  transition: transform 160ms ease;
}

.filter-select-trigger.is-open .filter-select-chevron {
  margin-top: 4px;
}

.filter-select-trigger.is-open .filter-select-chevron image {
  transform: rotate(-90deg);
}

.filter-select-options {
  position: absolute;
  z-index: 5;
  right: 0;
  left: 0;
  max-height: 148px;
  margin: 0;
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: 10px;
  box-shadow: 0 8px 20px rgba(22, 32, 42, 0.08);
}

.filter-select-options.is-down {
  top: calc(100% + 6px);
}

.filter-select-options.is-up {
  bottom: 50px;
}

.filter-select-option {
  min-height: 44px;
  padding: 0 12px;
  justify-content: space-between;
  border-bottom: 1px solid var(--ui-color-border);
  font-size: var(--ui-font-size-sm);
}

.filter-select-option:last-child {
  border-bottom: 0;
}

.filter-select-option.is-selected {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  font-weight: var(--ui-font-weight-semibold);
}

.filter-check {
  color: var(--ui-color-primary);
}

.filter-field-empty {
  display: block;
  padding: 10px;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.filter-sheet-actions {
  position: absolute;
  right: 16px;
  bottom: calc(14px + env(safe-area-inset-bottom));
  left: 16px;
  padding-top: 14px;
  gap: 10px;
}

.filter-clear,
.filter-apply {
  display: flex;
  min-height: 44px;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.filter-clear {
  color: var(--ui-color-primary);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-primary);
}

.filter-apply {
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border: 1px solid var(--ui-color-primary);
}

@keyframes filter-backdrop-enter {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes filter-sheet-enter {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@media (max-width: 340px) {
  .workbench-shell-header {
    padding-left: 10px;
  }

  .group-switcher-copy {
    max-width: 128px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .filter-sheet-backdrop,
  .filter-sheet,
  .group-switcher-arrow image,
  .filter-select-chevron image {
    animation: none !important;
    transition: none !important;
  }
}
