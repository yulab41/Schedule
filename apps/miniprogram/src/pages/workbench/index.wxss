page {
  height: 100%;
  background: var(--ui-color-background);
}

.workbench-page {
  height: 100%;
  min-height: 100%;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-background);
  font-family: var(--ui-font-family-system);
}

.workbench-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(var(--ui-layout-bottom-nav-height) + env(safe-area-inset-bottom));
}

.view-controls,
.view-switch,
.filter-button,
.calendar-navigation,
.list-calendar-heading,
.bottom-nav-item {
  display: flex;
  align-items: center;
}

.workbench-content {
  padding: 18px 14px 92px;
  box-sizing: border-box;
}

.filter-button.is-pressed,
.calendar-step.is-pressed,
.calendar-locator.is-pressed,
.week-day.is-pressed,
.bottom-nav-item.is-pressed,
.retry-action.is-pressed,
.login-action.is-pressed,
.group-option.is-pressed {
  opacity: 0.72;
}

.group-menu {
  margin-top: 10px;
  padding: 0 12px;
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
  box-shadow: var(--ui-shadow-elevated);
}

.group-option {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--ui-color-border);
}

.group-option:last-child {
  border-bottom: 0;
}

.group-option-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.group-option-copy text:first-child {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-sm);
}

.group-option-copy text:last-child {
  margin-top: 1px;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.group-option.is-selected text:first-child {
  color: var(--ui-color-primary);
  font-weight: var(--ui-font-weight-semibold);
}

.option-check {
  margin-left: 8px;
  color: var(--ui-color-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-strong);
}

.offline-note {
  display: block;
  margin: 0 0 8px;
  padding: 7px 9px;
  color: var(--ui-color-warning);
  background: var(--ui-color-warning-light);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-xs);
  line-height: var(--ui-line-height-normal);
}

.view-controls {
  position: relative;
  z-index: 24;
  top: auto;
  min-height: 52px;
  justify-content: space-between;
  background: var(--ui-color-background);
}

.view-switch {
  padding: 3px;
  background: var(--ui-color-surface-muted);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-small);
}

.view-tab {
  display: flex;
  min-width: 52px;
  min-height: 38px;
  padding: 0 10px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-text-muted);
  border-radius: 7px;
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 38px;
}

.view-tab.is-active {
  color: var(--ui-color-primary);
  background: var(--ui-color-surface);
  box-shadow: 0 2px 7px rgba(22, 32, 42, 0.08);
}

.filter-button {
  min-width: 76px;
  min-height: 44px;
  margin-left: 8px;
  padding: 0 10px;
  box-sizing: border-box;
  justify-content: center;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  border: 0;
  border-radius: 12px;
  font-size: var(--ui-font-size-sm);
}

.filter-button.has-filter {
  background: var(--ui-color-primary-light);
}

.filter-icon {
  display: flex;
  width: 20px;
  height: 20px;
  margin-right: 6px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
}

.filter-icon view {
  height: 2px;
  background: currentColor;
  border-radius: 2px;
}

.filter-icon view:first-child {
  width: 13px;
}

.filter-icon view:nth-child(2) {
  width: 8px;
  margin-left: 0;
}

.filter-icon view:last-child {
  width: 4px;
  margin-left: 0;
}

.filter-icon.is-animating view:first-child {
  animation: click-filter-top 520ms cubic-bezier(0.2, 0, 0, 1);
}

.filter-icon.is-animating view:nth-child(2) {
  animation: click-filter-middle 520ms cubic-bezier(0.2, 0, 0, 1);
}

.filter-icon.is-animating view:last-child {
  animation: click-filter-bottom 520ms cubic-bezier(0.2, 0, 0, 1);
}

.filter-count {
  display: flex;
  width: 16px;
  height: 16px;
  margin-left: 5px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-radius: 50%;
  font-size: 9px;
  font-weight: var(--ui-font-weight-strong);
}

.sr-announcement {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
}

.selected-date-details,
.week-calendar,
.list-calendar {
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-card);
}

.selected-date-details {
  margin-top: 12px;
  padding: 14px 12px;
  box-sizing: border-box;
  background: linear-gradient(145deg, var(--ui-color-surface), #f7fbff);
}

.detail-heading {
  display: flex;
  margin-bottom: 14px;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--ui-spacing-md);
}

.detail-date-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.detail-date-copy text:first-child {
  color: var(--ui-color-primary);
  font-size: 10px;
  font-weight: var(--ui-font-weight-strong);
}

.detail-date-value {
  margin-top: 4px;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-xl);
  font-weight: var(--ui-font-weight-strong);
  line-height: var(--ui-line-height-tight);
}

.duty-count,
.duty-status {
  display: inline-flex;
  min-height: 22px;
  padding: 2px 8px;
  box-sizing: border-box;
  align-items: center;
  border-radius: var(--ui-radius-pill);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 1.25;
  white-space: nowrap;
}

.duty-count {
  margin-left: 8px;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
}

.duty-status.is-scheduled {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
}

.duty-status.is-changed {
  color: var(--ui-color-warning);
  background: var(--ui-color-warning-light);
}

.duty-status.is-pending {
  color: var(--ui-color-danger);
  background: var(--ui-color-danger-light);
}

.duty-group-grid,
.grouped-staff-list {
  display: grid;
}

.duty-group-grid {
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
}

.shift-detail-card {
  position: relative;
  min-width: 0;
  padding: 12px 10px 10px 13px;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
}

.shift-detail-accent {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 3px;
}

.shift-card-heading {
  display: grid;
  min-width: 0;
  grid-template-columns: 38px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
}

.shift-code {
  display: flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-medium);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-strong);
}

.shift-card-heading > view,
.staff-name-copy,
.staff-name-static {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.shift-name,
.shift-time,
.staff-name,
.staff-role {
  display: block;
}

.shift-name {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-strong);
}

.shift-time {
  margin-top: 2px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
  font-variant-numeric: tabular-nums;
}

.grouped-staff-list {
  margin-top: var(--ui-spacing-sm);
  gap: 6px;
}

.staff-duty-row {
  min-width: 0;
  padding: 6px;
  box-sizing: border-box;
  background: var(--ui-color-surface-muted);
  border-radius: var(--ui-radius-medium);
}

.staff-duty-heading {
  display: grid;
  min-width: 0;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 6px;
}

.staff-name-button,
.staff-name-static {
  min-width: 0;
  min-height: var(--ui-touch-target-minimum);
  padding: 6px 8px;
  box-sizing: border-box;
  border-radius: var(--ui-radius-small);
}

.staff-name-button {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 16px 16px;
  align-items: center;
  gap: 6px;
}

.staff-name-button.is-pressed,
.detail-phone-action.is-pressed,
.event-action.is-pressed {
  opacity: 0.72;
}

.staff-name {
  overflow: hidden;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-strong);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-role {
  margin-top: 2px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
}

.detail-phone-icon,
.detail-disclosure,
.detail-phone-action image {
  width: 16px;
  height: 16px;
}

.detail-phone-icon,
.detail-disclosure {
  flex: none;
}

.detail-disclosure {
  transition: transform var(--ui-duration-fast) ease;
}

.detail-disclosure.is-expanded {
  transform: rotate(90deg);
}

.phone-split-actions {
  display: grid;
  margin: 2px 0 6px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  overflow: hidden;
  background: var(--ui-color-primary-light);
  border: 1px solid var(--ui-color-primary-border);
  border-radius: var(--ui-radius-medium);
}

.detail-phone-action {
  display: flex;
  min-width: 0;
  min-height: var(--ui-touch-target-minimum);
  padding: 8px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 5px;
  color: var(--ui-color-primary-dark);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
}

.detail-phone-action + .detail-phone-action {
  border-left: 1px solid var(--ui-color-primary-border);
}

.staff-duty-meta {
  display: flex;
  padding: 0 8px 4px;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
}

.change-summary-item {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: var(--ui-color-warning);
  font-size: var(--ui-font-size-xs);
}

.detail-change-badge {
  display: inline-flex;
  min-width: 16px;
  height: 16px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: #92540a;
  background: #fff3cd;
  border-radius: 4px;
  font-size: 9px;
  font-weight: var(--ui-font-weight-strong);
}

.event-action {
  display: inline-flex;
  min-height: var(--ui-touch-target-minimum);
  margin-left: 8px;
  padding: 7px 0;
  box-sizing: border-box;
  align-items: center;
  gap: 5px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-xs);
}

.event-history-icon {
  display: block;
  width: 16px;
  height: 16px;
  flex: none;
}

.selected-date-empty {
  padding: var(--ui-spacing-lg);
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface);
  border: 1px dashed var(--ui-color-border-strong);
  border-radius: var(--ui-radius-medium);
  font-size: var(--ui-font-size-sm);
  text-align: center;
}

.detail-empty {
  padding: 12px;
  color: var(--ui-color-text-muted);
  background: var(--ui-color-surface-muted);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-xs);
  line-height: var(--ui-line-height-normal);
  text-align: center;
}

.calendar-navigation,
.list-calendar-heading {
  min-height: 62px;
  padding: 4px 6px;
  box-sizing: border-box;
  border-bottom: 1px solid var(--ui-color-border);
}

.calendar-step,
.calendar-locator {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  transition:
    background 140ms ease,
    transform 140ms ease;
}

.calendar-step {
  color: var(--ui-color-primary);
}

.calendar-locator {
  width: 44px;
  margin-left: 4px;
  color: var(--ui-color-primary);
}

.calendar-heading {
  display: flex;
  min-width: 0;
  margin: 0 3px;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.calendar-heading text:first-child {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 20px;
}

.calendar-heading text:last-child {
  margin-top: 2px;
  color: var(--ui-color-text-muted);
  font-size: 10px;
  line-height: 14px;
}

.chevron {
  width: 20px;
  height: 20px;
}

.chevron.is-left {
  transform: none;
}

.chevron.is-right {
  transform: none;
}

.locate-crosshair {
  position: relative;
  width: 20px;
  height: 20px;
}

.locate-crosshair::before,
.locate-crosshair::after {
  display: none;
}

.locate-image,
.chevron-image {
  display: block;
  width: 100%;
  height: 100%;
}

.locate-crosshair.is-animating {
  animation: click-locate 520ms cubic-bezier(0.2, 0, 0, 1);
}

.week-day-row,
.week-day-grid {
  display: flex;
}

.week-day-row {
  min-height: 28px;
  align-items: center;
  color: var(--ui-color-text-muted);
  background: var(--ui-color-surface-muted);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
  text-align: center;
}

.week-day-row text {
  width: 14.285714%;
}

.week-day-row .is-weekend {
  color: var(--ui-color-weekend);
}

.week-day-grid {
  background: var(--ui-color-border);
  overflow: hidden;
  border-bottom-right-radius: var(--ui-radius-large);
  border-bottom-left-radius: var(--ui-radius-large);
}

.week-day {
  display: flex;
  width: 14.285714%;
  min-height: 102px;
  padding: 7px 3px;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface);
  border-right: 1px solid var(--ui-color-border);
  font-size: 10px;
  text-align: center;
}

.week-day:last-child {
  border-right: 0;
}

.week-day.is-selected {
  border-radius: 0;
  box-shadow: inset 0 0 0 2px var(--ui-color-primary);
}

.week-day.is-today .day-number {
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
}

.week-day.is-weekend .day-number {
  color: var(--ui-color-weekend);
}

.day-number {
  display: flex;
  width: 24px;
  height: 24px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-strong);
  line-height: 24px;
}

.list-empty {
  margin: 8px 13px 13px;
}

.state-card {
  display: flex;
  margin-top: 12px;
  padding: 24px 18px;
  box-sizing: border-box;
  align-items: center;
  flex-direction: column;
  text-align: center;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-card);
}

.state-mark {
  display: flex;
  width: 48px;
  height: 48px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  border-radius: 16px;
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-strong);
}

.state-error .state-mark {
  color: var(--ui-color-danger);
  background: var(--ui-color-danger-light);
}

.state-title {
  margin-top: 14px;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-strong);
}

.state-description {
  max-width: 280px;
  margin-top: 6px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.retry-action,
.login-action {
  display: flex;
  min-width: 116px;
  min-height: 44px;
  margin-top: 16px;
  padding: 0 14px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-white);
  background: var(--ui-color-primary);
  border-radius: var(--ui-radius-small);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 44px;
}

.login-action {
  margin-top: 8px;
  color: var(--ui-color-primary-dark);
  background: var(--ui-color-primary-light);
}

.state-spinner {
  width: 20px;
  height: 20px;
  box-sizing: border-box;
  border: 2px solid var(--ui-color-primary-border);
  border-top-color: var(--ui-color-primary);
  border-radius: 50%;
}

.bottom-nav {
  position: fixed;
  z-index: var(--ui-z-index-navigation);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: var(--ui-layout-bottom-nav-height);
  padding: 5px 6px env(safe-area-inset-bottom);
  box-sizing: border-box;
  align-items: flex-start;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid var(--ui-color-border);
  box-shadow: 0 -4px 16px rgba(22, 32, 42, 0.06);
}

.bottom-nav-item {
  width: 20%;
  min-height: 56px;
  padding-top: 4px;
  box-sizing: border-box;
  justify-content: flex-start;
  flex-direction: column;
  color: var(--ui-color-text-muted);
  border-radius: var(--ui-radius-small);
  font-size: 10px;
  line-height: 16px;
}

.bottom-nav-item.is-active {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-light);
  font-weight: var(--ui-font-weight-semibold);
}

.bottom-nav-item.is-disabled {
  opacity: 0.58;
}

.nav-icon {
  position: relative;
  width: 24px;
  height: 24px;
  margin-bottom: 1px;
  box-sizing: border-box;
  transition:
    transform 140ms ease,
    opacity 140ms ease;
}

.nav-calendar {
  border: 0;
}

.nav-calendar::before,
.nav-calendar::after {
  position: absolute;
  content: '';
}

.nav-calendar::before {
  top: 5px;
  right: 2px;
  left: 2px;
  border-top: 2px solid currentColor;
}

.nav-calendar::after {
  top: 1px;
  left: 4px;
  width: 2px;
  height: 5px;
  background: currentColor;
  box-shadow: 8px 0 0 currentColor;
}

.nav-calendar.is-animating {
  animation: click-nav-calendar 420ms cubic-bezier(0.2, 0, 0, 1);
}

.nav-leave::before {
  position: absolute;
  inset: 1px 2px 0;
  border: 2px solid currentColor;
  border-radius: 2px;
  content: '';
}

.nav-leave::after {
  position: absolute;
  top: 1px;
  right: 2px;
  width: 7px;
  height: 7px;
  background: var(--ui-color-background);
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  content: '';
  transform: rotate(0deg);
}

.nav-leave view {
  position: absolute;
  left: 6px;
  width: 8px;
  height: 1px;
  background: currentColor;
}

.nav-leave view:nth-child(1) {
  top: 10px;
}

.nav-leave view:nth-child(2) {
  top: 14px;
}

.nav-leave view:nth-child(3) {
  top: 18px;
  width: 5px;
}

.nav-swap::before,
.nav-swap::after {
  position: absolute;
  left: 2px;
  width: 15px;
  height: 6px;
  border-top: 2px solid currentColor;
  border-right: 2px solid currentColor;
  content: '';
}

.nav-swap::before {
  top: 4px;
  transform: skewY(28deg);
}

.nav-swap::after {
  top: 12px;
  border-top: 0;
  border-right: 0;
  border-bottom: 2px solid currentColor;
  border-left: 2px solid currentColor;
  transform: skewY(28deg);
}

.nav-adjustment {
  display: grid;
  place-items: center;
  border: 2px solid currentColor;
  border-radius: 50%;
}

.nav-adjustment::before,
.nav-adjustment::after {
  position: absolute;
  background: currentColor;
  content: '';
}

.nav-adjustment::before {
  width: 10px;
  height: 2px;
}

.nav-adjustment::after {
  width: 2px;
  height: 10px;
}

.nav-more {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2px;
}

.nav-more view {
  width: 4px;
  height: 4px;
  background: currentColor;
  border-radius: 50%;
}

.nav-calendar::before,
.nav-calendar::after,
.nav-leave::before,
.nav-leave::after,
.nav-swap::before,
.nav-swap::after,
.nav-adjustment::before,
.nav-adjustment::after {
  display: none;
}

.nav-adjustment {
  border: 0;
}

.nav-more {
  padding: 0;
}

.bottom-nav-item.is-pressed .nav-icon,
.calendar-step.is-pressed .chevron,
.calendar-locator.is-pressed .locate-crosshair {
  transform: scale(0.88);
}

@keyframes click-filter-top {
  0%,
  100% {
    transform: translateX(0);
  }

  46% {
    transform: translateX(2px);
  }
}

@keyframes click-filter-middle {
  0%,
  100% {
    transform: translateX(0);
  }

  46% {
    transform: translateX(-2px);
  }
}

@keyframes click-filter-bottom {
  0%,
  100% {
    transform: translateX(0);
  }

  46% {
    transform: translateX(1px);
  }
}

@keyframes click-locate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(90deg);
  }
}

@keyframes click-nav-calendar {
  0%,
  100% {
    transform: translateY(0) scale(1);
  }

  42% {
    transform: translateY(-1px) scale(1.06);
  }

  68% {
    transform: translateY(0.5px) scale(0.98);
  }
}

@media (max-width: 340px) {
  .workbench-content {
    padding-right: 10px;
    padding-left: 10px;
  }

  .view-tab {
    min-width: 45px;
    padding-right: 7px;
    padding-left: 7px;
  }

  .week-day {
    min-height: 92px;
    padding-right: 2px;
    padding-left: 2px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .nav-icon {
    transition: none;
  }

  .filter-icon.is-animating,
  .filter-icon.is-animating view,
  .locate-crosshair.is-animating,
  .nav-calendar.is-animating {
    animation: none;
  }
}

/* P4 production-Web parity shell */
.workbench-shell-header {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  min-height: calc(64px + env(safe-area-inset-top));
  padding: calc(8px + env(safe-area-inset-top)) 92px 8px 12px;
  box-sizing: border-box;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid var(--ui-color-border);
}

.workbench-shell-heading {
  min-width: 0;
  flex: 1;
}

.group-switcher {
  position: relative;
  width: fit-content;
  max-width: 100%;
}

.group-switcher-trigger {
  display: flex;
  min-height: 24px;
  padding-right: 24px;
  align-items: center;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-medium);
