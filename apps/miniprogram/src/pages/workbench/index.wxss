  top: 7px;
  right: 5px;
  width: 8px;
  height: 8px;
  box-sizing: border-box;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
  transition: transform 160ms ease;
}

.group-switcher-arrow.is-open {
  top: 11px;
  transform: rotate(225deg);
}

.shell-page-title {
  display: block;
  margin-top: 1px;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-lg);
  font-weight: var(--ui-font-weight-semibold);
  line-height: 23px;
  letter-spacing: -0.25px;
}

.workbench-shell-header .group-menu {
  position: absolute;
  z-index: 120;
  top: 34px;
  left: 0;
  width: 216px;
  max-width: calc(100vw - 24px);
  margin: 0;
  padding: 4px;
  box-sizing: border-box;
}

.workbench-shell-header .group-option {
  min-height: 48px;
  padding: 5px 8px;
  box-sizing: border-box;
  border: 0;
  border-radius: 8px;
}

.workbench-shell-header .group-option.is-selected {
  background: var(--ui-color-primary-light);
}

.shell-actions {
  position: absolute;
  right: 10px;
  bottom: 9px;
  display: flex;
  gap: 4px;
}

.notification-action,
.shell-profile-action {
  display: flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  border-radius: 50%;
}

.shell-profile-action {
  background: var(--ui-color-primary-light);
}

.top-icon {
  position: relative;
  width: 24px;
  height: 24px;
  box-sizing: border-box;
}

.top-icon-image {
  display: block;
  width: 100%;
  height: 100%;
}

.nav-icon-image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  transform-origin: center;
}

.bell-icon.is-animating {
  transform-origin: 10px 2px;
  animation: minimal-bell 620ms cubic-bezier(0.2, 0, 0, 1);
}

.nav-calendar.is-looping .nav-icon-actor,
.nav-leave.is-animating .nav-icon-actor {
  animation: minimal-draw 1800ms ease-in-out infinite;
}

.nav-leave.is-animating .nav-icon-actor {
  animation-duration: 1500ms;
  animation-iteration-count: 1;
}

.nav-swap.is-animating .nav-icon-actor {
  animation: minimal-swap-left 520ms cubic-bezier(0.2, 0, 0, 1);
}

.nav-swap.is-animating .nav-icon-actor-secondary {
  animation: minimal-swap-right 520ms cubic-bezier(0.2, 0, 0, 1);
}

.nav-adjustment.is-animating .nav-icon-image {
  animation: minimal-duty 520ms ease-in-out;
}

.nav-more.is-animating .nav-icon-image {
  animation: minimal-dot 520ms ease-in-out;
}

.nav-more.is-animating .nav-icon-actor-secondary {
  animation-delay: 80ms;
}

.nav-more.is-animating .nav-icon-actor-tertiary {
  animation-delay: 160ms;
}

.profile-icon.is-animating {
  animation: click-profile 480ms cubic-bezier(0.2, 0, 0, 1);
}

.workbench-scroll {
  padding-top: calc(64px + env(safe-area-inset-top));
}

.workbench-content {
  padding: 14px 12px 92px;
}

.workbench-view-anchor {
