page {
  height: 100%;
}

.foundation-scroll {
  height: 100%;
}

.foundation-preview {
  min-height: 100%;
  padding: 20px 14px 36px;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-background);
  font-family: var(--ui-font-family-system);
}

.preview-heading {
  display: flex;
  margin-bottom: 14px;
  align-items: flex-start;
  justify-content: space-between;
}

.preview-heading__copy {
  display: flex;
  min-width: 0;
  margin-right: 12px;
  flex: 1;
  flex-direction: column;
}

.context-label {
  color: var(--ui-color-primary);
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-strong);
  letter-spacing: 0.04em;
}

.page-title {
  margin-top: 3px;
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-xxl);
  font-weight: var(--ui-font-weight-strong);
  line-height: var(--ui-line-height-title);
}

.page-description {
  max-width: 280px;
  margin-top: 6px;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-sm);
  line-height: var(--ui-line-height-normal);
}

.baseline-chip {
  display: flex;
  max-width: 150px;
  padding: 5px 9px;
  flex: none;
  align-items: center;
  overflow: hidden;
  color: var(--ui-color-primary-dark);
  background: var(--ui-color-primary-light);
  border-radius: var(--ui-radius-pill);
  font-family: monospace;
  font-size: var(--ui-font-size-xs);
  font-weight: var(--ui-font-weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-card {
  overflow: hidden;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-medium);
  box-shadow: var(--ui-shadow-card);
}

.preview-card + .preview-card {
  margin-top: 12px;
}

.card-heading {
  display: flex;
  min-height: 44px;
  padding: 0 13px;
  align-items: center;
  justify-content: space-between;
  background: var(--ui-color-surface-muted);
  border-bottom: 1px solid var(--ui-color-border);
}

.card-title {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-md);
  font-weight: var(--ui-font-weight-semibold);
}

.card-note {
  margin-left: 12px;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.button-grid {
  display: flex;
  padding: 8.5px;
  flex-wrap: wrap;
}

.button-cell {
  width: 50%;
  padding: 4.5px;
  box-sizing: border-box;
}

.setting-list {
  padding: 0 13px;
}

.setting-row {
  display: flex;
  min-height: 68px;
  align-items: center;
}

.setting-row + .setting-row {
  border-top: 1px solid var(--ui-color-border);
}

.setting-row.is-disabled {
  opacity: 0.58;
}

.setting-copy {
  display: flex;
  min-width: 0;
  min-height: 44px;
  padding: 7px 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.setting-title {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.setting-description {
  margin-top: 3px;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
  line-height: 1.4;
}

.choice-section {
  padding: 13px 13px 4px;
}

.radio-group {
  display: flex;
}

.radio-option + .radio-option {
  margin-left: 16px;
}

.field-wrap {
  margin: 8px 13px 13px;
}

.field-wrap--following {
  margin-top: -5px;
}

.chip-row {
  display: flex;
  padding: 13px 13px 6px;
  flex-wrap: wrap;
}

.chip-cell {
  margin-right: 7px;
  margin-bottom: 7px;
}

.alert-wrap {
  margin: 0 13px 13px;
}

.test-route-list {
  padding: 0 13px;
}

.test-route {
  display: flex;
  min-height: 52px;
  align-items: center;
  justify-content: space-between;
}

.test-route + .test-route {
  border-top: 1px solid var(--ui-color-border);
}

.test-route.is-pressed {
  opacity: 0.68;
}

.test-route-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.test-route-title {
  color: var(--ui-color-text-primary);
  font-size: var(--ui-font-size-sm);
  font-weight: var(--ui-font-weight-semibold);
}

.test-route-note {
  margin-top: 2px;
  color: var(--ui-color-text-muted);
  font-size: var(--ui-font-size-xs);
}

.test-route-arrow {
  margin-left: 12px;
  color: var(--ui-color-primary);
  font-size: 22px;
  line-height: 1;
}

@media (max-width: 340px) {
  .foundation-preview {
    padding-right: 10px;
    padding-left: 10px;
  }

  .page-description {
    max-width: 228px;
  }

  .button-cell {
    width: 100%;
  }
}
