@import '../workbench/index.wxss';
.guest-header { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; gap:12px; height:56px; box-sizing:border-box; }
.guest-title { font-size:16px; font-weight:600; flex:1; min-width:0; }
.guest-return { color:var(--ui-color-primary); padding:10px 12px; font-size:14px; }
.guest-scroll { height:calc(100vh - 56px); }
