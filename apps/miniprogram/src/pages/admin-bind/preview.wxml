<scroll-view class="identity-scroll" scroll-y show-scrollbar="{{false}}">
  <view class="identity-page is-login identity-bind-page">
    <view class="identity-login-intro">
      <view class="identity-login-brand-mark" aria-hidden="true"><view></view><view></view></view>
      <text class="identity-login-title">{{mode === 'loading' ? '正在读取绑定' : mode === 'error' ? '绑定链接不可用' : mode === 'authenticated' ? '绑定完成' : '确认绑定排班账号'}}</text>
      <text class="identity-bind-description">{{mode === 'error' ? '请向管理员重新获取绑定二维码，也可以使用访客码查看排班。' : '请核对管理员为你准备的账号。'}}</text>
    </view>
    <view class="identity-card identity-login-card">
      <ui-loading wx:if="{{mode === 'loading'}}" label="正在读取绑定信息"></ui-loading>
      <block wx:elif="{{mode === 'error'}}">
        <ui-alert title="绑定未完成" message="{{errorMessage}}" tone="danger"></ui-alert>
        <ui-button class="identity-card__button identity-card__button--secondary" label="进入访客页面" variant="secondary" bind:press="handleGuest"></ui-button>
      </block>
      <block wx:elif="{{mode === 'preview'}}">
        <text class="identity-bind-expiry">{{expiresAtLabel}}</text>
        <view class="identity-target">
          <text class="identity-target__label">目标账号</text>
          <text class="identity-target__name">{{isMemberQr ? realName : realNameMasked}}</text>
          <text class="identity-target__username">{{isMemberQr ? '工号：' + employeeCode : '账号：' + usernameMasked}}</text>
        </view>
        <text class="identity-bind-description">确认后，当前微信身份会绑定到该排班账号。</text>
        <ui-button class="identity-card__button" label="确认绑定" variant="primary" loading="{{loading}}" bind:press="handleConfirm"></ui-button>
        <ui-button class="identity-card__button identity-card__button--secondary" label="暂不绑定，进入访客页面" variant="secondary" bind:press="handleGuest"></ui-button>
      </block>
      <block wx:else>
        <view class="identity-success-mark" aria-hidden="true">✓</view>
        <text class="identity-card__heading">绑定成功</text>
        <text class="identity-bind-description">正在进入工作台。</text>
      </block>
    </view>
    <text class="identity-login-privacy">身份信息只用于进入有权限的排班群组。</text>
    <text class="identity-login-build">{{buildLabel}}</text>
  </view>
</scroll-view>
