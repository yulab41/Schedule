<scroll-view class="profile-scroll" scroll-y show-scrollbar="{{false}}">
  <view class="profile-page {{largeText ? 'is-large-text' : ''}}">
    <view class="profile-header"
      ><view
        class="header-back"
        hover-class="is-pressed"
        aria-role="button"
        aria-label="返回排班台"
        bindtap="handleBack"
        ><image src="/assets/icons/web-chevron-left.svg" mode="aspectFit" /></view
      ><view class="header-copy"
        ><text class="header-eyebrow">个人中心</text><text class="header-title">我的</text></view
      ><text class="build-label">{{buildLabel}}</text></view
    >
    <view wx:if="{{mode === 'missing'}}" class="profile-state"
      ><view class="state-mark">—</view><text class="state-title">尚未登录</text
      ><text class="state-copy">登录后才能查看个人资料和账号安全设置。</text
      ><navigator class="primary-action" url="/pages/identity/index" aria-role="button"
        >进入登录</navigator
      ></view
    >
    <block wx:else>
      <view class="identity-card"
        ><view class="profile-avatar">{{initial}}</view
        ><view class="identity-copy"
          ><text class="identity-name">{{realName}}</text
          ><text class="identity-role">已验证 · {{authMethodLabel}}</text
          ><text class="identity-version">{{profileVersion}}</text></view
        ><view class="status-pill">正常</view></view
      >
      <view class="section-card"
        ><view class="section-heading"
          ><text class="section-kicker">账号与安全</text
          ><text class="section-title">账户设置</text></view
        ><view class="setting-row"
          ><view
            ><text class="setting-title">登录身份</text
            ><text class="setting-copy">{{authMethodLabel}}</text></view
          ><text class="setting-value">当前</text></view
        ><view wx:if="{{canUnbindWechat}}" class="setting-row"
          ><view
            ><text class="setting-title">微信绑定</text
            ><text class="setting-copy">仅解除当前小程序身份，不影响排班资料</text></view
          ><button class="row-action" type="button" bindtap="handleUnbind">
            解除当前微信绑定
          </button></view
        ><view wx:else class="setting-row"
          ><view
            ><text class="setting-title">微信绑定</text
            ><text class="setting-copy">账号密码登录无需解除微信绑定</text></view
          ><text class="setting-value">不适用</text></view
        ></view
      >
      <view class="section-card"
        ><view class="section-heading"
          ><text class="section-kicker">会话</text><text class="section-title">切换账号</text></view
        ><text class="session-copy">切换登录方式会清理当前本地会话，不会删除业务资料或排班。</text
        ><button class="secondary-action" type="button" bindtap="handleSwitchLogin">
          切换登录方式
        </button></view
      >
      <button class="signout-action" type="button" bindtap="handleSignOut">退出当前会话</button>
    </block>
    <text class="privacy-note">⌁ 个人资料只用于当前账号展示；业务数据继续由服务端权限控制。</text>
  </view>
</scroll-view>
