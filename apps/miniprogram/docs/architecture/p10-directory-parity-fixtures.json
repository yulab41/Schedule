  "cases": [
    {
      "id": "idle-does-not-load-all",
      "kind": "state",
      "input": { "q": "", "filters": {} },
      "assertions": ["no-full-directory-search", "show-empty-or-priority-state"]
    },
    {
      "id": "search-chinese",
      "kind": "query",
      "directory": "internal",
      "query": { "q": "病案", "pageSize": 30 },
      "assertions": ["matches-subunit", "preserve-server-order"]
    },
    {
      "id": "search-pinyin-initials",
      "kind": "query",
      "directory": "employee",
      "query": { "q": "jzk", "pageSize": 30 },
      "assertions": ["matches-pinyin-initials", "show-job-title"]
    },
    {
      "id": "search-employee-code",
      "kind": "query",
      "directory": "employee",
      "query": { "q": "d0001", "pageSize": 30 },
      "assertions": ["matches-employee-code", "show-job-title"]
    },
    {
      "id": "phone-exact-and-prefix",
      "kind": "query",
      "query": { "q": "620", "pageSize": 1 },
      "assertions": [
        "phone-prefix-rank",
        "next-cursor-is-opaque",
        "cursor-only-continues-same-query"
      ]
    },
    {
      "id": "independent-floor-filter",
      "kind": "query",
      "query": { "floor": "5楼", "pageSize": 30 },
      "assertions": ["does-not-require-campus-or-section"]
    },
    {
      "id": "member-visibility",
      "kind": "authorization",
      "role": "member",
      "assertions": ["only-visibility-member", "administrator-entry-hidden"]
    },
    {
      "id": "administrator-visibility",
      "kind": "authorization",
      "role": "administrator",
      "assertions": ["visibility-member-and-administrator"]
    },
    {
      "id": "guest-denied",
      "kind": "authorization",
      "credential": "guest",
      "expectedHttpStatus": 403,
      "assertions": ["no-directory-data"]
    },
    {
      "id": "anonymous-denied",
      "kind": "authorization",
      "credential": "anonymous",
      "expectedHttpStatus": 401,
      "assertions": ["no-directory-data"]
    },
    {
      "id": "visitor-key-path-denied",
      "kind": "authorization",
      "credential": "visitor-key",
      "expectedHttpStatus": 404,
      "assertions": ["do-not-reuse-guest-calendar-route"]
    },
    {
      "id": "invalid-cursor",
      "kind": "validation",
      "query": { "cursor": "not-a-cursor" },
      "expectedHttpStatus": 400,
      "assertions": ["discard-cursor", "reload-first-page"]
    },
    {
      "id": "contact-display-policy",
      "kind": "privacy",
      "assertions": [
        "mobile-full-and-extension-dialable",
        "voice-full-dialable",
        "voice-extension-static",
        "fax-static",
        "no-raw-number-logging"
      ]
    },
    {
      "id": "same-contact-merge",
      "kind": "presentation",
      "assertions": ["merge-only-identical-contact-signature", "retain-all-entry-labels"]
    },
    {
      "id": "retry-preserves-query",
      "kind": "state",
      "assertions": ["keep-search-draft", "keep-filters", "no-duplicate-append"]
    }
