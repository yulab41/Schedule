<view class="phone-sheet">
  <text class="phone-sheet__member">{{memberName}}</text>
  <view wx:if="{{phoneActions.length === 0}}" class="phone-sheet__empty">该成员暂无电话号码</view>
  <view
    wx:for="{{phoneActions}}"
    wx:for-item="phoneAction"
    wx:key="actionId"
    class="phone-sheet__row"
  >
    <text>{{phoneAction.label}}</text>
    <text>{{phoneAction.number}}</text>
    <button
      wx:if="{{phoneAction.kind === 'dial'}}"
      data-action-id="{{phoneAction.actionId}}"
      bindtap="handleDial"
    >
      拨打
    </button>
    <button wx:else data-action-id="{{phoneAction.actionId}}" bindtap="handleCopy">
      复制（未确认）
    </button>
  </view>
</view>
