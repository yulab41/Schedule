<view class="group-switcher">
  <picker
    mode="selector"
    range="{{names}}"
    value="{{index}}"
    bindchange="onPickerChange"
    disabled="{{groups.length < 2}}"
  >
    <view class="group-switcher__inner">
      <text class="group-switcher__name">{{names[index] || '未选择群组'}}</text>
      <text class="group-switcher__arrow">▾</text>
    </view>
  </picker>
</view>
