.group-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.group-switcher.is-empty {
  color: var(--color-text-muted);
}

.group-switcher-label {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-switcher-arrow {
  margin-left: 12rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}
