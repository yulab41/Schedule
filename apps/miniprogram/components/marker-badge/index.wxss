.marker-badge {
  display: flex;
  box-sizing: border-box;
  width: 28rpx;
  min-width: 28rpx;
  min-height: 28rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: var(--v3-radius-sm);
  font-size: var(--v3-font-size-xs);
  font-weight: 700;
  line-height: 1;
}

.marker-badge--fill-color-primary-light {
  background: var(--v3-color-primary-light);
}

.marker-badge--fill-color-danger-light {
  background: var(--v3-color-danger-light);
}

.marker-badge--fill-color-warning-light {
  background: var(--v3-color-warning-light);
}

.marker-badge--foreground-color-primary {
  color: var(--v3-color-primary);
}

.marker-badge--foreground-color-danger {
  color: var(--v3-color-danger);
}

.marker-badge--foreground-color-warning {
  color: var(--v3-color-warning);
}

.marker-badge--pressed {
  opacity: 0.72;
}
