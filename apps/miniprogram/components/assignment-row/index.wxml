<view
  class="assignment-row {{comfortable ? 'assignment-row--comfortable' : ''}}"
  catchtap="handleRowRoute"
  data-action-id="{{assignment.routeActionId}}"
>
  <text class="assignment-row__member">{{assignment.memberName}}</text>
  <view wx:if="{{showDetails}}" class="assignment-row__details">
    <text class="assignment-row__role">{{assignment.roleName}}</text>
    <text class="assignment-row__shift-detail"
      >{{assignment.shiftTypeName}}（{{assignment.shiftTypeAbbreviation}}） ·
      {{assignment.timeRange}}</text
    >
    <text
      wx:if="{{assignment.actualMemberName && assignment.plannedMemberName && assignment.actualMemberName !== assignment.plannedMemberName}}"
      class="assignment-row__change"
      >原计划 {{assignment.plannedMemberName}} → 实际 {{assignment.actualMemberName}}</text
    >
  </view>
  <view class="assignment-row__meta">
    <text
      wx:if="{{!hideShiftBadge}}"
      class="assignment-row__shift"
      style="background-color: {{assignment.backgroundColor}}; color: {{assignment.foregroundColor}};"
      >{{assignment.compactShiftLabel}}</text
    >
    <view wx:if="{{assignment.markers.length > 0}}" class="assignment-row__markers">
      <marker-badge
        wx:for="{{assignment.markers}}"
        wx:for-item="marker"
        wx:key="actionId"
        marker="{{marker}}"
        bind:route="handleRoute"
      />
    </view>
  </view>
  <view wx:if="{{showPhones && assignment.phoneActions.length > 0}}" class="assignment-row__phones">
    <button
      wx:for="{{assignment.phoneActions}}"
      wx:for-item="phoneAction"
      wx:key="actionId"
      data-action-id="{{phoneAction.actionId}}"
      catchtap="handleRowRoute"
    >
      {{phoneAction.kind === 'dial' ? '拨打' : '复制（未确认）'}} {{phoneAction.number}}
    </button>
  </view>
</view>
