.assignment-row__meta,
.assignment-row__markers,
.assignment-row__phones,
.assignment-row__details {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.assignment-row {
  display: block;
  min-height: 56rpx;
}

.assignment-row--comfortable {
  box-sizing: border-box;
  min-height: var(--v3-touch-min);
  padding: var(--v3-space-xs) 0;
}

.assignment-row__member {
  display: block;
  overflow: hidden;
  color: var(--v3-color-text);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.25;
  overflow-wrap: anywhere;
  white-space: normal;
}

.assignment-row__details {
  flex-direction: column;
  margin-top: var(--v3-space-xxs);
  align-items: flex-start;
  color: var(--v3-color-text-muted);
  font-size: var(--v3-font-size-sm);
}

.assignment-row__role,
.assignment-row__shift-detail,
.assignment-row__change {
  display: block;
  overflow-wrap: anywhere;
}

.assignment-row__change {
  margin-top: var(--v3-space-xxs);
  color: var(--v3-color-warning);
}

.assignment-row__meta {
  gap: 4rpx;
  margin-top: 2rpx;
}

.assignment-row__shift {
  display: flex;
  box-sizing: border-box;
  min-width: 28rpx;
  min-height: 28rpx;
  padding: 0 4rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--v3-radius-sm);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.assignment-row__markers {
  flex-wrap: wrap;
  gap: 4rpx;
}

.assignment-row__phones {
  flex-wrap: wrap;
  gap: var(--v3-space-xs);
  margin-top: var(--v3-space-xs);
}
