<view class="date-detail-sheet">
  <text class="date-detail-sheet__date"
    >{{monthLabel}} {{day.dayNumber}}日 星期{{day.weekdayLabel}}</text
  >
  <view wx:if="{{day.holiday}}" class="date-detail-sheet__holiday">
    <text>{{day.holiday.holidayName}}</text>
    <text>{{day.holiday.isOffDay ? '休息日' : day.holiday.isWorkday ? '调休上班' : ''}}</text>
  </view>
  <view wx:if="{{day.assignments.length === 0}}" class="date-detail-sheet__empty">当日无排班</view>
  <assignment-row
    wx:for="{{day.assignments}}"
    wx:for-item="assignment"
    wx:key="assignmentId"
    assignment="{{assignment}}"
    show-phones="{{true}}"
    bind:route="handleRoute"
  />
</view>
