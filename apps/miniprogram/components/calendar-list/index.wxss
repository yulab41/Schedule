.calendar-list {
  display: block;
}

.calendar-list__day {
  display: block;
  margin-bottom: var(--v3-space-sm);
  padding: var(--v3-space-sm);
  border: 1rpx solid var(--v3-color-border);
  border-radius: var(--v3-radius-md);
  background: var(--v3-color-surface);
}

.calendar-list__day--today {
  background: var(--v3-color-primary-light);
  border-color: var(--v3-color-primary);
}

.calendar-list__day--weekend .calendar-list__date {
  color: var(--v3-color-weekend);
}

.calendar-list__day--past {
  opacity: 0.72;
}

.calendar-list__date-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--v3-space-xs);
}

.calendar-list__date-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--v3-space-xs);
}

.calendar-list__date {
  color: var(--v3-color-text);
  font-size: var(--v3-font-size-md);
  font-weight: 700;
}

.calendar-list__today-badge {
  padding: 2rpx var(--v3-space-xs);
  color: var(--v3-color-primary);
  font-size: var(--v3-font-size-xs);
  background: var(--v3-color-surface);
  border-radius: var(--v3-radius-sm);
}

.calendar-list__assignments {
  display: block;
  margin-top: var(--v3-space-xs);
}
