<view class="calendar-list">
  <view
    wx:for="{{days}}"
    wx:for-item="day"
    wx:key="id"
    class="calendar-list__day"
    catchtap="handleDayRoute"
    data-action-id="{{day.routeActionId}}"
  >
    <view class="calendar-list__date-card">
      <text class="calendar-list__date">{{day.businessDate}} {{day.weekdayLabel}}</text>
      <holiday-tag wx:if="{{day.holiday}}" holiday="{{day.holiday}}" />
    </view>
    <view class="calendar-list__assignments">
      <assignment-row
        wx:for="{{day.assignments}}"
        wx:for-item="assignment"
        wx:key="assignmentId"
        assignment="{{assignment}}"
        role="{{role}}"
        bind:route="handleRoute"
      />
    </view>
  </view>
</view>
