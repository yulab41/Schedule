<scroll-view scroll-x class="manual-grid">
  <view class="manual-grid__table">
    <view class="manual-grid__header">
      <view class="manual-grid__corner">人员 \ 日期</view>
      <view wx:for="{{columns}}" wx:key="cycleDay" class="manual-grid__column-head">
        <text>{{item.date.slice(5)}}</text>
        <text class="manual-grid__weekday">{{item.weekday}}</text>
      </view>
    </view>
    <view wx:for="{{grid}}" wx:for-item="row" wx:key="membershipId" class="manual-grid__row">
      <view class="manual-grid__row-head {{row.isStale ? 'is-stale' : ''}}">
        {{row.realName}}
      </view>
      <view
        wx:for="{{row.cells}}"
        wx:for-item="cell"
        wx:key="key"
        class="manual-grid__cell {{cell.isStale ? 'is-stale' : ''}} {{selected && selected.cycleDay === cell.cycleDay && selected.membershipId === cell.membershipId ? 'is-selected' : ''}}"
        style="{{cell.shiftTypeId ? 'background: ' + cell.color + '; color: ' + cell.textColor + ';' : ''}}"
        data-cycle-day="{{cell.cycleDay}}"
        data-membership-id="{{cell.membershipId}}"
        bind:tap="onCellTap"
      >
        <text wx:if="{{cell.shiftTypeId}}">{{cell.abbreviation}}</text>
      </view>
    </view>
  </view>
</scroll-view>
