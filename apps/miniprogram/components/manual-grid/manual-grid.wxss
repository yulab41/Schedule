.manual-grid {
  width: 100%;
  white-space: nowrap;
}

.manual-grid__table {
  display: inline-block;
  min-width: 100%;
}

.manual-grid__header,
.manual-grid__row {
  display: flex;
}

.manual-grid__corner,
.manual-grid__row-head {
  position: sticky;
  left: 0;
  z-index: 2;
  width: 120rpx;
  min-width: 120rpx;
  padding: 12rpx 8rpx;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 22rpx;
}

.manual-grid__column-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  padding: 8rpx 0;
  border-left: 1rpx solid #e5e7eb;
  font-size: 22rpx;
}

.manual-grid__weekday {
  color: var(--color-text-muted);
  font-size: 20rpx;
}

.manual-grid__row-head {
  display: flex;
  align-items: center;
  border-top: 1rpx solid #e5e7eb;
  font-weight: 500;
}

.manual-grid__row-head.is-stale,
.manual-grid__cell.is-stale {
  opacity: 0.45;
}

.manual-grid__cell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  height: 72rpx;
  border-left: 1rpx solid #e5e7eb;
  border-top: 1rpx solid #e5e7eb;
  box-sizing: border-box;
  font-size: 24rpx;
}

.manual-grid__cell.is-selected {
  outline: 4rpx solid var(--color-primary);
  outline-offset: -4rpx;
}
