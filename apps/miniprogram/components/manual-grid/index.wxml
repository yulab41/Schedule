<scroll-view class="manual-grid" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{true}}">
  <view class="manual-grid__table">
    <view class="manual-grid__header"
      ><view class="manual-grid__name">成员</view
      ><view wx:for="{{columns}}" wx:for-item="column" wx:key="cycleDay" class="manual-grid__day"
        ><text>{{column.date}}</text><text>{{column.weekday}}</text
        ><text wx:if="{{column.holidayName}}">{{column.holidayName}}</text></view
      ></view
    >
    <view wx:for="{{rows}}" wx:for-item="row" wx:key="membershipId" class="manual-grid__row"
      ><view class="manual-grid__name"
        ><text>{{row.realName}}</text><text wx:if="{{row.isStale}}">已离岗</text></view
      ><view
        wx:for="{{row.cells}}"
        wx:for-item="cell"
        wx:key="key"
        class="manual-grid__cell {{cell.isSelected ? 'manual-grid__cell--selected' : ''}} {{cell.isStale ? 'manual-grid__cell--stale' : ''}}"
        data-cycle-day="{{cell.cycleDay}}"
        data-membership-id="{{row.membershipId}}"
        bindtap="handleCell"
        bindtouchstart="handleTouchStart"
        bindtouchmove="handleTouchMove"
        bindtouchend="handleTouchEnd"
        bindtouchcancel="handleTouchEnd"
        ><text
          wx:if="{{cell.abbreviation}}"
          style="color: {{cell.textColor}}; background-color: {{cell.color}}"
          >{{cell.abbreviation}}</text
        ><text wx:if="{{cell.isStale}}">!</text></view
      ></view
    >
  </view>
</scroll-view>
