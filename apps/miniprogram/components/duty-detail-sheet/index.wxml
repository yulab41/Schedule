<view class="duty-detail-sheet">
  <text class="duty-detail-sheet__member">{{assignment.memberName}}</text>
  <text class="duty-detail-sheet__line">{{assignment.businessDate}} · {{assignment.roleName}}</text>
  <view class="duty-detail-sheet__shift">
    <text
      class="duty-detail-sheet__shift-chip"
      style="background-color: {{assignment.backgroundColor}}; color: {{assignment.foregroundColor}};"
      >{{assignment.shiftTypeAbbreviation}}</text
    >
    <text>{{assignment.shiftTypeName}} · {{assignment.timeRange}}</text>
  </view>
  <text
    wx:if="{{assignment.actualMemberName && assignment.plannedMemberName && assignment.actualMemberName !== assignment.plannedMemberName}}"
    class="duty-detail-sheet__change"
    >原计划 {{assignment.plannedMemberName}} → 实际 {{assignment.actualMemberName}}</text
  >
  <view wx:if="{{assignment.markers.length > 0}}" class="duty-detail-sheet__markers">
    <marker-badge
      wx:for="{{assignment.markers}}"
      wx:for-item="marker"
      wx:key="actionId"
      marker="{{marker}}"
      bind:route="handleMarkerRoute"
    />
    <text wx:for="{{assignment.markers}}" wx:for-item="marker" wx:key="description"
      >{{marker.description}}</text
    >
  </view>
  <view wx:if="{{assignment.phoneActions.length > 0}}" class="duty-detail-sheet__phones">
    <button
      wx:for="{{assignment.phoneActions}}"
      wx:for-item="phoneAction"
      wx:key="actionId"
      data-action-id="{{phoneAction.actionId}}"
      bindtap="handleActionRoute"
    >
      {{phoneAction.kind === 'dial' ? '拨打' : '复制（未确认）'}} {{phoneAction.number}}
    </button>
  </view>
  <button
    wx:if="{{role !== 'guest' && assignment.markers.length > 0}}"
    data-action-id="{{assignment.markers[0].actionId}}"
    bindtap="handleActionRoute"
  >
    查看事件记录
  </button>
</view>
