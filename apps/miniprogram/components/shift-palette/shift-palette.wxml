<scroll-view scroll-x class="shift-palette">
  <view
    wx:for="{{shiftTypes}}"
    wx:key="id"
    class="shift-palette__item {{selectedId === item.id ? 'is-selected' : ''}}"
    style="background: {{item.color}}; color: {{item.textColor}};"
    data-id="{{item.id}}"
    bind:tap="onSelect"
  >
    <text class="shift-palette__abbr">{{item.abbreviation}}</text>
    <text class="shift-palette__name">{{item.name}}</text>
  </view>
</scroll-view>
