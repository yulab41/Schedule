<view class="calendar-week">
  <view class="calendar-week__row">
    <view
      wx:for="{{week.days}}"
      wx:for-item="day"
      wx:key="id"
      class="calendar-week__cell"
      catchtap="handleDayRoute"
      data-action-id="{{day.routeActionId}}"
    >
      <view class="calendar-week__day-header">
        <text class="calendar-week__day-number">{{day.dayNumber}}</text>
        <holiday-tag wx:if="{{day.holiday}}" holiday="{{day.holiday}}" />
      </view>
      <view class="calendar-week__assignments">
        <assignment-row
          wx:for="{{day.assignments}}"
          wx:for-item="assignment"
          wx:key="assignmentId"
          assignment="{{assignment}}"
          hideShiftBadge="{{day.assignments.length === 1}}"
          role="{{role}}"
          bind:route="handleRoute"
        />
      </view>
    </view>
  </view>
</view>
