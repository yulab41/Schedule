.calendar-week {
  display: block;
}

.calendar-week__row {
  display: flex;
  flex-direction: column;
  gap: var(--v3-space-xs);
}

.calendar-week__cell {
  display: block;
  min-height: var(--v3-touch-min);
  padding: var(--v3-space-xs);
  border: 1rpx solid var(--v3-color-border);
  border-radius: var(--v3-radius-md);
  background: var(--v3-color-surface);
}

.calendar-week__cell--today {
  background: var(--v3-color-primary-light);
  border-color: var(--v3-color-primary);
}

.calendar-week__cell--weekend .calendar-week__day-number,
.calendar-week__cell--weekend .calendar-week__weekday {
  color: var(--v3-color-weekend);
}

.calendar-week__cell--past {
  opacity: 0.72;
}

.calendar-week__day-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--v3-space-xs);
}

.calendar-week__date-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--v3-space-xs);
}

.calendar-week__day-number {
  color: var(--v3-color-text);
  font-size: var(--v3-font-size-md);
  font-weight: 700;
}

.calendar-week__weekday,
.calendar-week__empty {
  color: var(--v3-color-text-muted);
  font-size: var(--v3-font-size-sm);
}

.calendar-week__today-badge {
  padding: 2rpx var(--v3-space-xs);
  color: var(--v3-color-primary);
  font-size: var(--v3-font-size-xs);
  background: var(--v3-color-surface);
  border-radius: var(--v3-radius-sm);
}

.calendar-week__empty {
  margin-top: var(--v3-space-xs);
}

.calendar-week__assignments {
  display: block;
  margin-top: var(--v3-space-xs);
}
