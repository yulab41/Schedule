.holiday-tag {
  display: block;
  box-sizing: border-box;
  max-width: 48rpx;
  min-height: 28rpx;
  padding: 0 4rpx;
  border-radius: var(--v3-radius-sm);
  font-size: 20rpx;
  line-height: 28rpx;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
}

.holiday-tag--off-day {
  color: var(--v3-color-danger);
  background: var(--v3-color-danger-light);
}

.holiday-tag--workday {
  color: var(--v3-color-primary);
  background: var(--v3-color-primary-light);
}

.holiday-tag--neutral {
  color: var(--v3-color-text-muted);
  background: var(--v3-color-surface);
}
