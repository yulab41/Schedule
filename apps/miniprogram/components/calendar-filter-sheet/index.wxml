<bottom-sheet
  id="calendar-filter-sheet-shell"
  title="{{title}}"
  visible="{{visible}}"
  sheet-key="{{sheetKey}}"
  bind:request-close="handleInnerRequestClose"
  bind:closed="handleInnerClosed"
>
  <view class="calendar-filter-sheet">
    <view class="calendar-filter-sheet__summary" aria-live="polite">
      <text class="calendar-filter-sheet__summary-label">{{selectionSummary}}</text>
      <text class="calendar-filter-sheet__summary-help">未选择时保留全部排班</text>
    </view>

    <view class="calendar-filter-sheet__search">
      <input
        class="calendar-filter-sheet__search-input"
        aria-label="{{searchPlaceholder}}"
        value="{{draft.query}}"
        placeholder="{{searchPlaceholder}}"
        adjust-position="{{true}}"
        confirm-type="search"
        cursor-spacing="24"
        maxlength="80"
        bindinput="handleSearchInput"
      />
      <button
        wx:if="{{draft.query.length > 0}}"
        class="calendar-filter-sheet__search-clear"
        aria-label="清空搜索内容"
        bindtap="handleClearSearch"
      >
        清搜索
      </button>
    </view>

    <view class="calendar-filter-sheet__bulk-actions">
      <button
        class="calendar-filter-sheet__bulk-action"
        disabled="{{!optionsReady || allSelected || totalCount === 0}}"
        bindtap="handleSelectAll"
      >
        全选
      </button>
      <button
        class="calendar-filter-sheet__bulk-action"
        disabled="{{selectionIntentCount === 0}}"
        bindtap="handleClearSelection"
      >
        清空
      </button>
    </view>

    <view class="calendar-filter-sheet__options">
      <button
        wx:for="{{items}}"
        wx:for-item="item"
        wx:key="id"
        class="calendar-filter-sheet__option {{item.isSelected ? 'calendar-filter-sheet__option--selected' : ''}}"
        data-option-id="{{item.id}}"
        aria-label="{{item.label}}，{{item.isSelected ? '已选择' : '未选择'}}"
        aria-pressed="{{item.isSelected}}"
        bindtap="handleOptionTap"
      >
        <view class="calendar-filter-sheet__option-copy">
          <text class="calendar-filter-sheet__option-label">{{item.label}}</text>
          <text wx:if="{{item.hint}}" class="calendar-filter-sheet__option-hint"
            >{{item.hint}}</text
          >
        </view>
        <view class="calendar-filter-sheet__selection-mark" aria-hidden="true">
          <text wx:if="{{item.isSelected}}" class="calendar-filter-sheet__check">✓</text>
        </view>
      </button>
      <view wx:if="{{items.length === 0}}" class="calendar-filter-sheet__empty">
        {{emptyMessage}}
      </view>
    </view>

    <view class="calendar-filter-sheet__footer">
      <button class="calendar-filter-sheet__footer-button" bindtap="handleCancel">取消</button>
      <button
        class="calendar-filter-sheet__footer-button calendar-filter-sheet__footer-button--apply"
        disabled="{{!optionsReady}}"
        bindtap="handleApply"
      >
        应用
      </button>
    </view>
  </view>
</bottom-sheet>
