.confirm-sheet__mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  /* 先写半透明底色：Android/低端机不支持 backdrop-filter 时即为降级效果 */
  background: rgba(17, 24, 39, 0.45);
  backdrop-filter: blur(12rpx);
  animation: sheet-fade-in 0.25s ease;
}

.confirm-sheet__mask.is-leaving {
  animation: sheet-fade-out 0.22s ease forwards;
}

.confirm-sheet__panel {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 0 env(safe-area-inset-bottom);
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
  /* 弹簧入场：0.34,1.56,0.64,1 会轻微越过终点再回弹，时长可按实际布局调整 */
  animation: sheet-in 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.confirm-sheet__panel.is-leaving {
  animation: sheet-out 0.22s ease forwards;
}

@keyframes sheet-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes sheet-out {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}

@keyframes sheet-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes sheet-fade-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

.confirm-sheet__grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 16rpx;
  border-radius: 8rpx;
  background: #e5e7eb;
}

.confirm-sheet__title {
  padding: 8rpx 32rpx 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.confirm-sheet__content {
  max-height: 480rpx;
  padding: 0 32rpx;
}

.confirm-sheet__content-inner {
  color: var(--color-text-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.confirm-sheet__actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 32rpx 16rpx;
}

.confirm-sheet__button {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  transition:
    transform 0.12s ease,
    opacity 0.12s ease;
}

.confirm-sheet__button::after {
  border: none;
}

.confirm-sheet__button--cancel {
  background: #f2f4f7;
  color: var(--color-text);
}

.confirm-sheet__button--confirm {
  background: var(--color-primary);
  color: #ffffff;
}

.confirm-sheet__button--hover {
  transform: scale(0.98);
  opacity: 0.85;
}
