.calendar-grid {
  padding: 16rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.calendar-weekdays {
  display: flex;
  margin-bottom: 8rpx;
}

.calendar-weekday {
  flex: 1;
  padding: 8rpx 0;
  color: var(--color-text-muted);
  font-size: 24rpx;
  text-align: center;
}

.calendar-weekday.is-weekend {
  color: var(--color-weekend);
}

.calendar-week {
  display: flex;
}

.calendar-day {
  flex: 1;
  min-height: 104rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: var(--radius-sm);
}

.calendar-day.is-placeholder {
  visibility: hidden;
}

.calendar-day.is-today {
  background: rgba(245, 197, 24, 0.22);
}

.calendar-day-number {
  display: block;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.calendar-day-number.is-weekend {
  color: var(--color-weekend);
}

.calendar-day.is-today .calendar-day-number {
  color: #8a6d00;
  font-weight: 600;
}

.calendar-duty {
  margin-top: 6rpx;
  padding: 6rpx 2rpx;
  overflow: hidden;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
