.calendar-grid__weekdays,
.calendar-grid__week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.calendar-grid__weekday {
  padding: 12rpx 0;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.calendar-grid__weekday.is-weekend {
  color: var(--color-weekend);
}

.calendar-grid__cell {
  min-height: 96rpx;
  margin: 4rpx;
  padding: 8rpx;
  background: var(--color-surface);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  overflow: hidden;
}

.calendar-grid__cell.is-weekend {
  background: #fff7f7;
}

.calendar-grid__cell.is-today {
  outline: 4rpx solid var(--color-today);
}

.calendar-grid__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.calendar-grid__day {
  font-size: 24rpx;
}

.calendar-grid__holiday {
  color: var(--color-weekend);
  font-size: 20rpx;
}

.calendar-grid__shift {
  margin-top: 4rpx;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
}

.calendar-grid__shift-abbr {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-grid__marker {
  margin-left: 4rpx;
  font-size: 18rpx;
}
