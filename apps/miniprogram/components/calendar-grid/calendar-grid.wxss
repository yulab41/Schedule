.calendar-grid__weekdays,
.calendar-grid__week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.calendar-grid__weekdays {
  border-bottom: 1rpx solid #f0f2f5;
}

.calendar-grid__weekday {
  padding: 14rpx 0;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.calendar-grid__weekday.is-weekend {
  color: var(--color-weekend);
}

.calendar-grid__cell {
  min-height: 96rpx;
  padding: 8rpx;
  box-sizing: border-box;
  overflow: hidden;
  /* 按压微反馈：轻微缩放 + 浅色底（低端机仅保留背景色过渡） */
  transition:
    background-color 0.15s ease,
    transform 0.15s ease;
}

.calendar-grid__week {
  border-bottom: 1rpx solid #f6f7f9;
}

.calendar-grid__cell--press {
  transform: scale(0.96);
  background: var(--color-primary-light);
}

.calendar-grid__cell.is-today {
  background: rgba(245, 197, 24, 0.12);
  box-shadow: inset 0 0 0 2rpx var(--color-today);
}

.calendar-grid__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.calendar-grid__day {
  font-size: 24rpx;
}

.calendar-grid__holiday {
  color: var(--color-weekend);
  font-size: 20rpx;
}

.calendar-grid__shift {
  margin-top: 4rpx;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
}

.calendar-grid__shift-abbr {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-grid__marker {
  margin-left: 4rpx;
  font-size: 18rpx;
}
