<view class="calendar-grid">
  <view class="calendar-grid__weekdays">
    <text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this" class="calendar-grid__weekday {{index >= 5 ? 'is-weekend' : ''}}">{{item}}</text>
  </view>
  <view wx:for="{{weeks}}" wx:key="index" class="calendar-grid__week">
    <view
      wx:for="{{item.cells}}"
      wx:key="businessDate"
      class="calendar-grid__cell {{item.isWeekend ? 'is-weekend' : ''}} {{item.isToday ? 'is-today' : ''}}"
      hover-class="calendar-grid__cell--press"
      hover-stay-time="60"
      data-date="{{item.businessDate}}"
      bind:tap="onCellTap"
    >
      <view class="calendar-grid__top">
        <text class="calendar-grid__day">{{item.dayNumber}}</text>
        <text wx:if="{{item.holidayLabel}}" class="calendar-grid__holiday">{{item.holidayLabel}}</text>
      </view>
      <view
        wx:for="{{item.assignments}}"
        wx:for-item="assignment"
        wx:key="id"
        class="calendar-grid__shift"
        style="background: {{assignment.color}}; color: {{assignment.textColor}};"
      >
        <text class="calendar-grid__shift-abbr">{{assignment.abbreviation}}</text>
        <text wx:for="{{assignment.markers}}" wx:for-item="marker" wx:key="*this" class="calendar-grid__marker">{{marker}}</text>
      </view>
    </view>
  </view>
</view>
