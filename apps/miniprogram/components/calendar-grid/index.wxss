.calendar-grid {
  display: block;
}

.calendar-grid__weekday-row,
.calendar-grid__week,
.calendar-grid__day-header {
  display: flex;
  flex-direction: row;
}

.calendar-grid__weekday,
.calendar-grid__cell {
  flex: 1;
  min-width: 0;
}

.calendar-grid__weekday {
  display: flex;
  min-height: var(--v3-touch-min);
  align-items: center;
  justify-content: center;
  color: var(--v3-color-text-muted);
}

.calendar-grid__weekday--weekend {
  color: var(--v3-color-weekend);
}

.calendar-grid__week {
  margin-bottom: var(--v3-space-xs);
}

.calendar-grid__padding,
.calendar-grid__day {
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 8rpx;
  border: 1rpx solid var(--v3-color-border);
  border-radius: var(--v3-radius-md);
}

.calendar-grid__padding {
  display: block;
  background: var(--v3-color-background);
}

.calendar-grid__day {
  display: block;
  background: var(--v3-color-surface);
}

.calendar-grid__day--today {
  border: 2rpx solid var(--v3-color-primary);
}

.calendar-grid__day--past {
  background: #f3f4f6;
}

.calendar-grid__day--off-day {
  background: var(--v3-color-warning-light);
}

.calendar-grid__day-header {
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--v3-space-xs);
}

.calendar-grid__day-number {
  color: var(--v3-color-text);
  font-size: var(--v3-font-size-md);
  font-weight: 700;
}

.calendar-grid__assignments {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-top: var(--v3-space-xs);
}
