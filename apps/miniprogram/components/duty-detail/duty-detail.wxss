.duty-detail__mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.duty-detail__panel {
  width: 100%;
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}

.duty-detail__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.duty-detail__title {
  font-size: 36rpx;
  font-weight: 600;
}

.duty-detail__close {
  padding: 8rpx 20rpx;
  font-size: 40rpx;
  color: var(--color-text-muted);
}

.duty-detail__row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.duty-detail__phones {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.duty-detail__no-phone {
  margin-top: 24rpx;
  color: var(--color-text-muted);
}
