.duty-detail__mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.45);
  backdrop-filter: blur(12rpx);
  animation: duty-fade-in 0.25s ease;
}

.duty-detail__mask.is-leaving {
  animation: duty-fade-out 0.22s ease forwards;
}

.duty-detail__panel {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 0 env(safe-area-inset-bottom);
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
  animation: duty-in 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.duty-detail__panel.is-leaving {
  animation: duty-out 0.22s ease forwards;
}

@keyframes duty-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes duty-out {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}

@keyframes duty-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes duty-fade-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

.duty-detail__grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 16rpx;
  border-radius: 8rpx;
  background: #e5e7eb;
}

.duty-detail__body {
  max-height: 70vh;
  padding: 0 32rpx;
}

.duty-detail__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.duty-detail__title {
  font-size: 36rpx;
  font-weight: 600;
}

.duty-detail__close {
  padding: 8rpx 20rpx;
  font-size: 40rpx;
  color: var(--color-text-muted);
}

.duty-detail__row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.duty-detail__phones {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.duty-detail__no-phone {
  margin-top: 24rpx;
  color: var(--color-text-muted);
}
