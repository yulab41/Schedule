.duty-modal-mask {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.duty-modal {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  width: 560rpx;
  padding: 40rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
}

.duty-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.duty-modal-row {
  color: var(--color-text);
  font-size: 28rpx;
}

.duty-modal-markers {
  display: flex;
  gap: 12rpx;
}

.duty-modal-marker {
  padding: 4rpx 12rpx;
  color: #b42318;
  background: #fee4e2;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
}
