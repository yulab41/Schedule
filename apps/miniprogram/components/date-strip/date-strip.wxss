.date-strip {
  width: 100%;
  white-space: nowrap;
}

.date-strip__track {
  display: inline-flex;
  padding: 12rpx 24rpx;
}

.date-strip__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 108rpx;
  margin-right: 8rpx;
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
  background: var(--color-surface);
  /* 滚动中由 JS 直接写 transform/opacity，无过渡；吸附时启用下方过渡 */
  transition: none;
  transform-origin: center;
}

.date-strip.is-snapping .date-strip__item {
  /* 吸附回弹时长/曲线可按实际布局调整 */
  transition:
    transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
    opacity 0.25s ease;
}

.date-strip__item--hover {
  opacity: 0.8;
}

.date-strip__item.is-selected {
  color: #ffffff;
  background: var(--color-primary);
}

.date-strip__weekday {
  font-size: 20rpx;
  line-height: 1.4;
  opacity: 0.8;
}

.date-strip__day {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* 低端机降级：若按帧更新 transform 掉帧，可移除 enhanced 并仅保留 is-selected 高亮，
   或把 STYLE_UPDATE_INTERVAL_MS 调大（组件注释已说明）。 */
