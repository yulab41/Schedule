.shift-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 16rpx;
  padding: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.shift-card__bar {
  width: 8rpx;
  margin-right: 16rpx;
  border-radius: 4rpx;
}

.shift-card__line {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.shift-card__name {
  font-weight: 600;
}

.shift-card__time {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.shift-card__markers {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.shift-card__marker {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--color-primaryLight, #eff6ff);
  color: var(--color-primary);
  font-size: 22rpx;
}
