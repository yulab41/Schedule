.shift-card {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.shift-card-badge {
  display: grid;
  flex: none;
  min-width: 56rpx;
  min-height: 56rpx;
  place-items: center;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 600;
}

.shift-card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.shift-card-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.shift-card-name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shift-card-time {
  margin-left: auto;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.shift-card-role {
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shift-card-marker {
  color: #b42318;
  font-size: 22rpx;
}

.shift-card-call {
  flex: none;
  padding: 10rpx 20rpx;
  color: var(--color-primary);
  background: #e8f1fb;
  border-radius: 999rpx;
  font-size: 24rpx;
}
