<view wx:if="{{assignment}}" class="shift-card" bind:tap="onTap">
  <view class="shift-card__bar" style="background: {{assignment.shiftTypeColor}};"></view>
  <view class="flex-1">
    <view class="shift-card__line">
      <text class="shift-card__name">{{assignment.shiftTypeName}}</text>
      <text class="shift-card__time">{{assignment.shiftTime}}</text>
    </view>
    <view class="shift-card__line muted">
      <text>{{assignment.scheduleRoleName}}</text>
      <text>{{assignment.memberName}}</text>
    </view>
    <view wx:if="{{assignment.markerTexts.length > 0}}" class="shift-card__markers">
      <text wx:for="{{assignment.markerTexts}}" wx:key="*this" class="shift-card__marker">{{item}}</text>
    </view>
  </view>
</view>
