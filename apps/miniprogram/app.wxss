@import './tokens/index.wxss';

page {
  display: block;
  box-sizing: border-box;
  min-height: 100%;
  color: var(--v3-color-text);
  background: var(--v3-color-background);
  font-family:
    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

button,
input,
scroll-view,
text,
view {
  box-sizing: border-box;
}
