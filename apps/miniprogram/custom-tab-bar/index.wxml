<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-bar__item {{selected === index ? 'is-active' : ''}}"
    hover-class="tab-bar__item--hover"
    hover-stay-time="80"
    data-path="{{item.pagePath}}"
    bind:tap="onSwitchTab"
  >
    <!--
      图标由 CSS 形状绘制：线性态 = 透明填充 + 描边；
      激活态 = 同形状填充 + 弹性缩放，通过 transition/animation 平滑过渡，
      不依赖图片替换，天然支持任意配色与回弹。
    -->
    <view class="tab-bar__icon tab-bar__icon--{{item.icon}}">
      <view class="tab-bar__shape tab-bar__shape--1"></view>
      <view class="tab-bar__shape tab-bar__shape--2"></view>
      <view class="tab-bar__shape tab-bar__shape--3"></view>
      <view class="tab-bar__shape tab-bar__shape--4"></view>
    </view>
    <text class="tab-bar__label">{{item.text}}</text>
  </view>
</view>
