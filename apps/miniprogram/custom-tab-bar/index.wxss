.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  background: var(--color-surface);
  border-top: 1rpx solid #eef1f5;
  padding-bottom: env(safe-area-inset-bottom);
  /* 轻投影即可，避免厚重阴影（扁平化原则） */
  box-shadow: 0 -4rpx 24rpx rgba(31, 35, 41, 0.04);
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 10rpx;
  color: #9aa0a6;
  transition: color 0.2s ease;
}

/* 按压微反馈：透明度 + 轻微缩小（低端机也可流畅运行） */
.tab-bar__item--hover {
  opacity: 0.7;
}

.tab-bar__item.is-active {
  color: var(--color-primary);
}

.tab-bar__icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  /* 切换回弹：激活时播放 tab-pop，时长/弹性可按实际布局调整 */
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-bar__item.is-active .tab-bar__icon {
  animation: tab-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes tab-pop {
  0% {
    transform: scale(0.82);
  }
  55% {
    transform: scale(1.16);
  }
  100% {
    transform: scale(1);
  }
}

.tab-bar__label {
  font-size: 20rpx;
  line-height: 1.2;
  margin-top: 6rpx;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-bar__item.is-active .tab-bar__label {
  transform: translateY(-2rpx);
}

/* ---------- CSS 图标形状 ---------- */
.tab-bar__shape {
  display: none;
}

/* 工作台：2x2 网格，线性为描边、激活为填充 */
.tab-bar__icon--home .tab-bar__shape {
  position: absolute;
  display: block;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease;
}

.tab-bar__icon--home .tab-bar__shape--1 {
  left: 5rpx;
  top: 5rpx;
}

.tab-bar__icon--home .tab-bar__shape--2 {
  left: 25rpx;
  top: 5rpx;
}

.tab-bar__icon--home .tab-bar__shape--3 {
  left: 5rpx;
  top: 25rpx;
}

.tab-bar__icon--home .tab-bar__shape--4 {
  left: 25rpx;
  top: 25rpx;
}

.tab-bar__item.is-active .tab-bar__icon--home .tab-bar__shape {
  background: currentColor;
}

/* 日历：圆角矩形 + 顶部挂环 + 内部事件条（激活时事件条加粗高亮） */
.tab-bar__icon--calendar {
  box-sizing: border-box;
  width: 44rpx;
  height: 40rpx;
  margin: 4rpx auto;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
}

.tab-bar__icon--calendar::before,
.tab-bar__icon--calendar::after {
  content: '';
  position: absolute;
  top: -4rpx;
  width: 6rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  transition: background-color 0.2s ease;
}

.tab-bar__icon--calendar::before {
  left: 8rpx;
}

.tab-bar__icon--calendar::after {
  right: 8rpx;
}

.tab-bar__icon--calendar .tab-bar__shape--1 {
  position: absolute;
  display: block;
  left: 7rpx;
  top: 20rpx;
  width: 26rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
  opacity: 0.35;
  transition:
    height 0.2s ease,
    opacity 0.2s ease;
}

.tab-bar__item.is-active .tab-bar__icon--calendar .tab-bar__shape--1 {
  height: 6rpx;
  opacity: 1;
}

/* 通知：铃身（描边→填充）+ 底部铃锤 */
.tab-bar__icon--bell {
  box-sizing: border-box;
  width: 34rpx;
  height: 32rpx;
  margin: 6rpx auto 4rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 18rpx 18rpx 4rpx 4rpx;
  transition: background-color 0.2s ease;
}

.tab-bar__icon--bell::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 28rpx;
  width: 8rpx;
  height: 8rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.tab-bar__icon--bell::after {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 22rpx;
  width: 36rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 20rpx 20rpx 0 0;
}

.tab-bar__item.is-active .tab-bar__icon--bell {
  background: currentColor;
}

/* 我的：头部圆形 + 肩部圆弧，激活时填充 */
.tab-bar__icon--user::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  transition: background-color 0.2s ease;
}

.tab-bar__icon--user::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 28rpx;
  width: 34rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 22rpx 22rpx 0 0;
  transition: background-color 0.2s ease;
}

.tab-bar__item.is-active .tab-bar__icon--user::before,
.tab-bar__item.is-active .tab-bar__icon--user::after {
  background: currentColor;
}
