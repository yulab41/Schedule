{
  "compilerOptions": {
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["miniprogram-api-typings"],
    "paths": {
      "@schedule/client-core": ["../../packages/client-core/dist/index.d.ts"],
      "@schedule/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["minitest/**/*"]
}
