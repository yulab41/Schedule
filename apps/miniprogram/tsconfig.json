{
  "compilerOptions": {
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["miniprogram-api-typings"],
    "paths": {
      "@schedule/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
