{
  "name": "@schedule/miniprogram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "auto-preview": "pnpm run core:prepare && node ../../scripts/miniprogram-devtools.mjs auto-preview",
    "build-npm": "pnpm run core:prepare && node ../../scripts/miniprogram-client-core-devtools-build.mjs",
    "calendar-core:prepare": "pnpm --filter @schedule/calendar-core build && node ../../scripts/miniprogram-calendar-core-bundle-gate.mjs",
    "client-core:prepare": "pnpm --filter @schedule/client-core build && node ../../scripts/miniprogram-client-core-bundle-gate.mjs",
    "core:prepare": "pnpm run client-core:prepare && pnpm run calendar-core:prepare",
    "preview": "pnpm run core:prepare && node ../../scripts/miniprogram-devtools.mjs preview",
    "typecheck": "pnpm run core:prepare && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@schedule/calendar-core": "workspace:*",
    "@schedule/client-core": "workspace:*",
    "tdesign-miniprogram": "^1.16.0"
  },
  "devDependencies": {
    "miniprogram-api-typings": "^5.2.3"
  }
}
