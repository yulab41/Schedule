{
  "name": "@schedule/miniprogram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@schedule/client-core": "workspace:*",
    "@schedule/contracts": "workspace:*",
    "@schedule/presentation-core": "workspace:*"
  },
  "scripts": {
    "build": "node scripts/build.mjs --profile=production",
    "build:production": "node scripts/build.mjs --profile=production",
    "build:staging": "node scripts/build.mjs --profile=staging",
    "check:determinism": "node scripts/determinism.mjs --profile=production",
    "check:package": "node scripts/package-audit.mjs",
    "check:performance": "node scripts/build.mjs --profile=production && node scripts/performance-budget.mjs",
    "check:source": "node scripts/source-audit.mjs",
    "ci:dry-run": "node scripts/miniprogram-ci.mjs preview --profile=production --dry-run",
    "preview": "node scripts/miniprogram-ci.mjs preview --profile=production",
    "test": "vitest run --dir scripts --fileParallelism=false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "upload:experience": "node scripts/miniprogram-ci.mjs upload-experience --profile=production",
    "visual:compare": "node scripts/visual-compare.mjs",
    "verify": "tsc --noEmit -p tsconfig.json && node scripts/verify.mjs --profile=production"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.21.4",
    "esbuild": "0.28.1",
    "jsdom": "26.1.0",
    "miniprogram-ci": "2.1.31",
    "miniprogram-simulate": "1.6.2",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
