<view class="page-container login-page">
  <view class="card">
    <view class="login-page__logo">科室排班</view>
    <view class="card-copy">使用微信一键登录，未注册用户将进入资料填写页。</view>
    <view class="actions">
      <t-button theme="primary" block loading="{{loggingIn}}" bind:tap="handleLogin">
        微信一键登录
      </t-button>
    </view>
    <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  </view>
  <view class="card">
    <view class="card-copy">加入群组需群主或管理员分享的邀请链接；访客可通过扫码查看排班。</view>
  </view>
</view>
