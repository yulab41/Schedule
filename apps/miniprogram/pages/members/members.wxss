.members-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.member-card {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.member-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.member-name-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.member-name {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-badge {
  padding: 2rpx 10rpx;
  color: var(--color-primary);
  background: #e8f1fb;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.member-role {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.member-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  align-items: center;
}

.member-status {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.member-contact {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.member-contact.is-confirmed {
  color: var(--color-text);
}

.member-call {
  flex: none;
  padding: 10rpx 24rpx;
  color: var(--color-primary);
  background: #e8f1fb;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.members-card {
  padding: 48rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.members-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  color: var(--color-text-muted);
}

.members-error {
  color: var(--color-weekend);
  text-align: center;
}
