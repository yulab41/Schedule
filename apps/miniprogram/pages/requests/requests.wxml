<view class="page-container">
  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />
  <t-tabs value="{{kind}}" bind:change="onKindChange">
    <t-tab-panel label="请假" value="leave" />
    <t-tab-panel label="换班" value="swap" />
    <t-tab-panel label="加扣班" value="duty" />
  </t-tabs>
  <view class="card">
    <view class="row-between">
      <view class="card-title">申请列表</view>
      <t-button size="small" theme="primary" bind:tap="openCreate">新建</t-button>
    </view>
    <view wx:for="{{kind === 'leave' ? leaveRows : kind === 'swap' ? swapRows : dutyRows}}" wx:key="id" class="list-item">
      <view class="flex-1">
        <view class="list-title">{{item.title}} · {{item.statusLabel}}</view>
        <view class="list-sub">{{item.summary}}</view>
      </view>
      <t-button
        wx:if="{{item.actionLabel}}"
        size="small"
        variant="outline"
        data-id="{{item.id}}"
        data-action="{{item.actionName}}"
        bind:tap="handleAction"
      >
        {{item.actionLabel}}
      </t-button>
    </view>
    <view wx:if="{{(kind === 'leave' ? leaveRows : kind === 'swap' ? swapRows : dutyRows).length === 0}}" class="empty-state">暂无申请</view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
</view>
