<view class="page-container">
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  <date-strip
    wx:if="{{dates.length > 0}}"
    dates="{{dates}}"
    selected="{{selectedDate}}"
    bind:change="handleDateChange"
  />
  <view
    wx:for="{{days}}"
    wx:key="businessDate"
    id="day-{{item.businessDate}}"
    class="card"
    hover-class="card--press"
    hover-stay-time="60"
  >
    <view class="row-between">
      <text class="list-day-label {{item.isToday ? 'is-today' : ''}}">{{item.label}}</text>
      <text wx:if="{{item.isToday}}" class="list-day-today">今天</text>
    </view>
    <shift-card
      wx:for="{{item.assignments}}"
      wx:for-item="assignment"
      wx:key="id"
      assignment="{{assignment}}"
      data-day="{{index}}"
      data-index="{{index}}"
      bind:tap="handleAssignmentTap"
    />
    <view wx:if="{{item.assignments.length === 0}}" class="empty-state">无排班</view>
  </view>
  <duty-detail
    show="{{showDetail}}"
    detail="{{dutyDetail}}"
    bind:close="closeDetail"
    bind:call="handleCall"
  />
</view>
