<page-shell title="排班日历">
  <view class="calendar-page">
    <shell-state
      wx:if="{{!hasActiveGroup}}"
      kind="empty"
      title="暂无可用群组"
      description="请先加入或选择一个群组。"
    />
    <shell-state
      wx:elif="{{surface.kind === 'state' && surface.status === 'loading'}}"
      kind="loading"
      title="正在加载排班"
    />
    <view wx:elif="{{surface.kind === 'state'}}" class="calendar-page__body">
      <shell-state
        wx:if="{{surface.status === 'forbidden'}}"
        kind="forbidden"
        title="无权查看该群组排班"
        description="请联系群组管理员确认权限。"
      />
      <shell-state
        wx:elif="{{surface.status === 'error'}}"
        kind="error"
        title="加载排班失败"
        description="{{surface.message}}"
      >
        <button
          class="calendar-page__retry"
          bindtap="handleRetry"
          hover-class="calendar-page__retry--pressed"
        >
          重试
        </button>
      </shell-state>
      <shell-state wx:else kind="conflict" title="排班数据已变化" description="{{surface.message}}">
        <button
          class="calendar-page__retry"
          bindtap="handleRetry"
          hover-class="calendar-page__retry--pressed"
        >
          刷新
        </button>
      </shell-state>
    </view>
    <view wx:else class="calendar-page__body">
      <view wx:if="{{viewMode !== 'week'}}" class="calendar-page__toolbar">
        <button
          class="calendar-page__month-action"
          bindtap="handlePreviousMonth"
          hover-class="calendar-page__month-action--pressed"
        >
          上月
        </button>
        <text class="calendar-page__month-label">{{monthSlots[1].businessMonth}}</text>
        <button
          class="calendar-page__month-action"
          bindtap="handleNextMonth"
          hover-class="calendar-page__month-action--pressed"
        >
          下月
        </button>
      </view>
      <view class="calendar-page__filters">
        <picker
          range="{{monthSlots[1].viewModel.filters.roles}}"
          range-key="label"
          value="{{monthSlots[1].viewModel.filters.selectedRoleIndex}}"
          bindchange="handleRoleFilter"
          ><view class="calendar-page__picker">岗位</view></picker
        >
        <picker
          range="{{monthSlots[1].viewModel.filters.shiftTypes}}"
          range-key="label"
          value="{{monthSlots[1].viewModel.filters.selectedShiftTypeIndex}}"
          bindchange="handleShiftFilter"
          ><view class="calendar-page__picker">班种</view></picker
        >
        <picker
          range="{{monthSlots[1].viewModel.filters.members}}"
          range-key="label"
          value="{{monthSlots[1].viewModel.filters.selectedMembershipIndex}}"
          bindchange="handleMemberFilter"
          ><view class="calendar-page__picker">成员</view></picker
        >
        <label class="calendar-page__switch-label"
          ><text>仅变更</text
          ><switch
            checked="{{monthSlots[1].viewModel.filters.onlyChanges}}"
            bindchange="handleOnlyChanges"
        /></label>
      </view>
      <view class="calendar-page__mode-tabs">
        <button
          class="calendar-page__mode-button {{viewMode === 'month' ? 'calendar-page__mode-button--selected' : ''}}"
          data-mode="month"
          bindtap="handleViewModeTap"
        >
          月
        </button>
        <button
          class="calendar-page__mode-button {{viewMode === 'week' ? 'calendar-page__mode-button--selected' : ''}}"
          data-mode="week"
          bindtap="handleViewModeTap"
        >
          周
        </button>
        <button
          class="calendar-page__mode-button {{viewMode === 'list' ? 'calendar-page__mode-button--selected' : ''}}"
          data-mode="list"
          bindtap="handleViewModeTap"
        >
          列表
        </button>
      </view>
      <text wx:if="{{cacheNotice && cacheNotice.stale}}" class="calendar-page__cache-notice"
        >可能不是最新数据</text
      >
      <view wx:if="{{surface.kind === 'month'}}" class="calendar-page__surface">
        <swiper
          class="calendar-page__swiper"
          circular
          enhanced
          duration="{{240}}"
          current="{{swiperIndex}}"
          bindchange="handleSwiperChange"
        >
          <swiper-item wx:for="{{monthSlots}}" wx:for-item="slot" wx:key="businessMonth">
            <calendar-grid
              wx:if="{{slot.viewModel.status === 'cached' || slot.viewModel.status === 'ready' || slot.viewModel.status === 'refreshing'}}"
              weeks="{{slot.viewModel.weeks}}"
              role="{{activeRole}}"
              bind:route="handleRouteAction"
            />
          </swiper-item>
        </swiper>
      </view>
      <view wx:elif="{{surface.kind === 'week'}}" class="calendar-page__surface">
        <view class="calendar-page__week-toolbar">
          <button class="calendar-page__month-action" bindtap="handlePreviousWeek">上一周</button>
          <text class="calendar-page__month-label">{{surface.weekLabel}}</text>
          <button class="calendar-page__month-action" bindtap="handleNextWeek">下一周</button>
        </view>
        <calendar-week
          week="{{surface.week}}"
          role="{{activeRole}}"
          bind:route="handleRouteAction"
        />
      </view>
      <calendar-list
        wx:elif="{{surface.kind === 'list'}}"
        days="{{surface.days}}"
        role="{{activeRole}}"
        bind:route="handleRouteAction"
      />
    </view>
    <bottom-sheet
      title="{{sheetTitle}}"
      visible="{{sheetHost.visible}}"
      sheet-key="{{sheetHost.sheetKey}}"
      bind:request-close="handleSheetRequestClose"
      bind:closed="handleSheetClosed"
    >
      <date-detail-sheet
        wx:if="{{sheetKind === 'date'}}"
        day="{{sheetHost.content.day}}"
        month-label="{{monthSlots[1].businessMonth}}"
        bind:route="handleRouteAction"
      />
      <duty-detail-sheet
        wx:elif="{{sheetKind === 'duty'}}"
        assignment="{{sheetHost.content.assignment}}"
        role="{{activeRole}}"
        bind:route="handleRouteAction"
      />
      <event-timeline-sheet
        wx:elif="{{sheetKind === 'events'}}"
        assignment="{{sheetHost.content.assignment}}"
        status="{{eventTimeline.status}}"
        items="{{eventTimeline.items}}"
        error-message="{{eventTimeline.errorMessage}}"
        has-more="{{eventTimeline.hasMore}}"
        change-chain-summary="{{eventTimeline.changeChainSummary}}"
      />
      <phone-sheet
        wx:elif="{{sheetKind === 'phone'}}"
        member-name="{{sheetHost.content.assignment.memberName}}"
        phone-actions="{{sheetHost.content.phoneActions}}"
        bind:dial="handleDial"
        bind:copy="handleCopy"
      />
    </bottom-sheet>
  </view>
</page-shell>
