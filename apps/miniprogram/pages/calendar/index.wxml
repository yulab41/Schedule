<page-shell title="排班日历">
  <view class="calendar-page">
    <shell-state
      wx:if="{{!hasActiveGroup}}"
      kind="empty"
      title="暂无可用群组"
      description="请先加入或选择一个群组。"
    />
    <view wx:else class="calendar-page__body">
      <view class="calendar-page__navigation calendar-page__toolbar">
        <button
          class="calendar-page__month-action"
          aria-label="上一月"
          bindtap="handlePreviousMonth"
          hover-class="calendar-page__month-action--pressed"
        >
          ‹
        </button>
        <picker
          mode="date"
          fields="month"
          value="{{monthSlots[1].businessMonth}}"
          bindchange="handleMonthChange"
        >
          <view class="calendar-page__month-picker">
            <text class="calendar-page__month-label">{{monthSlots[1].viewModel.monthLabel}}</text>
            <text class="calendar-page__month-caret">⌄</text>
          </view>
        </picker>
        <button
          class="calendar-page__today-action"
          bindtap="handleToday"
          hover-class="calendar-page__month-action--pressed"
        >
          今天
        </button>
        <button
          class="calendar-page__month-action"
          aria-label="下一月"
          bindtap="handleNextMonth"
          hover-class="calendar-page__month-action--pressed"
        >
          ›
        </button>
      </view>

      <view wx:if="{{viewMode === 'week'}}" class="calendar-page__week-toolbar">
        <button class="calendar-page__week-action" bindtap="handlePreviousWeek">上一周</button>
        <text class="calendar-page__week-label">{{weekLabel}}</text>
        <button class="calendar-page__week-action" bindtap="handleThisWeek">本周</button>
        <button class="calendar-page__week-action" bindtap="handleNextWeek">下一周</button>
      </view>

      <view class="calendar-page__mode-tabs">
        <button
          class="calendar-page__mode-button {{viewMode === 'month' ? 'calendar-page__mode-button--selected' : ''}}"
          data-mode="month"
          bindtap="handleViewModeTap"
        >
          月
        </button>
        <button
          class="calendar-page__mode-button {{viewMode === 'week' ? 'calendar-page__mode-button--selected' : ''}}"
          data-mode="week"
          bindtap="handleViewModeTap"
        >
          周
        </button>
        <button
          class="calendar-page__mode-button {{viewMode === 'list' ? 'calendar-page__mode-button--selected' : ''}}"
          data-mode="list"
          bindtap="handleViewModeTap"
        >
          列表
        </button>
      </view>

      <view wx:if="{{hasCalendarData}}" class="calendar-page__filters">
        <button
          class="calendar-page__filter-button"
          data-filter-kind="role"
          bindtap="handleOpenFilter"
        >
          {{roleFilterSummary}}
        </button>
        <button
          class="calendar-page__filter-button"
          data-filter-kind="shift"
          bindtap="handleOpenFilter"
        >
          {{shiftFilterSummary}}
        </button>
        <button
          class="calendar-page__filter-button"
          data-filter-kind="member"
          bindtap="handleOpenFilter"
        >
          {{memberFilterSummary}}
        </button>
        <label class="calendar-page__switch-label"
          ><text>仅变更</text
          ><switch
            checked="{{monthSlots[1].viewModel.filters.onlyChanges}}"
            bindchange="handleOnlyChanges"
        /></label>
      </view>

      <view wx:if="{{cacheNotice}}" class="calendar-page__cache-notice">
        <text wx:if="{{cacheNotice.stale}}"
          >缓存于 {{cacheNotice.savedAtText}}，可能不是最新数据</text
        >
        <text wx:else>缓存于 {{cacheNotice.savedAtText}}，正在同步最新排班</text>
      </view>

      <view wx:if="{{surface.kind === 'state'}}" class="calendar-page__state">
        <shell-state
          wx:if="{{surface.status === 'loading'}}"
          kind="loading"
          title="正在加载排班"
          description="{{surface.message}}"
        />
        <shell-state
          wx:elif="{{surface.status === 'forbidden'}}"
          kind="forbidden"
          title="无权查看该群组排班"
          description="请联系群组管理员确认权限。"
        />
        <shell-state
          wx:elif="{{surface.status === 'error'}}"
          kind="error"
          title="加载排班失败"
          description="{{surface.message}}"
        >
          <button
            class="calendar-page__retry"
            bindtap="handleRetry"
            hover-class="calendar-page__retry--pressed"
          >
            重试
          </button>
        </shell-state>
        <shell-state
          wx:else
          kind="conflict"
          title="排班数据已变化"
          description="{{surface.message}}"
        >
          <button
            class="calendar-page__retry"
            bindtap="handleRetry"
            hover-class="calendar-page__retry--pressed"
          >
            刷新
          </button>
        </shell-state>
      </view>

      <view wx:elif="{{surface.kind === 'month'}}" class="calendar-page__surface">
        <view wx:if="{{surface.isEmpty}}" class="calendar-page__empty">
          {{surface.emptyMessage}}
        </view>
        <swiper
          class="calendar-page__swiper"
          circular
          enhanced
          duration="{{240}}"
          current="{{swiperIndex}}"
          bindchange="handleSwiperChange"
        >
          <swiper-item wx:for="{{monthSlots}}" wx:for-item="slot" wx:key="businessMonth">
            <calendar-grid
              wx:if="{{slot.viewModel.status === 'cached' || slot.viewModel.status === 'ready' || slot.viewModel.status === 'refreshing'}}"
              weeks="{{slot.viewModel.weeks}}"
              role="{{activeRole}}"
              bind:route="handleRouteAction"
            />
          </swiper-item>
        </swiper>
      </view>
      <view wx:elif="{{surface.kind === 'week'}}" class="calendar-page__surface">
        <view wx:if="{{surface.isEmpty}}" class="calendar-page__empty">
          {{surface.emptyMessage}}
        </view>
        <calendar-week
          week="{{surface.week}}"
          role="{{activeRole}}"
          bind:route="handleRouteAction"
        />
      </view>
      <view wx:else class="calendar-page__surface">
        <view wx:if="{{surface.isEmpty}}" class="calendar-page__empty">
          {{surface.emptyMessage}}
        </view>
        <calendar-list
          wx:else
          days="{{surface.days}}"
          role="{{activeRole}}"
          bind:route="handleRouteAction"
        />
      </view>
    </view>
  </view>
</page-shell>

<calendar-filter-sheet
  filter-key="{{filterSheetKind}}"
  options="{{filterSheetOptions}}"
  options-ready="{{true}}"
  selected-ids="{{filterSheetSelectedIds}}"
  search-placeholder="搜索姓名或名称"
  sheet-key="{{filterSheetKey}}"
  title="{{filterSheetTitle}}"
  visible="{{filterSheetVisible}}"
  bind:apply="handleFilterApply"
  bind:request-close="handleFilterRequestClose"
  bind:closed="handleFilterClosed"
/>

<bottom-sheet
  title="{{sheetTitle}}"
  visible="{{sheetHost.visible}}"
  sheet-key="{{sheetHost.sheetKey}}"
  bind:request-close="handleSheetRequestClose"
  bind:closed="handleSheetClosed"
>
  <date-detail-sheet
    wx:if="{{sheetKind === 'date'}}"
    day="{{sheetHost.content.day}}"
    bind:route="handleRouteAction"
  />
  <duty-detail-sheet
    wx:elif="{{sheetKind === 'duty'}}"
    assignment="{{sheetHost.content.assignment}}"
    role="{{activeRole}}"
    bind:route="handleRouteAction"
  />
  <event-timeline-sheet
    wx:elif="{{sheetKind === 'events'}}"
    assignment="{{sheetHost.content.assignment}}"
    status="{{eventTimeline.status}}"
    items="{{eventTimeline.items}}"
    error-message="{{eventTimeline.errorMessage}}"
    has-more="{{eventTimeline.hasMore}}"
    change-chain-summary="{{eventTimeline.changeChainSummary}}"
  />
  <phone-sheet
    wx:elif="{{sheetKind === 'phone'}}"
    member-name="{{sheetHost.content.assignment.memberName}}"
    phone-actions="{{sheetHost.content.phoneActions}}"
    bind:dial="handleDial"
    bind:copy="handleCopy"
  />
</bottom-sheet>
