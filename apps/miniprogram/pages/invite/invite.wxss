.invite-card {
  padding: var(--v3-space-lg);
  background: var(--v3-color-surface);
  border-radius: var(--v3-radius-lg);
}
.invite-field {
  display: block;
  margin-bottom: var(--v3-space-sm);
}
.invite-error,
.invite-recovery {
  display: flex;
  flex-direction: column;
  gap: var(--v3-space-md);
}
.invite-status-title {
  color: var(--v3-color-text);
  font-size: 36rpx;
  font-weight: 700;
}
.invite-status-copy {
  color: var(--v3-color-text-muted);
  line-height: 1.6;
}
.invite-action {
  min-height: 88rpx;
  margin-top: var(--v3-space-lg);
  color: #fff;
  background: var(--v3-color-primary);
}
.invite-secondary {
  min-height: 88rpx;
  margin-top: var(--v3-space-sm);
  color: var(--v3-color-text-muted);
  background: var(--v3-color-surface);
  border: 2rpx solid var(--v3-color-border);
}
