<view class="page-container">
  <view wx:if="{{invite}}" class="card">
    <view class="card-title">{{invite.groupName}}</view>
    <view class="card-copy">
      邀请人：{{invite.inviteeRealName}} · 权限：{{invite.permissionRole === 'administrator' ? '管理员' : '成员'}}
      <block wx:if="{{invite.scheduleRoleName}}"> · 岗位：{{invite.scheduleRoleName}}</block>
    </view>
    <view class="invite-name">
      <t-input
        value="{{confirmRealName}}"
        placeholder="请输入你的真实姓名"
        bind:change="onNameInput"
      />
    </view>
    <view class="actions">
      <t-button theme="primary" block loading="{{submitting}}" bind:tap="handleAccept">
        确认姓名并加入
      </t-button>
    </view>
    <view wx:if="{{infoMessage}}" class="info-text">{{infoMessage}}</view>
    <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  </view>
  <view wx:elif="{{errorMessage}}" class="card empty-state">{{errorMessage}}</view>
</view>
