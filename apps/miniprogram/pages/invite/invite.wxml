<view class="page-container invite-page">
  <view class="invite-card">
    <text class="invite-title" wx:if="{{invite}}">邀请加入群组</text>

    <view wx:if="{{loading}}" class="invite-state">
      <text>加载中…</text>
    </view>

    <view wx:elif="{{errorMessage}}" class="invite-state">
      <text class="invite-error">{{errorMessage}}</text>
    </view>

    <block wx:elif="{{invite}}">
      <text class="invite-group-name">{{invite.groupName}}</text>
      <text class="invite-row">姓名：{{invite.inviteeRealName}}</text>
      <text class="invite-row">
        角色：{{invite.permissionRole === 'administrator' ? '管理员' : '成员'}}
      </text>
      <text class="invite-row" wx:if="{{invite.scheduleRoleName}}">
        排班岗位：{{invite.scheduleRoleName}}
      </text>
      <t-input
        value="{{confirmRealName}}"
        placeholder="请输入你的真实姓名以确认"
        maxlength="100"
        bind:change="handleConfirmNameInput"
      />
      <t-button
        theme="primary"
        block
        loading="{{submitting}}"
        disabled="{{submitting || !canAccept}}"
        bind:tap="handleAccept"
      >
        确认接受邀请
      </t-button>
      <text class="invite-warning">邀请链接仅限本人使用，先到先得；请勿转发给他人。</text>
    </block>
  </view>
</view>
