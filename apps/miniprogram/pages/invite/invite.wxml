<page-shell title="加入群组">
  <shell-state wx:if="{{loading}}" kind="loading" title="正在加载邀请" />
  <view wx:elif="{{acceptCommitted}}" class="invite-card invite-recovery">
    <text class="invite-status-title">已加入群组</text>
    <text class="invite-status-copy">服务端已接受邀请，但资料刷新失败。{{errorMessage}}</text>
    <button
      class="invite-action"
      bindtap="handleRetryContext"
      loading="{{refreshing}}"
      disabled="{{refreshing}}"
    >
      重新刷新资料
    </button>
    <button class="invite-secondary" bindtap="handleLeaveAfterCommit" disabled="{{refreshing}}">
      退出登录
    </button>
  </view>
  <view wx:elif="{{errorMessage}}" class="invite-error">
    <shell-state kind="error" title="邀请不可用" description="{{errorMessage}}" />
    <button class="invite-secondary" bindtap="handleAbandon">暂不加入</button>
  </view>
  <view wx:else class="invite-card">
    <text class="invite-field">群组：{{invite.groupName}}</text>
    <text class="invite-field">成员：{{invite.inviteeRealName}}</text>
    <text class="invite-field">权限：{{invite.permissionRole}}</text>
    <text wx:if="{{invite.scheduleRoleName}}" class="invite-field"
      >排班角色：{{invite.scheduleRoleName}}</text
    >
    <button
      class="invite-action"
      bindtap="handleAccept"
      loading="{{accepting}}"
      disabled="{{accepting}}"
    >
      确认加入
    </button>
    <button class="invite-secondary" bindtap="handleAbandon" disabled="{{accepting}}">
      暂不加入
    </button>
  </view>
</page-shell>
