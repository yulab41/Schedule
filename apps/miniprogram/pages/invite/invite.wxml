<page-shell title="加入群组"><shell-state wx:if="{{loading}}" kind="loading" title="正在加载邀请"/><shell-state wx:elif="{{errorMessage}}" kind="error" title="邀请不可用" description="{{errorMessage}}"/><view wx:else class="invite-card"><text class="invite-field">群组：{{invite.groupName}}</text><text class="invite-field">成员：{{invite.inviteeRealName}}</text><text class="invite-field">权限：{{invite.permissionRole}}</text><text wx:if="{{invite.scheduleRoleName}}" class="invite-field">排班角色：{{invite.scheduleRoleName}}</text><button class="invite-action" bindtap="handleAccept" loading="{{accepting}}" disabled="{{accepting}}">确认加入</button></view></page-shell>
