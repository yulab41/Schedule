<page-shell title="我的">
  <view class="profile-header"><text>{{profile.realName}}</text><text wx:if="{{isMemberProfile}}" class="profile-version">资料版本 {{profile.version}}</text></view>
  <text wx:if="{{errorMessage}}" class="profile-error">{{errorMessage}}</text>

  <view wx:if="{{isMemberProfile}}">
  <view class="profile-group">
    <text class="profile-section-title">个人资料</text>
    <input class="profile-input" value="{{draftRealName}}" placeholder="真实姓名" bindinput="handleProfileInput" />
    <button class="profile-save" bindtap="handleSaveProfile" loading="{{isSavingProfile}}">保存资料</button>
  </view>

  <view class="profile-group">
    <text class="profile-section-title">小程序运行信息</text>
    <text class="profile-runtime">运行版本：{{runtimeVersion}}</text>
    <text class="profile-runtime">运行环境：{{runtimeEnvVersion}}</text>
  </view>

  <view wx:for="{{contacts}}" wx:key="groupId" class="profile-group">
    <text class="profile-section-title">{{item.groupName}} · {{item.role}}</text>
    <text wx:if="{{item.state === 'not-applicable'}}">游客无需联系方式</text>
    <text wx:elif="{{item.state === 'unavailable'}}">暂时无法确认成员身份</text>
    <view wx:else>
      <text class="profile-contact-status">{{item.isConfirmed ? '联系方式已确认' : '联系方式待确认'}}</text>
      <input class="profile-input" data-index="{{index}}" data-field="mobilePhone" value="{{item.mobilePhone}}" placeholder="长号" bindinput="handleContactInput" />
      <input class="profile-input" data-index="{{index}}" data-field="shortPhone" value="{{item.shortPhone}}" placeholder="短号" bindinput="handleContactInput" />
      <button wx:if="{{item.canEdit}}" class="profile-save" data-index="{{index}}" bindtap="handleSaveContact" loading="{{isSavingContactIndex === index}}" disabled="{{isSavingContactIndex !== undefined && isSavingContactIndex !== index}}">保存并确认本人联系方式</button>
    </view>
  </view>
  </view>

  <view wx:else class="profile-group">
    <text class="profile-section-title">访客身份</text>
    <text>{{activeGroupName}}</text>
    <text class="profile-runtime">当前角色：{{activeGroupRole}}</text>
    <text class="profile-runtime">访客仅可查看日历和群组摘要。</text>
  </view>

  <button class="profile-logout" bindtap="handleLogout" disabled="{{isLoggingOut}}">退出登录</button>
</page-shell>
