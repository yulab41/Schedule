.guest-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.guest-header {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.guest-title {
  font-size: 40rpx;
  font-weight: 600;
}

.guest-subtitle {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.guest-card {
  padding: 48rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.guest-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  color: var(--color-text-muted);
}

.guest-error {
  color: var(--color-weekend);
  text-align: center;
}

.guest-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guest-month-label {
  font-size: 30rpx;
  font-weight: 600;
}

.duty-modal-mask {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.duty-modal {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  width: 560rpx;
  padding: 40rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
}

.duty-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.duty-modal-row {
  color: var(--color-text);
  font-size: 28rpx;
}
