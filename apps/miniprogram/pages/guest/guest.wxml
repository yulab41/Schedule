<page-shell title="群组访客日历">
  <view class="guest-calendar">
    <shell-state wx:if="{{status === 'loading'}}" kind="loading" title="正在加载公开排班" />
    <shell-state wx:elif="{{status === 'error'}}" kind="error" title="暂时无法查看" description="{{errorMessage}}" />
    <view wx:else class="guest-calendar__body">
      <text class="guest-calendar__group">{{groupName}}</text>
      <view class="guest-calendar__toolbar">
        <button class="guest-calendar__month-action" bindtap="handlePreviousMonth">上月</button>
        <text class="guest-calendar__month">{{businessMonth}}</text>
        <button class="guest-calendar__month-action" bindtap="handleNextMonth">下月</button>
      </view>
      <calendar-grid weeks="{{viewModel.weeks}}" />
    </view>
  </view>
</page-shell>
