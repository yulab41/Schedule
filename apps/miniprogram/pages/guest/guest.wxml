<view class="page-container">
  <view class="card">
    <view class="card-title">{{groupName || '访客排班'}}</view>
    <view class="card-copy">扫码匿名查看，不展示电话与事件。</view>
  </view>
  <view class="card">
    <view class="row-between">
      <t-button size="small" variant="text" data-delta="-1" bind:tap="changeMonth">‹ 上月</t-button>
      <text class="guest-month">{{monthLabel}}</text>
      <t-button size="small" variant="text" data-delta="1" bind:tap="changeMonth">下月 ›</t-button>
    </view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  <view wx:if="{{weeks.length > 0}}" class="card">
    <calendar-grid weeks="{{weeks}}" bind:celltap="handleCellTap" />
  </view>
  <duty-detail
    show="{{showDetail}}"
    detail="{{dutyDetail}}"
    bind:close="closeDetail"
    bind:call="handleCall"
  />
</view>
