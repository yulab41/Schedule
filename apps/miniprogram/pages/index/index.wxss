.index-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.index-card {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding: 48rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.index-state {
  align-items: center;
  text-align: center;
}

.index-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
}

.index-copy {
  color: var(--color-text-muted);
  line-height: 1.6;
  text-align: center;
}

.index-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-sm);
}

.index-hint {
  color: var(--color-text-muted);
  font-size: 24rpx;
  text-align: center;
}

.index-error {
  color: var(--color-weekend);
}
