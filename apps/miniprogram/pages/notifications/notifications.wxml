<view class="page-container">
  <view class="card">
    <view class="row-between">
      <view class="card-title">通知列表</view>
      <view class="row">
        <t-button size="small" variant="outline" bind:tap="openSettings">提醒设置</t-button>
        <t-button wx:if="{{unreadCount > 0}}" size="small" variant="outline" bind:tap="handleReadAll">全部已读</t-button>
      </view>
    </view>
    <view wx:for="{{rows}}" wx:key="id" class="list-item {{item.isRead ? 'notify-read' : ''}}" data-id="{{item.id}}" bind:tap="handleRead">
      <view class="flex-1">
        <view class="list-title">
          {{item.title}}
          <text wx:if="{{!item.isRead}}" class="notify-dot"></text>
        </view>
        <view class="list-sub">{{item.label}} · {{item.createdAt}}</view>
        <view class="notify-body">{{item.body}}</view>
      </view>
    </view>
    <view wx:if="{{rows.length === 0}}" class="empty-state">暂无通知</view>
    <view class="actions" wx:if="{{nextCursor}}">
      <t-button block variant="outline" loading="{{loading}}" bind:tap="handleLoadMore">加载更多</t-button>
    </view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
</view>
