<view class="page-container">
  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />
  <view class="card">
    <view class="card-title">我的提醒</view>
    <view class="settings-row">
      <text>微信订阅值班提醒</text>
      <t-switch value="{{wechatNotificationsEnabled}}" bind:change="onWechatToggle" />
    </view>
    <view class="settings-hint">提醒时间：提前 1 到 5 个整数小时，用逗号分隔。</view>
    <t-input value="{{hoursInput}}" placeholder="如 24, 2" bind:change="onHoursInput" />
    <view class="actions">
      <t-button theme="primary" block loading="{{submitting}}" bind:tap="handleSaveMine">保存我的提醒</t-button>
    </view>
  </view>
  <view class="card">
    <view class="card-title">群组默认提醒</view>
    <t-input value="{{groupDefaultHours}}" placeholder="如 24, 2" bind:change="onGroupHoursInput" />
    <view class="actions">
      <t-button block variant="outline" loading="{{submitting}}" bind:tap="handleSaveGroup">保存群组默认</t-button>
    </view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  <view wx:if="{{infoMessage}}" class="info-text">{{infoMessage}}</view>
</view>
