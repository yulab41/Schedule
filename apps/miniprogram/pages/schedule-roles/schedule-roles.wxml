<view class="page-container roles-page">
  <view wx:if="{{loading}}" class="roles-card roles-state">
    <text>加载中…</text>
  </view>

  <block wx:elif="{{groupId}}">
    <view class="roles-card">
      <text class="roles-title">新增排班岗位</text>
      <text class="roles-copy">岗位指值班班次岗位（如一线、二线），不是成员姓名。</text>
      <input
        class="roles-input"
        value="{{newRoleName}}"
        maxlength="100"
        placeholder="岗位名称"
        bind:input="handleNewRoleInput"
      />
      <t-button
        theme="primary"
        block
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:tap="handleCreateRole"
      >
        新增岗位
      </t-button>
    </view>

    <view class="roles-card" wx:for="{{roleRows}}" wx:key="id" wx:for-index="roleIndex">
      <view class="roles-header">
        <text class="roles-title">岗位：{{item.name}}</text>
        <view
          class="roles-delete"
          data-index="{{roleIndex}}"
          bind:tap="handleDeleteRole"
        >
          删除
        </view>
      </view>

      <text class="roles-section-label">参与成员</text>
      <checkbox-group
        class="roles-checkbox-group"
        data-index="{{roleIndex}}"
        bindchange="handleRoleMembersChange"
      >
        <label
          class="roles-checkbox"
          wx:for="{{groupMembers}}"
          wx:key="membershipId"
          wx:for-index="memberIndex"
        >
          <checkbox
            value="{{item.membershipId}}"
            checked="{{roleRows[roleIndex].memberChecked[memberIndex]}}"
          />
          <text>{{item.realName}}</text>
        </label>
      </checkbox-group>

      <text class="roles-section-label">轮值顺序（可上下调整）</text>
      <view class="rotation-row" wx:for="{{rotationMembers[roleIndex]}}" wx:key="scheduleRoleMemberId">
        <text class="rotation-position">{{index + 1}}. {{item.realName}}</text>
        <view class="rotation-actions">
          <view
            class="rotation-button"
            data-role-index="{{roleIndex}}"
            data-member-index="{{index}}"
            data-delta="-1"
            bind:tap="handleMoveMember"
          >
            ↑
          </view>
          <view
            class="rotation-button"
            data-role-index="{{roleIndex}}"
            data-member-index="{{index}}"
            data-delta="1"
            bind:tap="handleMoveMember"
          >
            ↓
          </view>
        </view>
      </view>

      <text class="roles-section-label">轮值规则</text>
      <view class="roles-field">
        <text class="roles-label">当前轮值位置</text>
        <input
          class="roles-input"
          type="number"
          value="{{currentPositionInputs[roleIndex]}}"
          data-index="{{roleIndex}}"
          bind:input="handleCurrentPositionInput"
        />
      </view>
      <view class="roles-field">
        <text class="roles-label">每日需要人数</text>
        <input
          class="roles-input"
          type="number"
          value="{{item.requiredMembersPerDay}}"
          data-index="{{roleIndex}}"
          bind:input="handleRequiredCountInput"
        />
      </view>
      <view class="roles-field">
        <text class="roles-label">默认班种</text>
        <picker
          mode="selector"
          range="{{shiftTypeNames}}"
          value="{{item.defaultShiftTypeIndex}}"
          disabled="{{shiftTypeNames.length === 0}}"
          data-index="{{roleIndex}}"
          bindchange="handleDefaultShiftChange"
        >
          <view class="roles-picker">
            {{shiftTypeNames[item.defaultShiftTypeIndex] || '请选择班种'}}
            <text class="roles-picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="roles-field">
        <text class="roles-label">起始日期（可选）</text>
        <picker
          mode="date"
          value="{{item.startDate || '2026-01-01'}}"
          data-index="{{roleIndex}}"
          bindchange="handleStartDateChange"
        >
          <view class="roles-picker">
            {{item.startDate || '不指定'}}
            <text class="roles-picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="roles-field">
        <text class="roles-label">起始成员（可选）</text>
        <picker
          mode="selector"
          range="{{rotationNames[roleIndex]}}"
          value="{{startingMemberIndexes[roleIndex]}}"
          disabled="{{rotationMembers[roleIndex].length === 0}}"
          data-index="{{roleIndex}}"
          bindchange="handleStartingMemberChange"
        >
          <view class="roles-picker">
            {{rotationNames[roleIndex][startingMemberIndexes[roleIndex]] || '不指定'}}
            <text class="roles-picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <t-button
        theme="default"
        block
        variant="outline"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        data-index="{{roleIndex}}"
        bind:tap="handleSaveRotationRule"
      >
        保存轮值规则
      </t-button>
    </view>

    <text wx:if="{{errorMessage}}" class="roles-error">{{errorMessage}}</text>
  </block>

  <view wx:else class="roles-card roles-state">
    <text>请先选择一个群组。</text>
  </view>
</view>
