.roles-page {
  display: grid;
  gap: 24rpx;
}

.roles-card {
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.roles-state {
  text-align: center;
  color: var(--color-text-muted);
}

.roles-title {
  display: block;
  margin: 0 0 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.roles-copy {
  display: block;
  margin: 0 0 16rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.roles-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.roles-header .roles-title {
  margin: 0;
}

.roles-delete {
  color: #e03131;
  font-size: 26rpx;
}

.roles-section-label {
  display: block;
  margin: 20rpx 0 12rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  font-weight: 500;
}

.roles-checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}

.roles-checkbox {
  display: inline-flex;
  gap: 8rpx;
  align-items: center;
  font-size: 28rpx;
}

.roles-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe3ea;
  border-radius: var(--radius-md);
}

.roles-field {
  margin: 0 0 16rpx;
}

.roles-label {
  display: block;
  margin: 0 0 8rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
}

.roles-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe3ea;
  border-radius: var(--radius-md);
}

.roles-picker-arrow {
  color: var(--color-text-muted);
}

.rotation-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef1f4;
}

.rotation-position {
  font-size: 28rpx;
}

.rotation-actions {
  display: flex;
  gap: 12rpx;
}

.rotation-button {
  padding: 4rpx 20rpx;
  border: 1rpx solid #c9d4e0;
  border-radius: 10rpx;
  color: #1f5aa6;
  font-size: 26rpx;
}

.roles-error {
  display: block;
  color: #e03131;
  font-size: 26rpx;
}
