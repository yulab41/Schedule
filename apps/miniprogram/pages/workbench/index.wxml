<page-shell title="工作台"><view wx:for="{{sections}}" wx:for-item="section" wx:key="id" class="workbench-section"><text class="workbench-section__title">{{section.label}}</text><view wx:if="{{section.id === 'platform'}}" class="workbench-entry workbench-entry--disabled">当前版本尚未开放</view><view wx:for="{{section.entries}}" wx:for-item="entry" wx:key="id" class="workbench-entry" data-entry="{{entry.id}}" data-group-id="{{section.groupId}}" data-route="{{entry.tabRoute}}" bindtap="handleEntry">{{entry.label}}</view></view></page-shell>
