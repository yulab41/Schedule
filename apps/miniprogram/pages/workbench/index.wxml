<page-shell title="工作台"><view wx:for="{{sections}}" wx:key="id" class="workbench-section"><text class="workbench-section__title">{{item.label}}</text><view wx:if="{{item.id === 'platform'}}" class="workbench-entry workbench-entry--disabled">当前版本尚未开放</view><view wx:for="{{item.entries}}" wx:key="id" class="workbench-entry" data-group-id="{{item.groupId}}" data-route="{{item.tabRoute}}" bindtap="handleEntry">{{item.label}}</view></view></page-shell>
