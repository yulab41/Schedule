.workbench-section {
  margin-bottom: var(--v3-space-md);
  padding: var(--v3-space-md);
  background: var(--v3-color-surface);
  border: 2rpx solid transparent;
  border-radius: var(--v3-radius-lg);
}

.workbench-section--active {
  background: var(--v3-color-primary-light);
  border-color: var(--v3-color-primary-border);
}

.workbench-section__header {
  display: flex;
  min-height: var(--v3-touch-min);
  align-items: center;
  justify-content: space-between;
}

.workbench-section__title {
  display: block;
  font-weight: 700;
}

.workbench-section__role,
.workbench-global-action__description,
.workbench-zero__description {
  display: block;
  margin-top: var(--v3-space-xxs);
  color: var(--v3-color-text-muted);
  font-size: var(--v3-font-size-sm);
}

.workbench-section__current {
  padding: var(--v3-space-xxs) var(--v3-space-xs);
  color: var(--v3-color-primary);
  background: var(--v3-color-surface);
  border: 1rpx solid var(--v3-color-primary-border);
  border-radius: var(--v3-radius-md);
  font-size: var(--v3-font-size-xs);
}

.workbench-entry {
  min-height: 88rpx;
  padding-top: var(--v3-space-sm);
}

.workbench-entry--disabled {
  color: var(--v3-color-text-muted);
}

.workbench-zero {
  margin-bottom: var(--v3-space-md);
  padding: var(--v3-space-md);
  background: var(--v3-color-surface);
  border-radius: var(--v3-radius-lg);
}

.workbench-zero__title,
.workbench-global-action__label {
  display: block;
  color: var(--v3-color-text);
  font-weight: 700;
}

.workbench-global-action {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--v3-touch-min);
  margin-top: var(--v3-space-sm);
  padding: var(--v3-space-sm) var(--v3-space-md);
  text-align: left;
  background: var(--v3-color-primary-light);
  border: 1rpx solid var(--v3-color-primary-border);
  border-radius: var(--v3-radius-md);
}
