.workbench__welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.workbench__hello {
  font-size: 36rpx;
  font-weight: 600;
}

.workbench__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.workbench__module {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 8rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.workbench__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.workbench__label {
  font-size: 26rpx;
}
