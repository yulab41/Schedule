<view class="page-container">
  <view wx:if="{{profile}}" class="card workbench__welcome">
    <view>
      <view class="workbench__hello">{{profile.realName}}，你好</view>
      <view class="muted">科室排班工作台</view>
    </view>
    <t-tag wx:if="{{isPlatformAdmin}}" theme="primary" variant="light">平台管理员</t-tag>
  </view>

  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>

  <view class="workbench__grid">
    <view
      wx:for="{{modules}}"
      wx:key="id"
      class="workbench__module"
      data-url="{{item.url}}"
      bind:tap="openModule"
    >
      <view class="workbench__icon">{{item.icon}}</view>
      <view class="workbench__label">{{item.label}}</view>
    </view>
  </view>
</view>
