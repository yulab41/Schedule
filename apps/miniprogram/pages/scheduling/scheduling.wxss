.scheduling-page {
  display: grid;
  gap: 24rpx;
}

.schedule-card {
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.schedule-state {
  text-align: center;
  color: var(--color-text-muted);
}

.schedule-title {
  display: block;
  margin: 0 0 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.schedule-copy {
  display: block;
  margin: 0 0 16rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.schedule-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 20rpx;
}

.schedule-month {
  font-size: 32rpx;
  font-weight: 600;
}

.schedule-section-label {
  display: block;
  margin: 0 0 12rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  font-weight: 500;
}

.schedule-role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef1f4;
}

.schedule-role-name {
  font-size: 28rpx;
}

.schedule-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe3ea;
  border-radius: var(--radius-md);
}

.schedule-picker-arrow {
  color: var(--color-text-muted);
}

.schedule-preview {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef1f4;
}

.schedule-preview-row {
  display: block;
  margin: 0 0 8rpx;
  font-size: 28rpx;
}

.schedule-preview-row.is-warning {
  color: #e03131;
}

.schedule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f4;
}

.schedule-row:last-child {
  border-bottom: 0;
}

.schedule-row-main {
  min-width: 0;
}

.schedule-row-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.schedule-row-meta {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.schedule-row-actions {
  display: flex;
  gap: 8rpx;
}

.schedule-action {
  padding: 10rpx 20rpx;
  border: 1rpx solid #c9d4e0;
  border-radius: 10rpx;
  color: #1f5aa6;
  font-size: 24rpx;
}

.schedule-action.is-primary {
  color: #ffffff;
  background: #1f5aa6;
  border-color: #1f5aa6;
}

.schedule-action.is-danger {
  color: #e03131;
  border-color: #f0c4c4;
}

.schedule-action.is-warning {
  color: #92400e;
  border-color: #f3d9a4;
}

.schedule-error {
  display: block;
  color: #e03131;
  font-size: 26rpx;
}

.schedule-success {
  display: block;
  color: #1f7a3d;
  font-size: 26rpx;
}
