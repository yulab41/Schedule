<view class="page-container templates-page">
  <view wx:if="{{loading}}" class="template-card template-state">
    <text>加载中…</text>
  </view>

  <block wx:elif="{{groupId}}">
    <view class="template-card" wx:if="{{templates.length > 0}}">
      <text class="template-title">手动排班模板</text>
      <view class="template-row" wx:for="{{templates}}" wx:key="id">
        <text class="template-row-title">{{item.title}}</text>
        <view class="template-actions">
          <view class="template-action" data-id="{{item.id}}" bind:tap="handleStartEdit">
            编辑
          </view>
          <view class="template-action is-primary" data-id="{{item.id}}" bind:tap="handleSelectApply">
            应用
          </view>
          <view class="template-action is-danger" data-id="{{item.id}}" bind:tap="handleDeleteTemplate">
            删除
          </view>
        </view>
      </view>
    </view>

    <view class="template-card">
      <text class="template-title">{{editingId ? '编辑模板' : '新建手动排班模板'}}</text>
      <view class="template-field">
        <text class="template-label">排班岗位</text>
        <picker
          mode="selector"
          range="{{roleNames}}"
          value="{{roleIndex}}"
          disabled="{{roleNames.length === 0}}"
          bindchange="handleRoleChange"
        >
          <view class="template-picker">
            {{roleNames[roleIndex] || '请选择岗位'}}
            <text class="template-picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="template-field">
        <text class="template-label">循环天数（1-31）</text>
        <input
          class="template-input"
          type="number"
          value="{{cycleDays}}"
          bind:input="handleCycleDaysInput"
          bind:blur="applyCycleDays"
        />
      </view>
      <view class="template-field">
        <text class="template-label">起始日期</text>
        <picker
          mode="date"
          value="{{startDate || '2026-01-01'}}"
          bindchange="handleStartDateChange"
        >
          <view class="template-picker">
            {{startDate || '请选择日期'}}
            <text class="template-picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <text class="template-section-label" wx:if="{{memberNames.length > 0}}">
        每天每人班种（{{days.length}} 天 × {{memberNames.length}} 人）
      </text>
      <view
        class="template-day"
        wx:for="{{days}}"
        wx:key="*this"
        wx:for-index="dayIndex"
      >
        <text class="template-day-label">第 {{item}} 天</text>
        <view class="template-cell-row" wx:for="{{memberNames}}" wx:key="*this" wx:for-index="memberIndex">
          <text class="template-member-name">{{item}}</text>
          <picker
            mode="selector"
            range="{{cellOptions}}"
            value="{{grid[dayIndex][memberIndex] || 0}}"
            data-day="{{dayIndex}}"
            data-member="{{memberIndex}}"
            bindchange="handleCellChange"
          >
            <view class="template-cell-picker">
              {{cellOptions[grid[dayIndex][memberIndex] || 0]}}
              <text class="template-picker-arrow">▾</text>
            </view>
          </picker>
        </view>
      </view>

      <t-button
        theme="primary"
        block
        loading="{{submitting}}"
        disabled="{{submitting || roleNames.length === 0}}"
        bind:tap="handleSaveTemplate"
      >
        {{editingId ? '保存修改' : '创建模板'}}
      </t-button>
    </view>

    <view class="template-card" wx:if="{{applyTemplateId}}">
      <text class="template-title">应用模板</text>
      <view class="template-field">
        <text class="template-label">起始日期（可选，默认模板起始日期）</text>
        <picker
          mode="date"
          value="{{applyStartDate || '2026-01-01'}}"
          bindchange="handleApplyStartDateChange"
        >
          <view class="template-picker">
            {{applyStartDate || '默认'}}
            <text class="template-picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="template-field">
        <text class="template-label">结束日期（可选）</text>
        <picker
          mode="date"
          value="{{applyEndDate || '2026-01-31'}}"
          bindchange="handleApplyEndDateChange"
        >
          <view class="template-picker">
            {{applyEndDate || '默认'}}
            <text class="template-picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="template-field">
        <text class="template-label">保存方式</text>
        <picker
          mode="selector"
          range="{{['草稿', '发布']}}"
          value="{{applyPublishModeIndex}}"
          bindchange="handleApplyPublishModeChange"
        >
          <view class="template-picker">
            {{applyPublishModeIndex === 1 ? '发布' : '草稿'}}
            <text class="template-picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="template-switch-row">
        <text class="template-label">替换已有草稿</text>
        <switch
          checked="{{applyReplaceDrafts}}"
          color="#1F5AA6"
          bindchange="handleApplyReplaceDraftsChange"
        />
      </view>
      <view class="template-switch-row">
        <text class="template-label">替换已发布排班</text>
        <switch
          checked="{{applyReplacePublished}}"
          color="#1F5AA6"
          bindchange="handleApplyReplacePublishedChange"
        />
      </view>
      <t-button
        theme="default"
        block
        variant="outline"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:tap="handlePreviewApply"
      >
        预览应用结果
      </t-button>

      <view wx:if="{{applyPreview}}" class="template-preview">
        <text class="template-preview-row">排班记录：{{applyPreviewSummary.assignmentCount}} 条</text>
        <text class="template-preview-row" wx:if="{{applyPreviewSummary.vacancyCount > 0}}">
          空缺：{{applyPreviewSummary.vacancyCount}} 个
        </text>
        <text class="template-preview-row" wx:if="{{applyPreviewSummary.warningCount > 0}}">
          连续值班提醒：{{applyPreviewSummary.warningCount}} 处
        </text>
        <text class="template-preview-row is-warning" wx:if="{{applyPreviewSummary.conflictCount > 0}}">
          冲突：{{applyPreviewSummary.conflictCount}} 处（应用时将确认覆盖）
        </text>
        <t-button
          theme="primary"
          block
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:tap="handleApply"
        >
          确认应用
        </t-button>
      </view>
    </view>

    <text wx:if="{{errorMessage}}" class="template-error">{{errorMessage}}</text>
    <text wx:if="{{infoMessage}}" class="template-success">{{infoMessage}}</text>
  </block>

  <view wx:else class="template-card template-state">
    <text>请先选择一个群组。</text>
  </view>
</view>
