<view class="page-container qr-page">
  <view class="qr-card">
    <view wx:if="{{loading}}" class="qr-state">
      <text>加载中…</text>
    </view>

    <view wx:elif="{{errorMessage}}" class="qr-state">
      <text class="qr-error">{{errorMessage}}</text>
    </view>

    <block wx:elif="{{imageUrl}}">
      <image class="qr-image" src="{{imageUrl}}" mode="aspectFit" />
      <text class="qr-copy">扫描小程序码即可查看本群排班日历</text>
      <t-button theme="primary" block bind:tap="handleSave">保存到相册</t-button>
    </block>
  </view>
</view>
