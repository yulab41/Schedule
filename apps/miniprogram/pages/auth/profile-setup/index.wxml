<page-shell title="完善资料" show-back="{{false}}"><view class="auth-card"><text class="auth-card__description">真实姓名用于排班和邀请核对。</text><input value="{{realName}}" maxlength="50" placeholder="请输入真实姓名" bindinput="handleNameInput"/><text wx:if="{{errorMessage}}" class="auth-card__error">{{errorMessage}}</text><button class="auth-card__button" bindtap="handleSubmit" disabled="{{submitting}}" loading="{{submitting}}">保存并继续</button></view></page-shell>
