.auth-card {
  padding: var(--v3-space-lg);
  background: var(--v3-color-surface);
  border-radius: var(--v3-radius-lg);
}
.auth-card__description {
  display: block;
  margin-bottom: var(--v3-space-md);
  color: var(--v3-color-text-muted);
}
.auth-card__error {
  display: block;
  margin-top: var(--v3-space-sm);
  color: var(--v3-color-danger);
}
.auth-card__button {
  min-height: 88rpx;
  margin-top: var(--v3-space-lg);
  color: #fff;
  background: var(--v3-color-primary);
}
