<view class="page-container">
  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view class="card">
    <view class="card-title">排班岗位</view>
    <picker mode="selector" range="{{roleNames}}" value="{{selectedRoleIndex}}" bindchange="onRoleChange">
      <view class="config-picker">{{roleNames[selectedRoleIndex] || '选择岗位'}}</view>
    </picker>
    <view wx:for="{{roles}}" wx:key="id" class="row-between config-role">
      <view>
        <view class="list-title">{{item.name}}</view>
        <view class="list-sub">{{item.members.length}} 位成员</view>
      </view>
      <t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="handleDeleteRole">
        删除
      </t-button>
    </view>
    <view class="config-row">
      <t-input value="{{newRoleName}}" placeholder="新岗位名称" bind:change="onNewRoleInput" />
      <t-button size="small" theme="primary" bind:tap="handleCreateRole">新增</t-button>
    </view>
    <view class="section-title">参与成员</view>
    <view wx:for="{{memberRows}}" wx:key="id" class="config-member">
      <view class="flex-1">{{item.name}}</view>
      <t-switch
        value="{{item.checked}}"
        data-id="{{item.id}}"
        bind:change="onMemberToggle"
      />
    </view>
    <view class="actions">
      <t-button block variant="outline" bind:tap="handleSaveRoleMembers">保存岗位成员</t-button>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="card-title">班种</view>
      <t-button size="small" variant="outline" bind:tap="startCreateShift">新增班种</t-button>
    </view>
    <view wx:for="{{shiftTypes}}" wx:key="id" class="row-between config-shift">
      <view class="flex-1">
        <view class="row">
          <view class="config-shift-color" style="background: {{item.color}};"></view>
          <view>
            <view class="list-title">{{item.name}}（{{item.abbreviation}}）</view>
            <view class="list-sub">
              {{item.isAllDay ? '全天' : item.startTime + '–' + item.endTime}}
              · {{item.isEnabled ? '启用' : '停用'}}
            </view>
          </view>
        </view>
      </view>
      <view class="config-shift-actions">
        <t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="startEditShift">编辑</t-button>
        <t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="handleDeleteShift">删除</t-button>
      </view>
    </view>
  </view>

  <view wx:if="{{showShiftForm}}" class="card">
    <view class="card-title">{{shiftForm.id ? '编辑班种' : '新增班种'}}</view>
    <t-input value="{{shiftForm.name}}" data-field="name" placeholder="班种名称" bind:change="onShiftField" />
    <t-input value="{{shiftForm.abbreviation}}" data-field="abbreviation" placeholder="缩写（如 全/A/N）" bind:change="onShiftField" />
    <view class="config-row">
      <t-input value="{{shiftForm.color}}" data-field="color" placeholder="颜色 #RRGGBB" bind:change="onShiftField" />
      <t-input value="{{shiftForm.textColor}}" data-field="textColor" placeholder="文字颜色" bind:change="onShiftField" />
    </view>
    <view class="config-row">
      <t-input wx:if="{{!shiftForm.isAllDay}}" value="{{shiftForm.startTime}}" data-field="startTime" placeholder="开始 HH:mm" bind:change="onShiftField" />
      <t-input wx:if="{{!shiftForm.isAllDay}}" value="{{shiftForm.endTime}}" data-field="endTime" placeholder="结束 HH:mm" bind:change="onShiftField" />
    </view>
    <view class="config-switch-row">
      <text>全天班</text>
      <t-switch value="{{shiftForm.isAllDay}}" data-field="isAllDay" bind:change="onShiftSwitch" />
    </view>
    <view class="config-switch-row">
      <text>计入统计</text>
      <t-switch value="{{shiftForm.countsTowardStatistics}}" data-field="countsTowardStatistics" bind:change="onShiftSwitch" />
    </view>
    <view class="config-switch-row">
      <text>跨日</text>
      <t-switch value="{{shiftForm.crossesMidnight}}" data-field="crossesMidnight" bind:change="onShiftSwitch" />
    </view>
    <view class="config-switch-row">
      <text>启用</text>
      <t-switch value="{{shiftForm.isEnabled}}" data-field="isEnabled" bind:change="onShiftSwitch" />
    </view>
    <view class="actions">
      <t-button theme="primary" block bind:tap="handleSaveShift">保存班种</t-button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  <view wx:if="{{infoMessage}}" class="info-text">{{infoMessage}}</view>
</view>
