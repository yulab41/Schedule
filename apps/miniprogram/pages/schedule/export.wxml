<view class="page-container">
  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view class="card">
    <view class="card-title">导出排班 / 统计</view>
    <picker mode="selector" range="{{['排班','统计']}}" value="{{exportType === 'statistics' ? 1 : 0}}" bindchange="onExportTypeChange">
      <view class="form-row"><text class="muted">导出内容</text><text>{{exportType === 'statistics' ? '统计' : '排班'}}</text></view>
    </picker>
    <picker mode="selector" range="{{['按月','按年']}}" value="{{periodType === 'year' ? 1 : 0}}" bindchange="onPeriodTypeChange">
      <view class="form-row"><text class="muted">时间范围</text><text>{{periodType === 'year' ? '按年' : '按月'}}</text></view>
    </picker>
    <picker wx:if="{{periodType === 'month'}}" mode="date" fields="month" value="{{month}}" bindchange="onMonthChange">
      <view class="form-row"><text class="muted">月份</text><text>{{periodLabel}}</text></view>
    </picker>
    <picker wx:else mode="selector" range="{{yearOptions}}" value="{{1}}" bindchange="onYearChange">
      <view class="form-row"><text class="muted">年份</text><text>{{periodLabel}}</text></view>
    </picker>
    <picker mode="selector" range="{{roleOptions}}" range-key="name" value="{{roleIndex}}" bindchange="onRoleChange">
      <view class="form-row"><text class="muted">岗位（可选）</text><text>{{roleOptions[roleIndex].name || '全部岗位'}}</text></view>
    </picker>
    <picker mode="selector" range="{{memberOptions}}" range-key="name" value="{{memberIndex}}" bindchange="onMemberChange">
      <view class="form-row"><text class="muted">成员（可选）</text><text>{{memberOptions[memberIndex].name || '全部成员'}}</text></view>
    </picker>
    <view class="actions">
      <t-button theme="primary" block loading="{{submitting}}" bind:tap="handleCreateJob">创建导出任务</t-button>
    </view>
    <view wx:if="{{job}}" class="info-text">
      状态：{{job.status}} · {{job.exportType}} · {{job.period}}
    </view>
    <view wx:if="{{infoMessage}}" class="info-text">{{infoMessage}}</view>
    <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  </view>
</view>
