<view class="page-container">
  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  <view wx:if="{{infoMessage}}" class="info-text">{{infoMessage}}</view>

  <view class="card">
    <view class="card-title">手动排班模板</view>
    <picker mode="selector" range="{{templateOptions}}" range-key="label" value="{{templateIndex}}" bindchange="onTemplateChange">
      <view class="form-row"><text class="muted">模板</text><text>{{templateOptions[templateIndex].label || '新建模板'}}</text></view>
    </picker>
    <picker mode="selector" range="{{roleOptions}}" range-key="name" value="{{roleIndex}}" bindchange="onRoleChange">
      <view class="form-row"><text class="muted">排班岗位</text><text>{{roleOptions[roleIndex].name || '请选择'}}</text></view>
    </picker>
    <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
      <view class="form-row"><text class="muted">开始日期</text><text>{{startDate}}</text></view>
    </picker>
    <view class="form-row">
      <text class="muted">周期天数</text>
      <t-input type="number" value="{{cycleDays}}" bind:change="onCycleDaysInput" />
    </view>

    <view class="section-title">值班人员</view>
    <view wx:if="{{memberRows.length === 0}}" class="muted">该排班岗位还没有成员，请先在排班配置中添加。</view>
    <view wx:for="{{memberRows}}" wx:key="id" class="member-row">
      <text>{{item.name}}</text>
      <t-switch value="{{item.checked}}" data-id="{{item.id}}" bind:change="toggleMember" />
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="card-title">绘制网格</view>
      <view class="row">
        <t-button size="small" variant="outline" disabled="{{!canUndo}}" bind:tap="undo">撤销</t-button>
      </view>
    </view>
    <view wx:if="{{staleWarning}}" class="info-text">模板包含失效标记（成员失效或班种变更），保存后服务端会再次校验。</view>
    <shift-palette shift-types="{{shiftTypes}}" selected-id="{{activeShiftTypeId}}" bind:select="selectShiftType" />
    <view wx:if="{{scheduleRoleId}}" class="manual-actions">
      <t-button size="small" variant="outline" disabled="{{!selectedCell}}" bind:tap="clearSelectedCell">清除格子</t-button>
      <t-button size="small" variant="outline" disabled="{{!selectedCell}}" bind:tap="clearSelectedRow">清空整行</t-button>
      <t-button size="small" variant="outline" disabled="{{!selectedCell}}" bind:tap="clearSelectedColumn">清空整列</t-button>
    </view>
    <manual-grid
      wx:if="{{scheduleRoleId}}"
      columns="{{columns}}"
      rows="{{rows}}"
      grid="{{grid}}"
      selected="{{selectedCell}}"
      bind:celltap="onCellTap"
    />
    <view wx:else class="empty-state">请先选择排班岗位并勾选值班人员。</view>
    <view class="actions">
      <t-button theme="primary" block loading="{{isSaving}}" bind:tap="handleSave">保存模板</t-button>
      <t-button block variant="outline" disabled="{{!selectedTemplateId}}" bind:tap="openApplyDialog">应用模板</t-button>
      <t-button block variant="outline" disabled="{{!selectedTemplateId}}" bind:tap="handleDeleteTemplate">删除模板</t-button>
    </view>
  </view>

  <view wx:if="{{draftBatches.length > 0}}" class="card">
    <view class="card-title">排班草稿</view>
    <view class="muted">模板应用后按范围保存为草稿，可一次发布整个范围；重复应用时可选择覆盖旧草稿。</view>
    <view wx:for="{{draftBatches}}" wx:key="key" class="batch-row">
      <view class="flex-1">
        <view class="list-title">{{item.rangeStart}} 至 {{item.rangeEnd}}</view>
        <view class="list-sub">{{item.roleName}} · 共 {{item.items.length}} 个月</view>
        <view class="month-chips">
          <text wx:for="{{item.months}}" wx:for-item="month" wx:key="*this" class="month-chip">{{month}}</text>
        </view>
      </view>
      <view class="batch-actions">
        <t-button size="small" theme="primary" data-key="{{item.key}}" loading="{{isPublishingId === item.key}}" bind:tap="publishBatch">发布</t-button>
        <t-button size="small" theme="danger" variant="outline" data-key="{{item.key}}" loading="{{isDeletingDraftId === item.key}}" bind:tap="deleteBatch">删除</t-button>
      </view>
    </view>

    <view wx:if="{{batchBlocked}}" class="blocker-panel">
      <view class="error-text">{{batchBlocked.message}}</view>
      <view wx:if="{{batchBlocked.conflictingMonths.length > 0}}" class="month-chips">
        <text wx:for="{{batchBlocked.conflictingMonths}}" wx:key="*this" class="month-chip is-conflict">{{item}}</text>
      </view>
      <block wx:if="{{batchBlocked.needsReplace}}">
        <view class="ack-row">
          <text>覆盖已发布排班</text>
          <t-switch value="{{replacePublished}}" data-field="replacePublished" bind:change="onApplyFlag" />
        </view>
        <view wx:if="{{batchBlocked.workflowImpacts.length > 0}}" class="impact-list">
          <view wx:for="{{batchBlocked.workflowImpacts}}" wx:key="id">
            {{item.kind === 'swap' ? '换班' : '加扣班'}} · {{item.memberNames}} · {{item.businessDates}}
          </view>
          <view class="ack-row">
            <text>我已了解这些事件将被撤销</text>
            <t-switch value="{{acknowledgeWorkflowRevocations}}" data-field="acknowledgeWorkflowRevocations" bind:change="onApplyFlag" />
          </view>
        </view>
        <t-button block theme="danger" variant="outline" disabled="{{!replacePublished || (batchBlocked.workflowImpacts.length > 0 && !acknowledgeWorkflowRevocations)}}" bind:tap="confirmBlockedPublish">确认覆盖发布</t-button>
      </block>
      <block wx:else>
        <view class="ack-row">
          <text>我已了解冲突和空缺，确认发布</text>
          <t-switch value="{{acknowledgeBlockers}}" data-field="acknowledgeBlockers" bind:change="onApplyFlag" />
        </view>
        <t-button block theme="danger" variant="outline" disabled="{{!acknowledgeBlockers}}" bind:tap="confirmBlockedPublish">确认发布</t-button>
      </block>
    </view>
  </view>

  <view wx:if="{{versionMonthGroups.length > 0}}" class="card">
    <view class="card-title">排班发布记录</view>
    <view wx:for="{{versionMonthGroups}}" wx:key="businessMonth" class="month-group">
      <view class="row-between">
        <text class="list-title">{{item.businessMonth.slice(0, 7)}} · {{item.roleName}}</text>
      </view>
      <view wx:for="{{item.currentViews}}" wx:for-item="view" wx:key="item.id" class="version-row">
        <view class="flex-1">
          <view class="list-title">{{view.isPast ? '既往排班（锁定）' : '当前已发布'}}</view>
          <view class="list-sub">草稿 {{view.draftCode}}</view>
        </view>
        <view class="batch-actions">
          <t-button size="small" variant="outline" data-id="{{view.item.id}}" bind:tap="openDraftPreview">查看</t-button>
          <t-button wx:if="{{view.isPast}}" size="small" variant="outline" bind:tap="openBackfill">排班补录</t-button>
          <t-button wx:else size="small" theme="danger" variant="outline" data-id="{{view.item.id}}" data-action="withdraw" bind:tap="preparePeriodMutation">撤销发布</t-button>
        </view>
      </view>
      <view wx:for="{{item.pastViews}}" wx:for-item="view" wx:key="item.id" class="version-row">
        <view class="flex-1">
          <view class="list-title">既往排班（锁定）</view>
          <view class="list-sub">草稿 {{view.draftCode}}</view>
        </view>
        <view class="batch-actions">
          <t-button size="small" variant="outline" data-id="{{view.item.id}}" bind:tap="openDraftPreview">查看</t-button>
          <t-button size="small" variant="outline" bind:tap="openBackfill">排班补录</t-button>
        </view>
      </view>
      <view wx:if="{{item.archived.length > 0}}" class="archived-block">
        <view class="list-title">已归档（{{item.archived.length}}）</view>
        <view wx:for="{{item.archivedViews}}" wx:for-item="view" wx:key="item.id" class="version-row">
          <view class="flex-1">
            <view class="list-title">已归档</view>
            <view class="list-sub">草稿 {{view.draftCode}}</view>
          </view>
          <view class="batch-actions">
            <t-button size="small" variant="outline" data-id="{{view.item.id}}" bind:tap="openDraftPreview">查看</t-button>
            <t-button size="small" theme="primary" variant="outline" data-id="{{view.item.id}}" data-action="publish" bind:tap="preparePeriodMutation">重新发布</t-button>
            <t-button size="small" theme="danger" variant="outline" data-id="{{view.item.id}}" bind:tap="deleteDraft">删除</t-button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 模板应用弹层 -->
  <view wx:if="{{applyVisible || applyLeaving}}" class="overlay {{applyLeaving ? 'is-leaving' : ''}}">
    <view
      class="overlay-panel {{applyLeaving ? 'is-leaving' : ''}}"
      style="transform: translateY({{overlayDragY}}px);"
      bind:touchstart="onOverlayTouchStart"
      bind:touchmove="onOverlayTouchMove"
      bind:touchend="onOverlayTouchEnd"
      bind:touchcancel="onOverlayTouchEnd"
    >
      <view class="overlay-grabber"></view>
      <view class="row-between">
        <view class="card-title">应用模板</view>
        <text class="overlay-close" bind:tap="closeApply">×</text>
      </view>
      <view class="form-row"><text class="muted">应用开始</text><text>{{applyStartDate}}</text></view>
      <view class="ack-row">
        <text>重复应用到结束日期</text>
        <t-switch value="{{repeatEnabled}}" data-field="repeatEnabled" bind:change="onApplyFlag" />
      </view>
      <picker wx:if="{{repeatEnabled}}" mode="date" value="{{applyEndDate}}" bindchange="onApplyEndDate">
        <view class="form-row"><text class="muted">结束日期</text><text>{{applyEndDate}}</text></view>
      </picker>
      <view class="actions">
        <t-button block variant="outline" loading="{{isPreviewingDraftId}}" bind:tap="computeApplyPreview">生成预览</t-button>
      </view>
      <view wx:if="{{applyPreview}}" class="preview-block">
        <view class="preview-stats">
          <text>班次 {{applyPreview.statistics.assignmentCount}}</text>
          <text>计入 {{applyPreview.statistics.countedAssignmentCount}}</text>
          <text>空缺 {{applyPreview.statistics.vacancyCount}}</text>
        </view>
        <view wx:if="{{applyPreview.conflicts.length > 0}}" class="error-text">发现 {{applyPreview.conflicts.length}} 处硬冲突。</view>
        <view wx:if="{{applyPreview.continuousDutyWarnings.length > 0}}" class="info-text">发现 {{applyPreview.continuousDutyWarnings.length}} 处连续值班风险。</view>
        <view wx:if="{{applyPreview.vacancies.length > 0}}" class="info-text">发现 {{applyPreview.vacancies.length}} 个待处理空缺。</view>
        <view wx:if="{{applyOverlappingDrafts}}" class="ack-row">
          <text>覆盖已有草稿</text>
          <t-switch value="{{applyReplaceDrafts}}" data-field="applyReplaceDrafts" bind:change="onApplyFlag" />
        </view>
        <view wx:if="{{applyNeedsReplacePublished}}" class="ack-row">
          <text>覆盖已有排班</text>
          <t-switch value="{{applyReplacePublished}}" data-field="applyReplacePublished" bind:change="onApplyFlag" />
        </view>
        <view wx:if="{{applyWorkflowImpacts.length > 0}}" class="impact-list">
          <view wx:for="{{applyWorkflowImpacts}}" wx:key="id">{{item.memberNames}} · {{item.businessDates}}</view>
          <view class="ack-row">
            <text>我已了解这些事件将被撤销</text>
            <t-switch value="{{applyAckWorkflows}}" data-field="applyAckWorkflows" bind:change="onApplyFlag" />
          </view>
        </view>
        <view wx:if="{{applyPreview.conflicts.length > 0 || applyPreview.vacancies.length > 0}}" class="ack-row">
          <text>我已了解冲突和空缺</text>
          <t-switch value="{{applyAckBlockers}}" data-field="applyAckBlockers" bind:change="onApplyFlag" />
        </view>
        <view class="actions">
          <t-button theme="primary" block loading="{{isSaving}}" bind:tap="handleApply">应用模板</t-button>
        </view>
      </view>
      <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
    </view>
  </view>

  <!-- 预览弹层 -->
  <view wx:if="{{previewVisible || previewLeaving}}" class="overlay {{previewLeaving ? 'is-leaving' : ''}}">
    <view
      class="overlay-panel {{previewLeaving ? 'is-leaving' : ''}}"
      style="transform: translateY({{overlayDragY}}px);"
      bind:touchstart="onOverlayTouchStart"
      bind:touchmove="onOverlayTouchMove"
      bind:touchend="onOverlayTouchEnd"
      bind:touchcancel="onOverlayTouchEnd"
    >
      <view class="overlay-grabber"></view>
      <view class="row-between">
        <view class="card-title">{{previewTargetLabel}}</view>
        <text class="overlay-close" bind:tap="closeDraftPreview">×</text>
      </view>
      <view wx:if="{{draftPreview}}" class="preview-block">
        <view class="preview-stats">
          <text>班次 {{draftPreview.statistics.assignmentCount}}</text>
          <text>计入 {{draftPreview.statistics.countedAssignmentCount}}</text>
          <text>空缺 {{draftPreview.statistics.vacancyCount}}</text>
        </view>
        <view wx:if="{{draftPreview.hardConflicts.length > 0}}" class="error-text">发现 {{draftPreview.hardConflicts.length}} 处硬冲突。</view>
        <view wx:if="{{draftPreview.continuousDutyWarnings.length > 0}}" class="info-text">发现 {{draftPreview.continuousDutyWarnings.length}} 处连续值班风险。</view>
        <view wx:if="{{draftPreview.vacancies.length > 0}}" class="info-text">发现 {{draftPreview.vacancies.length}} 个空缺。</view>
      </view>
      <view wx:elif="{{periodCalendar}}" class="preview-block">
        <view class="card-copy">{{periodCalendar.businessMonth}} · {{periodCalendar.assignments.length}} 条班次</view>
      </view>
      <view wx:if="{{draftPreviewError}}" class="error-text">{{draftPreviewError}}</view>
    </view>
  </view>

  <!-- 发布/撤销弹层 -->
  <view wx:if="{{mutationVisible || overlayLeaving}}" class="overlay {{overlayLeaving ? 'is-leaving' : ''}}">
    <view
      class="overlay-panel {{overlayLeaving ? 'is-leaving' : ''}}"
      style="transform: translateY({{overlayDragY}}px);"
      bind:touchstart="onOverlayTouchStart"
      bind:touchmove="onOverlayTouchMove"
      bind:touchend="onOverlayTouchEnd"
      bind:touchcancel="onOverlayTouchEnd"
    >
      <view class="overlay-grabber"></view>
      <view class="row-between">
        <view class="card-title">{{mutationAction === 'withdraw' ? '撤销当前排班' : '重新发布归档排班'}}</view>
        <text class="overlay-close" bind:tap="closeMutation">×</text>
      </view>
      <view wx:if="{{mutationTarget}}" class="preview-block">
        <view class="muted">{{mutationTargetLabel}}</view>
        <view wx:if="{{mutationAction === 'withdraw' && mutationHasPastDates}}" class="info-text">
          撤销后仅未来日期失效；已过日期保留为既往排班（锁定）。
        </view>
        <view wx:if="{{mutationAction === 'publish' && mutationHasPastDates}}" class="info-text">
          该版本包含已过日期；发布后仍保持既往排班（锁定）状态。
        </view>
        <view wx:if="{{mutationImpact && mutationImpact.workflowImpacts.length > 0}}" class="impact-list">
          <view wx:for="{{mutationImpact.workflowImpacts}}" wx:key="id">{{item.memberNames}} · {{item.businessDates}}</view>
          <view class="ack-row">
            <text>我已了解上述影响，确认继续</text>
            <t-switch value="{{acknowledgeWorkflowRevocations}}" data-field="acknowledgeWorkflowRevocations" bind:change="onApplyFlag" />
          </view>
        </view>
        <view wx:if="{{mutationHasBlockers}}" class="error-text">
          该归档版本包含硬冲突与空缺。
        </view>
        <view wx:if="{{mutationAction === 'publish' && mutationHasPastDates}}" class="ack-row">
          <text>我已了解已过日期不可修改，确认发布</text>
          <t-switch value="{{acknowledgePastDates}}" data-field="acknowledgePastDates" bind:change="onApplyFlag" />
        </view>
        <view class="actions">
          <t-button theme="{{mutationAction === 'withdraw' ? 'danger' : 'primary'}}" block loading="{{isMutatingPeriod}}" bind:tap="confirmPeriodMutation">
            {{mutationAction === 'withdraw' ? '确认撤销发布' : '确认重新发布'}}
          </t-button>
        </view>
      </view>
    </view>
  </view>

  <!-- 版本冲突弹层 -->
  <view wx:if="{{conflictVisible || overlayLeaving}}" class="overlay {{overlayLeaving ? 'is-leaving' : ''}}">
    <view
      class="overlay-panel {{overlayLeaving ? 'is-leaving' : ''}}"
      style="transform: translateY({{overlayDragY}}px);"
      bind:touchstart="onOverlayTouchStart"
      bind:touchmove="onOverlayTouchMove"
      bind:touchend="onOverlayTouchEnd"
      bind:touchcancel="onOverlayTouchEnd"
    >
      <view class="overlay-grabber"></view>
      <view class="card-title">资料已更新</view>
      <view wx:if="{{conflictSummary}}" class="muted">{{conflictSummary}}</view>
      <view class="card-copy">{{conflictMessage}}</view>
      <view class="actions-row">
        <t-button block variant="outline" bind:tap="closeConflict">关闭</t-button>
        <t-button block theme="primary" bind:tap="refreshAfterConflict">刷新</t-button>
      </view>
    </view>
  </view>
</view>
