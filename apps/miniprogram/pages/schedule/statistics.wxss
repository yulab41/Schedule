.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.stat-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  padding: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-label {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.stat-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.stat-col-name {
  flex: 2;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.stat-col {
  flex: 1;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.stat-table-head .stat-col {
  color: var(--color-text-muted);
  font-size: 22rpx;
}
