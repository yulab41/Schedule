.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.manual-actions {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
}

.batch-row,
.version-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e5e7eb;
}

.batch-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.month-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.month-chip {
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
}

.month-chip.is-conflict {
  background: #fffbeb;
  color: #92400e;
}

.blocker-panel,
.impact-list {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: var(--radius-md);
  background: #fffbeb;
  color: #92400e;
}

.ack-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0;
}

.archived-block {
  margin-top: 16rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.overlay-panel {
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
}

.overlay-close {
  padding: 8rpx 16rpx;
  font-size: 40rpx;
  color: var(--color-text-muted);
}

.preview-block {
  margin-top: 16rpx;
}

.preview-stats {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  font-weight: 600;
}
