.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.manual-actions {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
}

.batch-row,
.version-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e5e7eb;
}

.batch-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.month-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.month-chip {
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
}

.month-chip.is-conflict {
  background: #fffbeb;
  color: #92400e;
}

.blocker-panel,
.impact-list {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: var(--radius-md);
  background: #fffbeb;
  color: #92400e;
}

.ack-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0;
}

.archived-block {
  margin-top: 16rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.45);
  backdrop-filter: blur(12rpx);
  animation: overlay-fade-in 0.25s ease;
}

.overlay.is-leaving {
  animation: overlay-fade-out 0.22s ease forwards;
}

.overlay-panel {
  width: 100%;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
  padding: 16rpx 32rpx env(safe-area-inset-bottom);
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
  animation: overlay-in 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.overlay-panel.is-leaving {
  animation: overlay-out 0.22s ease forwards;
}

@keyframes overlay-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes overlay-out {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}

@keyframes overlay-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes overlay-fade-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

.overlay-grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 16rpx;
  border-radius: 8rpx;
  background: #e5e7eb;
}

.overlay-close {
  padding: 8rpx 16rpx;
  font-size: 40rpx;
  color: var(--color-text-muted);
}

.preview-block {
  margin-top: 16rpx;
}

.preview-stats {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  font-weight: 600;
}
