.config-picker {
  margin: 16rpx 0;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.config-role,
.config-shift {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.config-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.config-row > t-input,
.config-row > t-button {
  flex: 1;
}

.config-member {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.config-shift-color {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
}

.config-shift-actions {
  display: flex;
  gap: 8rpx;
}

.config-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
