.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.backfill-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.backfill-cell {
  position: relative;
  min-height: 84rpx;
  padding: 8rpx;
  background: var(--color-surface);
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
}

.backfill-cell.is-weekend {
  background: #fff7f7;
}

.backfill-cell.is-future {
  opacity: 0.35;
}

.backfill-cell.is-pending {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.backfill-day {
  display: block;
  font-size: 24rpx;
}

.backfill-label {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.backfill-pending {
  position: absolute;
  right: 8rpx;
  bottom: 6rpx;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
}
