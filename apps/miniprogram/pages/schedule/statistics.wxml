<view class="page-container">
  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view class="card">
    <t-tabs value="{{viewMode}}" bind:change="onViewModeChange">
      <t-tab-panel label="按月" value="month" />
      <t-tab-panel label="按年" value="year" />
    </t-tabs>
    <picker wx:if="{{viewMode === 'month'}}" mode="date" fields="month" value="{{businessMonth}}" bindchange="onMonthChange">
      <view class="form-row"><text class="muted">月份</text><text>{{monthLabel}}</text></view>
    </picker>
    <picker wx:else mode="selector" range="{{yearOptions}}" value="{{1}}" bindchange="onYearChange">
      <view class="form-row"><text class="muted">年份</text><text>{{year}} 年</text></view>
    </picker>
    <view class="actions-row">
      <t-button size="small" variant="outline" bind:tap="refreshSnapshot">刷新快照</t-button>
      <t-button size="small" variant="outline" bind:tap="runRecalculateCheck">重算校验</t-button>
    </view>
    <view wx:if="{{checkMessage}}" class="info-text">{{checkMessage}}</view>
  </view>

  <view class="stat-cards">
    <view wx:for="{{cards}}" wx:key="label" class="stat-card">
      <view class="stat-value">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">成员统计</view>
    <view class="stat-table-head stat-row">
      <text class="stat-col-name">成员</text>
      <text class="stat-col">计划</text>
      <text class="stat-col">实际</text>
      <text class="stat-col">计值</text>
      <text class="stat-col">净值</text>
      <text class="stat-col">对照</text>
    </view>
    <view wx:for="{{memberRows}}" wx:key="membershipId" class="stat-table-row stat-row">
      <text class="stat-col-name">{{item.realName}}</text>
      <text class="stat-col">{{item.plannedCount}}</text>
      <text class="stat-col">{{item.actualCount}}</text>
      <text class="stat-col">{{item.countedActualCount}}</text>
      <text class="stat-col">{{item.netLabel}}</text>
      <text class="stat-col">{{item.actualVsPlannedCount}}</text>
    </view>
    <view wx:if="{{memberRows.length === 0}}" class="empty-state">暂无成员统计</view>
  </view>

  <view class="card">
    <view class="card-title">按排班岗位</view>
    <view wx:for="{{roleRows}}" wx:key="name" class="stat-table-row stat-row">
      <text class="stat-col-name">{{item.name}}</text>
      <text class="stat-col">计划 {{item.planned}}</text>
      <text class="stat-col">实际 {{item.actual}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">按班种</view>
    <view wx:for="{{shiftRows}}" wx:key="name" class="stat-table-row stat-row">
      <text class="stat-col-name">{{item.name}}</text>
      <text class="stat-col">计划 {{item.planned}}</text>
      <text class="stat-col">实际 {{item.actual}}</text>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
</view>
