<view class="page-container group-manage-page">
  <group-switcher
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view wx:if="{{loading}}" class="manage-card manage-state">
    <text>加载中…</text>
  </view>

  <block wx:elif="{{groups.length === 0}}">
    <view class="manage-card">
      <text class="manage-title">创建群组</text>
      <text class="manage-copy">创建后你就是群主，可通过成员页添加待认领名单并发送邀请链接。</text>
      <view class="manage-field">
        <text class="manage-label">群组名称</text>
        <input
          class="manage-input"
          value="{{createName}}"
          maxlength="100"
          placeholder="例如：头颈外科"
          bind:input="handleCreateNameInput"
        />
      </view>
      <view class="manage-field">
        <text class="manage-label">自定义四位群组码（可选）</text>
        <input
          class="manage-input"
          value="{{createCode}}"
          maxlength="4"
          placeholder="四位数字"
          bind:input="handleCreateCodeInput"
        />
      </view>
      <t-button
        theme="primary"
        block
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:tap="handleCreateGroup"
      >
        创建群组
      </t-button>
    </view>

    <view class="manage-card">
      <text class="manage-title">加入其他群组</text>
      <text class="manage-copy">只能以访客身份加入公开群组；成员身份必须通过群主/管理员邀请链接加入。</text>
      <picker
        mode="selector"
        range="{{catalogNames}}"
        value="{{catalogIndex}}"
        disabled="{{catalogNames.length === 0}}"
        bindchange="handleCatalogChange"
      >
        <view class="manage-picker">
          {{catalogNames.length > 0 ? catalogNames[catalogIndex] : '暂无可加入的群组'}}
          <text class="manage-picker-arrow">▾</text>
        </view>
      </picker>
      <t-button
        theme="default"
        block
        variant="outline"
        loading="{{submitting}}"
        disabled="{{submitting || catalogNames.length === 0}}"
        bind:tap="handleJoinGuest"
      >
        以访客身份加入
      </t-button>
    </view>

    <text wx:if="{{errorMessage}}" class="manage-error">{{errorMessage}}</text>
  </block>

  <block wx:else>
    <view class="manage-card">
      <text class="manage-title">当前群组操作</text>
      <text class="manage-copy">{{selectedGroupName}}</text>
      <view class="manage-actions" wx:if="{{selectedRole === 'owner'}}">
        <view class="manage-field">
          <text class="manage-label">群组名称</text>
          <input
            class="manage-input"
            value="{{groupNameInput}}"
            maxlength="100"
            bind:input="handleGroupNameInput"
          />
        </view>
        <t-button
          theme="default"
          block
          variant="outline"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:tap="handleSaveGroupName"
        >
          保存名称
        </t-button>
        <t-button
          theme="default"
          block
          variant="outline"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:tap="handleRegenerateCode"
        >
          重新生成群组码
        </t-button>
        <t-button
          theme="default"
          block
          variant="outline"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:tap="handleRegenerateVisitorKey"
        >
          重新生成访客小程序码
        </t-button>
        <t-button
          theme="danger"
          block
          variant="outline"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:tap="handleDissolve"
        >
          解散群组
        </t-button>
      </view>
      <t-button
        wx:else
        theme="default"
        block
        variant="outline"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:tap="handleLeave"
      >
        退出群组
      </t-button>
    </view>

    <view class="manage-card" wx:if="{{selectedRole === 'owner' || selectedRole === 'administrator'}}">
      <text class="manage-title">管理入口</text>
      <t-button
        theme="default"
        block
        variant="outline"
        bind:tap="openGroupQr"
      >
        群组访客小程序码
      </t-button>
      <t-button
        theme="default"
        block
        variant="outline"
        bind:tap="openMembers"
      >
        成员与邀请
      </t-button>
      <t-button
        theme="default"
        block
        variant="outline"
        bind:tap="openScheduleRoles"
      >
        排班岗位与轮值
      </t-button>
      <t-button
        theme="default"
        block
        variant="outline"
        bind:tap="openShiftTypes"
      >
        班种设置
      </t-button>
      <t-button
        theme="default"
        block
        variant="outline"
        bind:tap="openScheduling"
      >
        排班期间与手动模板
      </t-button>
      <t-button
        theme="default"
        block
        variant="outline"
        bind:tap="openStatistics"
      >
        统计
      </t-button>
    </view>

    <view class="manage-card" wx:if="{{selectedRole === 'owner' && dissolved.length > 0}}">
      <text class="manage-title">已解散群组（30 天内可恢复）</text>
      <view class="manage-dissolved-row" wx:for="{{dissolved}}" wx:key="id">
        <text class="manage-dissolved-name">{{item.name}}</text>
        <t-button
          size="small"
          variant="outline"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          data-id="{{item.id}}"
          bind:tap="handleRestore"
        >
          恢复
        </t-button>
      </view>
    </view>

    <text wx:if="{{errorMessage}}" class="manage-error">{{errorMessage}}</text>
    <text wx:if="{{infoMessage}}" class="manage-success">{{infoMessage}}</text>
  </block>
</view>
