<view class="page-container">
  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />
  <t-tabs value="{{showAccess ? 1 : 0}}" bind:change="onTabChange">
    <t-tab-panel label="事件时间线" value="0" />
    <t-tab-panel wx:if="{{selectedRole === 'owner' || selectedRole === 'administrator'}}" label="访客访问记录" value="1" />
  </t-tabs>
  <view class="card" wx:if="{{!showAccess}}">
    <view class="card-title">事件时间线</view>
    <view wx:for="{{events}}" wx:key="id" class="list-item">
      <view class="flex-1">
        <view class="list-title">{{item.narrative}}</view>
        <view class="list-sub">{{item.time}}</view>
      </view>
    </view>
    <view wx:if="{{events.length === 0}}" class="empty-state">暂无事件</view>
  </view>
  <view class="card" wx:else>
    <view class="card-title">访客访问记录</view>
    <view wx:for="{{accessRows}}" wx:key="id" class="list-item">
      <view class="flex-1">
        <view class="list-title">{{item.createdAt}}</view>
        <view class="list-sub">{{item.businessMonth}}</view>
      </view>
    </view>
    <view wx:if="{{accessRows.length === 0}}" class="empty-state">暂无访问记录</view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
</view>
