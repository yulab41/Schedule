.events-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.events-tabs {
  display: flex;
  padding: 6rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.events-tab {
  flex: 1;
  padding: 12rpx 0;
  color: var(--color-text-muted);
  font-size: 26rpx;
  text-align: center;
}

.events-tab.is-active {
  color: var(--color-primary);
  background: #e8f1fb;
  border-radius: var(--radius-sm);
  font-weight: 600;
}

.event-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.event-header {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: space-between;
}

.event-type {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.event-time {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.event-narrative {
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 1.5;
}

.events-card {
  padding: 48rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.events-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  color: var(--color-text-muted);
}

.events-error {
  color: var(--color-weekend);
  text-align: center;
}
