.register-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
}

.register-card {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 24rpx;
  padding: 48rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.register-title {
  font-size: 38rpx;
  font-weight: 600;
  text-align: center;
}

.register-error {
  color: var(--color-weekend);
  font-size: 26rpx;
  text-align: center;
}
