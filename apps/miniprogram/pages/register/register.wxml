<view class="page-container">
  <view class="card">
    <view class="card-title">填写真实姓名</view>
    <view class="card-copy">姓名用于排班、统计与事件记录，并会展示给同组成员。</view>
    <view class="register-input">
      <t-input
        value="{{realName}}"
        placeholder="请输入真实姓名"
        bind:change="onInput"
        maxlength="30"
      />
    </view>
    <view class="actions">
      <t-button theme="primary" block loading="{{submitting}}" bind:tap="handleSubmit">
        保存并进入
      </t-button>
    </view>
    <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  </view>
</view>
