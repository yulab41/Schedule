<view class="page-container register-page">
  <view class="register-card">
    <text class="register-title">完善个人资料</text>
    <t-input
      value="{{realName}}"
      placeholder="请输入真实姓名"
      maxlength="100"
      bind:change="handleRealNameInput"
    />
    <t-button
      theme="primary"
      block
      loading="{{loading}}"
      disabled="{{loading}}"
      bind:tap="handleSubmit"
    >
      保存并进入
    </t-button>
    <text wx:if="{{errorMessage}}" class="register-error">{{errorMessage}}</text>
  </view>
</view>
