<view class="page-container swap-create-page">
  <group-switcher
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view class="swap-toolbar">
    <t-button size="small" variant="outline" bind:tap="changeMonth" data-delta="-1">
      上一月
    </t-button>
    <text class="swap-month-label">{{monthLabel}}</text>
    <t-button size="small" variant="outline" bind:tap="changeMonth" data-delta="1">
      下一月
    </t-button>
  </view>

  <view class="swap-card">
    <text class="swap-label">我的值班班次</text>
    <picker
      mode="selector"
      range="{{myAssignmentLabels}}"
      value="{{selectedMyIndex}}"
      disabled="{{myAssignmentLabels.length === 0}}"
      bindchange="handleMyAssignmentChange"
    >
      <view class="swap-picker">{{myAssignmentLabels[selectedMyIndex] || '本月暂无可选班次'}}</view>
    </picker>

    <text class="swap-label">换班对象</text>
    <picker
      mode="selector"
      range="{{targetNames}}"
      value="{{selectedTargetIndex}}"
      disabled="{{targetNames.length === 0}}"
      bindchange="handleTargetChange"
    >
      <view class="swap-picker">{{targetNames[selectedTargetIndex] || '暂无可选成员'}}</view>
    </picker>

    <text class="swap-label">对方班次</text>
    <picker
      mode="selector"
      range="{{targetAssignmentLabels}}"
      value="{{selectedTargetAssignmentIndex}}"
      disabled="{{targetAssignmentLabels.length === 0}}"
      bindchange="handleTargetAssignmentChange"
    >
      <view class="swap-picker">
        {{targetAssignmentLabels[selectedTargetAssignmentIndex] || '对方暂无未来班次'}}
      </view>
    </picker>

    <view wx:if="{{preview}}" class="swap-preview">
      <text class="swap-preview-status">{{previewStatusDescription}}</text>
      <view wx:if="{{preview.conflicts.length > 0}}">
        <text class="swap-conflict" wx:for="{{preview.conflicts}}" wx:key="message">
          {{item.message}}
        </text>
      </view>
    </view>

    <text wx:if="{{errorMessage}}" class="swap-error">{{errorMessage}}</text>
    <t-button
      theme="primary"
      block
      loading="{{submitting || previewLoading}}"
      disabled="{{submitting || previewLoading || !preview || preview.conflicts.length > 0}}"
      bind:tap="handleSubmit"
    >
      提交换班申请
    </t-button>
  </view>
</view>
