<view class="page-container">
  <group-switcher
    wx:if="{{groups.length > 0}}"
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />
  <t-tabs value="{{kind}}" bind:change="onKindChange">
    <t-tab-panel label="请假" value="leave" />
    <t-tab-panel label="换班" value="swap" />
    <t-tab-panel label="加扣班" value="duty" />
  </t-tabs>
  <view class="card">
    <view class="card-title">待审批（{{visibleRows.length}}）</view>
    <view wx:for="{{visibleRows}}" wx:key="id" class="list-item">
      <view class="flex-1">
        <view class="list-title">{{item.title}}</view>
        <view class="list-sub">{{item.summary}} · {{item.statusLabel}}</view>
      </view>
      <view class="approvals-actions">
        <t-button size="small" theme="primary" data-id="{{item.id}}" data-decision="approve" bind:tap="handleDecide">批准</t-button>
        <t-button size="small" theme="danger" variant="outline" data-id="{{item.id}}" data-decision="reject" bind:tap="handleDecide">驳回</t-button>
      </view>
    </view>
    <view wx:if="{{visibleRows.length === 0}}" class="empty-state">暂无待审批申请</view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
</view>
