.approvals-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.approvals-section {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.approvals-section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.approvals-empty {
  padding: 24rpx;
  color: var(--color-text-muted);
  background: var(--color-surface);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  text-align: center;
}

.approval-card {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.approval-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.approval-title {
  font-size: 28rpx;
  font-weight: 600;
}

.approval-detail {
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.approval-status {
  color: var(--color-primary);
  font-size: 22rpx;
}

.approval-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.approval-button {
  padding: 10rpx 20rpx;
  color: var(--color-text-muted);
  background: #f3f4f6;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-align: center;
}

.approval-button.is-primary {
  color: var(--color-primary);
  background: #e8f1fb;
}

.approval-button.is-danger {
  color: #b42318;
  background: #fee4e2;
}

.approvals-card {
  padding: 48rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.approvals-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  color: var(--color-text-muted);
}

.approvals-error {
  color: var(--color-weekend);
  text-align: center;
}

.approval-modal-mask {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.approval-modal {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  width: 560rpx;
  padding: 40rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
}

.approval-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.approval-modal-row {
  color: var(--color-text);
  font-size: 28rpx;
}
