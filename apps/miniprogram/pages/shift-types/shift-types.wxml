<view class="page-container shift-types-page">
  <view wx:if="{{loading}}" class="shift-card shift-state">
    <text>加载中…</text>
  </view>

  <block wx:elif="{{groupId}}">
    <view class="shift-card">
      <text class="shift-title">新增自定义班种</text>
      <text class="shift-copy">全天班固定为 08:00 至次日 08:00；其他班种需填写时间才可启用。</text>
      <view class="shift-field">
        <text class="shift-label">名称</text>
        <input
          class="shift-input"
          value="{{newShift.name}}"
          maxlength="100"
          data-field="name"
          bind:input="handleNewFieldInput"
        />
      </view>
      <view class="shift-field">
        <text class="shift-label">简称</text>
        <input
          class="shift-input"
          value="{{newShift.abbreviation}}"
          maxlength="16"
          data-field="abbreviation"
          bind:input="handleNewFieldInput"
        />
      </view>
      <view class="shift-field">
        <text class="shift-label">颜色（#RRGGBB）</text>
        <input
          class="shift-input"
          value="{{newShift.color}}"
          maxlength="7"
          data-field="color"
          bind:input="handleNewFieldInput"
        />
      </view>
      <view class="shift-field">
        <text class="shift-label">开始时间</text>
        <picker
          mode="time"
          value="{{newShift.startTime}}"
          data-field="startTime"
          bindchange="handleNewTimeChange"
        >
          <view class="shift-picker">{{newShift.startTime || '请选择'}} ▾</view>
        </picker>
      </view>
      <view class="shift-field">
        <text class="shift-label">结束时间</text>
        <picker
          mode="time"
          value="{{newShift.endTime}}"
          data-field="endTime"
          bindchange="handleNewTimeChange"
        >
          <view class="shift-picker">{{newShift.endTime || '请选择'}} ▾</view>
        </picker>
      </view>
      <view class="shift-switch-row">
        <text class="shift-label">跨日</text>
        <switch
          checked="{{newShift.crossesMidnight}}"
          color="#1F5AA6"
          data-field="crossesMidnight"
          bindchange="handleNewSwitchChange"
        />
      </view>
      <view class="shift-switch-row">
        <text class="shift-label">启用</text>
        <switch
          checked="{{newShift.isEnabled}}"
          color="#1F5AA6"
          data-field="isEnabled"
          bindchange="handleNewSwitchChange"
        />
      </view>
      <view class="shift-switch-row">
        <text class="shift-label">计入统计</text>
        <switch
          checked="{{newShift.countsTowardStatistics}}"
          color="#1F5AA6"
          data-field="countsTowardStatistics"
          bindchange="handleNewSwitchChange"
        />
      </view>
      <t-button
        theme="primary"
        block
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:tap="handleCreateShift"
      >
        新增班种
      </t-button>
    </view>

    <view class="shift-card" wx:for="{{shiftTypes}}" wx:key="id">
      <view class="shift-header">
        <text class="shift-title">{{item.name}}</text>
        <view
          wx:if="{{!item.isBuiltIn}}"
          class="shift-delete"
          data-index="{{index}}"
          bind:tap="handleDeleteShift"
        >
          删除
        </view>
      </view>
      <view class="shift-field">
        <text class="shift-label">名称</text>
        <input
          class="shift-input"
          value="{{item.name}}"
          maxlength="100"
          data-index="{{index}}"
          data-field="name"
          bind:input="handleFieldInput"
        />
      </view>
      <view class="shift-field">
        <text class="shift-label">简称</text>
        <input
          class="shift-input"
          value="{{item.abbreviation}}"
          maxlength="16"
          data-index="{{index}}"
          data-field="abbreviation"
          bind:input="handleFieldInput"
        />
      </view>
      <view class="shift-field">
        <text class="shift-label">颜色</text>
        <input
          class="shift-input"
          value="{{item.color}}"
          maxlength="7"
          data-index="{{index}}"
          data-field="color"
          bind:input="handleFieldInput"
        />
      </view>
      <view class="shift-field">
        <text class="shift-label">开始时间</text>
        <picker
          mode="time"
          value="{{item.startTime}}"
          disabled="{{item.isAllDay}}"
          data-index="{{index}}"
          data-field="startTime"
          bindchange="handleTimeChange"
        >
          <view class="shift-picker">{{item.startTime || '请选择'}} ▾</view>
        </picker>
      </view>
      <view class="shift-field">
        <text class="shift-label">结束时间</text>
        <picker
          mode="time"
          value="{{item.endTime}}"
          disabled="{{item.isAllDay}}"
          data-index="{{index}}"
          data-field="endTime"
          bindchange="handleTimeChange"
        >
          <view class="shift-picker">{{item.endTime || '请选择'}} ▾</view>
        </picker>
      </view>
      <view class="shift-switch-row">
        <text class="shift-label">跨日</text>
        <switch
          checked="{{item.crossesMidnight}}"
          disabled="{{item.isAllDay}}"
          color="#1F5AA6"
          data-index="{{index}}"
          data-field="crossesMidnight"
          bindchange="handleSwitchChange"
        />
      </view>
      <view class="shift-switch-row">
        <text class="shift-label">启用</text>
        <switch
          checked="{{item.isEnabled}}"
          disabled="{{item.isAllDay}}"
          color="#1F5AA6"
          data-index="{{index}}"
          data-field="isEnabled"
          bindchange="handleSwitchChange"
        />
      </view>
      <view class="shift-switch-row">
        <text class="shift-label">计入统计</text>
        <switch
          checked="{{item.countsTowardStatistics}}"
          color="#1F5AA6"
          data-index="{{index}}"
          data-field="countsTowardStatistics"
          bindchange="handleSwitchChange"
        />
      </view>
      <t-button
        theme="default"
        block
        variant="outline"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        data-index="{{index}}"
        bind:tap="handleSaveShift"
      >
        保存
      </t-button>
    </view>

    <text wx:if="{{errorMessage}}" class="shift-error">{{errorMessage}}</text>
  </block>

  <view wx:else class="shift-card shift-state">
    <text>请先选择一个群组。</text>
  </view>
</view>
