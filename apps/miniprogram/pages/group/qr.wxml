<view class="page-container">
  <view wx:if="{{imageSrc}}" class="card qr-card">
    <image class="qr-image" src="{{imageSrc}}" mode="aspectFit" />
    <view class="card-copy">访客扫码后可直接查看排班月历，无需登录。</view>
    <view class="actions">
      <t-button theme="primary" block bind:tap="handleSave">保存到相册</t-button>
    </view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
</view>
