<view class="page-container">
  <view class="card">
    <view class="card-title">{{isAdminMode ? '预填联系方式' : '我的联系方式'}}</view>
    <view class="card-copy">{{realName}} · 保存并确认后，日历值班详情将展示已确认号码。</view>
    <view class="contact-field">
      <t-input
        value="{{mobilePhone}}"
        placeholder="手机长号"
        type="number"
        maxlength="20"
        bind:change="onMobileInput"
      />
    </view>
    <view class="contact-field">
      <t-input
        value="{{shortPhone}}"
        placeholder="短号（可选）"
        maxlength="20"
        bind:change="onShortInput"
      />
    </view>
    <view class="actions">
      <t-button theme="primary" block loading="{{submitting}}" bind:tap="handleSave">
        {{canConfirm ? '保存并确认' : '保存'}}
      </t-button>
    </view>
    <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
    <view wx:if="{{infoMessage}}" class="info-text">{{infoMessage}}</view>
  </view>
</view>
