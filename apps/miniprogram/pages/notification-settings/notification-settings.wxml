<view class="page-container settings-page">
  <group-switcher
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view wx:if="{{loading}}" class="settings-card settings-state">
    <text>加载中…</text>
  </view>

  <block wx:else>
    <view class="settings-card">
      <text class="settings-title">微信订阅通知</text>
      <view class="settings-row">
        <text class="settings-label">接收微信值班提醒</text>
        <switch
          checked="{{wechatNotificationsEnabled}}"
          color="#1F5AA6"
          bindchange="handleWechatToggle"
        />
      </view>
      <text class="settings-hint">开启后每次进入会静默补充订阅额度；拒绝后站内通知仍可用。</text>
    </view>

    <view class="settings-card">
      <text class="settings-title">我的值班提醒时间</text>
      <view
        class="settings-option {{myHoursMode === 'default' ? 'is-selected' : ''}}"
        data-mode="default"
        bind:tap="handleHoursModeChange"
      >
        使用群组默认
      </view>
      <view
        class="settings-option {{myHoursMode === 'custom' ? 'is-selected' : ''}}"
        data-mode="custom"
        bind:tap="handleHoursModeChange"
      >
        自定义提前小时数
      </view>
      <view
        class="settings-option {{myHoursMode === 'off' ? 'is-selected' : ''}}"
        data-mode="off"
        bind:tap="handleHoursModeChange"
      >
        关闭值班提醒
      </view>
      <t-input
        wx:if="{{myHoursMode === 'custom'}}"
        value="{{myHoursInput}}"
        placeholder="例如：48, 12"
        bind:change="handleMyHoursInput"
      />
    </view>

    <view class="settings-card" wx:if="{{canManageSettings}}">
      <text class="settings-title">群组默认提醒时间</text>
      <t-input
        value="{{groupHoursInput}}"
        placeholder="例如：24, 2"
        bind:change="handleGroupHoursInput"
      />
    </view>

    <text wx:if="{{successMessage}}" class="settings-success">{{successMessage}}</text>
    <text wx:if="{{errorMessage}}" class="settings-error">{{errorMessage}}</text>
    <t-button
      theme="primary"
      block
      loading="{{saving}}"
      disabled="{{saving || loading}}"
      bind:tap="handleSave"
    >
      保存提醒设置
    </t-button>
  </block>
</view>
