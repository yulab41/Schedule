<view class="page-container group-members-page">
  <group-switcher
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view wx:if="{{loading}}" class="members-card members-state">
    <text>加载中…</text>
  </view>

  <block wx:elif="{{selectedGroupId}}">
    <view class="members-card">
      <text class="members-title">添加待认领人员</text>
      <text class="members-copy">每行一个真实姓名；添加后可对每位人员创建邀请链接。</text>
      <textarea
        class="members-textarea"
        value="{{rosterNames}}"
        maxlength="2000"
        placeholder="例如：&#10;张三&#10;李四"
        bind:input="handleRosterInput"
      />
      <t-button
        theme="default"
        block
        variant="outline"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:tap="handleAddRoster"
      >
        添加名单
      </t-button>
    </view>

    <view class="members-card" wx:if="{{pendingCount > 0}}">
      <text class="members-title">待认领名单（{{pendingCount}}）</text>
      <t-button
        theme="primary"
        block
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:tap="handleConvertPending"
      >
        全部转为正式成员
      </t-button>
    </view>

    <view class="members-card">
      <text class="members-title">成员列表</text>
      <view class="member-row" wx:for="{{members}}" wx:key="id">
        <view class="member-main">
          <view class="member-name-line">
            <text class="member-name">{{item.realName}}</text>
            <text wx:if="{{item.isCurrentUser}}" class="member-badge">我</text>
          </view>
          <text class="member-meta">{{item.roleLabel}} · {{item.claimLabel}}</text>
        </view>
        <view class="member-actions">
          <view
            wx:if="{{item.isPendingRoster || item.isUnclaimed}}"
            class="member-action is-primary"
            data-id="{{item.id}}"
            data-name="{{item.realName}}"
            data-pending="{{item.isPendingRoster}}"
            bind:tap="handleInvite"
          >
            邀请
          </view>
          <view
            wx:if="{{item.isPendingRoster && selectedRole !== 'member'}}"
            class="member-action"
            data-id="{{item.id}}"
            data-name="{{item.realName}}"
            data-pending="{{item.isPendingRoster}}"
            bind:tap="handleDeleteMember"
          >
            删除
          </view>
          <view
            wx:if="{{selectedRole === 'owner' && item.role !== 'owner' && !item.isPendingRoster}}"
            class="member-action"
            data-id="{{item.id}}"
            data-name="{{item.realName}}"
            bind:tap="handleTransfer"
          >
            转让
          </view>
          <view
            wx:if="{{selectedRole === 'owner' && item.role === 'member' && !item.isPendingRoster}}"
            class="member-action"
            data-id="{{item.id}}"
            data-role="administrator"
            bind:tap="handleToggleRole"
          >
            设管理员
          </view>
          <view
            wx:if="{{selectedRole === 'owner' && item.role === 'administrator'}}"
            class="member-action"
            data-id="{{item.id}}"
            data-role="member"
            bind:tap="handleToggleRole"
          >
            移除管理员
          </view>
          <view
            wx:if="{{(selectedRole === 'owner' || selectedRole === 'administrator') && item.role !== 'owner' && !item.isCurrentUser && !item.isPendingRoster}}"
            class="member-action is-danger"
            data-id="{{item.id}}"
            data-name="{{item.realName}}"
            data-pending="{{item.isPendingRoster}}"
            bind:tap="handleDeleteMember"
          >
            删除
          </view>
        </view>
      </view>
      <view wx:if="{{members.length === 0}}" class="members-state">
        <text>暂无成员</text>
      </view>
    </view>

    <text wx:if="{{errorMessage}}" class="members-error">{{errorMessage}}</text>
    <text wx:if="{{infoMessage}}" class="members-success">{{infoMessage}}</text>
  </block>

  <view wx:else class="members-card members-state">
    <text>你还没有加入任何群组。</text>
  </view>
</view>
