<view class="page-container leave-create-page">
  <view class="leave-card">
    <text class="leave-label">开始日期</text>
    <picker mode="date" value="{{startDate}}" bindchange="handleStartDateChange">
      <view class="leave-picker">{{startDate}}</view>
    </picker>
    <text class="leave-label">结束日期</text>
    <picker mode="date" value="{{endDate}}" bindchange="handleEndDateChange">
      <view class="leave-picker">{{endDate}}</view>
    </picker>
    <text class="leave-label">请假类型</text>
    <picker mode="selector" range="{{leaveTypeNames}}" value="{{leaveTypeIndex}}" bindchange="handleTypeChange">
      <view class="leave-picker">{{leaveType}}</view>
    </picker>
    <text class="leave-label">请假原因（可选）</text>
    <t-input
      value="{{reason}}"
      placeholder="请输入请假原因"
      maxlength="1000"
      bind:change="handleReasonInput"
    />

    <view wx:if="{{affectedShifts.length > 0}}" class="leave-affected">
      <text class="leave-label">影响的已发布班次</text>
      <view class="leave-shift-row" wx:for="{{affectedShifts}}" wx:key="label" wx:for-item="shift">
        <text class="leave-shift-label">{{shift.label}}</text>
        <text class="leave-shift-covered {{shift.coveredLabel === '未安排' ? 'is-uncovered' : ''}}">
          {{shift.coveredLabel}}
        </text>
      </view>
      <text class="leave-label">处理方式</text>
      <view
        class="leave-option {{resolutionMode === 'shift-forward' ? 'is-selected' : ''}}"
        data-mode="shift-forward"
        bind:tap="selectResolutionMode"
      >
        整体顺延（后续值班依次顺延）
      </view>
      <view
        class="leave-option {{resolutionMode === 'manual' ? 'is-selected' : ''}}"
        data-mode="manual"
        bind:tap="selectResolutionMode"
      >
        手动安排（需覆盖所有受影响班次）
      </view>
    </view>

    <text wx:if="{{errorMessage}}" class="leave-error">{{errorMessage}}</text>
    <t-button
      theme="primary"
      block
      loading="{{submitting || loading}}"
      disabled="{{submitting || loading}}"
      bind:tap="handleSubmit"
    >
      提交请假申请
    </t-button>
  </view>
</view>
