.invite-create-page {
  display: grid;
  gap: 24rpx;
}

.invite-card {
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.invite-state {
  text-align: center;
  color: var(--color-text-muted);
}

.invite-title {
  display: block;
  margin: 0 0 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.invite-copy {
  display: block;
  margin: 0 0 20rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.invite-field {
  margin: 0 0 20rpx;
}

.invite-label {
  display: block;
  margin: 0 0 8rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
}

.invite-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe3ea;
  border-radius: var(--radius-md);
}

.invite-picker-arrow {
  color: var(--color-text-muted);
}

.invite-error {
  display: block;
  margin-top: 16rpx;
  color: #e03131;
  font-size: 26rpx;
}

.invite-share-button {
  margin: 0 0 16rpx;
  color: #ffffff;
  background: #1f5aa6;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}

.invite-share-button::after {
  border: 0;
}
