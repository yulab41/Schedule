<view class="page-container statistics-page">
  <view wx:if="{{loading}}" class="stats-card stats-state">
    <text>加载中…</text>
  </view>

  <block wx:elif="{{groupId}}">
    <view class="stats-tabs">
      <view
        class="stats-tab {{activeTab === 'month' ? 'is-active' : ''}}"
        data-tab="month"
        bind:tap="switchTab"
      >
        月度
      </view>
      <view
        class="stats-tab {{activeTab === 'year' ? 'is-active' : ''}}"
        data-tab="year"
        bind:tap="switchTab"
      >
        年度
      </view>
    </view>

    <view class="stats-toolbar">
      <t-button
        wx:if="{{activeTab === 'month'}}"
        size="small"
        variant="outline"
        data-delta="-1"
        bind:tap="changeMonth"
      >
        上一月
      </t-button>
      <text class="stats-period">{{activeTab === 'month' ? monthLabel : year}}</text>
      <block wx:if="{{activeTab === 'month'}}">
        <t-button size="small" variant="outline" data-delta="1" bind:tap="changeMonth">
          下一月
        </t-button>
      </block>
      <picker
        wx:else
        mode="selector"
        range="{{yearNames}}"
        value="{{yearIndex}}"
        bindchange="handleYearChange"
      >
        <view class="stats-year-picker">{{year}} ▾</view>
      </picker>
    </view>

    <view class="stats-card">
      <text class="stats-title">汇总</text>
      <view class="stats-summary-grid">
        <view class="stats-summary-item" wx:for="{{summaryRows}}" wx:key="label">
          <text class="stats-summary-label">{{item.label}}</text>
          <text class="stats-summary-value">{{item.value}}</text>
        </view>
      </view>
      <view class="stats-actions" wx:if="{{activeTab === 'month'}}">
        <t-button
          theme="default"
          size="small"
          variant="outline"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:tap="handleRefreshMonth"
        >
          刷新快照
        </t-button>
        <t-button
          theme="default"
          size="small"
          variant="outline"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:tap="handleRecalculate"
        >
          重算校验
        </t-button>
      </view>
    </view>

    <view class="stats-card">
      <text class="stats-title">成员明细</text>
      <view class="stats-member-row" wx:for="{{memberRows}}" wx:key="realName">
        <text class="stats-member-name">{{item.realName}}</text>
        <text class="stats-member-meta">
          计划 {{item.plannedCount}} / 实际 {{item.actualCount}}
        </text>
        <text class="stats-member-meta">
          周末 {{item.weekendCount}} · 节假日 {{item.holidayCount}} · 加扣 {{item.netDutyAdjustment}}
        </text>
        <text class="stats-member-meta">
          请假覆盖 {{item.leaveCoverCount}} · 手动 {{item.manualAdjustmentCount}} · 换班 {{item.swapCount}}
        </text>
        <text class="stats-member-meta">
          加班 {{item.overtimeCount}} · 扣班 {{item.deductionCount}} · 差值 {{item.deltaCount}}
        </text>
      </view>
      <view wx:if="{{memberRows.length === 0}}" class="stats-state">
        <text>暂无统计明细</text>
      </view>
    </view>

    <text wx:if="{{errorMessage}}" class="stats-error">{{errorMessage}}</text>
    <text wx:if="{{infoMessage}}" class="stats-success">{{infoMessage}}</text>
  </block>

  <view wx:else class="stats-card stats-state">
    <text>请先选择一个群组。</text>
  </view>
</view>
