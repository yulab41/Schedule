.statistics-page {
  display: grid;
  gap: 24rpx;
}

.stats-tabs {
  display: flex;
  padding: 8rpx;
  background: #e9eef4;
  border-radius: var(--radius-md);
}

.stats-tab {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 10rpx;
  color: var(--color-text-muted);
  text-align: center;
  font-size: 28rpx;
}

.stats-tab.is-active {
  color: #1f5aa6;
  background: var(--color-surface);
  font-weight: 600;
}

.stats-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stats-period {
  font-size: 34rpx;
  font-weight: 600;
}

.stats-year-picker {
  padding: 12rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  font-size: 30rpx;
}

.stats-card {
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stats-state {
  text-align: center;
  color: var(--color-text-muted);
}

.stats-title {
  display: block;
  margin: 0 0 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.stats-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stats-summary-item {
  padding: 20rpx;
  background: #f8fafc;
  border-radius: var(--radius-md);
}

.stats-summary-label {
  display: block;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.stats-summary-value {
  display: block;
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.stats-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.stats-member-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f4;
}

.stats-member-row:last-child {
  border-bottom: 0;
}

.stats-member-name {
  display: block;
  margin-bottom: 4rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.stats-member-meta {
  display: block;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.stats-error {
  display: block;
  color: #e03131;
  font-size: 26rpx;
}

.stats-success {
  display: block;
  color: #1f7a3d;
  font-size: 26rpx;
}
