.week-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.week-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.week-label {
  font-size: 28rpx;
  font-weight: 600;
}

.week-view-tabs {
  display: flex;
  padding: 6rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.week-view-tab {
  flex: 1;
  padding: 12rpx 0;
  color: var(--color-text-muted);
  font-size: 26rpx;
  text-align: center;
}

.week-view-tab.is-active {
  color: var(--color-primary);
  background: #e8f1fb;
  border-radius: var(--radius-sm);
  font-weight: 600;
}

.week-day-card {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  padding: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.week-day-header {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.week-day-number {
  font-size: 28rpx;
  font-weight: 600;
}

.week-day-number.is-weekend,
.week-day-weekday.is-weekend {
  color: var(--color-weekend);
}

.week-day-number.is-today {
  color: #8a6d00;
}

.week-day-weekday {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.week-today-badge {
  padding: 2rpx 10rpx;
  color: #8a6d00;
  background: var(--color-today);
  border-radius: 999rpx;
  font-size: 20rpx;
}

.week-duty-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.week-empty {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.week-card {
  padding: 48rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.week-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  color: var(--color-text-muted);
}

.week-error {
  color: var(--color-weekend);
  text-align: center;
}
