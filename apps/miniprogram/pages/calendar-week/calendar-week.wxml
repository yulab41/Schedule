<view class="page-container week-page">
  <group-switcher
    groups="{{groups}}"
    selected-id="{{selectedGroupId}}"
    bind:change="handleGroupChange"
  />

  <view class="week-toolbar">
    <t-button size="small" variant="outline" bind:tap="changeWeek" data-delta="-1">
      上一周
    </t-button>
    <text class="week-label">{{weekLabel}}</text>
    <t-button size="small" variant="outline" bind:tap="changeWeek" data-delta="1">
      下一周
    </t-button>
  </view>

  <view class="week-view-tabs">
    <view class="week-view-tab" bind:tap="openMonth">月</view>
    <view class="week-view-tab is-active">周</view>
    <view class="week-view-tab" bind:tap="openList">列表</view>
  </view>

  <view wx:if="{{loading}}" class="week-card week-state">
    <text>加载中…</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="week-card week-state">
    <text class="week-error">{{errorMessage}}</text>
    <t-button size="small" variant="outline" bind:tap="loadWeek">重新加载</t-button>
  </view>

  <view wx:elif="{{groups.length === 0}}" class="week-card week-state">
    <text>你还没有加入任何群组。</text>
  </view>

  <block wx:else>
    <view class="week-day-card" wx:for="{{days}}" wx:key="businessDate" wx:for-item="day">
      <view class="week-day-header">
        <text class="week-day-number {{day.isWeekend ? 'is-weekend' : ''}} {{day.isToday ? 'is-today' : ''}}">
          {{day.dayLabel}}
        </text>
        <text class="week-day-weekday {{day.isWeekend ? 'is-weekend' : ''}}">
          {{day.weekdayLabel}}
        </text>
        <text class="week-today-badge" wx:if="{{day.isToday}}">今天</text>
      </view>
      <view class="week-duty-list" wx:if="{{day.assignments.length > 0}}">
        <shift-card
          wx:for="{{day.assignments}}"
          wx:key="id"
          wx:for-item="assignment"
          assignment="{{assignment}}"
          member="{{membersMap[assignment.actualMembershipId || assignment.plannedMembershipId]}}"
          bind:dutytap="handleDutyTap"
          bind:call="handleCall"
        />
      </view>
      <text wx:else class="week-empty">当日无排班</text>
    </view>
  </block>

  <duty-detail
    detail="{{dutyDetail}}"
    visible="{{showDetail}}"
    bind:close="closeDetail"
    bind:call="handleCall"
  />
</view>
