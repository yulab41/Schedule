<view class="page-container">
  <view class="card">
    <view class="card-title">{{weekLabel}}</view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  <view wx:for="{{days}}" wx:key="businessDate" class="card">
    <view class="row-between week-day-header">
      <text class="week-day-label {{item.isToday ? 'is-today' : ''}}">{{item.label}}</text>
      <text wx:if="{{item.isToday}}" class="week-day-today">今天</text>
    </view>
    <shift-card
      wx:for="{{item.assignments}}"
      wx:for-item="assignment"
      wx:key="id"
      assignment="{{assignment}}"
      data-day="{{index}}"
      data-index="{{index}}"
      bind:tap="handleAssignmentTap"
    />
    <view wx:if="{{item.assignments.length === 0}}" class="empty-state">无排班</view>
  </view>
  <duty-detail
    show="{{showDetail}}"
    detail="{{dutyDetail}}"
    bind:close="closeDetail"
    bind:call="handleCall"
  />
</view>
