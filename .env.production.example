# Production Docker deployment on Aliyun ECS. Copy to .env.production on the
# server and replace every value with a strong random secret.
NODE_ENV=production
AUTH_DEV_MODE=false
AUTH_PASSWORD_ENABLED=true
MYSQL_DATABASE=schedule_prod
MYSQL_USER=schedule_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters

# Generate with: node -e "const webpush=require('web-push');console.log(webpush.generateVAPIDKeys())"
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WeChat mini program. AppSecret and WECHAT_SESSION_SECRET are secrets: keep
# them only in the server .env.production, never in the repository. Mock mode
# is rejected by the API in production.
WECHAT_APPID=wx56a7a21f974fd9af
WECHAT_APPSECRET=replace-with-mini-program-app-secret
WECHAT_SESSION_SECRET=replace-with-32-byte-session-secret
WECHAT_MOCK_MODE=false
WECHAT_QR_ENV_VERSION=release
WECHAT_DUTY_REMINDER_TEMPLATE_ID=Nmgf9k3bTIUaohtQFIMl8j_xbZAN2VDm1qnpQIL5WKI

# Mini Program release contract. Every value is explicit in production: an
# unknown version is rejected and disabled modules are blocked by both client
# and API. The previous experience build remains the legacy-token contract.
MINIPROGRAM_SUPPORTED_CLIENT_VERSIONS=0.1.0-p6.20260824.78,0.1.0-p6.20260824.79,0.1.0-p6.20260824.80,0.1.0-p6.20260824.81
MINIPROGRAM_LEGACY_CLIENT_VERSION=0.1.0-p6.20260824.78
MINIPROGRAM_CAPABILITY_GLOBAL_ENABLED=true
MINIPROGRAM_CAPABILITY_CORE_ENABLED=true
MINIPROGRAM_CAPABILITY_WORKFLOWS_ENABLED=false
MINIPROGRAM_CAPABILITY_ORGANIZATION_ENABLED=false
MINIPROGRAM_CAPABILITY_INSIGHTS_ENABLED=false
MINIPROGRAM_CAPABILITY_EXTERNAL_MESSAGES_ENABLED=false
MINIPROGRAM_CAPABILITY_GUEST_ENABLED=true

# Browser website QR login is not enabled because it requires a separate
# WeChat Open Platform website application. Leave these values empty until one
# is available; production account/password login does not use them.
WECHAT_WEB_APPID=
WECHAT_WEB_APPSECRET=
WECHAT_WEB_REDIRECT_URI=

# Fill these with stable administrator user IDs after formal admin assignment;
# never use local-admin or local-member in production.
HOLIDAY_ADMIN_UIDS=
PLATFORM_ADMIN_UIDS=
