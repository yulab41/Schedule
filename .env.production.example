# Production Docker deployment on Aliyun ECS. Copy to .env.production on the
# server and replace every value with a strong random secret.
MYSQL_DATABASE=schedule_prod
MYSQL_USER=schedule_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters

VAPID_SUBJECT=mailto:replace-with-a-contact-address@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 试用期临时门禁（浏览器密码提示）：仅限当前非正式测试阶段。
# 值填任意提示名（如 Trial_access）即开启，填 off 即关闭。
# 微信小程序/正式上线改用微信账号登录前，必须改回 off 并按部署文档移除门禁。
NGINX_BASIC_AUTH_REALM=Trial_access
# .htpasswd 在容器内的路径（一般保持默认，无需改动）。
# NGINX_BASIC_AUTH_USER_FILE=/etc/nginx/.htpasswd

# Dev-mode auth UIDs until the self-hosted auth task lands.
HOLIDAY_ADMIN_UIDS=local-admin
PLATFORM_ADMIN_UIDS=local-admin
