{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@schedule/client-core": ["packages/client-core/src/index.ts"],
      "@schedule/client-core/testing": ["packages/client-core/src/testing/index.ts"],
      "@schedule/contracts/workspace-name": ["packages/contracts/src/workspace-name.ts"],
      "@schedule/contracts": ["packages/contracts/src/index.ts"],
      "@schedule/database": ["packages/database/src/index.ts"],
      "@schedule/presentation-core": ["packages/presentation-core/src/index.ts"],
      "@schedule/presentation-core/testing": ["packages/presentation-core/src/testing/index.ts"],
      "@schedule/scheduling-domain": ["packages/scheduling-domain/src/index.ts"],
      "@schedule/test-fixtures": ["packages/test-fixtures/src/index.ts"],
      "@schedule/ui-tokens": ["packages/ui-tokens/src/index.ts"]
    }
  }
}
