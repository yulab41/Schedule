{
  "name": "@schedule/ui-icons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:generated": "node scripts/generate-miniprogram-assets.mjs --check && node scripts/generate-motion-adapters.mjs --check",
    "generate:mini": "node scripts/generate-miniprogram-assets.mjs",
    "generate:motion": "node scripts/generate-motion-adapters.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@schedule/ui-tokens": "workspace:*"
  }
}
