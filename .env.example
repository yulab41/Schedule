# Local development only. Do not reuse any of these values in production.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# Local development auth. Both switches must stay off (or absent) in
# production; the API refuses the dev auth port unless NODE_ENV=development,
# so this is a defense-in-depth switch.
VITE_AUTH_DEV_MODE=false
AUTH_DEV_MODE=false

# Public web runtime configuration.
VITE_API_BASE_URL=/api

# Vite dev server proxy target. vite.config.ts reads this from the root .env
# via loadEnv. Defaults to the local API on port 3000; start a second dev web
# on another port with VITE_API_PROXY_TARGET=http://127.0.0.1:3001 to accept
# against a separate API instance.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Persistent development MySQL on the host port below.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=schedule_dev
MYSQL_USER=schedule_app
MYSQL_PASSWORD=replace-with-a-local-development-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password

# Ephemeral test MySQL. It is deliberately isolated from the development database.
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3307
TEST_MYSQL_DATABASE=schedule_test
TEST_MYSQL_USER=schedule_test_app
TEST_MYSQL_PASSWORD=replace-with-a-local-test-password
TEST_MYSQL_ROOT_PASSWORD=replace-with-a-different-local-test-root-password

# Optional browser push (Web Push). Leave empty for local development; the
# production deployment configures real VAPID keys. Generate keys with:
#   node -e "const webpush=require('web-push');console.log(webpush.generateVAPIDKeys())"
VAPID_SUBJECT=mailto:replace-with-a-contact-address@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Platform administrators allowed to import and confirm official holiday data.
# Comma-separated stable user UIDs; empty means holiday imports are disabled.
HOLIDAY_ADMIN_UIDS=

# Platform administrators allowed to restore recycled groups, change user
# status, and read job/backup state. Comma-separated stable user UIDs.
PLATFORM_ADMIN_UIDS=

# Encrypted database backup destination and key. BACKUP_ENCRYPTION_KEY must be
# 32 bytes (64 hex characters or base64). Backups fail closed when the key is
# missing; never store plaintext backups.
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=

# WeChat mini program. WECHAT_MOCK_MODE=true lets local development run without
# real credentials (stable mock openid / placeholder QR / logged sends). The
# API refuses WECHAT_MOCK_MODE=true when NODE_ENV=production.
WECHAT_APPID=wx56a7a21f974fd9af
WECHAT_APPSECRET=
WECHAT_SESSION_SECRET=
WECHAT_MOCK_MODE=true
WECHAT_QR_ENV_VERSION=develop
WECHAT_DUTY_REMINDER_TEMPLATE_ID=Nmgf9k3bTIUaohtQFIMl8j_xbZAN2VDm1qnpQIL5WKI
WECHAT_APPROVAL_RESULT_TEMPLATE_ID=
WECHAT_STATUS_CHANGE_TEMPLATE_ID=
