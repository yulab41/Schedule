{
  "name": "medical-staff-scheduling-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" --if-present run build && pnpm holidays:build",
    "ecs:package": "node scripts/package-ecs-release.mjs",
    "ecs:source-audit": "node scripts/audit-ecs-release-source.mjs",
    "release:worktree": "node scripts/prepare-release-worktree.mjs",
    "dev": "pnpm --filter @schedule/api build && pnpm --parallel --filter @schedule/api --filter @schedule/web run dev",
    "dev:api": "pnpm --filter @schedule/api build && pnpm --filter @schedule/api start",
    "dev:web": "pnpm --filter @schedule/web dev",
    "directory:import": "node --env-file=.env infra/scripts/dist/import-directory.js",
    "directory:readiness:setup": "node scripts/directory-query-readiness/setup-isolation.mjs",
    "directory:readiness:plans": "node scripts/directory-query-readiness/plan-audit.mjs",
    "directory:readiness:concurrency": "node scripts/directory-query-readiness/concurrency-benchmark.mjs",
    "directory:readiness:import-ddl": "node scripts/directory-query-readiness/import-ddl-benchmark.mjs",
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.js .prettierrc.json \"{apps,packages}/**/*.{ts,vue,json,html}\" \"infra/scripts/**/*.ts\" \"scripts/*.mjs\" \"scripts/directory-query-readiness/**/*.mjs\" \"packages/*/scripts/*.mjs\" \"apps/miniprogram/scripts/*.mjs\"",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.js .prettierrc.json \"{apps,packages}/**/*.{ts,vue,json,html}\" \"infra/scripts/**/*.ts\" \"scripts/*.mjs\" \"scripts/directory-query-readiness/**/*.mjs\" \"packages/*/scripts/*.mjs\" \"apps/miniprogram/scripts/*.mjs\"",
    "holidays:build": "tsc -p infra/scripts/tsconfig.json",
    "holidays:import": "node --env-file=.env infra/scripts/dist/import-holidays.js",
    "load:build": "tsc -p tests/load/tsconfig.json",
    "load:test": "node --env-file=.env tests/load/dist/run-load-test.js",
    "icon:parity": "pnpm --filter @schedule/ui-icons build && pnpm icon:parity:check",
    "icon:parity:check": "pnpm --filter @schedule/ui-icons check:generated && node scripts/icon-parity-determinism.mjs && node scripts/icon-parity.mjs",
    "restore:backup": "node --env-file=.env infra/scripts/dist/restore-backup.js",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:check-core": "node scripts/smoke-browser.mjs --check-core",
    "lint": "eslint \"{apps,packages}/**/*.{ts,vue}\" \"apps/miniprogram/scripts/**/*.mjs\" \"scripts/directory-query-readiness/**/*.mjs\" \"infra/scripts/**/*.ts\" --max-warnings=0",
    "miniprogram:build": "pnpm --filter @schedule/miniprogram build",
    "miniprogram:ci:dry-run": "pnpm --filter @schedule/miniprogram ci:dry-run",
    "miniprogram:package-audit": "pnpm --filter @schedule/miniprogram check:package",
    "miniprogram:preview": "pnpm --filter @schedule/miniprogram preview",
    "miniprogram:test": "pnpm --filter @schedule/miniprogram test",
    "miniprogram:upload-experience": "pnpm --filter @schedule/miniprogram upload:experience",
    "miniprogram:verify": "pnpm --filter @schedule/miniprogram verify",
    "miniprogram:visual-compare": "pnpm --filter @schedule/miniprogram visual:compare",
    "test": "node --test scripts/codex/*.test.mjs && vitest run",
    "test:api-integration": "node --env-file=.env scripts/run-api-integration.mjs",
    "test:api-integration:manual-schedule": "node --env-file=.env scripts/run-api-integration-manual-schedule.mjs",
    "test:api-integration:task10": "node --env-file=.env scripts/run-api-integration-task10.mjs",
    "tokens:generate": "pnpm --filter @schedule/ui-tokens generate",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" --if-present run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm icon:parity:check && pnpm miniprogram:test && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1"
  }
}
